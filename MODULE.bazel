module(name = "xrack", version = "0.7.0")

bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "hermetic_android_toolchains", version = "0.2.0", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_rust_bindgen", version = "0.75.0")
bazel_dep(name = "rules_rust_pyo3", version = "0.75.0")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "rules_multitool", version = "0.11.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "ffmpeg", version = "9.0.1.beta.bcr.6")

# OpenSSL needs Winsock declarations and a native Perl runtime on Windows.
bazel_dep(name = "openssl", version = "3.5.9.bcr.1")
bazel_dep(name = "rules_perl", version = "2.1.0")

single_version_override(
    module_name = "ffmpeg",
    patches = [
        "//bazel:ffmpeg_hls_window.patch",
        "//bazel:ffmpeg_windows_probes.patch",
    ],
    patch_strip = 1,
)

single_version_override(
    module_name = "openssl",
    patches = [
        "//bazel:openssl_windows_ssize_max.patch",
        "//bazel:openssl_windows_winstore.patch",
    ],
    patch_strip = 1,
)

register_toolchains("@llvm//toolchain:all")

# Download pinned Android tools instead of discovering a host installation.
android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(version = "34", build_tools_version = "35.0.0")
android.ndk(version = "r28c", api_level = 26)
use_repo(android, "androidsdk", "androidndk")

android_sdk = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension")
override_repo(android_sdk, "androidsdk")

android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
override_repo(android_ndk, "androidndk")

# Gazelle requires a newer Go SDK than the one requested by rules_android.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.6")

single_version_override(
    module_name = "rules_rust",
    patches = ["//bazel:rust_llvm_msvc_linker.patch"],
    patch_strip = 1,
)

single_version_override(
    module_name = "rules_rust_bindgen",
    patches = [
        "//bazel:bindgen_libclang_runtime.patch",
        "//bazel:bindgen_toolchain_headers.patch",
        "//bazel:bindgen_windows_imports.patch",
    ],
    patch_strip = 1,
)

# MLIR is built from the LLVM module's source repository. No system LLVM discovery.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "23.1.2")
use_repo(llvm, "llvm-project")
register_toolchains("//mlir:bindgen_toolchain")

# Keep the SDK supplied by LLVM and include the frameworks used by desktop apps.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "AVFAudio",
    "AVFCapture",
    "AVFCore",
    "AVFoundation",
    "AVRouting",
    "AppKit",
    "ApplicationServices",
    "AudioToolbox",
    "AudioToolboxCore",
    "Carbon",
    "CFNetwork",
    "CollectionViewCore",
    "ColorSync",
    "CoreAudio",
    "CoreAudioTypes",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreMIDI",
    "CoreMedia",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "FontServices",
    "Foundation",
    "IOKit",
    "IOSurface",
    "ImageIO",
    "Kernel",
    "Metal",
    "OSLog",
    "OpenGL",
    "QuartzCore",
    "Security",
    "SystemConfiguration",
    "UIFoundation",
    "UniformTypeIdentifiers",
    "VideoToolbox",
])

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
    rustfmt_version = "1.99.1",
    rust_analyzer_version = "1.99.1",
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "wasm32-wasip2",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")
use_repo(python, "python_3_11")
register_toolchains(
    "@rules_rust_pyo3//toolchains:toolchain",
    "//bindings/python:rust_pyo3_toolchain",
)

python_tools = use_extension("//bindings/python:ruff_repositories.bzl", "python_tools")
use_repo(python_tools, "xrack_python_tools")
register_toolchains("@xrack_python_tools//toolchains:all")

rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host_tools.host_tools(
    name = "xrack_rust_host_tools",
    version = "1.99.1",
    rustfmt_version = "1.99.1",
)
use_repo(rust_host_tools, "xrack_rust_host_tools")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# Share the same PyO3 instance between the extension and the asyncio bridge.
inject_repo(crate, rules_rust_pyo3 = "rules_rust_pyo3")
python_abi_toolchain = "@rules_rust_pyo3//:current_pyo3_toolchain"
[
    crate.annotation(
        crate = name,
        version = "0.29.0",
        build_script_data = [python_abi_toolchain],
        build_script_env = {
            "PYO3_CROSS": "$(PYO3_CROSS)",
            "PYO3_CROSS_LIB_DIR": "$(PYO3_CROSS_LIB_DIR)",
            "PYO3_CROSS_PYTHON_IMPLEMENTATION": "$(PYO3_CROSS_PYTHON_IMPLEMENTATION)",
            "PYO3_CROSS_PYTHON_VERSION": "$(PYO3_CROSS_PYTHON_VERSION)",
            "PYO3_NO_PYTHON": "$(PYO3_NO_PYTHON)",
            "PYO3_PYTHON": "$(PYO3_PYTHON)",
        },
        build_script_toolchains = [python_abi_toolchain],
    )
    for name in ["pyo3-build-config", "pyo3-ffi"]
]

# Preserve the native AppKit mixed value for tri-state check boxes.
crate.annotation(
    crate = "accesskit_macos",
    version = "0.27.2",
    patch_args = ["-p1"],
    patches = ["//bazel:accesskit_macos_mixed_state.patch"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    host_tools = "@xrack_rust_host_tools",
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-nixos-gnu",
    ],
)
use_repo(crate, "crates")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "miniaudio",
    urls = ["https://codeload.github.com/mackron/miniaudio/tar.gz/refs/tags/0.11.26"],
    type = "tar.gz",
    strip_prefix = "miniaudio-0.11.26",
    sha256 = "838ba55a21c9142adf7b76bdc4351e5cd8b7ae128f46b25ec25f94ae9969c600",
    build_file_content = 'load("@rules_cc//cc:defs.bzl", "cc_library")\ncc_library(name = "headers", hdrs = ["miniaudio.h"], includes = ["."], visibility = ["//visibility:public"])',
)
http_file(
    name = "antlr4_rust_tool",
    urls = ["https://github.com/antlr4rust/antlr4/releases/download/v0.6.0/antlr4-4.13.3-SNAPSHOT-complete.jar"],
    downloaded_file_path = "antlr4-4.13.3-SNAPSHOT-complete.jar",
    sha256 = "391e77311794f7c8fed2bc6d291f54b04725e37456d79e1981edfd3fc919b677",
)

# Extend the document layer of the pinned upstream LSP without changing LLVM's
# repository or the dialect's serialized representation.
mlir_lsp_sources = use_repo_rule("//mlir:lsp_sources.bzl", "mlir_lsp_sources")
mlir_lsp_sources(
    name = "xrack_mlir_lsp_upstream",
    patch = "//mlir:llvm_lsp_document.patch",
    srcs = [
        "@llvm-project//mlir:lib/AsmParser/Lexer.h",
        "@llvm-project//mlir:lib/AsmParser/Token.h",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/LSPServer.cpp",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/LSPServer.h",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/MLIRServer.cpp",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/MLIRServer.h",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/MlirLspServerMain.cpp",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/Protocol.cpp",
        "@llvm-project//mlir:lib/Tools/mlir-lsp-server/Protocol.h",
    ],
)
