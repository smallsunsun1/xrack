load("@rules_rust//rust:defs.bzl", "rust_library")
load(":antlr.bzl", "antlr_rust")

antlr_rust(
    name = "generate_rust",
    src = "Xrack.g4",
    crate_root = "generated/rust/lib.rs",
    outs = [
        "generated/rust/xracklexer.rs",
        "generated/rust/xracklistener.rs",
        "generated/rust/xrackparser.rs",
    ],
)

rust_library(
    name = "xrack_antlr_rust",
    srcs = [":generate_rust"],
    crate_root = "generated/rust/lib.rs",
    edition = "2024",
    tags = ["no-clippy", "no-rustfmt"],
    visibility = ["//crates/xrack-parser:__pkg__"],
    deps = ["@crates//:antlr4rust"],
)
