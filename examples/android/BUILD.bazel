load("//bazel:xrack.bzl", "xr_ui_library")

_NAVIGATION_IMAGE_ASSETS = [
    "//examples/media:assets/pulse.gif",
    "//examples/media:assets/sprite-atlas.png",
]

xr_ui_library(
    name = "mobile_navigation_ui",
    src = "navigation.xr",
    assets = _NAVIGATION_IMAGE_ASSETS,
)

rust_shared_library(
    name = "mobile_navigation",
    srcs = ["navigation.rs"],
    crate_root = "navigation.rs",
    edition = "2024",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":mobile_navigation_ui",
        "//crates/xrack-platform-winit:xrack_platform_winit",
    ],
)

android_binary(
    name = "navigation_app",
    manifest = "NavigationManifest.xml",
    resource_files = ["res/values/styles.xml"],
    tags = ["manual"],
    deps = [
        ":mobile_navigation",
        "//crates/xrack-platform-winit/android:activity",
    ],
)

