<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.xrack.android_controls">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="XRack Controls">
        <activity
            android:name="dev.xrack.platform.XRackActivity"
            android:theme="@style/PocketTasksTheme"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="mobile_controls" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
