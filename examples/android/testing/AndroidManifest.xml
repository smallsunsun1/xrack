<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.xrack.share_test">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application android:label="XRack Test Receiver">
        <service
            android:name=".TestInputMethodService"
            android:exported="true"
            android:label="XRack Test Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/xrack_test_ime" />
        </service>
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
