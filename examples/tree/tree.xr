export struct TreeRecord {
    id: int,
    parent-id: int,
    label: string,
    detail: string,
    active: bool,
    quota: int,
    load: float,
}

export struct SizedBranch {
    key: int,
    parent: int,
    label: string,
    height: length,
}

export struct BranchVisibility {
    shown: bool,
}

export struct VisibilityBranch {
    key: int,
    parent: int,
    label: string,
    visibility: BranchVisibility,
}

export component VisibilityTreeDemo inherits Window {
    title: "XRack · 按记录隐藏树分支";
    width: 540px; height: 312px;
    background: #182331;
    in-out property <[VisibilityBranch]> records: [
        VisibilityBranch { key: 1, parent: -1, label: "工作区", visibility: BranchVisibility { shown: true } },
        VisibilityBranch { key: 2, parent: 1, label: "内部资料", visibility: BranchVisibility { shown: true } },
        VisibilityBranch { key: 3, parent: 2, label: "计划文档", visibility: BranchVisibility { shown: true } },
        VisibilityBranch { key: 4, parent: 1, label: "发布说明", visibility: BranchVisibility { shown: true } },
        VisibilityBranch { key: 5, parent: -1, label: "归档", visibility: BranchVisibility { shown: true } },
    ];
    in-out property <string> query: "";
    in-out property <int> current: -1;
    in property <int> branch-root: -1;
    in property <int> inspected-source: 2;
    in property <int> inspected-view: 1;
    out property <int> visible-index: branches.view-index-for-source(root.inspected-source);
    out property <int> source-index: branches.source-index-for-view(root.inspected-view);
    callback select-source(int);
    select-source(source) => { branches.select-source-index(source); }
    callback toggle-branch();
    callback locate-source(int);
    locate-source(source) => { branches.position-view-at-source-index(source, beginning); }
    callback initialize();
    initialize => { branches.expand-to(3); }

    HorizontalLayout {
        x: 12px; y: 8px; width: 516px; height: 32px;
        spacing: 8px;
        toggle := Button { text: "切换内部资料"; clicked => { root.toggle-branch(); } }
        SearchField { placeholder-text: "搜索分支"; text <=> root.query; }
    }
    branches := TreeView {
        x: 12px; y: 50px; width: 516px; height: 250px;
        row-height: 28px;
        root-key: root.branch-root;
        row-visible-field: "visibility.shown";
        filter-field: "label";
        filter-text: root.query;
        preserve-scroll-anchor: true;
        multi-select: true;
        current-key <=> root.current;
        for entry in root.records : TreeRow {
            key: entry.key;
            parent-key: entry.parent;
            TreeCell { text <=> entry.label; }
        }
    }
}

export component DelegateTreeDemo inherits Window {
    width: 360px; height: 250px;
    in-out property <[SizedBranch]> records: [
        SizedBranch { key: 2, parent: 1, label: "子记录", height: 38px },
        SizedBranch { key: 1, parent: -1, label: "目录", height: 38px },
    ];
    out property <int> committed-index: -1;
    branches := TreeView {
        row-height: 38px;
        for branch[index] in root.records : TreeRow {
            key: branch.key;
            parent-key: branch.parent;
            HorizontalLayout {
                BranchEditor {
                    value <=> branch.label;
                    submitted => { root.committed-index = index; }
                }
            }
        }
    }
}

component BranchEditor inherits HorizontalLayout {
    in-out property <string> value <=> input.text;
    callback submitted <=> input.accepted;
    input := LineEdit { accessible-name: "分支名称"; horizontal-stretch: 1; }
}

export component SizedTreeDemo inherits Window {
    title: "XRack · 不同行高的树";
    width: 320px; height: 240px;
    in-out property <[SizedBranch]> records: [
        SizedBranch { key: 1, parent: -1, label: "目录", height: 32px },
        SizedBranch { key: 2, parent: 1, label: "详情", height: 76px },
        SizedBranch { key: 3, parent: -1, label: "下一条", height: 44px },
    ];
    branches := TreeView {
        row-height-field: "height";
        for branch in root.records : TreeRow {
            key: branch.key;
            parent-key: branch.parent;
            Text { text: branch.label; }
        }
    }
}

export component TreeDemo inherits Window {
    title: "XRack · 目录树";
    width: 600px;
    height: 370px;
    background: #182331;

    in-out property <[TreeRecord]> records: [
        TreeRecord { id: 1, parent-id: -1, label: "项目", detail: "目录", active: true, quota: 10, load: 0.5 },
        TreeRecord { id: 2, parent-id: 1, label: "源码", detail: "目录", active: true, quota: 8, load: 0.7 },
        TreeRecord { id: 3, parent-id: 2, label: "main.rs", detail: "Rust", active: true, quota: 4, load: 0.4 },
        TreeRecord { id: 4, parent-id: 1, label: "README.md", detail: "文档", active: true, quota: 2, load: 0.25 },
        TreeRecord { id: 5, parent-id: -1, label: "归档", detail: "目录", active: false, quota: 5, load: 0.1 },
        TreeRecord { id: 6, parent-id: 5, label: "笔记.txt", detail: "文本", active: false, quota: 2, load: 0.15 },
    ];
    in-out property <int> current: -1;
    in-out property <bool> multiple: true;
    in property <bool> preserve-viewport: false;
    out property <int> expansions: 0;
    out property <int> collapses: 0;
    out property <int> selected-count: 0;
    callback sort-requested();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text { text: "目录树 · F2 重命名，Tab 编辑当前行"; font-size: 20px; }
        directory := TreeView {
            preserve-scroll-anchor: root.preserve-viewport;
            current-key <=> root.current;
            multi-select: root.multiple;
            row-height: 34px;
            indentation: 18px;
            expanded(key) => { root.expansions += 1; }
            collapsed(key) => { root.collapses += 1; }
            selection-changed(count) => { root.selected-count = count; }
            for record[index] in root.records : TreeRow {
                key: record.id;
                parent-key: record.parent-id;
                HorizontalLayout {
                    spacing: 8px;
                    padding-right: 12px;
                    cross-axis-alignment: center;
                    TreeCell { text <=> record.label; horizontal-stretch: 1; height: 30px; }
                    if record.detail != "" : TreeCell {
                        text: record.detail; width: 66px; height: 30px; color: #acc0db;
                    }
                    CheckBox { checked <=> record.active; width: 28px; height: 30px; }
                    SpinBox { value <=> record.quota; editable: true; minimum: 0; maximum: 99; width: 94px; height: 30px; }
                    Slider { value <=> record.load; enabled: record.active; minimum: 0; maximum: 1; step: 0.05; width: 88px; height: 28px; }
                }
            }
        }
        sort := Button { text: "按名称重排模型"; clicked() => { root.sort-requested(); } }
        Text { text: "已选 " + root.selected-count + " 项 · 当前节点 " + root.current; color: #b8caff; }
    }
}


export component TreeCommandsDemo inherits Window {
    title: "XRack · 树目录导航";
    width: 610px; height: 440px;
    background: #162034;
    in-out property <[SizedBranch]> records: [
        SizedBranch { key: 1, parent: -1, label: "项目", height: 34px },
        SizedBranch { key: 10, parent: 1, label: "src", height: 34px },
        SizedBranch { key: 100, parent: 10, label: "platform", height: 34px },
        SizedBranch { key: 103, parent: 100, label: "window.rs", height: 34px },
        SizedBranch { key: 104, parent: 100, label: "accessibility.rs", height: 34px },
        SizedBranch { key: 11, parent: 1, label: "README.md", height: 34px },
        SizedBranch { key: 2, parent: -1, label: "文档", height: 34px },
        SizedBranch { key: 20, parent: 2, label: "构建指南", height: 34px },
    ];
    in-out property <int> current: -1;
    in-out property <int> target: 103;
    out property <int> expansions: 0;
    out property <int> collapses: 0;
    out property <int> last-event-key: -1;
    callback reveal(int);
    reveal(key) => {
        directory.expand-to(key);
        root.current = directory.row-for-key(key) >= 0 ? key : root.current;
        directory.position-view-at-index(directory.row-for-key(key), ScrollAlignment.center);
    }

    VerticalLayout {
        padding: 18px; spacing: 10px;
        Text { text: "按业务键定位目录"; font-size: 23px; }
        HorizontalLayout {
            spacing: 8px;
            target-key := SpinBox {
                value <=> root.target; minimum: 0; maximum: 1000000;
                width: 128px; editable: true; accessible-name: "目标节点键";
            }
            reveal-node := Button { text: "定位节点"; clicked => { root.reveal(root.target); } }
            expand-all := Button { text: "全部展开"; clicked => { directory.expand-recursively(); } }
            collapse-all := Button { text: "全部折叠"; clicked => { directory.collapse-recursively(); } }
        }
        directory := TreeView {
            row-height-field: "height";
            current-key <=> root.current;
            multi-select: true;
            expanded(key) => { root.expansions += 1; root.last-event-key = key; }
            collapsed(key) => { root.collapses += 1; root.last-event-key = key; }
            for item in root.records : TreeRow {
                key: item.key;
                parent-key: item.parent;
                TreeCell { text <=> item.label; height: 32px; }
            }
        }
        node-status := Text {
            text: "节点 " + root.target + " · 深度 " + directory.depth(root.target) + " · 显示行 " + directory.row-for-key(root.target);
            color: #acc0db;
        }
    }
}


export component TreeBranchesDemo inherits Window {
    title: "XRack · 分支浏览";
    width: 760px; height: 430px;
    background: #162034;
    in-out property <[SizedBranch]> records: [
        SizedBranch { key: 1, parent: -1, label: "项目", height: 34px },
        SizedBranch { key: 10, parent: 1, label: "src", height: 34px },
        SizedBranch { key: 100, parent: 10, label: "platform", height: 34px },
        SizedBranch { key: 103, parent: 100, label: "window.rs", height: 34px },
        SizedBranch { key: 104, parent: 100, label: "accessibility.rs", height: 34px },
        SizedBranch { key: 11, parent: 1, label: "README.md", height: 34px },
        SizedBranch { key: 2, parent: -1, label: "文档", height: 34px },
        SizedBranch { key: 20, parent: 2, label: "构建指南", height: 34px },
    ];
    in-out property <int> folder: 1;
    in-out property <string> query: "";
    in-out property <int> current: -1;
    callback initialize();
    initialize => { overview.expand-recursively(); }

    VerticalLayout {
        padding: 18px; spacing: 10px;
        Text { text: "同一份模型 · 不同的浏览分支"; font-size: 23px; }
        HorizontalLayout {
            spacing: 8px;
            all-branches := Button { text: "全部目录"; clicked => { root.folder = -1; root.current = -1; } }
            source-branch := Button { text: "源码分支"; clicked => { root.folder = 10; root.current = -1; } }
            docs-branch := Button { text: "文档分支"; clicked => { root.folder = 2; root.current = -1; } }
            branch-filter := SearchField {
                width: 200px;
                text <=> root.query;
                placeholder-text: "搜索右侧分支";
                accessible-name: "搜索右侧分支";
            }
        }
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 6px;
                Text { text: "选择左侧节点，在右侧查看它的内容"; color: #acc0db; }
                overview := TreeView {
                    row-height-field: "height";
                    current-key <=> root.folder;
                    changed(key) => { root.current = -1; }
                    for item in root.records : TreeRow {
                        key: item.key; parent-key: item.parent;
                        TreeCell { text <=> item.label; height: 32px; }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 6px;
                Text { text: root.folder == -1 ? "完整目录" : "分支 " + root.folder; color: #acc0db; }
                branch := TreeView {
                    root-key: root.folder;
                    filter-field: "label";
                    filter-text: root.query;
                    row-height-field: "height";
                    current-key <=> root.current;
                    multi-select: true;
                    preserve-scroll-anchor: true;
                    for item in root.records : TreeRow {
                        key: item.key; parent-key: item.parent;
                        TreeCell { text <=> item.label; height: 32px; }
                    }
                }
            }
        }
        Text { text: "两侧都可编辑记录，改动会同步显示"; color: #acc0db; }
    }
}
