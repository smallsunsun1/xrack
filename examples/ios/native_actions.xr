}

export component ClipboardAuthorizationDemo inherits Window {
    title <- "Cross-app paste";
    width <- 390px;
    height <- 320px;
    private property <string> draft: "A🧪B";
    private property <int> edits: 0;

    VerticalLayout {
        padding <- 20px;
        spacing <- 12px;
        alignment <- start;
        draft-field := LineEdit {
            accessible-name <- "Paste destination";
            text <-> root.draft;
            edited => { root.edits += 1; }
        }
        selection := Label {
            text <- draft-field.selected-text == "" ? "No selection" : "Selected " + draft-field.selected-text;
        }
        edit-count := Label { text <- "Edits " + root.edits; }
        select-emoji := Button {
            text <- "Select emoji";
            focus-on-click <- false;
            clicked => { draft-field.focus(); draft-field.set-selection-offsets(1, 5); }
        }
        paste := Button {
            text <- "Paste into selection";
            focus-on-click <- false;
            clicked => { draft-field.paste(); }
        }
        undo := Button {
            text <- "Undo edit";
            focus-on-click <- false;
            enabled <- draft-field.can-undo;
            clicked => { draft-field.undo(); }
        }
    }
}

export component TextDropDemo inherits Window {
    title <- "Text drop";
    width <- 440px;
    height <- 400px;
    private property <string> draft: "A🧪B";
    private property <string> notes: "";
    private property <int> edits: 0;

    ScrollView {
        width <- 100%;
        height <- 100%;
        VerticalLayout {
            padding <- 20px;
            spacing <- 8px;
            alignment <- start;
            Label { text <- "Drag selected text from another app"; }
            draft := LineEdit {
                accessible-name <- "Drop title";
                text <-> root.draft;
                edited => { root.edits += 1; }
            }
            notes := TextArea {
                height <- 78px;
                accessible-name <- "Drop notes";
                text <-> root.notes;
                edited(value) => { root.edits += 1; }
            }
            read-only := LineEdit {
                accessible-name <- "Read-only drop target";
                text <- "Locked";
                read-only <- true;
            }
            disabled := LineEdit {
                accessible-name <- "Disabled drop target";
                text <- "Disabled";
                enabled <- false;
            }
            edit-count := Label { text <- "Drop edits " + root.edits; }
            HorizontalLayout {
                spacing <- 8px;
                change-title := Button {
                    text <- "Change title";
                    focus-on-click <- false;
                    clicked => { root.draft = "Updated"; }
                }
                undo-title := Button {
                    text <- "Undo title";
                    focus-on-click <- false;
                    enabled <- draft.can-undo;
                    clicked => { draft.undo(); }
                }
            }
        }
    }
}

export component PointerStyleDemo inherits Window {
    title <- "Inspection workspace";
    width <- 390px;
    height <- 460px;
    background <- #f1f5fa;
    private property <string> inspection-name: "Pump inspection";
    private property <string> last-input: "";

    VerticalLayout {
        padding <- 24px;
        spacing <- 12px;
        alignment <- start;
        Label {
            text <- "Inspection workspace";
            color <- #142c44;
            font-size <- 24px;
            font-weight <- 700;
        }
        name-field := LineEdit {
            accessible-name <- "Inspection name";
            text <-> root.inspection-name;
        }
        selection := Label {
            text <- name-field.selected-text == "" ? "No text selected" : "Selected " + name-field.selected-text;
            color <- #335671;
        }
        columns := SplitView {
            height <- 180px;
            handle-size <- 8px;
            handle-hit-size <- 24px;
            SplitHandle {
                background <- #6482a6;
                border-radius <- 4px;
            }
            Rectangle {
                min-width <- 90px;
                preferred-width <- 138px;
                background <- #dcecf4;
                border-radius <- 8px;
                canvas := HoverHandler {
                    width <- 100%;
                    height <- 100%;
                    cursor-shape <- crosshair;
                    Label {
                        width <- 100%;
                        height <- 100%;
                        text <- canvas.hovered ? "Canvas hovered" : "Align sensor";
                        horizontal-alignment <- center;
                        vertical-alignment <- center;
                        color <- #153c55;
                    }
                }
            }
            rows := SplitView {
                orientation <- vertical;
                min-width <- 100px;
                handle-size <- 8px;
                handle-hit-size <- 24px;
                SplitHandle {
                    background <- #6482a6;
                    border-radius <- 4px;
                }
                Rectangle {
                    min-height <- 50px;
                    preferred-height <- 80px;
                    background <- #e3f0e7;
                    border-radius <- 8px;
                    Label { x <- 12px; y <- 12px; text <- "Sensors"; color <- #194b3c; }
                }
                Rectangle {
                    min-height <- 50px;
                    background <- #f4eadc;
                    border-radius <- 8px;
                    Label { x <- 12px; y <- 12px; text <- "Readings"; color <- #584329; }
                }
            }
        }
        clear-name := Button {
            text <- "Clear inspection name";
            clicked => { root.inspection-name = ""; }
        }
        input-probe := TouchArea {
            height <- 36px;
            accessible-name <- "Test input source";
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.last-input = event.is-touch ? "Touch" : "Mouse";
                }
            }
            Rectangle {
                width <- 100%; height <- 100%;
                background <- #dcecf4;
                border-radius <- 8px;
                Label {
                    width <- 100%; height <- 100%;
                    text <- "Click or tap here";
                    horizontal-alignment <- center;
                    vertical-alignment <- center;
                    color <- #153c55;
                }
            }
        }
        input-source := Label {
            text <- root.last-input == "" ? "Waiting for input" : "Input " + root.last-input;
            color <- #335671;
        }
    }
}

