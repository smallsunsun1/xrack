export component NativeSelectionDemo inherits Window {
    title <- "Keyboard selection";
    width <- 390px;
    height <- 480px;
    private property <string> line-value: "A🧪B";
    private property <string> notes-value: "First\nA🧪B";
    private property <int> line-edits: 0;
    private property <int> notes-edits: 0;

    VerticalLayout {
        padding <- 16px;
        spacing <- 8px;
        alignment <- start;
        focus-line := Button {
            text <- "Focus line";
            clicked => { line.focus(); }
        }
        line := LineEdit {
            accessible-name <- "Selection line";
            text <-> root.line-value;
            edited => { root.line-edits += 1; }
        }
        line-selection := Label {
            text <- "Line selection: " + line.selected-text + " [" +
                line.selection-start-offset + ", " + line.selection-end-offset + ")";
        }
        line-edit-count := Label { text <- "Line edits: " + root.line-edits; }
        line-copy-state := Label { text <- line.can-copy ? "Line copy available" : "Line copy blocked"; }
        focus-notes := Button {
            text <- "Focus notes";
            clicked => { notes.focus(); }
        }
        notes := TextEdit {
            accessible-name <- "Selection notes";
            height <- 62px;
            text <-> root.notes-value;
            edited(value) => { root.notes-edits += 1; }
        }
        notes-selection := Label {
            text <- "Notes selection: " + notes.selected-text + " [" +
                notes.selection-start-offset + ", " + notes.selection-end-offset + ")";
        }
        notes-edit-count := Label { text <- "Notes edits: " + root.notes-edits; }
        notes-copy-state := Label { text <- notes.can-copy ? "Notes copy available" : "Notes copy blocked"; }
        HorizontalLayout {
            spacing <- 8px;
            replace-line := TouchArea {
                height <- 36px;
                accessible-name <- "Replace line";
                clicked => { root.line-value = "Updated line"; }
                Rectangle {
                    width <- 100%;
                    height <- 100%;
                    background <- #dae6f3;
                    border-radius <- 6px;
                    Label { text <- "Replace line"; }
                }
            }
            replace-notes := TouchArea {
                height <- 36px;
                accessible-name <- "Replace notes";
                clicked => { root.notes-value = "Updated notes"; }
                Rectangle {
                    width <- 100%;
                    height <- 100%;
                    background <- #dae6f3;
