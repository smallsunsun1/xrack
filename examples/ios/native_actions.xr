component SwipeDocumentRow inherits SwipeDelegate {
    in property <string> document-name;
    in property <bool> can-pin;
    private property <SwipeSide> side: closed;
    callback action(string);

    width <- 100%;
    height <- 64px;
    accessible-name <- root.document-name;
    open-side <-> root.side;
    clicked => { root.action("Reviewed"); }

    SwipeContent {
        Rectangle {
            width <- 100%;
            height <- 100%;
            background <- #283a51;
            Label {
                x <- 14px;
                height <- 100%;
                text <- root.document-name;
                color <- #edf3ff;
                vertical-alignment <- center;
            }
        }
    }
    SwipeLeft {
        visible <- root.can-pin;
        width <- 108px;
        pin-document := Button {
            width <- 100%; height <- 100%;
            text <- "Pin";
            accessible-name <- "Pin document";
            clicked => { root.side = closed; root.action("Pinned"); }
        }
    }
    SwipeRight {
        width <- 108px;
        archive-document := Button {
            width <- 100%; height <- 100%;
            text <- "Archive";
            accessible-name <- "Archive document";
            clicked => { root.side = closed; root.action("Archived"); }
        }
    }
}

export component SwipeActionsDemo inherits Window {
    title <- "Document actions";
    width <- 390px;
    height <- 500px;
    private property <string> result: "Ready";

    VerticalLayout {
        padding <- 20px;
        spacing <- 12px;
        alignment <- start;
        documents := ListView {
            height <- 160px;
            row-height <- 64px;
            accessible-name <- "Documents";
            for name in ["Review document", "Next document"]: SwipeDocumentRow {
                document-name <- name;
                can-pin <- name == "Review document";
                action(result) => { root.result = result; }
            }
        }
        swipe-result := Label { text <- root.result; }
    }
}

