struct Sample {
    instrument: string,
    location: string,
}

export component KeyboardOptionsDemo inherits Dialog {
    title <- "Keyboard assistance";
    in-out property <bool> shown: true;
    open <-> root.shown;
    width <- 350px; height <- 320px;
    private property <bool> identifier-mode: false;
    callback focus-title();
    focus-title => { draft-title.focus(); }

    form-viewport := ScrollView {
        vertical-stretch <- 1;
        horizontal-scroll-bar-policy <- always-off;
        dismiss-keyboard-on-drag <- true;
        accessible-name <- "Keyboard setup form";
        VerticalLayout {
            spacing <- 8px;
            draft-title := LineEdit {
                height <- 44px;
                accessible-name <- "Draft title";
                text: "Survey";
                return-key <- next;
                keyboard-capitalization <- root.identifier-mode ? KeyboardCapitalization.characters : KeyboardCapitalization.words;
                auto-correct <- !root.identifier-mode;
                spell-check <- !root.identifier-mode;
            }
            FlowLayout {
                spacing <- 8px;
                toggle-keyboard := Button {
                    height <- 44px;
                    text <- root.identifier-mode ? "Use prose keyboard" : "Use identifier keyboard";
                    focus-on-click <- false;
                    clicked => { root.identifier-mode = !root.identifier-mode; }
                }
                edit-code := Button {
                    height <- 44px;
                    text <- "Edit access code";
                    clicked => { draft-secret.focus(); }
                }
            }
            review-note := TextArea {
                height <- 66px;
                accessible-name <- "Review note";
                keyboard-navigation <- true;
                minimum-length <- 2;
                keyboard-capitalization <- none;
                auto-correct <- false;
                spell-check <- true;
            }
            draft-secret := LineEdit {
                height <- 44px;
                accessible-name <- "Access code";
                input-type <- password;
                return-key <- done;
                keyboard-navigation <- false;
                keyboard-capitalization <- characters;
                auto-correct <- true;
                spell-check <- true;
            }
        }
    }
    save-drafts := DialogButton { text <- "Save drafts"; role <- accept; height <- 44px; }
}

export component KeyboardLayoutDemo inherits Window {
    title <- "Keyboard layout";
    width <- 390px;
    height <- 480px;
    Label { x <- 20px; y <- 20px; text <- "Keyboard dialog closed"; }
    options := KeyboardOptionsDemo { height <- 100%; }
}

component NavigationInstrument inherits Button {
    in property <string> caption;
    callback recorded();
    text <- "Record " + root.caption;
    clicked => { root.recorded(); }
}

export component LongNoteDemo inherits Dialog {
    title <- "Inspection narrative";
    in-out property <bool> shown: true;
    open <-> root.shown;
    width <- 350px;
    height <- 310px;
    private property <string> draft: "";

    callback focus-note();
    focus-note => { long-note.focus(); }

    VerticalLayout {
        width <- 100%;
        height <- 100%;
        spacing <- 4px;
        Label {
            height <- 24px;
            text <- root.draft == "" ? "Ready to write" :
                note-viewport.content-y < -24px ? "Showing later lines" : "Showing first lines";
        }
        note-viewport := ScrollView {
            width <- 100%;
            vertical-stretch <- 1;
            content-height <- 520px;
            horizontal-scroll-bar-policy <- always-off;
            long-note := TextArea {
                accessible-name <- "Inspection narrative text";
                text <-> root.draft;
                width <- 100%;
                height <- 520px;
                font-size <- 18px;
            }
        }
    }
}

export component EditMenuEscapeDemo inherits Window {
    title <- "Edit menu demo";
    width <- 390px;
    height <- 480px;
    private property <bool> draft-open: true;
    private property <bool> shift-pending: false;
    private property <bool> draft-shifted: false;
    shift := Timer {
        interval <- 4200;
        running <- root.shift-pending;
        triggered => { root.draft-shifted = !root.draft-shifted; root.shift-pending = false; }
    }
    Label { x <- 20px; y <- 20px; text <- "Draft closed"; }
    draft := Dialog {
        title <- "Review draft";
        width <- 314px;
        height <- 260px;
        open <-> root.draft-open;
        VerticalLayout {
            padding <- 8px;
            padding-left <- root.draft-shifted ? 60px : 8px;
            spacing <- 8px;
            alignment <- start;
            entry := LineEdit {
                accessible-name <- "Draft text";
                text <- "Survey";
                height <- 44px;
                read-only <- true;
            }
            Label { text <- "Selected " + entry.selected-text; }
            HorizontalLayout {
                spacing <- 6px;
                select-draft := Button {
                    text <- "Select draft";
                    focus-on-click <- false;
                    clicked => { entry.focus(); entry.select-all(); }
                }
                move-draft := Button {
                    text <- "Move draft";
                    focus-on-click <- false;
                    clicked => { root.shift-pending = true; }
                }
            }
        }
        DialogButton { text <- "Close draft"; role <- reject; }
    }
}

export component SelectionScrollDemo inherits Window {
    title <- "Select inspection notes";
    width <- 390px;
    height <- 480px;

    VerticalLayout {
        padding <- 20px;
        spacing <- 12px;
        alignment <- start;
        Label { text <- "Select inspection notes"; }
        notes := TextArea {
            accessible-name <- "Scrollable inspection notes";
            height <- 112px;
            font-size <- 16px;
            text <- "Pump overview\nCheck inlet pressure\nRecord outlet pressure\nInspect safety guard\nRead motor temperature\nReview current draw\nCheck inlet filter\nCheck outlet valve\nReview cooling loop\nInspect fan assembly\nCheck shaft alignment\nReview vibration trend\nCheck mounting bolts\nRecord cable condition\nCheck sensor readings\nInspect control wiring\nReview last service\nFinal sign-off";
        }
        Label { text <- "Selected characters " + Strings.character-count(notes.selected-text); }
        Label { text <- Strings.contains(notes.selected-text, "Final sign-off") ? "End of notes selected" : "More notes below"; }
    }
}

export component ChoicePopupDemo inherits Dialog {
    title <- "Inspection choices";
    width <- 356px;
    height <- 340px;
    in-out property <bool> shown: true;
    open <-> root.shown;
    private property <string> query: "";
    out property <string> submitted: "";

    VerticalLayout {
        padding <- 12px;
        spacing <- 10px;
        alignment <- start;
        category := ComboBox {
            accessible-name <- "Inspection category";
            model <- ["Boilers", "Cabinets", "Drains", "Filters", "Gauges", "Hoses",
                    "Intakes", "Meters", "Pipes", "Pumps", "Sensors", "Tanks", "Valves"];
            current-index: 0;
            min-height <- 44px;
        }
        lookup := SearchField {
            accessible-name <- "Search inspections";
            text <-> root.query;
            suggestions <- ["Pump 01", "Pump 02", "Pump 03", "Pump 04", "Pump 05", "Pump 06",
                          "Pump 07", "Pump 08", "Pump 09", "Pump 10", "Pump 11", "Pump 12"];
            suggestions-for <- root.query;
            accepted(value) => { root.submitted = value; }
            min-height <- 44px;
        }
        submitted-choice := Label {
            text <- root.submitted == "" ? "Choose a suggestion" : "Submitted: " + root.submitted;
        }
    }
}

export component AdjustableValuesDemo inherits Dialog {
    title <- "Instrument settings";
    width <- 348px;
    height <- 360px;
    in-out property <bool> shown: true;
    open <-> root.shown;

    VerticalLayout {
        spacing <- 6px;
        alignment <- start;
        gain := Slider {
            accessible-name <- "Sensor gain";
            minimum <- 0; maximum <- 2; step <- 1; value: 0;
            height <- 36px;
        }
        band := RangeSlider {
            accessible-name <- "Recording band";
            minimum <- 0; maximum <- 10; step <- 2;
            lower-value: 4; upper-value: 6;
            height <- 36px;
        }
        offset := DoubleSpinBox {
            accessible-name <- "Calibrated offset";
            minimum <- 0; maximum <- 1; step-size <- 0.25; value: 0.75;
            decimals <- 2; decimal-separator <- ",";
            height <- 38px;
        }
        fixed-count := SpinBox {
            accessible-name <- "Fixed sample count";
            minimum <- 7; maximum <- 7; value <- 7;
            read-only <- true;
            height <- 38px;
        }
        clock := TimePicker {
            time: Time { hour: 14, minute: 59 };
            height <- 86px;
        }
        transfer := ProgressIndicator {
            accessible-name <- "Sample transfer";
            minimum <- 100;
            maximum <- 900;
            progress <- gain.value == 2 ? 920 : 380;
            indeterminate <- gain.value == 1;
            width <- 100%;
            height <- 12px;
        }
    }
}

export component NativeNavigationDemo inherits VerticalLayout {
    width <- 100%; height <- 100%;
    padding <- 20px; spacing <- 8px; alignment <- start;
    private property <bool> tool-active: true;
    private property <string> tool: "pressure";
    private property <string> reading: "No samples";
    private property <bool> back-locked: false;
    private property <int> blocked: 0;
    private property <bool> dialog-open: false;
    callback closed();

    tool-state := Label { text <- "Tool " + instrument.status; }
    latest-reading := Label { text <- root.reading; }
    HorizontalLayout {
        spacing <- 8px;
        load-flow := Button {
            text <- "Load flow tool";
            clicked => { root.tool = "flow"; root.tool-active = true; }
        }
        unload-tool := Button { text <- "Unload tool"; clicked => { root.tool-active = false; } }
    }
    instrument := Loader {
        height <- 44px;
        active <- root.tool-active;
        asynchronous <- true;
        source <- root.tool;
        loaded => { self.focus(); }
        pressure := NavigationInstrument { caption <- "pressure"; recorded => { root.reading = "Pressure recorded"; } }
        flow := NavigationInstrument { caption <- "flow"; recorded => { root.reading = "Flow recorded"; } }
    }
    page-state := Label { text <- "Page " + navigation.current-page; }
    back-status := Label { text <- "Blocked returns " + root.blocked; }
    navigation := StackView {
        height <- 154px;
        summary := StackPage {
            open-detail := Button { width <- 100%; height <- 44px; text <- "Open inspection detail"; clicked => { navigation.push("detail"); } }
        }
        detail := StackPage {
            leave-requested(destination, removing) => {
                if root.back-locked { root.blocked += 1; }
                !root.back-locked
            }
            VerticalLayout {
                alignment <- start;
                spacing <- 8px;
                lock-back := Button {
                    text <- root.back-locked ? "Unlock return" : "Lock return";
                    clicked => { root.back-locked = !root.back-locked; }
                }
                open-dialog := Button {
                    text <- "Open review overlay";
                    clicked => { root.dialog-open = true; }
                }
            }
        }
    }
    close-demo := Button { text <- "Close navigation demo"; clicked => { root.closed(); } }
    review-overlay := Dialog {
        open <-> root.dialog-open;
        width <- 300px; height <- 150px;
        title <- "Review overlay";
        close-on-escape <- !root.back-locked;
        dismiss-overlay := Button { text <- "Dismiss review overlay"; clicked => { root.dialog-open = false; } }
    }
}

export component HardwareCommandsDemo inherits Window {
    title <- "Hardware commands";
    width <- 390px;
    height <- 430px;
    private property <int> refreshes;
    private property <int> releases;
    private property <int> snapshots;
    private property <int> runbooks;
    private property <string> last-key: "Ready";

    Shortcut { sequence <- "F2"; activated => { root.refreshes += 1; } }
    Shortcut { sequence <- "Primary+F12"; activated => { root.snapshots += 1; } }

    command-scope := FocusScope {
        width <- 100%;
        height <- 100%;
        capture-key-pressed(event) => {
            root.last-key = event.key;
            reject
        }
        capture-key-released(event) => {
            if event.key == "F2" && event.text == "" { root.releases += 1; }
            reject
        }
        VerticalLayout {
            padding <- 20px;
            spacing <- 10px;
            alignment <- start;
            field := LineEdit { accessible-name <- "Command draft"; text <- "Draft"; }
            ContextMenuArea {
                height <- 44px;
                commands := Button { width <- 100%; height <- 100%; text <- "Inspection commands"; }
                Menu {
                    runbook := MenuItem { text <- "Open runbook"; activated => { root.runbooks += 1; } }
                }
            }
            pressed := Label { text <- "Last key " + root.last-key; }
            refresh-count := Label { text <- "Refreshes " + root.refreshes; }
            release-count := Label { text <- "F2 releases " + root.releases; }
            snapshot-count := Label { text <- "Snapshots " + root.snapshots; }
            runbook-count := Label { text <- "Runbooks " + root.runbooks; }
        }
    }
}

export component TouchTooltipDemo inherits Window {
    title <- "Inspection controls";
    width <- 390px;
