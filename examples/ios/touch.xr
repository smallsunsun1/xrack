export struct RoundTask {
    id: int,
    title: string,
    location: string,
    category: string,
}

export struct InspectionPhoto {
    preview: image,
    has-preview: bool,
    details: string,
}

export component PointerInspectionDemo inherits Window {
    title: "Pointer inspection";
    width: 390px;
    height: 520px;
    private property <int> pointer-moves: 0;
    private property <int> inspections: 0;
    private property <int> sensor-log-opens: 0;
    private property <int> wheel-events: 0;
    private property <bool> large-log-text: false;
    private property <bool> log-entered: false;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: start;
        sensor := HoverHandler {
            height: 52px;
            moved => { root.pointer-moves += 1; }
            ContextMenuArea {
                width: 100%;
                height: 100%;
                inspect := Button {
                    width: 100%;
                    height: 100%;
                    text: "Inspect sensor";
                    background: sensor.hovered ? #2d6878 : #33516a;
                    clicked => { root.inspections += 1; }
                }
                Menu {
                    open-sensor-log := MenuItem {
                        text: "Open sensor log";
                        activated => { root.sensor-log-opens += 1; }
                    }
                }
            }
        }
        pointer-state := Label { text: sensor.hovered ? "Sensor hovered" : "Sensor idle"; }
        moved := Label { text: "Pointer moves " + root.pointer-moves; }
        inspected := Label { text: "Inspections " + root.inspections; }
        sensor-log-count := Label { text: "Sensor log opens " + root.sensor-log-opens; }
        log := ScrollView {
            accessible-name: "Inspection log";
            width: 100%;
            height: 180px;
            content-height: 480px;
            log-hover := HoverHandler {
                width: 100%;
                height: 480px;
                entered => { root.log-entered = true; }
                log-wheel := WheelHandler {
                    width: 100%;
                    height: 480px;
                    wheel(event) => {
                        root.wheel-events += 1;
                        if event.modifiers.primary {
                            root.large-log-text = event.delta-y > 0px;
                        }
                        event.modifiers.primary ? accept : reject
                    }
                    Rectangle {
                        width: 100%;
                        height: 480px;
                        background: log-hover.hovered ? #dce8e0 : #e8edea;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 14px;
                            alignment: start;
                            for record[index] in ["Pump pressure", "Valve position", "Safety guard",
                                "Filter status", "Motor temperature", "Cooling fan", "Flow rate",
                                "Alarm history", "Meter calibration", "Inspection complete"] : Label {
                                height: 30px;
                                text: record;
                                font-size: root.large-log-text ? 20px : 14px;
                                color: #203447;
                            }
                        }
                    }
                }
            }
        }
        wheel-count := Label { text: "Wheel events " + root.wheel-events; }
        log-hover-state := Label {
            text: log-hover.hovered ? "Pointer over log" :
                root.log-entered ? "Pointer left log" : "Pointer outside log";
        }
        log-position := Label { text: log.content-y == 0px ? "Log at top" : "Log scrolled"; }
        log-text-size := Label { text: root.large-log-text ? "Log text enlarged" : "Log text standard"; }
    }
}

export component FolderDialogDemo inherits Window {
    title: "Directory import";
    width: 390px;
    height: 430px;
    in property <string> starting-directory;
    in-out property <string> status: "Choose a folder in Files";
    private property <bool> multiple;
    callback inspect-folders([string]);

    folder-picker := FileDialog {
        mode: root.multiple ? FileDialogMode.select-folders : FileDialogMode.select-folder;
        directory: root.starting-directory;
        accepted(paths) => { root.status = "Imported " + Model.count(paths); root.inspect-folders(paths); }
        canceled => { root.status = "Folder selection canceled"; }
        failed(reason) => { root.status = reason; }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: start;
        one := Button {
            text: "Import one folder";
            height: 48px;
            enabled: !folder-picker.pending;
            clicked => { root.multiple = false; folder-picker.open(); }
        }
        many := Button {
            text: "Import folders";
            height: 48px;
            enabled: !folder-picker.pending;
            clicked => { root.multiple = true; folder-picker.open(); }
        }
        result := Label { text: root.status; accessible-live: polite; }
    }
}

export component NativeColorDemo inherits Window {
    title: "Marker color";
    width: 390px;
    height: 360px;
    in-out property <color> marker-color: #2D638880;
    in-out property <string> color-readout: "#2D638880";
    in-out property <color> preview-color: #2D638880;
    in-out property <string> preview-readout: "#2D638880";
    in-out property <string> picker-error: "";
    in-out property <bool> show-alpha: true;
    in-out property <bool> pending: false;
    callback edit-color();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: start;
        swatch := Rectangle {
            height: 96px;
            background: root.pending ? root.preview-color : root.marker-color;
            border-radius: 12px;
        }
        readout := Label { text: root.pending ? "Preview " + root.preview-readout : root.color-readout; }
        alpha := CheckBox {
            text: "Edit opacity";
            checked <=> root.show-alpha;
            enabled: !root.pending;
        }
        edit := Button {
            text: "Edit marker color";
            height: 44px;
            enabled: !root.pending;
            clicked => { root.edit-color(); }
        }
        Label {
            text: root.picker-error;
            accessible-live: polite;
            visible: root.picker-error != "";
        }
    }
}

component PageScopedPanel inherits Rectangle {
    in property <bool> opens-files;
    callback reported-result();
    callback show-files();
    show-files => { picker.open(); }
    callback show-message();
    show-message => { message.open(); }

    picker := FileDialog {
        mode: open-file;
        accepted(paths) => { root.reported-result(); }
        canceled => { root.reported-result(); }
        failed(reason) => { root.reported-result(); }
    }

    message := MessageDialog {
        title: "Inspection page notice";
        text: "This dialog belongs to the active page.";
        finished(button) => { root.reported-result(); }
        failed(reason) => { root.reported-result(); }
    }

    show-inspection-dialog := Button {
        text: "Show inspection dialog";
        width: 100%;
        height: 100%;
        clicked => {
            if root.opens-files {
                root.show-files();
            } else {
                root.show-message();
            }
        }
    }
}

export component NativePanelQueueDemo inherits Window {
    title: "System panels";
    width: 390px;
    height: 360px;
    in-out property <int> panels-left: 0;
    in-out property <string> files-status: "";
    in-out property <string> photos-status: "";
    in-out property <string> share-status: "";
    private property <string> notice-status: "";
    private property <int> timeouts-left: 0;
    private property <bool> page-active: false;
    private property <bool> page-opens-files: false;
    private property <string> page-status: "";
    private property <bool> panel-idle: root.panels-left == 0 && root.timeouts-left == 0 &&
        !root.page-active && !notice.pending;
    callback queue-panels(timed: bool);
    callback abort-panel(files: bool);
    callback show-timeout-notice();
    show-timeout-notice => { notice.open(); }
    callback open-inspection-page(files: bool);
    open-inspection-page(files) => {
        root.page-opens-files = files;
        root.notice-status = "";
        root.page-status = "Inspection page open";
        root.page-active = true;
        remove-page.restart();
    }

    notice := MessageDialog {
        title: "System panel queue";
        text: "Close each panel to continue.";
        accepted => { root.notice-status = "Notice completed"; }
        failed(message) => { root.notice-status = message; }
    }

    queue-delay := Timer {
        interval: 250;
        repeat: false;
        triggered => { root.queue-panels(false); }
    }

    panel-timeout := Timer {
        interval: 6500;
        repeat: true;
        running: root.timeouts-left > 0;
        triggered => {
            root.abort-panel(root.timeouts-left == 2);
            root.timeouts-left -= 1;
            if root.timeouts-left == 0 {
                root.show-timeout-notice();
            }
        }
    }

    remove-page := Timer {
        interval: 7500;
        repeat: false;
        triggered => {
            root.page-active = false;
            root.page-status = "Inspection page closed";
            notice.open();
        }
    }

    VerticalLayout {
        alignment: start;
        padding: 20px;
        spacing: 12px;
        start := Button {
            text: "Open panel queue";
            height: 44px;
            enabled: root.panel-idle;
            clicked => {
                root.panels-left = 3;
                root.notice-status = "Waiting for notice";
                root.files-status = "Files queued";
                root.photos-status = "Photos queued";
                root.share-status = "Share queued";
                notice.open();
                queue-delay.start();
            }
        }
        timed := Button {
            text: "Open timed panels";
            height: 44px;
            enabled: root.panel-idle;
            clicked => {
                root.panels-left = 2;
                root.timeouts-left = 2;
                root.notice-status = "";
                root.files-status = "Files queued";
                root.photos-status = "";
                root.share-status = "Share queued";
                root.queue-panels(true);
            }
        }
        HorizontalLayout {
            spacing: 8px;
            open-page-notice := Button {
                text: "Open page notice";
                height: 44px;
                enabled: root.panel-idle;
                clicked => { root.open-inspection-page(false); }
            }
            open-page-files := Button {
                text: "Open page Files";
                height: 44px;
                enabled: root.panel-idle;
                clicked => { root.open-inspection-page(true); }
            }
        }
        if root.page-active : PageScopedPanel {
            height: 44px;
            opens-files: root.page-opens-files;
            reported-result => { root.page-status = "Inspection page received a reply"; }
        }
        page-status := Label { text: root.page-status; }
        Label { text: root.notice-status; }
        Label { text: root.files-status; }
        Label { text: root.photos-status; }
        Label { text: root.share-status; }
    }
}

export component PhotoPickerDemo inherits Window {
    title: "Inspection photos";
    width: 390px;
    height: 540px;
    background: #f3f6f1;
    in-out property <bool> pending: false;
    in-out property <[InspectionPhoto]> photos: [];
    in-out property <int> current-photo: 0;
    out property <int> photo-count: Model.count(root.photos);
    in-out property <string> photo-status: "No photos selected";
    callback choose-photos();
    callback save-original(int);
    callback save-all();
    callback share-originals();

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;
        Text {
            text: "Inspection photos";
            font-size: 27px;
            font-weight: 700;
            accessible-heading-level: 1;
        }
        HorizontalLayout {
            spacing: 8px;
            choose := Button {
                text: "Choose photos";
                height: 44px;
                horizontal-stretch: 1;
                enabled: !root.pending;
                clicked => { root.choose-photos(); }
            }
            share-originals := Button {
                text: "Share originals";
                height: 44px;
                visible: root.photo-count > 0;
                enabled: !root.pending;
                clicked => { root.share-originals(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;
            import-status := Label {
                horizontal-stretch: 1;
                text: root.photo-status;
                accessible-live: polite;
            }
            photo-position := Label {
                text: "Photo " + (root.current-photo + 1) + " of " + root.photo-count;
                visible: root.photo-count > 0;
            }
        }
        gallery := SwipeView {
            width: 100%;
            min-height: 64px;
            vertical-stretch: 1;
            visible: root.photo-count > 0;
            accessible-name: "Imported photo gallery";
            current-index <=> root.current-photo;
            transition-duration: 160;
            for photo[index] in root.photos : SwipePage {
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 6px;
                    alignment: start;
                    Image {
                        width: 100%;
                        min-height: 0px;
                        vertical-stretch: 1;
                        source: photo.preview;
                        image-fit: contain;
                        visible: photo.has-preview;
                        accessible-name: "Photo preview " + (index + 1);
                    }
                    Label { text: photo.details; }
                }
            }
        }
        HorizontalLayout {
            visible: root.photo-count > 0;
            spacing: 8px;
            cross-axis-alignment: center;
            photo-pages := PageIndicator {
                width: 86px;
                height: 44px;
                visible: root.photo-count > 1;
                accessible-name: "Imported photos";
                count: root.photo-count;
                current-index <=> root.current-photo;
                interactive: !root.pending;
            }
            save := Button {
                height: 44px;
                text: "Save original";
                enabled: !root.pending && root.current-photo >= 0 && root.current-photo < root.photo-count;
                clicked => { root.save-original(root.current-photo); }
            }
            save-all := Button {
                height: 44px;
                text: "Save all";
                visible: root.photo-count > 1;
                enabled: !root.pending;
                clicked => { root.save-all(); }
            }
        }
    }
}

struct QueueCheck {
    id: int,
    caption: string,
}

component ReorderQueueRow inherits DropArea {
    in property <string> caption;
    in property <string> payload;
    in property <bool> selected;
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    private property <bool> marked: false;
    private property <bool> dragging: false;
    private property <bool> previewed: false;
    callback choose();
    callback reorder(string);
    callback move-by(int);
    callback preview-delta(int);
    callback clear-preview();
    clear-preview() => {
        if root.previewed {
            root.previewed = false;
            root.preview-delta(-1);
        }
    }

    keys: ["inspection-queue"];
    drop-action: move;
    width: 100%;
    height: 56px;
    entered(data, action) => {
        if !root.previewed {
            root.previewed = true;
            root.preview-delta(1);
        }
    }
    exited() => { root.clear-preview(); }
    dropped(data, action) => {
        root.clear-preview();
        root.reorder(data);
    }

    HorizontalLayout {
        padding: 4px;
        spacing: 6px;
        cross-axis-alignment: center;
        drag-row := DragArea {
            horizontal-stretch: 1;
            height: 48px;
            data: root.payload;
            drag-key: "inspection-queue";
            allow-move: true;
            touch-drag-delay: 420;
            opacity: root.dragging ? 0.6 : 1.0;
            drag-started => { root.dragging = true; }
            drag-finished(action) => { root.dragging = false; }
            mark-row := Button {
                width: 100%;
                height: 100%;
                text: root.caption + (root.marked ? " · marked" : "");
                background: root.previewed ? #f7e8c4 : root.selected ? #d5eddf : #ffffff;
                clicked => {
                    root.marked = !root.marked;
                    root.choose();
                }
            }
        }
        up := Button {
            width: 44px;
            height: 44px;
            text: "↑";
            accessible-name: "Move " + root.caption + " up";
            enabled: root.can-move-up;
            clicked => { root.move-by(-1); }
        }
        down := Button {
            width: 44px;
            height: 44px;
            text: "↓";
            accessible-name: "Move " + root.caption + " down";
            enabled: root.can-move-down;
            clicked => { root.move-by(1); }
        }
    }
}

export component ListReorderDemo inherits Window {
    title: "Reorder inspection queue";
    width: 390px;
    height: 540px;
    background: #f3f6f1;

    private property <[QueueCheck]> checks: [
        QueueCheck { id: 11, caption: "Pump pressure" },
        QueueCheck { id: 12, caption: "Door interlock" },
        QueueCheck { id: 13, caption: "Water temperature" },
        QueueCheck { id: 14, caption: "Exhaust airflow" },
        QueueCheck { id: 15, caption: "Filter seals" },
        QueueCheck { id: 16, caption: "Emergency lighting" },
        QueueCheck { id: 17, caption: "Cooling fan" },
    ];
    in-out property <int> selected-row: 0;
    out property <int> moves: 0;
    out property <int> active-previews: 0;

    callback move-check(from: int, to: int);
    move-check(from, to) => {
        if from != to && from >= 0 && to >= 0 &&
           from < Model.count(root.checks) && to < Model.count(root.checks) {
            if root.selected-row == from {
                root.selected-row = to;
            } else if from < root.selected-row && root.selected-row <= to {
                root.selected-row -= 1;
            } else if to <= root.selected-row && root.selected-row < from {
                root.selected-row += 1;
            }
            Model.move(root.checks, from, to);
            root.moves += 1;
        }
    }
    callback drop-check(payload: string, destination: int);
    drop-check(payload, destination) => {
        for check[index] in root.checks {
            if "" + check.id == payload {
                root.move-check(index, destination);
            }
        }
    }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Text {
            text: "Inspection order";
            font-size: 27px;
            font-weight: 700;
            accessible-heading-level: 1;
        }
        Text { text: "Hold a row to move it. Swipe to browse."; }
        check-queue := ListView {
            height: 236px;
            row-height: 56px;
            accessible-name: "Inspection queue";
            drag-auto-scroll: true;
            current-index <=> root.selected-row;
            for check[index] in root.checks : ReorderQueueRow {
                caption: check.caption;
                payload: "" + check.id;
                selected: index == root.selected-row;
                can-move-up: index > 0;
                can-move-down: index + 1 < Model.count(root.checks);
                choose => { root.selected-row = index; }
                reorder(data) => { root.drop-check(data, index); }
                move-by(step) => { root.move-check(index, index + step); }
                preview-delta(change) => { root.active-previews += change; }
            }
        }
        order-status := Label {
            text: "Moves: " + root.moves + " · Selected row: " + (root.selected-row + 1);
        }
        Label {
            text: "Drop to place the inspection";
            visible: root.active-previews > 0;
        }
    }
}

component ChecklistMark inherits Rectangle {
    width: 41px;
    height: 41px;
    border-radius: 14px;
    background: #ddefe5;

    Path {
        x: 9px;
        y: 9px;
        width: 23px;
        height: 23px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #00000000;
        stroke: #27654f;
        stroke-width: 1.65px;
        commands: "M7 6 H17 Q19 6 19 8 V19 Q19 21 17 21 H7 Q5 21 5 19 V8 Q5 6 7 6 Z M9 6 V3 H15 V6 M8.5 13 L11 15.5 L16 10.5";
    }
}

component TaskRow inherits ContextMenuArea {
    in property <string> caption;
    in property <string> context;
    in property <string> tag;
    in property <bool> done;
    private property <SwipeSide> revealed: once closed;

    callback request-toggle;
    width: 100%;
    height: 66px;

    task-toggle := SwipeDelegate {
        width: 100%;
        height: 100%;
        clicked => { root.request-toggle(); }
        open-side <=> root.revealed;
        accessible-name: root.caption;
        accessible-description: (root.done ? "Completed. " : "Open. ") + root.context +
            (root.done ? ". Reopen task." : ". Mark task complete.");
        SwipeContent {
            task-button := Button {
                width: 100%;
                height: 100%;
                text: root.caption;
                clicked => { root.request-toggle(); }
                background: self.pressed ? #e4f0e8 : #ffffff;
                border-color: #dce7df;
                border-width: 1px;
                border-radius: 15px;
                ButtonContent {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 10px;
                            background: root.done ? #e0f1e7 : #f6f9f6;
                            border-width: 1px;
                            border-color: root.done ? #cce6d6 : #cbdcd0;

                            if root.done : Path {
                                x: 6px;
                                y: 6px;
                                width: 18px;
                                height: 18px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                fill: #00000000;
                                stroke: #217257;
                                stroke-width: 1.95px;
                                commands: "M5 12 L10 17 L19 7";
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Label { text: root.caption; font-size: 15px; font-weight: 650; color: #18362b; overflow: elide; }
                            Label { text: root.context; font-size: 12px; color: #50685c; overflow: elide; }
                        }
                        Rectangle {
                            width: 69px;
                            height: 23px;
                            border-radius: 8px;
                            background: root.tag == "Safety" ? #fff0d8 : root.tag == "Quality" ? #e8f0fb : #e9f2eb;
                            Label {
                                width: 100%;
                                height: 100%;
                                text: root.tag;
                                font-size: 11px;
                                font-weight: 650;
                                color: root.tag == "Safety" ? #835321 : root.tag == "Quality" ? #345b86 : #3c644e;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
        SwipeRight {
            width: 112px;
            task-action := Button {
                width: 112px;
                height: 100%;
                text: root.done ? "Reopen" : "Complete";
                accessible-name: (root.done ? "Reopen " : "Complete ") + root.caption;
                background: #24684f;
                color: #ffffff;
                border-radius: 12px;
                clicked => { root.revealed = SwipeSide.closed; root.request-toggle(); }
            }
        }
    }

    Menu {
        toggle-item := MenuItem {
            text: root.done ? "Reopen task" : "Mark complete";
            activated => { root.request-toggle(); }
        }
    }
}

export component TouchDemo inherits Window {
    title: "Pocket Tasks";
    width: 402px;
    height: 780px;
    color-scheme: light;
    accent-color: #25735a;
    default-font-size: 15px;
    background: #f3f6f1;

    in-out property <string> draft: "";
    in-out property <bool> show-completed: false;
    in-out property <bool> show-notes: false;
    in-out property <bool> show-readings: false;
    in-out property <string> notes: "";
    in-out property <int> sample-count: 0;
    in-out property <float> pressure: 0;
    in-out property <float> temperature-offset: 0;
    in-out property <Date> inspection-date: Date { year: 2024, month: 2, day: 28 };
    in-out property <Time> inspection-time: Time { hour: 12, minute: 30, second: 41 };
    in-out property <bool> date-open: false;
    in-out property <bool> time-open: false;
    out property <string> schedule-status: "";
    out property <string> form-result: "";
    private property <string> code-draft: "";
    private property <string> reading-draft: "";
    private property <bool> contact-open: false;
    private property <string> contact-status: "";
    private property <string> contact-email-draft: "";
    private property <string> contact-url-draft: "";
    private property <string> contact-tel-draft: "";
    in-out property <int> note-category: 0;
    in-out property <bool> notes-locked: false;
    out property <string> import-status: "";
    in property <bool> folder-import-available: false;
    in property <bool> saved-folder-available: false;
    in property <bool> transfer-pending: false;
    in property <string> transfer-status: "";
    private property <bool> note-operation-pending: root.transfer-pending ||
        note-picker.pending || replace-notes.pending;
    private property <bool> can-transfer: root.notes != "" && !root.note-operation-pending;
    private property <bool> can-import: !root.notes-locked && !root.note-operation-pending;
    in property <bool> wide: false;
    in property <bool> compact: false;
    out property <int> remaining: Model.count(root.pending-tasks);
    out property <int> resolved: Model.count(root.completed-tasks);
    private property <int> next-id: 100;
    private property <int> total: root.remaining + root.resolved;

    in-out property <[RoundTask]> pending-tasks: [
        RoundTask { id: 1, title: "Check pump pressure", location: "Utilities · North plant", category: "Equipment" },
        RoundTask { id: 2, title: "Verify door interlock", location: "Loading bay · Dock B", category: "Safety" },
        RoundTask { id: 3, title: "Log chilled water temperature", location: "Cooling loop · Station 02", category: "Quality" },
        RoundTask { id: 4, title: "Inspect fire cabinet", location: "Warehouse · West aisle", category: "Safety" },
        RoundTask { id: 5, title: "Confirm sensor calibration", location: "Production · Line 1", category: "Quality" },
        RoundTask { id: 6, title: "Clean ventilation grille", location: "Mechanical · Level 2", category: "Equipment" },
        RoundTask { id: 7, title: "Review spill kit supplies", location: "Stores · Receiving", category: "Safety" },
        RoundTask { id: 8, title: "Inspect return valve", location: "Utilities · South plant", category: "Equipment" },
        RoundTask { id: 9, title: "Review calibration logs", location: "Maintenance · Office", category: "Quality" },
    ];
    in-out property <[RoundTask]> completed-tasks: [
        RoundTask { id: 10, title: "Record meter reading", location: "Utilities · North plant", category: "Equipment" },
        RoundTask { id: 11, title: "Clear emergency walkway", location: "Warehouse · North aisle", category: "Safety" },
        RoundTask { id: 12, title: "Confirm sample labels", location: "Quality lab · Bench 3", category: "Quality" },
    ];

    callback add-task;
    add-task => {
        Model.insert(root.pending-tasks, Strings.trim(root.draft) != "" ? 0 : -1,
            RoundTask { id: root.next-id, title: Strings.trim(root.draft), location: "Field notes", category: "New" });
        root.next-id += 1;
        root.draft = "";
        root.show-completed = false;
    }

    callback read-notes(paths: [string]) -> bool;
    callback transfer-note(text: string, export-file: bool);
    callback import-folder;
    callback reload-folder;

    inspection-date-picker := DatePickerPopup {
        title: "Inspection date";
        open <=> root.date-open;
        date <=> root.inspection-date;
        minimum-date: Date { year: 2024, month: 2, day: 1 };
        maximum-date: Date { year: 2024, month: 4, day: 30 };
        disabled-weekdays: [6, 7];
        accept-text: "Save date";
        cancel-text: "Cancel";
        accepted(date) => { root.schedule-status = "Date saved"; }
        canceled => { root.schedule-status = "Date unchanged"; }
    }

    inspection-time-picker := TimePickerPopup {
        title: "Inspection time";
        open <=> root.time-open;
        time <=> root.inspection-time;
        minimum-time: Time { hour: 8 };
        maximum-time: Time { hour: 18 };
        use-24-hour-format: false;
        show-seconds: true;
        accept-text: "Save time";
        cancel-text: "Cancel";
        accepted(time) => { root.schedule-status = "Time saved"; }
        canceled => { root.schedule-status = "Time unchanged"; }
    }

    contact-dialog := Dialog {
        title: "Inspection contact";
        open <=> root.contact-open;
        width: 340px;
        height: 260px;
        padding: root.compact ? 6px : 16px;

        contact-viewport := ScrollView {
            width: 100%;
            height: 100%;
            horizontal-scroll-bar-policy: always-off;
            VerticalLayout {
                width: 100%;
                spacing: 6px;
                contact-email := LineEdit {
                    accessible-name: "Contact email";
                    placeholder-text: "Email address";
                    text <=> root.contact-email-draft;
                    input-type: email;
                    return-key: next;
                    minimum-length: 2;
                    height: 38px;
                    accepted => { root.contact-status = "Email: " + root.contact-email-draft; }
                }
                contact-tel := LineEdit {
                    accessible-name: "Contact telephone";
                    placeholder-text: "Telephone";
                    text <=> root.contact-tel-draft;
                    input-type: tel;
                    return-key: ReturnKey.next;
                    minimum-length: 3;
                    height: 38px;
                    accepted => { root.contact-status = "Telephone: " + root.contact-tel-draft; }
                }
                contact-url := TextInput {
                    accessible-name: "Contact website";
                    placeholder-text: "Website URL";
                    text <=> root.contact-url-draft;
                    input-type: InputType.url;
                    return-key: done;
                    height: 38px;
                    accepted => { root.contact-status = "Website: " + root.contact-url-draft; }
                }
                contact-result := Label {
                    text: root.contact-status;
                    visible: root.contact-status != "";
                    color: #225a46;
                }
                close-contact := Button {
                    text: "Close contact details";
                    height: 38px;
                    clicked => { root.contact-open = false; }
                }
            }
        }
    }

    note-picker := FileDialog {
        mode: FileDialogMode.open-files;
        name-filters: ["Text notes (*.txt *.md)"];
        accepted(paths) => { replace-notes.open(); }
        canceled => { root.import-status = "Import canceled"; }
        failed(message) => { root.import-status = message; }
    }

    replace-notes := MessageDialog {
        title: root.notes == "" ? "Import notes?" : "Replace current notes?";
        text: Model.count(note-picker.selected-files) == 1 ? "1 selected file" :
            Model.count(note-picker.selected-files) + " selected files";
        informative-text: root.notes == "" ? "" : "Choosing Yes replaces the text in the editor.";
        buttons: yes-no-cancel;
        finished(button) => {
            root.import-status = button == StandardButtonKind.cancel ? "Replacement canceled" :
                button != StandardButtonKind.yes ? "Current notes kept" :
                !root.read-notes(note-picker.selected-files) ? "Could not read the selected notes" :
                Model.count(note-picker.selected-files) == 1 ? "Note imported" :
                Model.count(note-picker.selected-files) + " notes imported";
        }
        failed(message) => { root.import-status = message; }
    }

    callback finish-task(index: int, task: RoundTask) -> bool;
    finish-task(index, task) => {
        Model.remove(root.pending-tasks, index);
        Model.insert(root.completed-tasks, 0, task);
        true
    }

    callback reopen-task(index: int, task: RoundTask) -> bool;
    reopen-task(index, task) => {
        Model.remove(root.completed-tasks, index);
        Model.insert(root.pending-tasks, 0, task);
        true
    }

    callback move-task(index: int, task: RoundTask) -> bool;
    move-task(index, task) => {
        root.show-completed ? root.reopen-task(index, task) : root.finish-task(index, task)
    }

    Pane {
        width: 100%;
        height: 100%;
        background: #f3f6f1;
        padding: root.compact ? 9px : 18px;
        VerticalLayout {
            spacing: root.compact ? 8px : 15px;
            HorizontalLayout {
                min-height: root.compact ? 41px : 50px;
                vertical-stretch: 0;
                spacing: 11px;
                cross-axis-alignment: center;
                ChecklistMark {}
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    alignment: center;
                    Label { text: "Pocket Tasks"; min-width: 0px; overflow: elide; font-size: 22px; font-weight: 750; color: #18362b; }
                    Label { text: "Field checklist"; min-width: 0px; overflow: elide; font-size: 12px; color: #526b5e; visible: !root.compact; }
                }
                readings-toggle := Button {
                    text: root.show-readings ? "Tasks" : "Readings";
                    accessible-name: root.show-readings ? "Back to checklist" : "Open readings";
                    min-height: 36px;
                    min-width: 86px;
                    font-size: 14px;
                    background: #e0eee5;
                    border-radius: 10px;
                    color: #225a46;
                    clicked => { root.show-readings = !root.show-readings; root.show-notes = false; }
                }
                notes-toggle := Button {
                    text: root.show-notes ? "Tasks" : "Notes";
                    accessible-name: root.show-notes ? "Back to tasks" : "Open field notes";
                    min-height: 36px;
                    min-width: 75px;
                    primary: false;
                    background: #e0eee5;
                    border-radius: 10px;
                    color: #225a46;
                    clicked => { root.show-notes = !root.show-notes; root.show-readings = false; }
                }
            }
            FlexboxLayout {
                visible: !root.show-notes && !root.show-readings;
                vertical-stretch: 1;
                flex-direction: root.wide ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
                flex-wrap: no-wrap;
                spacing: 15px;
                alignment: stretch;
                cross-axis-alignment: stretch;

                summary := VerticalLayout {
                    preferred-width: root.wide ? 264px : 0px;
                    max-width: root.wide ? 264px : 1600px;
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        height: 135px;
                        visible: !root.compact;
                        border-radius: 17px;
                        background: @linear-gradient(118deg, #123c32 0%, #285e4b 100%);
                        VerticalLayout {
                            padding: 15px;
                            spacing: 7px;
                            Label { text: "Round progress"; color: #c6e2d2; font-size: 13px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Label { text: root.resolved + " / " + root.total; font-size: 31px; font-weight: 750; color: #ffffff; horizontal-stretch: 1; }
                                Label { text: root.remaining + " open"; font-size: 12px; color: #d2ebdb; }
                            }
                            round-progress := ProgressIndicator {
                                accessible-name: "Round progress";
                                height: 6px;
                                maximum: root.total > 0 ? root.total : 1;
                                progress: root.resolved;
                                animate progress { duration: 800ms; }
                                ProgressTrack { background: #417663; border-radius: 3px; }
                                ProgressFill { background: #aee9c5; border-radius: 3px; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        entry := LineEdit {
                            height: 46px;
                            padding-left: 12px;
                            background: #ffffff;
                            border-color: #d3dfd6;
                            border-radius: 12px;
                            color: #18362b;
                            text <=> root.draft;
                            placeholder-text: "New task";
                            accessible-name: "New task";
                            submit-when: Strings.trim(root.draft) != "";
                            accepted => { root.add-task(); }
                        }
                        add := Button {
                            width: 65px;
                            height: 46px;
                            text: "Add";
                            primary: true;
                            border-radius: 12px;
                            color: #ffffff;
                            background: self.pressed ? #1b5a46 : #267459;
                            enabled: Strings.trim(root.draft) != "";
                            clicked => { root.add-task(); }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    spacing: 5px;
                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        open-tab := Button {
                            text: "Open · " + root.remaining;
                            accessible-name: "Open tasks";
                            primary: false;
                            color: root.show-completed ? #456457 : #155e46;
                            border-radius: 9px;
                            background: root.show-completed ? #edf2eb : #dceee2;
                            clicked => { root.show-completed = false; }
                        }
                        completed-tab := Button {
                            text: "Done · " + root.resolved;
                            accessible-name: "Completed tasks";
                            primary: false;
                            color: root.show-completed ? #155e46 : #456457;
                            border-radius: 9px;
                            background: root.show-completed ? #dceee2 : #edf2eb;
                            clicked => { root.show-completed = true; }
                        }
                    }
                    task-list := ListView {
                        background: #00000000;
                        accessible-name: root.show-completed ? "Completed checklist" : "Open checklist";
                        row-height: 74px;
                        row-key-field: "id";
                        for task[index] in root.show-completed ? root.completed-tasks : root.pending-tasks : TaskRow {
                            caption: task.title;
                            context: task.location;
                            tag: task.category;
                            done: root.show-completed;
                            request-toggle => { root.move-task(index, task); }
                        }
                        EmptyState {
                            Label {
                                width: 100%;
                                height: 62px;
                                text: root.show-completed ? "Completed tasks appear here." : "All caught up.";
                                color: #526b5e;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle {
                visible: root.show-readings;
                vertical-stretch: 1;
                min-height: 0px;
                background: #ffffff;
                border-width: 1px;
                border-color: #dce7df;
                border-radius: 16px;
                readings-viewport := ScrollView {
                    width: 100%;
                    height: 100%;
                    accessible-name: "Readings form";
                    dismiss-keyboard-on-drag: true;
                    VerticalLayout {
                        padding: root.compact ? 8px : 14px;
                        spacing: root.compact ? 4px : 12px;
                        alignment: start;
                        Label {
                            text: "Instrument readings";
                            color: #18362b;
                            font-size: 20px;
                            font-weight: 700;
                            visible: !root.compact;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Label { text: "Samples"; color: #526b5e; visible: !root.compact; }
                                samples := SpinBox {
                                    accessible-name: "Sample count";
                                    value <=> root.sample-count;
                                    minimum: 0;
                                    maximum: 12;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Label { text: "Pressure"; color: #526b5e; visible: !root.compact; }
                                pressure-reading := DoubleSpinBox {
                                    accessible-name: "Pressure";
                                    value <=> root.pressure;
                                    minimum: 0;
                                    maximum: 20;
                                    decimals: 2;
                                    decimal-separator: ",";
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Label { text: "Offset"; color: #526b5e; visible: !root.compact; }
                                temperature-reading := DoubleSpinBox {
                                    accessible-name: "Temperature offset";
                                    value <=> root.temperature-offset;
                                    minimum: -10;
                                    maximum: 10;
                                    decimals: 1;
                                    height: 36px;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            form-code := TextInput {
                                accessible-name: "Inspection code";
                                width: 94px;
                                height: 38px;
                                horizontal-stretch: 1;
                                placeholder-text: "Code";
                                text <=> root.code-draft;
                                input-type: number;
                                minimum-length: 2;
                                accepted => { root.form-result = "Code " + root.code-draft; }
                            }
                            form-reading := LineEdit {
                                accessible-name: "Validated reading";
                                width: 103px;
                                height: 38px;
                                horizontal-stretch: 1;
                                placeholder-text: "Reading";
                                text <=> root.reading-draft;
                                input-type: decimal;
                                decimal-separator: ",";
                                minimum-value: 1.0;
                                maximum-value: 10.0;
                                accepted => { root.form-result = "Reading " + root.reading-draft; }
                            }
                            form-search := SearchField {
                                accessible-name: "Find instrument";
                                width: 108px;
                                height: 38px;
                                horizontal-stretch: 1;
                                placeholder-text: "Find";
                                accepted(value) => { root.form-result = "Search: " + value; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            choose-date := Button {
                                text: "" + root.inspection-date;
                                accessible-name: "Choose inspection date, " + root.inspection-date;
                                horizontal-stretch: 1;
                                height: 44px;
                                clicked => { root.date-open = true; }
                            }
                            choose-time := Button {
                                text: "" + root.inspection-time;
                                accessible-name: "Choose inspection time, " + root.inspection-time;
                                horizontal-stretch: 1;
                                height: 44px;
                                clicked => { root.time-open = true; }
                            }
                        }
                        schedule-result := Label {
                            text: root.schedule-status;
                            color: #225a46;
                            visible: root.schedule-status != "";
                        }
                        readings-result := Label {
                            text: root.sample-count + " samples · " + root.pressure + " bar · " +
                                root.temperature-offset + " °C";
                            color: #225a46;
                        }
                        submitted-form := Label {
                            text: root.form-result;
                            color: #225a46;
                            visible: root.form-result != "";
                        }
                        contact-details := Button {
                            text: "Contact details";
                            height: 44px;
                            clicked => { root.contact-open = true; }
                        }
                    }
                }
            }
            Rectangle {
                visible: root.show-notes;
                vertical-stretch: 1;
                background: #ffffff;
                border-width: 1px;
                border-color: #dce7df;
                border-radius: 16px;
                VerticalLayout {
                    padding: root.compact ? 9px : 14px;
                    spacing: root.compact ? 7px : 11px;
                    HorizontalLayout {
                        spacing: 8px;
                        visible: !root.compact;
                        Label {
                            text: "Field notes";
                            min-width: 0px;
                            overflow: elide;
                            color: #18362b;
                            font-size: 20px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        import-note := Button {
                            text: "Import";
                            accessible-name: "Import note";
                            enabled: root.can-import;
                            min-height: 36px;
                            clicked => { note-picker.open(); }
                        }
                        import-folder := Button {
                            text: "Folder";
                            accessible-name: "Import notes from folder";
                            visible: root.folder-import-available;
                            enabled: root.can-import;
                            min-height: 36px;
                            clicked => { root.import-folder(); }
                        }
                    }
                    import-status := Label {
                        text: root.import-status;
                        color: #526b5e;
                        visible: !root.compact && root.import-status != "";
                        min-width: 0px;
                        wrap: word-wrap;
                        max-lines: 2;
                        overflow: elide;
                    }
                    reload-folder := Button {
                        text: "Reload last folder";
                        visible: !root.compact && root.saved-folder-available;
                        enabled: root.can-import;
                        min-height: 36px;
                        clicked => { root.reload-folder(); }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        visible: !root.compact;
                        note-category := ComboBox {
                            accessible-name: "Note category";
                            editable: true;
                            height: 40px;
                            model: ["Routine", "Follow-up", "Urgent"];
                            current-index <=> root.note-category;
                        }
                        note-lock := CheckBox {
                            text: "Read-only";
                            checked <=> root.notes-locked;
                        }
                    }
                    notes-editor := TextEdit {
                        accessible-name: "Inspection notes";
                        vertical-stretch: 1;
                        min-height: 42px;
                        text <=> root.notes;
                        read-only: root.notes-locked;
                        placeholder-text: "Record findings and follow-up steps";
                        wrap: word-wrap;
                        padding: 10px;
                        background: #f6f9f6;
                        border-radius: 12px;
                        border-color: #dce7df;
                        color: #18362b;
                    }
                    transfer-status := Label {
                        text: root.transfer-status;
                        color: #526b5e;
                        visible: !root.compact && root.transfer-status != "";
                        min-width: 0px;
                        wrap: word-wrap;
                        max-lines: 2;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        visible: !root.compact;
                        share-note := Button {
                            text: "Share";
                            accessible-name: "Share note";
                            min-height: 36px;
                            enabled: root.can-transfer;
                            clicked => { root.transfer-note(root.notes, false); }
                        }
                        export-note := Button {
                            text: "Save to Files";
                            accessible-name: "Save note to Files";
                            min-height: 36px;
                            width: 112px;
                            enabled: root.can-transfer;
                            clicked => { root.transfer-note(root.notes, true); }
                        }
                    }
                }
            }
        }
    }
}
