load("@rules_apple//apple:ios.bzl", "ios_application", "ios_ui_test", "ios_unit_test")
load("@rules_apple//apple/testing/default_runner:ios_xctestrun_runner.bzl", "ios_xctestrun_runner")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")
load("//bazel:xrack.bzl", "xr_ui_library")

exports_files(glob(["*.mobileprovision"], allow_empty = True), visibility = ["//visibility:private"])

filegroup(name = "no_provisioning_profile")

label_flag(
    name = "provisioning_profile",
    build_setting_default = ":no_provisioning_profile",
)

config_setting(
    name = "ios_arm64_bundle",
    values = {"ios_multi_cpus": "arm64"},
)

_PROVISIONING_PROFILE = select({
    ":ios_arm64_bundle": ":provisioning_profile",
    "//conditions:default": None,
})

_IOS_DEVICE_CONSTRAINTS = [
    "@apple_support//constraints:device",
    "@platforms//cpu:arm64",
    "@platforms//os:ios",
]

_IOS_LINKOPTS = [
    "-framework UIKit",
    "-framework UniformTypeIdentifiers",
    "-framework Foundation",
    "-framework CoreFoundation",
    "-framework CoreGraphics",
    "-framework CoreText",
    "-framework ImageIO",
    "-framework Metal",
    "-framework PhotosUI",
    "-framework QuartzCore",
    "-liconv",
    "-lobjc",
]

xr_ui_library(
    name = "touch_ui",
    src = "touch.xr",
    visibility = [
        "//examples/android:__pkg__",
        "//tests:__pkg__",
    ],
)

rust_library(
    name = "pocket_tasks_notes",
    srcs = ["notes.rs"],
    edition = "2024",
    visibility = ["//examples/android:__pkg__"],
)

rust_test(
    name = "notes_test",
    size = "small",
    crate = ":pocket_tasks_notes",
    deps = ["@crates//:tempfile"],
)

rust_static_library(
    name = "touch_core",
    srcs = ["app.rs"],
    crate_root = "app.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        ":pocket_tasks_notes",
        ":touch_ui",
        "//crates/xrack-platform-winit:xrack_platform_winit",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

cc_library(
    name = "start",
    srcs = ["start.c"],
    linkopts = _IOS_LINKOPTS,
    target_compatible_with = ["@platforms//os:ios"],
    deps = [":touch_core"],
)

ios_application(
