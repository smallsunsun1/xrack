export component ControlsDemo inherits Window {
    in-out property <float> volume: 25;
    in-out property <float> level: 50;
    in-out property <bool> muted: false;
    in-out property <bool> busy: false;
    out property <int> changes: 0;
    out property <int> releases: 0;
    out property <float> last-release: 0;
    in-out property <float> lower: 20;
    in-out property <float> upper: 75;
    out property <int> interval-changes: 0;
    out property <int> interval-releases: 0;
    out property <float> released-lower: 0;
    out property <float> released-upper: 0;
    in-out property <float> rotation: 0;
    in-out property <DialInputMode> linear-mode: horizontal;
    out property <int> dial-changes: 0;
    out property <int> dial-releases: 0;
    out property <float> dial-last-release: 0;
    pure callback interval-caption(float, float) -> string;
    interval-caption(lower, upper) => { "区间 " + lower + " – " + upper }

    title: "XRack 控件示例";
    width: 540px;
    height: 652px;
    background: #101725;

    Text {
        x: 24px; y: 20px;
        text: "XRack 控件示例";
        font-size: 26px;
        color: #f0f4ff;
    }
    Text {
        x: 24px; y: 57px;
        text: "滑块 · 开关 · 进度指示器";
        font-size: 15px;
        color: #a7b6ce;
    }

    Rectangle {
        x: 24px; y: 92px; width: 316px; height: 230px;
        background: #1d293d;
        border-radius: 14px;
        Text { x: 16px; y: 14px; text: "音量  " + root.volume; color: #edf3ff; }
        volume-slider := Slider {
            x: 16px; y: 42px; width: 284px; height: 28px;
            minimum: 0;
            maximum: 100;
            step: 5;
            enabled: !root.muted;
            value <=> root.volume;
            changed(value) => { root.changes += 1; }
            released(value) => { root.releases += 1; root.last-release = value; }
        }
        mute-switch := Switch {
            x: 16px; y: 76px; width: 284px; height: 30px;
            text: "静音";
            checked <=> root.muted;
        }
        Text { x: 16px; y: 120px; text: "任务进度"; font-size: 15px; color: #a7b6ce; }
        progress-meter := ProgressIndicator {
            x: 16px; y: 151px; width: 284px; height: 10px;
            progress: root.volume / 100.0;
            indeterminate: root.busy;
        }
        task-switch := Switch {
            x: 16px; y: 174px; width: 284px; height: 30px;
            text: "模拟未知进度";
            checked <=> root.busy;
        }
    }

    Rectangle {
        x: 356px; y: 92px; width: 160px; height: 230px;
        background: #1d293d;
        border-radius: 14px;
        Text { x: 16px; y: 14px; text: "垂直调节"; color: #edf3ff; }
        vertical-slider := Slider {
            x: 32px; y: 51px; width: 28px; height: 148px;
            orientation: vertical;
            value <=> root.level;
            step: 10;
        }
        Text { x: 77px; y: 113px; text: "" + root.level; color: #a8ddff; }
    }

    Text {
        x: 24px; y: 338px;
        text: "变化 " + root.changes + " 次 · 结束 " + root.releases + " 次 · 结束值 " + root.last-release;
        font-size: 14px;
        color: #a7b6ce;
    }

    Rectangle {
        x: 24px; y: 372px; width: 316px; height: 114px;
        background: #1d293d;
        border-radius: 14px;
        Text { x: 16px; y: 16px; text: root.interval-caption(root.lower, root.upper); color: #edf3ff; }
        interval := RangeSlider {
            x: 16px; y: 48px; width: 284px; height: 36px;
            lower-value <=> root.lower;
            upper-value <=> root.upper;
            step: 5;
            enabled: !root.muted;
            changed(lower, upper) => { root.interval-changes += 1; }
            released(lower, upper) => {
                root.interval-releases += 1;
                root.released-lower = lower;
                root.released-upper = upper;
            }
            Tooltip { text: "拖动手柄，或用 Tab 选中后按方向键"; }
        }
    }

    Rectangle {
        x: 356px; y: 372px; width: 160px; height: 114px;
        background: #1d293d;
        border-radius: 14px;
        Text { x: 16px; y: 16px; text: "垂直区间"; color: #edf3ff; }
        vertical-interval := RangeSlider {
            x: 104px; y: 12px; width: 32px; height: 90px;
            orientation: vertical;
            lower-value: 30;
            upper-value: 70;
            step: 10;
        }
    }

    Rectangle {
        x: 24px; y: 504px; width: 492px; height: 124px;
        background: #1d293d;
        border-radius: 14px;
        Text { x: 28px; y: 14px; text: "限位旋钮"; color: #edf3ff; }
        Text { x: 204px; y: 14px; text: "循环旋钮"; color: #edf3ff; }
        Text { x: 366px; y: 14px; text: "直线拖动"; color: #edf3ff; }
        rotary := Dial {
            x: 26px; y: 36px; width: 78px; height: 78px;
            minimum: -50; maximum: 50;
            start-angle: -135; end-angle: 135;
            value <=> root.rotation;
            step: 5;
            enabled: !root.muted;
            changed(value) => { root.dial-changes += 1; }
            released(value) => { root.dial-releases += 1; root.dial-last-release = value; }
            Tooltip { text: "拖动旋转，也可以用方向键调节"; }
        }
        phase := Dial {
            x: 202px; y: 36px; width: 78px; height: 78px;
            wrap: true;
            value: 95;
            step: 5;
        }
        linear := Dial {
            x: 364px; y: 36px; width: 78px; height: 78px;
            input-mode: root.linear-mode;
            value: 35;
            step: 10;
        }
    }
}

export component CalendarDemo inherits Window {
    title: "XRack · 日期选择";
    width: 440px;
    height: 460px;
    background: #162034;

    in-out property <Date> selected: Date { year: 2024, month: 2, day: 28 };
    in-out property <Date> month: Date { year: 2024, month: 2, day: 1 };
    in-out property <bool> picker-open: false;
    in-out property <Date> draft;
    private property <Date> draft-month;
    private property <Date> earliest: Date { year: 2024, month: 2, day: 5 };
    private property <Date> latest: Date { year: 2024, month: 4, day: 15 };
    private property <[string]> weekdays: ["一", "二", "三", "四", "五", "六", "日"];
    out property <int> date-changes: 0;
    out property <int> month-changes: 0;
    out property <int> picked-day: 0;

    Text {
        x: 22px; y: 14px;
        text: "选中日期 · " + root.selected;
        color: #edf3ff; font-size: 22px;
    }
    calendar := Calendar {
        x: 22px; y: 54px; width: 396px; height: 322px;
        accessible-name: "行程日期";
        date <=> root.selected;
        display-month <=> root.month;
        minimum-date: root.earliest;
        maximum-date: root.latest;
        weekday-labels: root.weekdays;
        changed(day) => { root.date-changes += 1; root.picked-day = day.day; }
        month-changed(month) => { root.month-changes += 1; }
    }
    open-picker := Button {
        x: 22px; y: 390px; width: 174px; height: 44px;
        text: "在弹层中选择…";
        clicked => {
            root.draft = root.selected;
            root.draft-month = root.selected;
            root.picker-open = true;
        }
    }
    picker := Dialog {
        title: "选择行程日期";
        width: 408px; height: 404px;
        open <=> root.picker-open;
        accepted => { root.selected = root.draft; root.month = root.draft; }
        picker-calendar := Calendar {
            height: 284px;
            accessible-name: "待确认日期";
            date <=> root.draft;
            display-month <=> root.draft-month;
            minimum-date: root.earliest;
            maximum-date: root.latest;
            weekday-labels: root.weekdays;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            cancel-picker := DialogButton { text: "取消"; role: reject; }
            confirm-picker := DialogButton { text: "应用日期"; role: accept; }
        }
    }
}

export struct DecimalPrice {
    label: string,
    price: float,
}

export component DecimalSpinDemo inherits Window {
    title: "XRack · 小数输入";
    width: 480px; height: 306px;
    background: #162034;
    in-out property <float> level: 0.2;
    in-out property <bool> use-comma: true;
    in-out property <bool> locked: false;
    in-out property <[DecimalPrice]> prices: [
        DecimalPrice { label: "分析任务", price: 12.5 },
        DecimalPrice { label: "渲染任务", price: 18.75 },
    ];
    out property <int> edits: 0;

    Text { x: 24px; y: 18px; text: "小数步进 · 数值 " + root.level; font-size: 22px; }
    gain := DoubleSpinBox {
        x: 24px; y: 57px; width: 148px; height: 40px;
        accessible-name: "增益";
        minimum: -2; maximum: 2; step-size: 0.1; decimals: 2; wrap: true;
        decimal-separator: root.use-comma ? "," : ".";
        value <=> root.level;
        read-only: root.locked;
        edited(value) => { root.edits += 1; }
    }
    comma-toggle := Switch {
        x: 188px; y: 57px; width: 138px; height: 40px;
        text: "逗号小数点";
        checked <=> root.use-comma;
    }
    lock-toggle := CheckBox {
        x: 344px; y: 57px; width: 112px; height: 40px;
        text: "锁定";
        checked <=> root.locked;
    }
    Text { x: 24px; y: 117px; text: "可编辑记录 · 单价"; font-size: 17px; color: #acc0db; }
    pricing := TableView {
        x: 24px; y: 145px; width: 432px; height: 134px; row-height: 42px;
        TableColumn { title: "项目"; min-width: 220px; }
        TableColumn { title: "单价"; width: 148px; }
        for row in root.prices : TableRow {
            TableCell { text <=> row.label; }
            DoubleSpinBox {
                value <=> row.price;
                minimum: 0; maximum: 99; step-size: 0.25; decimals: 2;
                decimal-separator: root.use-comma ? "," : ".";
                accessible-name: "单价 · " + row.label;
            }
        }
    }
}
