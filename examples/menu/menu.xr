export component MenuDemo inherits Window {
    title: "XRack · 菜单";
    width: 620px;
    height: 366px;
    background: #182331;

    in-out property <bool> show-grid: false;
    in-out property <bool> grid-enabled: true;
    in-out property <bool> dialog-open: false;
    in-out property <string> new-shortcut: "Primary+N";
    out property <int> background-clicks: 0;
    out property <int> grid-activations: 0;
    out property <string> command: "请选择一条命令";

    grid-command := Action {
        text: "显示网格";
        icon: @image-url("assets/grid.svg");
        shortcut: "Primary+G";
        enabled: root.grid-enabled;
        checkable: true;
        checked <=> root.show-grid;
        activated() => {
            root.grid-activations += 1;
            root.command = root.show-grid ? "已显示网格" : "已隐藏网格";
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        MenuBar {
            file-menu := Menu {
                title: "文件";
                MenuItem { text: "新建"; shortcut: root.new-shortcut; activated() => { root.command = "已新建"; } }
                MenuItem { text: "导入"; shortcut: "Primary+I"; enabled: false; }
                MenuSeparator { }
                Menu {
                    title: "导出为";
                    MenuItem { text: "纯文本"; activated() => { root.command = "已导出纯文本"; } }
                    MenuItem { text: "图像"; shortcut: "Primary+Shift+E"; activated() => { root.command = "已导出图像"; } }
                }
            }
            view-menu := Menu {
                title: "视图";
                grid-item := MenuItem { action: grid-command; }
            }
        }
        workspace := ContextMenuArea {
            Rectangle {
                background: #25364e;
                border-radius: 10px;
                Text { x: 16px; y: 16px; text: "工作区"; font-size: 22px; }
                Text { x: 16px; y: 56px; text: "右键或 Shift+F10 打开上下文菜单"; color: #acc0db; }
                Text { x: 16px; y: 89px; text: root.show-grid ? "网格已显示" : "网格已隐藏"; }
            }
            Menu {
                MenuItem { text: "刷新"; shortcut: "Primary+R"; activated() => { root.command = "已刷新工作区"; } }
                MenuSeparator { }
                MenuItem { text: "重置视图"; activated() => { root.show-grid = false; root.command = "已重置视图"; } }
            }
        }
        ToolBar {
            spacing: 8px;
            wrap: true;
            grid-button := ToolButton {
                action: grid-command;
                icon-only: true;
                accessible-name: "显示网格";
                Tooltip { text: "显示网格 · Primary+G"; }
            }
            dialog-button := ToolButton { text: "对话框"; clicked() => { root.dialog-open = true; } }
            background-button := ToolButton { text: "背景计数 · " + root.background-clicks; clicked() => { root.background-clicks += 1; } }
        }
        status := Text { text: root.command; color: #acc0db; }
        inspector := Dialog {
            open <=> root.dialog-open;
            title: "对话框中的菜单";
            width: 370px;
            height: 210px;
            inspector-area := ContextMenuArea {
                Rectangle { background: #344866; border-radius: 6px; Text { x: 10px; y: 10px; text: "右键检查此区域"; } }
                Menu { MenuItem { text: "检查属性"; shortcut: "Primary+R"; activated() => { root.command = "已检查属性"; } } }
            }
            DialogButton { text: "关闭"; role: reject; }
        }
    }
}

export component ShortcutDemo inherits Window {
    title: "XRack · 快捷键";
    width: 532px; height: 344px;

    in-out property <bool> conflict: false;
    in-out property <bool> command-enabled: true;
    in-out property <bool> dialog-open: false;
    in-out property <string> draft: "";
    out property <int> commands: 0;
    out property <int> window-hits: 0;
    out property <int> dialog-hits: 0;
    out property <int> focused-hits: 0;
    out property <int> repeats: 0;
    out property <int> conflicts: 0;

    palette-command := Action {
        text: "命令面板";
        shortcut: "F9";
        enabled: root.command-enabled;
        activated => { root.commands += 1; }
    }
    Shortcut {
        action: palette-command;
        sequences: ["Primary+K, Primary+P", "F9"];
    }
    Shortcut {
        sequence: "F6";
        activated => { root.window-hits += 1; }
        activated-ambiguously => { root.conflicts += 1; }
    }
    Shortcut {
        sequence: "F6";
        enabled: root.conflict;
        activated-ambiguously => { root.conflicts += 1; }
    }
    Shortcut {
        sequence: "F7";
        auto-repeat: true;
        activated => { root.repeats += 1; }
    }

    VerticalLayout {
        padding: 18px;
        spacing: 8px;
        alignment: start;
        MenuBar { Menu { title: "操作"; MenuItem { action: palette-command; } } }
        Text { text: "命令面板 · Primary+K 后按 Primary+P，或 F9"; }
        Text { text: "已执行命令 · " + root.commands; }
        GroupBox {
            title: "编辑区 · 聚焦后按 F8";
            height: 94px;
            entry := LineEdit { text <=> root.draft; placeholder-text: "这里可以正常输入"; }
            Shortcut { sequence: "F8"; focus-within: true; activated => { root.focused-hits += 1; } }
        }
        Text { text: "窗口 F6 · " + root.window-hits + "    F7 · " + root.repeats + "    编辑区 F8 · " + root.focused-hits; }
        HorizontalLayout {
            spacing: 10px;
            conflict-toggle := CheckBox { text: "制造 F6 冲突"; checked <=> root.conflict; }
            open-shortcut-dialog := Button { text: "打开模态窗口"; clicked => { root.dialog-open = true; } }
        }
        Text { text: "冲突通知 · " + root.conflicts; }
    }
    shortcut-dialog := Dialog {
        open <=> root.dialog-open;
        title: "模态窗口快捷键";
        width: 350px;
        Text { text: "对话框 F6 · " + root.dialog-hits; }
        DialogButton { text: "关闭"; role: reject; }
        Shortcut { sequence: "F6"; activated => { root.dialog-hits += 1; } }
    }
}
