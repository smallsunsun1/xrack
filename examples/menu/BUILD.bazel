load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:xrack.bzl", "xr_ui_library")

xr_ui_library(
    name = "menu_ui",
    src = "menu.xr",
    assets = ["assets/grid.svg"],
    visibility = ["//tests:__pkg__"],
)

exports_files(
    ["menu.xr", "assets/grid.svg"],
    visibility = ["//tests:__pkg__"],
)

rust_binary(
    name = "menu",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        ":menu_ui",
        "//crates/xrack-platform-winit:xrack_platform_winit",
    ],
)
