load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//bazel:xrack.bzl", "xr_ui_library")

xr_ui_library(
    name = "async_ui",
    src = "async.xr",
    visibility = ["//tests:__pkg__"],
)

exports_files(
    ["async.xr"],
    visibility = [
        "//bindings/python:__pkg__",
        "//tests:__pkg__",
    ],
)

rust_library(
    name = "search_completion",
    srcs = ["search.rs"],
    crate_root = "search.rs",
    edition = "2024",
    visibility = ["//tests:__pkg__"],
    deps = [
        "//crates/xrack-runtime:xrack_runtime",
        "@crates//:tracing",
    ],
)

rust_library(
    name = "trace_capture",
    srcs = ["trace_capture.rs"],
    crate_root = "trace_capture.rs",
    edition = "2024",
    visibility = ["//tests:__pkg__"],
    deps = [
        "//crates/xrack-runtime:xrack_runtime",
        "@crates//:serde_json",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)

rust_binary(
    name = "async_demo",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        ":async_ui",
        ":search_completion",
        ":trace_capture",
        "//crates/xrack-platform-winit:xrack_platform_winit",
        "//crates/xrack-runtime:xrack_runtime",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)

xr_ui_library(
    name = "async_ui_live",
    src = "async.xr",
    live_reload = True,
)

rust_binary(
    name = "async_demo_live",
    srcs = ["main.rs"],
    aliases = {":async_ui_live": "async_ui"},
    edition = "2024",
    deps = [
        ":async_ui_live",
        ":search_completion",
        ":trace_capture",
        "//crates/xrack-platform-winit:xrack_platform_winit",
        "//crates/xrack-runtime:xrack_runtime",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)
