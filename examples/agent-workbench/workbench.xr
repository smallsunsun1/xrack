    private property <bool> show-review-matches <- root.review-find-open && root.review-find-ready && root.review-find-count > 0;
    pure function diff-match-marked(id: int) -> bool {
        let mark = root.review-mark(id);
        mark.marked
    }
    pure function diff-match-current(id: int) -> bool {
        let mark = root.review-mark(id);
        mark.current
    }
    pure function diff-match-body(id: int) -> styled-text {
        let mark = root.review-mark(id);
        mark.body
    }
    pure function review-mark(id: int) -> ReviewMatchRow {
        let blank = ReviewMatchRow { marked: false, current: false, body: @markdown("") };
        root.show-review-matches ? Model.at(root.review-match-rows, id, blank) : blank
    }
    in-out property <bool> review-split: false;
    private property <bool> split-review-active <- root.review-split && !root.review-raw && !root.files-active && Model.count(root.review-pairs) > 0;
