    callback recall-composer-prompt(step: int) -> bool;
    callback end-composer-recall();
    callback save-composer-settings();
    submit-composer(alternate) => {
        root.slash-commands-open = false;
        if root.can-followup {
            if root.composer-recalling { root.end-composer-recall(); }
            root.followup(root.draft, root.composer-steers != alternate);
        } else if !alternate && root.can-send {
            if root.composer-recalling { root.end-composer-recall(); }
            root.send(root.draft);
        }
    }

    callback interrupt();
    callback transcript-updated();
    callback open-chat-find();
