struct BranchChoice {
    name: string,
    state: string,
}

struct TranscriptEntry {
    kind: string,
    heading: string,
    status: string,
    status-tone: string,
    body: styled-text,
}

struct TranscriptSection {
    owner: string,
    start: int,
    language: string,
    body: styled-text,
    annotated: styled-text,
}

struct CommandGroup {
    first: int,
    last: int,
    status: string,
    status-tone: string,
}

struct TurnActivity {
    turn: string,
    summary: string,
    expanded: bool,
    attention: bool,
}

struct ChatFindDocument {
    body: styled-text,
}

struct ConversationRow {
    id: int,
    title: string,
    folder: string,
    activity: string,
    shown: bool,
    pinned: bool,
    pinned-shown: bool,
}

struct ConversationTab {
    id: string,
    title: string,
    workspace: string,
    activity: string,
    archived: bool,
}

struct SidebarMenuState {
    pinned: bool,
    archived: bool,
    rename: bool,
    pin: bool,
    archive: bool,
}

struct ProjectGroupRow {
    key: int,
    parent: int,
    title: string,
    detail: string,
    kind: string,
    project: string,
    conversation: int,
    selected: bool,
}

struct ActivityRow {
    id: int,
    title: string,
    project: string,
    activity: string,
}

struct GenerationChoice {
    key: string,
    label: string,
}

struct QueuedRow {
    id: string,
    text: string,
    editable: bool,
}

struct AttachmentRow {
    path: string,
    name: string,
    kind: string,
    preview: image,
    has-preview: bool,
}

struct ReviewFile {
    path: string,
    status: string,
}

struct WorkspaceFile {
    id: int,
    parent-id: int,
    path: string,
    name: string,
    kind: string,
}

struct WorkspacePreviewTab {
    id: string,
    title: string,
    path: string,
    dirty: bool,
}

struct TerminalTab {
    id: string,
    title: string,
}

struct PaletteItem {
    key: string,
    title: string,
    detail: string,
    enabled: bool,
}

struct ReviewLine {
    id: int,
    old-line: int,
    new-line: int,
    kind: string,
    content: string,
    section: string,
}

struct ReviewPair {
    id: int,
    full: bool,
    left: ReviewLine,
    right: ReviewLine,
}

struct ReviewMatchRow {
    marked: bool,
    current: bool,
    body: styled-text,
}

struct ReviewNoteRow {
    id: int,
    reference: string,
    text: string,
}

component ReviewPairTile inherits Rectangle {
    in property <ReviewPair> pair;
    in property <int> selected;
    in property <bool> old-selected;
    in property <bool> can-comment;
    in property <bool> no-comment-text;
    in property <string> hunk-action;
    in property <bool> hunk-action-enabled;
    in property <bool> can-revert;
    in property <ReviewMatchRow> left-mark;
    in property <ReviewMatchRow> right-mark;
    in property <bool> can-edit;
    callback comment(id: int, old: bool);
    callback update-hunk(id: int);
    callback revert-hunk(id: int);
    callback edit(id: int);

    height <- 23px;
    if root.pair.full : ReviewLineTile {
        width <- 100%;
        old-line <- 0;
        new-line <- 0;
        kind <- root.pair.left.kind;
        content <- root.pair.left.content;
        active <- false;
        can-comment <- false;
        match-marked <- root.left-mark.marked;
        match-current <- root.left-mark.current;
        match-body <- root.left-mark.body;
        hunk-action <- root.hunk-action;
        hunk-action-enabled <- root.hunk-action-enabled;
        can-revert <- root.can-revert;
        update-hunk => { root.update-hunk(root.pair.left.id); }
        revert-hunk => { root.revert-hunk(root.pair.left.id); }
    }
    if !root.pair.full : HorizontalLayout {
        width <- 100%;
        height <- 100%;
        spacing <- 0px;
        ReviewSideCell {
            number <- root.pair.left.old-line;
            content <- root.pair.left.content;
            kind <- root.pair.left.kind;
            old <- true;
            active <- root.selected >= 0 && root.pair.left.id == root.selected && root.old-selected;
            can-comment <- root.can-comment && (root.no-comment-text || root.pair.left.id == root.selected && root.old-selected);
            match-marked <- root.left-mark.marked;
            match-current <- root.left-mark.current;
            match-body <- root.left-mark.body;
            comment => { root.comment(root.pair.left.id, true); }
        }
        Rectangle { width <- 1px; background <- Palette.border; }
        ReviewSideCell {
            number <- root.pair.right.new-line;
            content <- root.pair.right.content;
            kind <- root.pair.right.kind;
            old <- false;
            active <- root.selected >= 0 && root.pair.right.id == root.selected && !root.old-selected;
            can-comment <- root.can-comment && (root.no-comment-text || root.pair.right.id == root.selected && !root.old-selected);
            match-marked <- root.right-mark.marked;
            match-current <- root.right-mark.current;
            match-body <- root.right-mark.body;
            can-edit <- root.can-edit;
            comment => { root.comment(root.pair.right.id, false); }
            edit => { root.edit(root.pair.right.id); }
        }
    }
}

export component AgentWorkbench inherits Window {
    title <- "XRack Agent Workbench";
    width <- 1120px;
    height <- 760px;
    min-width <- 680px;
    min-height <- 490px;
    color-scheme <- Palette.dark ? ColorScheme.dark : ColorScheme.light;
    background <- Palette.canvas;
    accent-color <- Palette.accent;
    default-font-size <- 14px;

    out property <ColorScheme> appearance-mode <- Palette.mode;
    out property <bool> dark-appearance <- Palette.dark;
    in-out property <bool> appearance-open: false;
    in property <string> appearance-status;
    in property <string> language-status;
    out property <string> ui-language <- I18n.locale();
    callback select-language(locale: string);

    in-out property <string> draft: "";
    in property <bool> composer-recalling: false;
    in property <bool> draft-store-ready: false;
    in property <string> draft-storage-status;
    private property <string> draft-checkpoint-text;
    private property <bool> draft-items-dirty: false;
    callback save-composer-draft();
    callback draft-files-changed();
    callback draft-checkpoint();
    callback draft-review-notes-changed();
    draft-files-changed => { root.draft-items-dirty = true; }
    draft-review-notes-changed => { root.draft-items-dirty = true; }
    draft-checkpoint => {
        root.draft-checkpoint-text = root.draft;
        root.draft-items-dirty = false;
    }
    in property <int> composer-recall-caret: 0;
    in-out property <string> composer-enter-mode: "modified";
    in-out property <bool> composer-steers: false;
    in-out property <bool> composer-settings-open: false;
    in property <string> composer-settings-status;
    in-out property <string> status-kind: "connecting";
    in-out property <string> status-detail;
    out property <string> status <- root.status-kind == "" ? root.status-detail : @tr("workbench-status", state: root.status-kind);
    in property <string> workspace: "";
    in property <string> workspace-name: "";
    in property <[GenerationChoice]> project-choices: [];
    in-out property <bool> project-groups-open: false;
    in property <[ProjectGroupRow]> project-groups: [];
    in property <[SidebarMenuState]> sidebar-menus: [];
    in property <string> sidebar-action-status;
    in-out property <bool> sidebar-menu-open: false;
    in-out property <int> sidebar-menu-target: -1;
    in-out property <string> sidebar-menu-title;
    private property <SidebarMenuState> sidebar-menu-current <- root.menu-for-session(root.sidebar-menu-target);
    in-out property <bool> sidebar-rename-open: false;
    in-out property <int> sidebar-rename-id: -1;
    in-out property <string> sidebar-rename-draft;
    in property <bool> sidebar-rename-pending: false;
    in property <string> sidebar-rename-error;
    pure function menu-for-session(id: int) -> SidebarMenuState {
        Model.at(root.sidebar-menus, id,
            SidebarMenuState { pinned: false, archived: false, rename: false, pin: false, archive: false })
    }
    pure function session-menu-flag(id: int, flag: string) -> bool {
        let menu = root.menu-for-session(id);
        flag == "rename" ? menu.rename : flag == "pin" ? menu.pin :
            flag == "archive" ? menu.archive : flag == "pinned" ? menu.pinned : menu.archived
    }
    pure function sidebar-menu-available(id: int) -> bool {
        let menu = root.menu-for-session(id);
        menu.rename || menu.pin || menu.archive
    }
    in-out property <int> project-group-key: -1;
    in-out property <string> project-search-input;
    in-out property <bool> project-search-archived: false;
    in property <string> project-search-query;
    in property <bool> project-search-result-archived: false;
    in property <bool> project-search-loading: false;
    in property <bool> project-search-more: false;
    in property <string> project-search-status;
    in property <[ConversationRow]> project-search-results: [];
    private property <string> project-search-term <- Strings.trim(root.project-search-input);
    private property <bool> project-search-active <- root.project-search-term != "";
    private property <bool> project-search-ready <- root.project-search-term == root.project-search-query
        && root.project-search-archived == root.project-search-result-archived;
    in-out property <string> project-selection: "";
    in property <string> project-status: "";
    in property <bool> workspace-write: false;
    in-out property <bool> external-open: false;
    in property <string> external-open-path;
    in-out property <string> external-destination: "vscode";
    in-out property <bool> external-remember: false;
    in property <bool> external-can-remember: false;
    in property <bool> external-open-pending: false;
    in property <string> external-open-error;
    in property <bool> connected: false;
    in property <bool> navigation-back: false;
    in property <bool> navigation-forward: false;
    private property <length> transcript-position: 0px;
    out property <length> transcript-offset <- root.expanded-inspector ? root.transcript-position : transcript.content-y;
    private property <bool> restore-reading-pending: false;
    private property <length> reading-offset: 0px;
    in property <bool> busy: false;
    in property <bool> stopping: false;
    in property <bool> switching: false;
    in property <bool> history-loading: false;
    in property <bool> history-more: false;
    in property <bool> earlier-turns: false;
    in property <string> history-status: "";
    in property <string> history-query: "";
    in property <int> history-hit-count: 0;
    in property <int> pinned-count: 0;
    in property <string> pin-status;
    in property <bool> conversation-pinned: false;
    in-out property <string> session-search-text: "";
    in property <bool> renamable: false;
    in property <bool> rename-pending: false;
    in property <string> rename-error: "";
    in-out property <bool> rename-open: false;
    in-out property <bool> conversation-menu-open: false;
    in-out property <string> rename-draft: "";
    in property <bool> fork-pending: false;
    in property <string> fork-error: "";
    in property <[GenerationChoice]> fork-choices: [];
    in property <[string]> message-forks: [];
    in-out property <int> message-copy-index: -1;
    in-out property <int> message-copy-offset: -1;
    in property <string> message-copy-status: "";
    in-out property <bool> message-quote-open: false;
    in-out property <styled-text> message-quote-body;
    in-out property <bool> historical-prompt-open: false;
    in-out property <string> historical-prompt-text;
    in-out property <string> historical-prompt-turn;
    in-out property <bool> historical-prompt-has-attachments: false;
    in-out property <bool> historical-prompt-fork-requested: false;
    in-out property <string> historical-prompt-error;
    in-out property <bool> fork-open: false;
    in-out property <string> fork-name: "";
    in-out property <string> fork-cutoff: "";
    in property <bool> worktree-available: false;
    in property <bool> worktree-preparing: false;
    in property <string> worktree-start-label;
    in-out property <bool> worktree-start-open: false;
    in property <bool> worktree-start-loading: false;
    in property <[string]> worktree-start-choices: [];
    in-out property <string> worktree-start-base;
    in property <string> worktree-start-commit;
    in property <bool> worktree-start-can-copy: false;
    in property <int> worktree-start-include-count: 0;
    in-out property <bool> worktree-start-copy: false;
    in property <string> worktree-start-error;
    in property <[string]> worktree-start-environments: [];
    in-out property <string> worktree-start-environment;
    in property <string> worktree-start-script;
    in property <string> worktree-setup-output;
    in-out property <bool> worktree-setup-log-open: false;
    in-out property <bool> handoff-open: false;
    in property <bool> handoff-loading: false;
    in property <bool> handoff-preview-ready: false;
    in property <bool> handoff-preparing: false;
    in property <bool> handoff-pending: false;
    in property <bool> handoff-prepared: false;
    in property <bool> handoff-to-local: false;
    in property <bool> handoff-can-copy: false;
    in property <int> handoff-include-count: 0;
    in-out property <bool> handoff-copy: false;
    in property <string> handoff-destination;
    in property <string> handoff-source-commit;
    in property <string> handoff-error;
    private property <bool> handoff-available <- root.connected && root.renamable && !root.busy
        && !root.switching && !root.conversation-archived && !root.queue-loading && !root.has-queue
        && !root.queue-pending && !root.review-index-busy && !root.worktree-preparing
        && !root.handoff-preparing && !root.handoff-pending && root.workspace != "";
    out property <bool> can-open-handoff <- root.handoff-available && root.can-open-palette;
    out property <bool> can-confirm-handoff <- root.handoff-available && root.handoff-preview-ready && !root.handoff-loading;
    private property <bool> show-worktree-start <- root.worktree-available && root.workspace != ""
        && !root.renamable && !root.conversation-archived && Model.count(root.entries) == 0;
    out property <bool> can-configure-worktree-start <- root.show-worktree-start
        && !root.busy && !root.switching && !root.worktree-preparing && !root.sending-prompt && root.can-open-palette;
    in-out property <string> worktree-error: "";
    in-out property <bool> fork-worktree: false;
    in-out property <bool> fork-copy-changes: false;
    in property <bool> archive-view: false;
    in property <bool> archive-pending: false;
    in property <bool> conversation-archived: false;
    in property <[GenerationChoice]> model-choices: [];
    in property <[GenerationChoice]> effort-choices: [];
    in-out property <bool> generation-picker-open: false;
    in-out property <string> generation-model: "";
    in-out property <string> generation-effort: "";
    in property <bool> models-loading: false;
    in property <string> models-status: "";
    in property <bool> plan-available: false;
    in property <bool> plan-mode: false;
    in property <bool> compacting: false;
    in property <bool> reviewing: false;
    in property <bool> context-known: false;
    in property <bool> context-window-known: false;
    in property <float> context-fraction: 0.0;
    in property <string> context-button-text: @tr("usage");
    in property <string> context-summary: @tr("usage-appears-after-the-first-turn");
    in property <string> context-recent: "";
    in property <string> context-total: "";
    in-out property <bool> context-open: false;
    in property <bool> question-open: false;
    in-out property <bool> question-deferred: false;
    in property <int> question-token: 0;
    in property <int> question-index: 0;
    in property <string> question-heading: "";
    in property <string> question-text: "";
    in property <bool> question-allows-text: false;
    in property <bool> question-secret: false;
    in property <string> active-turn-id: "";
    in property <bool> followup-pending: false;
    in property <string> submitted-draft: "";
    in property <bool> sending-prompt: false;
    in property <[QueuedRow]> queued-messages: [];
    in property <bool> queue-loading: false;
    in property <bool> queue-pending: false;
    in property <bool> queue-resumed: false;
    in-out property <bool> queue-edit-open: false;
    in-out property <string> queue-edit-text;
    in property <string> queue-edit-original;
    in property <bool> queue-edit-has-attachments: false;
    in property <bool> queue-edit-read-only: false;
    in property <bool> queue-edit-stale: false;
    in property <string> queue-edit-error;
    out property <bool> can-manage-queue <- root.connected && !root.switching
        && !root.queue-loading && !root.queue-pending && !root.followup-pending && !root.conversation-archived;
    out property <bool> can-save-queued-edit <- root.can-manage-queue && !root.queue-edit-read-only
        && !root.queue-edit-stale && root.queue-edit-text != root.queue-edit-original
        && (root.queue-edit-has-attachments || Strings.trim(root.queue-edit-text) != "");
    in property <[AttachmentRow]> attachment-rows: [];
    in property <bool> attachment-loading: false;
    in-out property <string> attachment-status: "";
    in property <string> attachment-preview-title: "";
    in property <image> attachment-preview-image;
    in property <styled-text> attachment-preview-text: @markdown("");
    in property <bool> attachment-preview-is-text: false;
    in-out property <bool> attachment-preview-open: false;
    in property <[GenerationChoice]> question-options: [];
    in-out property <string> question-choice: "";
    in-out property <string> question-draft: "";
    in property <[TranscriptEntry]> entries: [];
    in-out property <bool> chat-find-open: false;
    in-out property <string> chat-find-query;
    in property <string> chat-find-result-query;
    in property <int> chat-find-count: 0;
    in property <int> chat-find-position: 0;
    in property <[ChatFindDocument]> chat-find-documents: [];
    in property <[TranscriptSection]> transcript-sections: [];
    in property <[string]> transcript-section-owners: [];
    private property <bool> can-find-chat <- root.can-open-palette && Model.count(root.entries) > 0;
    private property <bool> chat-find-ready <- root.chat-find-query == root.chat-find-result-query;
    pure function transcript-body(index: int, body: styled-text) -> styled-text {
        let document = Model.at(root.chat-find-documents, index, ChatFindDocument { body: body });
        root.chat-find-open && root.chat-find-ready ? document.body : body
    }
    pure function section-owner(index: int) -> string {
        Model.at(root.transcript-section-owners, index, "")
    }
    in-out property <int> expanded-command: -1;
    in-out property <int> expanded-command-group: -1;
    in property <[CommandGroup]> command-groups: [];
    in property <[TurnActivity]> turn-activities: [];
    callback toggle-turn-activity(index: int);
    pure function turn-activity(index: int) -> TurnActivity {
        Model.at(root.turn-activities, index, TurnActivity { turn: "", summary: "", expanded: false, attention: false })
    }
    pure function turn-activity-summary(index: int) -> string {
        let activity = root.turn-activity(index);
        activity.summary
    }
    pure function turn-activity-expanded(index: int) -> bool {
        let activity = root.turn-activity(index);
        activity.expanded
    }
    pure function turn-activity-attention(index: int) -> bool {
        let activity = root.turn-activity(index);
        activity.attention
    }
    pure function show-transcript-entry(index: int, kind: string) -> bool {
        let activity = root.turn-activity(index);
        (activity.turn == "" || activity.expanded) && (kind != "command" || root.command-row-visible(index))
    }
    pure function command-group(index: int) -> CommandGroup {
        Model.at(root.command-groups, index, CommandGroup { first: index, last: index, status: "", status-tone: "" })
    }
    pure function group-contains(group: CommandGroup, index: int) -> bool {
        group.last > group.first && index >= group.first && index <= group.last
    }
    pure function command-group-open(group: CommandGroup) -> bool {
        root.group-contains(group, root.expanded-command-group)
            || root.group-contains(group, root.expanded-command)
    }
    pure function is-command-group-first(index: int) -> bool {
        let group = root.command-group(index);
        index == group.first && group.last > group.first
    }
    pure function command-group-title(index: int) -> string {
        let group = root.command-group(index);
        @tr("command-count", count: group.last - group.first + 1)
    }
    pure function command-group-status(index: int) -> string {
        let group = root.command-group(index);
        group.status
    }
    pure function command-group-color(index: int) -> color {
        let group = root.command-group(index);
        group.status-tone == "error" ? Palette.error :
            group.status-tone == "running" ? Palette.accent : Palette.muted
    }
    pure function command-row-visible(index: int) -> bool {
        let group = root.command-group(index);
        group.first == group.last || index == group.first || root.command-group-open(group)
    }
    pure function command-output-toggle-visible(index: int) -> bool {
        let group = root.command-group(index);
        group.first == group.last || root.command-group-open(group)
    }
    callback toggle-command-group(index: int);
    toggle-command-group(index) => {
        let group = root.command-group(index);
        if root.command-group-open(group) {
            if root.group-contains(group, root.expanded-command-group) { root.expanded-command-group = -1; }
            if root.group-contains(group, root.expanded-command) { root.expanded-command = -1; }
        } else {
            root.expanded-command-group = group.first;
            root.follow-output = false;
        }
        root.transcript-updated();
    }
    in property <[ConversationRow]> conversations: [];
    in property <[ActivityRow]> activity-rows: [];
    in-out property <bool> activity-open: false;
    in-out property <bool> notification-settings-open: false;
    in property <bool> notifications-supported: false;
    in property <bool> notifications-authorized: false;
    in property <int> notification-access-status: 0;
    in property <bool> notification-access-pending: false;
    in property <string> notification-settings-error;
    in-out property <string> completion-notice-mode: "off";
    in-out property <bool> question-notices: false;
    out property <bool> notice-window-active <- root.window-active;
    in-out property <string> activity-filter: "";
    in property <int> activity-waiting: 0;
    in property <int> activity-updated: 0;
    in property <int> activity-running: 0;
    in property <bool> activity-can-jump: false;
    private property <[ActivityRow]> visible-activity <- root.activity-filter == "" ? root.activity-rows :
        Model.filter(root.activity-rows, "activity", root.activity-filter);
    private property <[GenerationChoice]> activity-filters <- [
        GenerationChoice { key: "", label: (@tr("all-with-detail") + " ") + Model.count(root.activity-rows) },
        GenerationChoice { key: "needs-input", label: (@tr("needs-input-with-detail") + " ") + root.activity-waiting },
        GenerationChoice { key: "updated", label: (@tr("updated-with-detail") + " ") + root.activity-updated },
        GenerationChoice { key: "running", label: (@tr("running-with-detail") + " ") + root.activity-running },
    ];
    in property <int> conversation-id: 0;
