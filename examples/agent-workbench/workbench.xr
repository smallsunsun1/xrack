        root.file-mention-count == 0 ? @tr("no-matching-skills") : "";
    private property <length> file-mention-height <- (root.file-mention-count * 30) * 1px
        + (root.mention-status-text != "" ? 30px : 10px);
    private property <bool> composer-available <- !root.sending-prompt && !root.worktree-preparing && !root.worktree-setup-log-open && !root.composer-settings-open && !root.generation-picker-open && !root.appearance-open && !root.context-open && !root.question-open && !root.review-line-edit-open && !root.review-notes-open && !root.review-revert-open &&
        !root.attachment-preview-open && !root.message-quote-open && !root.historical-prompt-open && !root.queue-edit-open && !root.external-open && !root.git-commit-open && !root.git-push-open && !root.git-pr-open && !root.git-branch-open && !root.worktree-start-open && !root.handoff-open && !root.workspace-edit-confirm-open && !root.workspace-window-confirm-open;
    private property <bool> enter-sends <- root.composer-enter-mode == "enter" ||
        root.composer-enter-mode == "single-line" && !Strings.contains(root.draft, "\n") && !Strings.contains(root.draft, "\r");
    private property <string> composer-submit-hint <- root.composer-enter-mode == "enter" ? "Enter" :
        root.composer-enter-mode == "single-line" ? @tr("enter-for-one-line") : "⌘ / Ctrl + Enter";
    private property <bool> can-recall-composer <- root.composer-available && !root.switching
