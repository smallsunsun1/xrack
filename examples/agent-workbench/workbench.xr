    callback workspace-checkout-changed();
    callback confirm-git-commit();
    callback reload-git-commit();
    callback focus-git-commit-message();
    focus-git-commit-message => { git-commit-content.focus-message(); }
    callback select-review-file(path: string);
    callback select-review-line(id: int);
    callback select-review-side(id: int, old: bool);
    callback edit-review-line(id: int);
    callback save-review-line-edit();
    callback focus-review-line-edit();
    focus-review-line-edit => { review-line-edit-dialog-content.focus-input(); }
    callback toggle-review-split();
    callback open-review-find();
    callback close-review-find(restore-focus: bool);
    callback refresh-review-find();
    callback move-review-find(delta: int);
    callback reveal-review-find();
    callback schedule-review-find-reveal();
    callback add-review-note();
    callback stage-review-note();
    callback edit-staged-review-note(id: int);
    callback remove-staged-review-note(id: int);
    callback apply-staged-review-notes();
    callback focus-review-note();
    focus-review-note => { root.review-note-focus-pending = true; }
    callback cancel-review-note();
    callback toggle-review();
    callback show-turn-review(index: int);
    callback open-review-scope();
    callback sync-terminal(restart: bool);
    callback show-terminal-panel();
    callback open-project-actions();
    callback load-project-actions();
    callback select-project-action();
    callback run-project-action();
    callback new-terminal-tab();
    callback select-terminal-tab(id: string);
    callback cycle-terminal-tab(step: int);
    callback close-terminal-tab(id: string);
    callback reorder-terminal-tabs(from: int, to: int);
    callback terminal-key(event: KeyEvent) -> EventResult;
    callback terminal-text(text: string);
    callback terminal-resize(width: length, height: length);
    callback terminal-scroll(pages: int);
    callback attach-terminal-output(start: int, end: int, selection: string);
    callback toggle-terminal();
    callback open-review-comparison();
    callback start-review-comparison(mode: string, target: string);
    callback open-comparison-source();
    callback load-review-branches();
    callback start-code-review(mode: string, branch: string, revision: string);
    callback show-review-report(index: int);
    callback open-review-source(href: string);
    callback show-workspace-files();
    callback reset-workspace-files();
    callback load-workspace-files();
    callback expand-workspace-directory(key: int);
    callback open-workspace-selection(key: int);
    callback preview-diff-source(path: string);
    callback open-preview-external();
    callback open-diff-external();
    callback present-external(origin: string, path: string, line: int, column: int);
    callback confirm-external-open();
    callback open-workspace-reference(target: string);
    callback load-workspace-file-from-start();
    callback select-workspace-preview-tab(id: string);
    callback close-workspace-preview-tab(id: string);
    callback reorder-workspace-preview-tabs(from: int, to: int);
    callback start-workspace-file-edit();
    callback change-workspace-file-edit(text: string);
    callback save-workspace-file-edit();
    callback leave-workspace-file-edit();
    callback resolve-workspace-edit-close(discard: bool);
    callback confirm-workspace-window-close() -> bool;
    focus-composer => {
        root.generation-picker-open = false;
        if root.expanded-inspector { root.review-open = false; }
        input.focus();
    }
    show-historical-prompt(text, turn, has-attachments) => {
        root.historical-prompt-text = text;
        root.historical-prompt-turn = turn;
        root.historical-prompt-has-attachments = has-attachments;
        root.historical-prompt-fork-requested = false;
        root.historical-prompt-error = "";
        root.historical-prompt-open = true;
        historical-prompt-dialog.focus-prompt();
    }
    open-fork(cutoff) => {
        root.fork-name = "";
        root.fork-cutoff = cutoff;
        root.fork-worktree = false;
        root.fork-copy-changes = false;
        root.worktree-error = "";
        root.fork-open = true;
        fork-name-field.focus();
    }
    restore-composer-caret(offset) => { input.set-selection-offsets(offset, offset); }
    dismiss-file-mention => {
        file-mention-debounce.stop();
        root.file-mention-open = false;
    }
    pick-workspace => { picker.open(); }
    focus-session-search => {
        root.sessions-open = true;
        root.activity-open = false;
        if root.expanded-inspector { root.review-open = false; }
        if root.project-groups-open {
            project-search-field.focus();
        } else {
            session-search.focus();
        }
    }
    open-project-search => {
        root.sessions-open = true;
        root.activity-open = false;
        root.project-groups-open = true;
        if root.expanded-inspector { root.review-open = false; }
        root.show-project-groups();
        if root.project-search-active && !root.project-search-ready { project-search-debounce.restart(); }
        project-search-field.focus();
    }
    open-workbench-palette(files) => {
        root.conversation-menu-open = false;
        root.generation-picker-open = false;
        root.slash-commands-open = false;
        if root.can-open-palette && (!files || root.workspace != "") {
            root.dismiss-file-mention();
            root.palette-file-mode = files;
            root.palette-query = "";
            root.palette-index = -1;
            root.palette-ready = false;
            root.palette-open = true;
            root.begin-palette-search();
            palette-query-field.focus();
        }
    }
    reveal-palette-item => {
        if root.palette-index >= 0 {
            palette-results.position-view-at-index(root.palette-index, ScrollAlignment.center);
        }
    }
    move-palette-item(delta) => {
        if root.can-use-palette-results && Model.count(root.palette-items) > 0 {
            root.palette-index = Math.clamp(root.palette-index + delta, 0, Model.count(root.palette-items) - 1);
            root.reveal-palette-item();
            palette-query-field.focus();
        }
    }

    confirm-workspace-window-close => {
        root.workspace-window-confirm-open = true;
        false
    }
    close-requested() => {
        let editor-can-close = !root.review-line-edit-open || !root.review-line-edit-dirty && !root.review-line-edit-busy;
        let approved = editor-can-close && !root.git-commit-pending && !root.git-push-pending && !root.git-pr-pending && !root.git-branch-pending && !root.worktree-preparing && !root.handoff-preparing && !root.handoff-pending && (root.workspace-window-close-approved
            || (!root.workspace-edits-dirty && !root.workspace-edits-saving)
            || root.confirm-workspace-window-close());
        if approved && root.draft-store-ready { root.save-composer-draft(); }
        approved
    }
    callback show-workspace-changes();

    composer-save-timer := Timer {
        interval <- 250;
        running <- root.draft-store-ready
            && (root.draft != root.draft-checkpoint-text || root.draft-items-dirty);
        repeat <- true;
        triggered => {
            root.draft-checkpoint();
            root.save-composer-draft();
        }
    }

    transcript-updated => { root.scroll-pending = true; }
    open-chat-find => {
        if root.can-find-chat {
            if root.expanded-inspector { root.review-open = false; }
            root.chat-find-open = true;
            chat-find-bar.focus-query();
            root.refresh-chat-find();
        }
    }
    close-chat-find => {
        root.chat-find-open = false;
        chat-find-debounce.stop();
        chat-find-reveal-timer.stop();
    }
    schedule-chat-find-reveal => {
        root.follow-output = false;
        root.scroll-pending = false;
        chat-find-reveal-timer.restart();
    }
    chat-find-debounce := Timer {
        interval <- 70;
        repeat <- false;
        triggered => { root.refresh-chat-find(); }
    }
    chat-find-reveal-timer := Timer {
        interval <- 1;
        repeat <- false;
        triggered => {
            if root.chat-find-open && root.chat-find-ready && root.chat-find-count > 0 {
                root.reveal-chat-find();
                root.transcript-updated();
            }
        }
    }
    restore-reading-position(offset) => {
        root.reading-offset = offset;
        root.restore-reading-pending = true;
        root.history-anchor-pending = false;
        root.follow-output = false;
        root.scroll-pending = true;
    }
    reveal-latest => {
        root.restore-reading-pending = false;
        root.history-anchor-pending = false;
        root.follow-output = true;
        root.reading-history = false;
        root.scroll-pending = true;
    }
    preserve-transcript-anchor => {
        root.follow-output = false;
        root.scroll-pending = false;
        root.history-anchor-height = transcript-content.layout-height;
        root.history-anchor-offset = transcript.content-y;
        root.history-anchor-pending = root.history-anchor-height > 0px;
    }
    show-turn-review(index) => {
        if root.review-turn != index {
            root.review-offset = 0px;
        }
        root.review-turn = index;
        root.review-comparison-mode = "";
        root.review-comparison-target = "";
        root.review-open = true;
        root.files-active = false;
        root.refresh-review();
        if root.expanded-inspector { close-review.focus(); }
    }
    toggle-review => {
        root.conversation-menu-open = false;
        root.generation-picker-open = false;
        if root.review-open && !root.files-active {
            root.close-inspector();
        } else {
            root.review-open = true;
            root.review-turn = -1;
            root.show-workspace-changes();
        }
    }
    show-workspace-changes => {
        root.files-active = false;
        root.refresh-review();
        if root.expanded-inspector { close-review.focus(); }
    }
    show-workspace-files => {
        root.close-review-find(false);
        root.conversation-menu-open = false;
        root.generation-picker-open = false;
        root.review-open = true;
        root.files-active = true;
        root.load-workspace-files();
        if root.expanded-inspector { workspace-tree.focus(); }
    }
    callback close-inspector();
    close-inspector => {
        let return-to-chat = root.expanded-inspector;
        root.close-review-find(false);
        root.review-open = false;
        if return-to-chat { input.focus(); }
    }
    open-review-find => {
        if root.can-find-review {
            let selection = Strings.trim(review-diff.selected-text);
            if root.review-raw && selection != "" && !Strings.contains(selection, "\n") && !Strings.contains(selection, "\r") {
                root.review-find-query = selection;
            }
            root.review-find-open = true;
            root.refresh-review-find();
            review-find-input.focus();
        }
    }
    close-review-find(restore-focus) => {
        root.review-find-open = false;
        review-find-debounce.stop();
        review-find-reveal-timer.stop();
        if restore-focus {
            if root.review-raw { review-diff.focus(); }
            else { review-find-button.focus(); }
        }
    }
    schedule-review-find-reveal => {
        if root.show-review-matches {
            review-find-reveal-timer.restart();
        }
    }
    review-find-debounce := Timer {
        interval <- 70;
        repeat <- false;
        triggered => { root.refresh-review-find(); }
    }
    review-find-reveal-timer := Timer {
        interval <- 1;
        repeat <- false;
        triggered => {
            if root.show-review-matches && root.can-find-review { root.reveal-review-find(); }
        }
    }
    open-review-scope => {
        root.conversation-menu-open = false;
        root.generation-picker-open = false;
        root.review-scope-compare = false;
        root.review-scope-mode = "working";
        root.review-scope-branch = "";
        root.review-scope-revision = "";
        root.review-scope-open = true;
        root.load-review-branches();
    }
    open-review-comparison => {
        root.review-scope-compare = true;
        root.review-scope-mode = root.review-comparison-mode == "commit" ? "commit" : "branch";
        root.review-scope-branch = root.review-comparison-mode == "branch" ? root.review-comparison-target : "";
        root.review-scope-revision = root.review-comparison-mode == "commit" ? root.review-comparison-target : "";
        root.review-scope-open = true;
        root.load-review-branches();
    }
    toggle-terminal => {
        root.conversation-menu-open = false;
        root.generation-picker-open = false;
        if root.terminal-open && !root.expanded-inspector {
            root.terminal-open = false;
            root.focus-composer();
        } else if root.workspace != "" {
            root.show-terminal-panel();
            root.sync-terminal(false);
        }
        root.transcript-updated();
    }
    show-terminal-panel => {
        if root.expanded-inspector { root.close-inspector(); }
        root.terminal-open = true;
        root.terminal-last-width = 0px;
        root.terminal-last-height = 0px;
        terminal-panel.focus-input();
        root.transcript-updated();
    }
    open-project-actions => {
        if root.workspace != "" && root.can-open-palette {
            root.project-actions-open = true;
            root.load-project-actions();
        }
    }
    terminal-viewport-timer := Timer {
        interval <- 80;
        repeat <- true;
        running <- root.terminal-open && root.terminal-running && !root.expanded-inspector;
        triggered => {
            let width = root.terminal-width;
            let height = root.terminal-height;
            if width > 0px && height > 0px && (width != root.terminal-last-width || height != root.terminal-last-height) {
                root.terminal-last-width = width;
                root.terminal-last-height = height;
                root.terminal-resize(width, height);
            }
        }
    }

    transcript-scroll-timer := Timer {
        interval <- 1;
        running <- !root.switching && !root.expanded-inspector && (root.history-anchor-pending || root.scroll-pending);
        repeat <- true;
        triggered => {
            root.scroll-pending = false;
            if root.restore-reading-pending {
                root.restore-reading-pending = false;
                root.reading-history = transcript-content.layout-height + root.reading-offset - transcript.visible-height > 2px;
                transcript.scroll-to(0px, -root.reading-offset);
            } else if root.history-anchor-pending {
                let offset = transcript-content.layout-height - root.history-anchor-height - root.history-anchor-offset;
                root.history-anchor-pending = false;
                root.reading-history = root.history-anchor-height + root.history-anchor-offset - transcript.visible-height > 2px;
                transcript.scroll-to(0px, offset);
            } else if root.follow-output {
                transcript.scroll-to(0px, transcript-content.layout-height - transcript.visible-height);
            } else {
                root.reading-history = root.transcript-gap > 2px;
            }
        }
    }

    git-checkout-refresh := Timer {
        interval <- 4500;
        running <- root.window-active && root.git-checkout-label != "" && !root.git-branch-open && !root.git-branch-pending;
        repeat <- true;
        triggered => { root.refresh-git-checkout(); }
    }

    attach-timer := Timer {
        interval <- 1;
        running <- true;
        repeat <- false;
        triggered => { root.attach(); }
    }

    review-note-focus-timer := Timer {
        interval <- 1;
        running <- root.review-note-focus-pending && root.review-open && !root.files-active && root.review-note-reference != "";
        repeat <- false;
        triggered => {
            root.review-note-focus-pending = false;
            review-note-input.focus();
        }
    }

    workspace-file-scroll-timer := Timer {
        interval <- 1;
        running <- root.workspace-file-scroll-pending && root.review-open && root.files-active && !root.workspace-file-editing
            && (root.workspace-file-kind == "text" || root.workspace-file-kind == "markdown");
        repeat <- false;
        triggered => {
            root.workspace-file-scroll-pending = false;
            workspace-text-preview.scroll-to(0px, root.workspace-file-restore-y);
        }
    }

    search-debounce := Timer {
        interval <- 180;
        repeat <- false;
        triggered => { root.search-sessions(root.session-search-text); }
    }
    project-search-debounce := Timer {
        interval <- 180;
        repeat <- false;
        triggered => {
            if root.project-groups-open {
                root.search-all-projects(root.project-search-term, root.project-search-archived, false);
            }
        }
    }

    palette-search-debounce := Timer {
        interval <- 70;
        repeat <- false;
        triggered => { root.search-palette(); }
    }

    file-mention-debounce := Timer {
        interval <- 70;
        repeat <- false;
        triggered => { root.search-file-mention(input.cursor-offset, input.selected-text != ""); }
    }

    picker := FileDialog {
        mode <- select-folder;
        title <- @tr("choose-a-workspace");
        directory <- root.workspace;
        accepted(paths) => { root.select-workspace(self.selected-file); }
        failed(message) => { root.status-kind = ""; root.status-detail = message; }
    }

    attachment-picker := FileDialog {
        mode <- open-files;
        title <- @tr("add-message-attachments");
        directory <- root.workspace;
        accepted(paths) => { root.attach-files(paths); }
        failed(message) => { root.attachment-status = message; }
    }

    project-actions-dialog := Dialog {
        open <-> root.project-actions-open;
        title <- @tr("project-actions");
        width <- 510px;
        height <- 264px;
        VerticalLayout {
            padding <- 12px;
            spacing <- 8px;
            alignment <- start;
            project-action-choice := ComboBox {
                height <- 32px;
                model <- root.project-actions;
                text-role <- "label";
                value-role <- "key";
                current-value <-> root.project-action-id;
                accessible-name <- @tr("select-a-project-action");
                enabled <- !root.project-actions-loading && Model.count(root.project-actions) > 0;
                value-selected(value) => { root.select-project-action(); }
            }
            Label {
                text <- root.project-actions-loading ? @tr("loading-actions") : root.project-actions-status;
                color <- Palette.muted;
                overflow <- elide;
                height <- 23px;
                visible <- root.project-actions-loading || root.project-actions-status != "";
            }
            Pane {
                height <- 68px;
                padding <- 8px;
                border-radius <- 7px;
                border-width <- 1px;
                border-color <- Palette.border;
                background <- Palette.canvas;
                visible <- root.project-action-command != "";
                ScrollView {
                    horizontal-scroll-bar-policy <- always-off;
                    accessible-name <- @tr("command-to-run");
                    project-action-command-preview := Text {
                        width <- 100%;
                        text <- root.project-action-command;
                        font-family <- "monospace";
                        font-size <- 12px;
                        color <- Palette.text;
                        wrap <- char-wrap;
                        vertical-alignment <- top;
                    }
                }
            }
            Label {
                text <- (@tr("working-directory-display") + " ") + root.project-action-directory;
                height <- 21px;
                visible <- root.project-action-directory != "";
                accessible-name <- (@tr("working-directory") + " ") + root.project-action-directory;
                font-size <- 11px;
                color <- Palette.muted;
                overflow <- elide;
            }
            HorizontalLayout {
                height <- 34px;
                spacing <- 6px;
                alignment <- end;
                cross-axis-alignment <- center;
                reload-project-actions := Button {
                    text <- @tr("reload");
                    height <- 29px;
                    flat <- true;
                    padding <- 5px;
                    enabled <- !root.project-actions-loading;
                    clicked => { root.load-project-actions(); }
                }
                close-project-actions := Button {
                    text <- @tr("cancel");
                    height <- 29px;
                    flat <- true;
                    padding <- 5px;
                    clicked => { root.project-actions-open = false; }
                }
                run-project-action := Button {
                    text <- @tr("run");
                    height <- 29px;
                    primary <- true;
                    padding <- 6px;
                    enabled <- !root.project-actions-loading && !root.switching && root.project-action-command != "";
                    clicked => { root.run-project-action(); }
                }
            }
        }
    }

    attachment-preview-dialog := Dialog {
        open <-> root.attachment-preview-open;
        title <- root.attachment-preview-title;
        width <- 620px;
        height <- 439px;
        AttachmentPreview {
            attachment-preview-image <- root.attachment-preview-image;
            attachment-preview-is-text <- root.attachment-preview-is-text;
            attachment-preview-open <-> root.attachment-preview-open;
            attachment-preview-text <- root.attachment-preview-text;
        }
    }

    review-scope-dialog := Dialog {
        title <- root.review-scope-compare ? @tr("compare-git-revisions") : @tr("start-code-review");
        open <-> root.review-scope-open;
        width <- 426px;
        height <- 185px + (root.review-scope-mode == "working" ? 0px : 60px)
            + (root.review-scope-error != "" ? 39px : 0px);
        VerticalLayout {
            padding <- 14px;
            alignment <- start;
            spacing <- 8px;
            Label { text <- root.review-scope-compare ? @tr("comparison-scope") : @tr("review-scope"); color <- Palette.muted; font-size <- 12px; }
            review-scope-choice := ComboBox {
                height <- 34px;
                model <- root.review-scope-compare ? [
                    GenerationChoice { key: "branch", label: @tr("compare-with-branch") },
                    GenerationChoice { key: "commit", label: @tr("select-commit") },
                ] : [
                    GenerationChoice { key: "working", label: @tr("uncommitted-changes") },
                    GenerationChoice { key: "branch", label: @tr("compare-with-branch") },
                    GenerationChoice { key: "commit", label: @tr("select-commit") },
                ];
                text-role <- "label";
                value-role <- "key";
                current-value <-> root.review-scope-mode;
                accessible-name <- root.review-scope-compare ? @tr("comparison-scope") : @tr("review-scope");
                enabled <- !root.review-scope-loading;
            }
            VerticalLayout {
                visible <- root.review-scope-mode != "working";
                spacing <- 8px;
                Label {
                    text <- root.review-scope-mode == "branch" ? @tr("base-branch") : @tr("commit");
                    color <- Palette.muted;
                    font-size <- 12px;
                }
                review-branch-choice := ComboBox {
                    height <- 34px;
                    visible <- root.review-scope-mode == "branch";
                    enabled <- !root.review-scope-loading;
                    model <- root.review-branch-choices;
                    text-role <- "label";
                    value-role <- "key";
                    current-value <-> root.review-scope-branch;
                    accessible-name <- @tr("base-branch");
                }
                review-revision := LineEdit {
                    height <- 34px;
                    visible <- root.review-scope-mode == "commit";
                    enabled <- !root.review-scope-loading;
                    text <-> root.review-scope-revision;
                    placeholder-text <- @tr("enter-a-commit-sha-or-git-ref");
                    accessible-name <- root.review-scope-compare ? @tr("commit-to-view") : @tr("commit-to-review");
                }
            }
            Text {
                visible <- root.review-scope-error != "";
                height <- 32px;
                text <- root.review-scope-error;
                wrap <- char-wrap;
                color <- Palette.error;
                font-size <- 12px;
            }
            HorizontalLayout {
                alignment <- end;
                spacing <- 8px;
                height <- 34px;
                cancel-code-review := Button {
                    text <- @tr("cancel");
                    flat <- true;
                    padding <- 6px;
                    clicked => { root.review-scope-open = false; }
                }
                submit-code-review := Button {
                    text <- root.review-scope-loading ? @tr("reading-git") : root.review-scope-compare ? @tr("view-diff") : @tr("start-review-action");
                    primary <- true;
                    padding <- 6px;
                    border-radius <- 7px;
                    enabled <- (root.review-scope-compare ? !root.review-index-busy && !root.switching : root.can-start-code-review) && !root.review-scope-loading &&
                        (root.review-scope-mode == "working" ||
                        root.review-scope-mode == "branch" && root.review-scope-branch != "" ||
                        root.review-scope-mode == "commit" && root.review-scope-revision != "");
                    clicked => {
                        if root.review-scope-compare {
                            root.start-review-comparison(root.review-scope-mode, root.review-scope-mode == "branch"
                                ? root.review-scope-branch : root.review-scope-revision);
                        } else {
                            root.start-code-review(root.review-scope-mode, root.review-scope-branch, root.review-scope-revision);
                        }
                    }
                }
            }
        }
    }

    review-report-dialog := ReviewReportDialog {
        review-report-document <- root.review-report-document;
        review-report-open <-> root.review-report-open;
        review-source-document <- root.review-source-document;
        review-source-open <-> root.review-source-open;
        review-source-title <- root.review-source-title;
        open-review-source(href) => { root.open-review-source(href); }
    }

    context-dialog := Dialog {
        title <- @tr("context-usage");
        open <-> root.context-open;
        width <- 425px;
        height <- root.context-known ? 312px : 159px;
        ContextUsageContent {
            can-compact-context <- root.can-compact-context;
            compact-context => { root.compact-context(); }
            context-fraction <- root.context-fraction;
            context-known <- root.context-known;
            context-open <-> root.context-open;
            context-recent <- root.context-recent;
            context-summary <- root.context-summary;
            context-total <- root.context-total;
            context-window-known <- root.context-window-known;
        }
    }

    Shortcut {
        sequence <- "Primary+Shift+D";
        enabled <- !root.rename-open && !root.fork-open && root.workspace != "";
        activated => { root.toggle-review(); }
    }

    save-file-shortcut := Shortcut {
        sequence <- "Primary+S";
        enabled <- root.review-open && root.files-active && root.workspace-file-editing && root.workspace-file-edit-dirty
            && !root.workspace-file-edit-saving && !root.workspace-edit-confirm-open && !root.workspace-window-confirm-open
            && !root.review-dialog-open && !root.question-open && !root.switching;
        activated => { root.save-workspace-file-edit(); }
    }

    files-shortcut := Shortcut {
        sequence <- "Primary+Shift+E";
        enabled <- !root.rename-open && !root.fork-open && !root.review-dialog-open && !root.question-open && root.workspace != "";
        activated => { root.show-workspace-files(); }
    }
    terminal-shortcut := Shortcut {
        sequence <- "Primary+J";
        enabled <- root.workspace != "" && root.can-open-palette && !root.palette-open;
        activated => { root.toggle-terminal(); }
    }
    Shortcut {
        sequence <- "Primary+Alt+[";
        enabled <- root.terminal-open && !root.expanded-inspector && root.can-open-palette && !root.palette-open
            && Model.count(root.terminal-tabs) > 1;
        activated => { root.cycle-terminal-tab(-1); terminal-panel.focus-input(); }
    }
    Shortcut {
        sequence <- "Primary+Alt+]";
        enabled <- root.terminal-open && !root.expanded-inspector && root.can-open-palette && !root.palette-open
            && Model.count(root.terminal-tabs) > 1;
        activated => { root.cycle-terminal-tab(1); terminal-panel.focus-input(); }
    }

    code-review-shortcut := Shortcut {
        sequence <- "Primary+Shift+R";
        enabled <- root.can-start-code-review && !root.rename-open && !root.fork-open && !root.review-dialog-open && !root.question-open && !root.attachment-preview-open && !root.context-open;
        activated => { root.open-review-scope(); }
    }

    generation-picker-shortcut := Shortcut {
        sequence <- "Ctrl+Shift+M";
        enabled <- root.can-open-generation-picker && !root.palette-open;
        activated => {
            root.slash-commands-open = false;
            root.generation-picker-open = !root.generation-picker-open;
        }
    }

    Shortcut {
        sequence <- "Ctrl+Tab";
        enabled <- root.show-conversation-tabs && root.can-use-conversation-tabs && !terminal-panel.input-focused;
        activated => { root.cycle-conversation-tab(1); }
    }
    Shortcut {
        sequence <- "Ctrl+Shift+Tab";
        enabled <- root.show-conversation-tabs && root.can-use-conversation-tabs && !terminal-panel.input-focused;
        activated => { root.cycle-conversation-tab(-1); }
    }
    Shortcut {
        sequence <- "Primary+W";
        enabled <- root.show-conversation-tabs && root.can-use-conversation-tabs && !terminal-panel.input-focused;
        activated => { root.close-conversation-tab(root.conversation-tab); }
    }
    Shortcut {
        sequence <- "Primary+Shift+T";
        enabled <- root.can-reopen-conversation-tab && root.can-use-conversation-tabs;
        activated => { root.reopen-conversation-tab(); }
    }

    Shortcut {
        sequence <- "Primary+K";
        enabled <- root.connected && !root.rename-open && !root.fork-open
            && (root.workspace != "" || root.project-groups-open && Model.count(root.project-choices) > 0);
        activated => { root.focus-session-search(); }
    }

    commands-shortcut := Shortcut {
        sequence <- "Primary+Shift+P";
        enabled <- root.can-open-palette && !root.palette-open;
        activated => { root.open-workbench-palette(false); }
    }

    quick-file-shortcut := Shortcut {
        sequence <- "Primary+P";
        enabled <- root.can-open-palette && !root.palette-open && root.workspace != "";
        activated => { root.open-workbench-palette(true); }
    }

    Shortcut {
        sequence <- "Primary+F";
        enabled <- root.review-find-here || root.can-find-chat && !root.palette-open;
        activated => {
            if root.review-find-here { root.open-review-find(); }
            else { root.open-chat-find(); }
        }
    }
    Shortcut {
        sequence <- "Primary+G";
        enabled <- root.review-find-here ? root.show-review-matches : root.chat-find-open && root.can-find-chat && !root.palette-open;
        activated => {
            if root.review-find-here { root.move-review-find(1); }
            else { root.move-chat-find(1); }
        }
    }
    Shortcut {
        sequence <- "Primary+Shift+G";
        enabled <- root.review-find-here ? root.show-review-matches : root.chat-find-open && root.can-find-chat && !root.palette-open;
        activated => {
            if root.review-find-here { root.move-review-find(-1); }
            else { root.move-chat-find(-1); }
        }
    }
    Shortcut {
        sequence <- "Shift+F3";
        enabled <- root.review-find-here ? root.show-review-matches : root.chat-find-open && root.can-find-chat && !root.palette-open;
        activated => {
            if root.review-find-here { root.move-review-find(-1); }
            else { root.move-chat-find(-1); }
        }
    }

    Shortcut {
        sequences <- ["Primary+[", "MouseBack"];
        enabled <- root.can-travel && !root.palette-open && root.navigation-back;
        activated => { root.navigate-conversation(false); }
    }
    Shortcut {
        sequences <- ["Primary+]", "MouseForward"];
        enabled <- root.can-travel && !root.palette-open && root.navigation-forward;
        activated => { root.navigate-conversation(true); }
    }

    Shortcut {
        sequence <- "Primary+Alt+U";
        enabled <- !root.palette-open;
        activated => { root.toggle-activity(); }
    }
    Shortcut {
        sequence <- "Primary+Alt+A";
        enabled <- root.can-switch-conversation && !root.palette-open && root.activity-can-jump;
        activated => { root.open-next-attention(); }
    }
    Shortcut {
        sequence <- "Shift+Escape";
        enabled <- root.activity-updated > 0 && !root.palette-open;
        activated => { root.mark-activity-read(); }
    }

    pin-session-shortcut := Shortcut {
        sequence <- "Primary+Alt+P";
        enabled <- root.can-pin-session && !root.palette-open;
        activated => { root.set-session-pinned(!root.conversation-pinned); }
    }

    notification-settings-dialog := Dialog {
        title <- @tr("notification-settings");
        open <-> root.notification-settings-open;
        width <- 414px;
        height <- root.notification-settings-error == "" ? 348px : 382px;
        NotificationSettings {
            completion-notice-mode <-> root.completion-notice-mode;
            notification-access-pending <- root.notification-access-pending;
            notification-access-status <- root.notification-access-status;
            notification-settings-error <- root.notification-settings-error;
            notification-settings-open <-> root.notification-settings-open;
            notifications-authorized <- root.notifications-authorized;
            notifications-supported <- root.notifications-supported;
            question-notices <-> root.question-notices;
            request-notification-access => { root.request-notification-access(); }
            save-notification-settings => { root.save-notification-settings(); }
        }
    }

    composer-settings-dialog := Dialog {
        title <- @tr("send-settings");
        open <-> root.composer-settings-open;
        width <- 396px;
        height <- root.composer-settings-status == "" ? 320px : 354px;
        ComposerSettings {
            restore-focus => { input.focus(); }
            composer-enter-mode <-> root.composer-enter-mode;
            composer-settings-open <-> root.composer-settings-open;
            composer-settings-status <- root.composer-settings-status;
            composer-steers <-> root.composer-steers;
            save-composer-settings => { root.save-composer-settings(); }
        }
    }

    queued-editor := Dialog {
        title <- root.queue-edit-read-only ? @tr("preview-queued-message") : @tr("edit-queued-message");
        open <-> root.queue-edit-open;
        width <- 545px;
        height <- 365px;
        close-on-outside <- false;
        close-on-escape <- !root.queue-pending;
        queue-editor-content := QueuedEditorContent {
            body <-> root.queue-edit-text;
            is-read-only <- root.queue-edit-read-only;
            has-attachments <- root.queue-edit-has-attachments;
            stale <- root.queue-edit-stale;
            saving <- root.queue-pending;
            error <- root.queue-edit-error;
            can-save <- root.can-save-queued-edit;
            save => { root.save-queued-edit(); }
            close-editor => { root.queue-edit-open = false; root.focus-composer(); }
        }
    }

    appearance-dialog := Dialog {
        title <- @tr("appearance");
        open <-> root.appearance-open;
        width <- 370px;
        height <- 270px + (root.appearance-status != "" ? 32px : 0px)
            + (root.language-status != "" ? 32px : 0px);
        AppearanceSettings {
            appearance-open <-> root.appearance-open;
            appearance-status <- root.appearance-status;
            language-status <- root.language-status;
            select-appearance(mode) => { root.select-appearance(mode); }
            select-language(locale) => { root.select-language(locale); }
        }
    }

    workspace-palette := Dialog {
        title <- root.palette-file-mode ? @tr("quick-open-file") : @tr("command-palette");
        open <-> root.palette-open;
        width <- 570px;
        height <- 424px;
        palette-key-scope := FocusScope {
            initial-focus <- palette-query-field;
            capture-key-pressed(event) => {
                if event.key == "ArrowDown" {
                    root.move-palette-item(1);
                }
                if event.key == "ArrowUp" {
                    root.move-palette-item(-1);
                }
                event.key == "ArrowDown" || event.key == "ArrowUp" ? EventResult.accept : EventResult.reject
            }
            VerticalLayout {
                width <- 100%;
                height <- 100%;
                padding <- 12px;
                spacing <- 8px;
                palette-query-field := LineEdit {
                    height <- 36px;
                    text <-> root.palette-query;
                    placeholder-text <- root.palette-file-mode ? @tr("file-or-path-optionally-with-line") : @tr("search-commands");
                    accessible-name <- root.palette-file-mode ? @tr("search-workspace-files") : @tr("search-commands");
                    edited => {
                        root.palette-ready = false;
                        palette-search-debounce.restart();
                    }
                    accepted => { root.activate-palette-item(root.palette-index); }
                }
                Label {
                    text <- root.palette-status;
                    visible <- root.palette-status != "";
                    color <- Palette.muted;
                    font-size <- 12px;
                    overflow <- elide;
                    height <- 21px;
                }
                palette-results := ListView {
                    vertical-stretch <- 1;
                    row-height <- 36px;
                    current-index <-> root.palette-index;
                    content-y <-> root.palette-offset;
                    enabled <- root.can-use-palette-results;
                    background <- Palette.surface;
                    accessible-name <- root.palette-file-mode ? @tr("file-search-results") : @tr("command-search-results");
                    for item[index] in root.palette-items : PaletteResult {
                        title <- item.title;
                        detail <- item.detail;
                        current <- index == root.palette-index;
                        ready <- root.can-use-palette-results;
                        choose => { root.activate-palette-item(index); }
                    }
                }
            }
        }
    }

    external-open-dialog := Dialog {
        title <- @tr("open-with");
        open <-> root.external-open;
        width <- 432px;
        height <- root.external-open-error == "" ? 294px : 338px;
        close-on-outside <- !root.external-open-pending;
        close-on-escape <- !root.external-open-pending;
        ExternalOpenContent {
            path <- root.external-open-path;
            destination <-> root.external-destination;
            remember <-> root.external-remember;
            can-remember <- root.external-can-remember;
            pending <- root.external-open-pending;
            error <- root.external-open-error;
            confirm => { root.confirm-external-open(); }
            cancel => { root.external-open = false; }
        }
    }

    workspace-edit-confirm-dialog := Dialog {
        title <- root.workspace-edit-confirm-closing ? @tr("close-unsaved-file") : @tr("discard-current-changes");
        open <-> root.workspace-edit-confirm-open;
        width <- 420px;
        height <- 160px;
        close-on-escape <- false;
        close-on-outside <- false;
        FileEditConfirmation {
            resolve-workspace-edit-close(discard) => { root.resolve-workspace-edit-close(discard); }
            workspace-edit-confirm-closing <- root.workspace-edit-confirm-closing;
            workspace-edit-confirm-file <- root.workspace-edit-confirm-file;
        }
    }

    workspace-window-confirm-dialog := WorkspaceCloseDialog {
        workspace-edits-dirty <- root.workspace-edits-dirty;
        workspace-edits-saving <- root.workspace-edits-saving;
        workspace-window-close-approved <-> root.workspace-window-close-approved;
        workspace-window-confirm-open <-> root.workspace-window-confirm-open;
        finish-close => { root.close(); }
    }

    sidebar-session-dialog := Dialog {
        title <- root.sidebar-menu-title;
        open <-> root.sidebar-menu-open;
        width <- 320px;
        height <- 181px;
        VerticalLayout {
            alignment <- start;
            padding <- 12px;
            spacing <- 6px;
            sidebar-menu-rename := Button {
                text <- @tr("rename");
                height <- 29px;
                padding <- 4px;
                flat <- true;
                enabled <- root.sidebar-menu-current.rename;
                clicked => {
                    root.sidebar-menu-open = false;
                    root.manage-sidebar-session(root.sidebar-menu-target, "rename");
                }
            }
            sidebar-menu-pin := Button {
                text <- root.sidebar-menu-current.pinned ? @tr("unpin") : @tr("pin");
                height <- 29px;
                padding <- 4px;
                flat <- true;
                enabled <- root.sidebar-menu-current.pin;
                clicked => {
                    root.sidebar-menu-open = false;
                    root.manage-sidebar-session(root.sidebar-menu-target, "pin");
                }
            }
            sidebar-menu-archive := Button {
                text <- root.sidebar-menu-current.archived ? @tr("restore-conversation") : @tr("archive-conversation");
                height <- 29px;
                padding <- 4px;
                flat <- true;
                enabled <- root.sidebar-menu-current.archive;
                clicked => {
                    root.sidebar-menu-open = false;
                    root.manage-sidebar-session(root.sidebar-menu-target, "archive");
                }
            }
        }
    }

    sidebar-rename-dialog := Dialog {
        title <- @tr("rename-conversation");
        width <- 390px;
        height <- root.sidebar-rename-error == "" ? 168px : 194px;
        open <-> root.sidebar-rename-open;
        close-on-escape <- !root.sidebar-rename-pending;
        close-on-outside <- false;
        sidebar-rename-dialog-content := RenameSidebarConversationContent {
            rename-sidebar-session(name) => { root.rename-sidebar-session(name); }
            sidebar-rename-draft <-> root.sidebar-rename-draft;
            sidebar-rename-error <- root.sidebar-rename-error;
            sidebar-rename-open <-> root.sidebar-rename-open;
            sidebar-rename-pending <- root.sidebar-rename-pending;
        }
    }

    rename-dialog := Dialog {
        title <- @tr("rename-conversation");
        width <- 390px;
        height <- root.rename-error == "" ? 168px : 194px;
        open <-> root.rename-open;
        rename-dialog-content := RenameConversationContent {
            rename-conversation(name) => { root.rename-conversation(name); }
            rename-draft <-> root.rename-draft;
            rename-error <- root.rename-error;
            rename-open <-> root.rename-open;
            rename-pending <- root.rename-pending;
        }
    }

    git-commit-dialog := Dialog {
        title <- @tr("commit-staged-changes");
        open <-> root.git-commit-open;
        width <- 520px;
        height <- 418px + (root.git-commit-error != "" ? 35px : 0px);
        close-on-outside <- false;
        close-on-escape <- !root.git-commit-pending;
        git-commit-content := GitCommitContent {
            branch <- root.git-commit-branch;
            detached <- root.git-commit-detached;
            files <- root.git-commit-files;
            message <-> root.git-commit-message;
            loading <- root.git-commit-loading;
            pending <- root.git-commit-pending;
            done <- root.git-commit-done;
            commit-id <- root.git-commit-result;
            error <- root.git-commit-error;
            confirm-enabled <- root.can-confirm-git-commit;
            refresh => { root.reload-git-commit(); }
            confirm => { root.confirm-git-commit(); }
            dismiss => { root.git-commit-open = false; }
            push => { root.git-commit-open = false; root.open-git-push(); }
        }
    }

    git-push-dialog := Dialog {
        title <- @tr("push-commit");
        open <-> root.git-push-open;
        width <- 507px;
        height <- 397px + (root.git-push-error != "" ? 46px : 0px);
        close-on-outside <- false;
        close-on-escape <- !root.git-push-pending;
        GitPushContent {
            loading <- root.git-push-loading;
            pending <- root.git-push-pending;
            done <- root.git-push-done;
            source <- root.git-push-source;
            commit-id <- root.git-push-commit;
            remotes <- root.git-push-remotes;
            remote <-> root.git-push-remote;
            address <- root.git-push-address;
            target <-> root.git-push-target;
            track <-> root.git-push-track;
            error <- root.git-push-error;
            confirm-enabled <- root.can-confirm-git-push;
            reload => { root.reload-git-push(); }
            remote-selected => { root.select-git-push-remote(); }
            confirm => { root.confirm-git-push(); }
            dismiss => { root.git-push-open = false; }
            create-pr => { root.git-push-open = false; root.open-git-pr(true); }
        }
    }

    git-branch-dialog := Dialog {
        title <- @tr("local-git-branches");
        open <-> root.git-branch-open;
        width <- 486px;
        height <- (root.git-branch-done ? 245px : root.git-branch-mode == "create" ? 306px : 421px)
            + (root.git-branch-error != "" ? 40px : 0px);
        close-on-outside <- false;
        close-on-escape <- !root.git-branch-pending;
        GitBranchContent {
            location <- root.git-checkout-label;
            detached <- root.git-checkout-detached;
            mode <-> root.git-branch-mode;
            query <-> root.git-branch-query;
            new-name <-> root.git-branch-new-name;
            loading <- root.git-branch-loading;
            pending <- root.git-branch-pending;
            done <- root.git-branch-done;
            ready <- root.can-confirm-git-branch;
            error <- root.git-branch-error;
            filter(text) => { root.filter-git-branches(text); }
            confirm => { root.confirm-git-branch(); }
            reload => { root.reload-git-branches(); }
            dismiss => { root.git-branch-open = false; }
            slot branches {
                git-branch-list := ListView {
                    height <- 139px;
                    row-height <- 29px;
                    accessible-name <- @tr("local-git-branches");
                    background <- Palette.rail;
                    for branch in root.git-branch-choices : GitBranchRow {
                        name <- branch.name;
                        state <- branch.state;
                        selected <- root.git-branch-target == branch.name;
                        available <- !root.git-branch-loading && !root.git-branch-pending;
                        choose => { root.git-branch-target = branch.name; }
                    }
                }
            }
        }
    }

    git-pr-dialog := Dialog {
        title <- @tr("create-git-pr");
        open <-> root.git-pr-open;
        width <- 535px;
        height <- root.git-pr-url != "" ? 265px + (root.git-pr-error != "" ? 32px : 0px) :
            430px + (root.git-pr-error != "" ? 32px : 0px);
        close-on-outside <- false;
        close-on-escape <- !root.git-pr-pending;
        PullRequestContent {
            source <- root.git-pr-source;
            repositories <- root.git-pr-repositories;
            repository <-> root.git-pr-repo;
            branch <-> root.git-pr-branch;
            heading <-> root.git-pr-title;
            body <-> root.git-pr-body;
            draft <-> root.git-pr-draft;
            loading <- root.git-pr-loading;
            pending <- root.git-pr-pending;
            ready <- root.can-confirm-git-pr;
            error <- root.git-pr-error;
            url <- root.git-pr-url;
            existing <- root.git-pr-existing;
            copied <- root.git-pr-copied;
            reload => { root.reload-git-pr(); }
            repository-changed => { root.select-git-pr-repo(); }
            confirm => { root.confirm-git-pr(); }
            copy-link => { root.copy-git-pr-link(); }
            dismiss => { root.git-pr-open = false; }
        }
    }

    review-revert-dialog := Dialog {
        title <- root.review-revert-file ? @tr("revert-unstaged-file-changes") : @tr("revert-diff-hunk");
        open <-> root.review-revert-open;
        width <- 586px;
        height <- 372px + (root.review-revert-error != "" ? 32px : 0px);
        close-on-outside <- false;
        ReviewRevertContent {
            confirm-review-revert => { root.confirm-review-revert(); }
            review-index-busy <- root.review-index-busy;
            review-revert-error <- root.review-revert-error;
            review-revert-open <-> root.review-revert-open;
            review-revert-path <- root.review-revert-path;
            review-revert-preview <- root.review-revert-preview;
            switching <- root.switching;
        }
    }

    staged-review-notes-dialog := Dialog {
        title <- @tr("pending-review-comments");
        open <-> root.review-notes-open;
        width <- 568px;
        height <- 166px + Math.min(root.review-note-count, 4) * 58px;
        VerticalLayout {
            alignment <- start;
            padding <- 12px;
            spacing <- 8px;
            Label {
                text <- @tr("no-pending-comments");
                visible <- root.review-note-count == 0;
                height <- 28px;
                color <- Palette.muted;
            }
            staged-review-notes-list := ListView {
                height <- Math.min(root.review-note-count, 4) * 58px;
                row-height <- 58px;
                row-key-field <- "id";
                current-key <- -1;
                visible <- root.review-note-count > 0;
                accessible-name <- @tr("pending-review-comments");
                background <- Palette.surface;
                for note in root.review-notes : StagedReviewNoteTile {
                    reference <- note.reference;
                    body <- note.text;
                    can-edit <- !root.switching && Strings.trim(root.review-note-text) == "";
                    can-remove <- !root.switching && root.review-note-queued-id != note.id;
                    edit => { root.edit-staged-review-note(note.id); }
                    remove => { root.remove-staged-review-note(note.id); }
                }
            }
            HorizontalLayout {
                height <- 33px;
                alignment <- end;
                spacing <- 7px;
                close-staged-review-notes := Button {
                    text <- @tr("back-to-review");
                    height <- 33px;
                    padding <- 6px;
                    flat <- true;
                    clicked => { root.review-notes-open = false; }
                }
                apply-staged-review-notes-button := Button {
                    text <- @tr("add-all-to-draft");
                    height <- 33px;
                    padding <- 6px;
                    primary <- true;
                    enabled <- !root.switching && !root.conversation-archived && root.review-note-count > 0 && root.review-note-queued-id < 0;
                    clicked => { root.apply-staged-review-notes(); }
                }
            }
        }
    }

    review-line-edit-dialog := Dialog {
        title <- @tr("edit-workspace-line");
        open <-> root.review-line-edit-open;
        width <- 565px;
        height <- 300px + (root.review-line-edit-error != "" ? 32px : 0px);
        close-on-escape <- !root.review-line-edit-busy && !root.review-line-edit-dirty;
        close-on-outside <- false;
        Shortcut {
            sequence <- "Primary+S";
            focus-within <- true;
            enabled <- root.can-save-review-line;
            activated => { root.save-review-line-edit(); }
        }
        review-line-edit-dialog-content := ReviewLineEditContent {
            can-save-review-line <- root.can-save-review-line;
            review-line-edit-busy <- root.review-line-edit-busy;
            review-line-edit-dirty <- root.review-line-edit-dirty;
            review-line-edit-error <- root.review-line-edit-error;
            review-line-edit-location <- root.review-line-edit-location;
            review-line-edit-open <-> root.review-line-edit-open;
            review-line-edit-ready <- root.review-line-edit-ready;
            review-line-edit-text <-> root.review-line-edit-text;
            save-review-line-edit => { root.save-review-line-edit(); }
        }
    }

    historical-prompt-dialog := HistoricalPromptDialog {
        can-fork <- root.can-fork;
        conversation-archived <- root.conversation-archived;
        draft <-> root.draft;
        fork-error <- root.fork-error;
        fork-pending <- root.fork-pending;
        historical-prompt-error <- root.historical-prompt-error;
        historical-prompt-fork-requested <- root.historical-prompt-fork-requested;
        historical-prompt-has-attachments <- root.historical-prompt-has-attachments;
        historical-prompt-open <-> root.historical-prompt-open;
        historical-prompt-text <-> root.historical-prompt-text;
        historical-prompt-turn <- root.historical-prompt-turn;
        switching <- root.switching;
        end-composer-recall => { root.end-composer-recall(); }
        focus-composer => { root.focus-composer(); }
        fork-historical-prompt(turn, text) => { root.fork-historical-prompt(turn, text); }
    }

    message-quote-dialog := MessageQuoteDialog {
        conversation-archived <- root.conversation-archived;
        message-quote-body <- root.message-quote-body;
        message-quote-open <-> root.message-quote-open;
        switching <- root.switching;
        quote-message(selected) => { root.quote-message(selected); }
    }

    handoff-dialog := Dialog {
        title <- root.handoff-to-local ? @tr("handoff-to-local") : @tr("handoff-to-worktree");
        open <-> root.handoff-open;
        width <- 510px;
        height <- 347px + (root.handoff-error != "" ? 38px : 0px);
        close-on-outside <- false;
        close-on-escape <- !root.handoff-preparing && !root.handoff-pending;
        HandoffContent {
            source <- root.workspace;
            source-commit <- root.handoff-source-commit;
            destination <- root.handoff-destination;
            copy <-> root.handoff-copy;
            can-copy <- root.handoff-can-copy;
            include-count <- root.handoff-include-count;
            loading <- root.handoff-loading;
            ready <- root.can-confirm-handoff;
            preparing <- root.handoff-preparing;
            pending <- root.handoff-pending;
            prepared <- root.handoff-prepared;
            error <- root.handoff-error;
            confirm => { root.confirm-handoff(); }
            reload => { root.reload-handoff(); }
            cancel => { root.handoff-open = false; }
        }
    }

    worktree-start-dialog := Dialog {
        title <- @tr("choose-conversation-location");
        open <-> root.worktree-start-open;
        width <- 485px;
        height <- 293px + (root.worktree-start-error != "" ? 47px : 0px)
            + (Model.count(root.worktree-start-environments) > 0 ? 43px : 0px)
            + (root.worktree-start-script != "" ? 101px : 0px);
        WorktreeStartContent {
            choices <- root.worktree-start-choices;
            base <-> root.worktree-start-base;
            commit-id <- root.worktree-start-commit;
            can-copy <- root.worktree-start-can-copy;
            include-count <- root.worktree-start-include-count;
            copy <-> root.worktree-start-copy;
            loading <- root.worktree-start-loading;
            error <- root.worktree-start-error;
            environments <- root.worktree-start-environments;
            environment <-> root.worktree-start-environment;
            script <- root.worktree-start-script;
            select-base => { root.select-worktree-start-base(); }
            select-environment => { root.select-worktree-start-environment(); }
            configure(isolated) => { root.configure-worktree-start(isolated); }
            cancel => { root.worktree-start-open = false; root.focus-composer(); }
        }
    }

    worktree-setup-log := WorktreeSetupLog {
        log-open <-> root.worktree-setup-log-open;
        output <- root.worktree-setup-output;
    }

    fork-dialog := Dialog {
        title <- @tr("fork-conversation");
        open <-> root.fork-open;
        close-on-escape <- !root.fork-pending && !root.worktree-preparing;
        close-on-outside <- false;
        width <- 438px;
        height <- 268px + (root.fork-worktree ? 36px : 0px) +
            (root.fork-error != "" || root.worktree-error != "" ? 64px : 0px);
        VerticalLayout {
            alignment <- start;
            padding <- 12px;
            spacing <- 7px;
            Label { text <- @tr("history-to-include"); font-size <- 12px; color <- Palette.muted; }
            fork-turn-choice := ComboBox {
                height <- 34px;
                model <- root.fork-choices;
                text-role <- "label";
                value-role <- "key";
                current-value <-> root.fork-cutoff;
                accessible-name <- @tr("select-how-much-conversation-history-to-include");
                enabled <- !root.fork-pending && !root.worktree-preparing;
            }
            Label { text <- @tr("fork-name"); font-size <- 12px; color <- Palette.muted; }
            fork-name-field := LineEdit {
                height <- 34px;
                accessible-name <- @tr("forked-conversation-name");
                placeholder-text <- root.conversation-title + (" " + @tr("fork-suffix"));
                text <-> root.fork-name;
                maximum-length <- 72;
                enabled <- !root.fork-pending && !root.worktree-preparing;
                accepted => { root.create-fork(root.fork-name, root.fork-cutoff, root.fork-worktree, root.fork-copy-changes); }
            }
            choose-worktree := CheckBox {
                text <- @tr("separate-git-worktree-from-head");
                height <- 28px;
                enabled <- root.worktree-available && !root.fork-pending && !root.worktree-preparing;
                checked <-> root.fork-worktree;
            }
            copy-worktree-changes := CheckBox {
                text <- @tr("include-tracked-changes-from-the-original-worktree");
                height <- 28px;
                visible <- root.fork-worktree;
                enabled <- !root.fork-pending && !root.worktree-preparing;
                checked <-> root.fork-copy-changes;
            }
            Text {
                height <- 58px;
                text <- root.worktree-error == "" ? root.fork-error : root.worktree-error;
                color <- Palette.error;
                font-size <- 11px;
                wrap <- char-wrap;
                visible <- root.fork-error != "" || root.worktree-error != "";
            }
            HorizontalLayout {
                height <- 33px;
                alignment <- end;
                spacing <- 8px;
                cancel-fork := Button {
                    text <- @tr("cancel");
                    height <- 33px;
                    padding <- 6px;
                    flat <- true;
                    enabled <- !root.fork-pending && !root.worktree-preparing;
                    clicked => { root.fork-open = false; }
                }
                submit-fork := Button {
                    text <- root.worktree-preparing ? @tr("preparing-worktree") : root.fork-pending ? @tr("creating") : @tr("create-fork");
                    height <- 33px;
                    padding <- 6px;
                    primary <- true;
                    border-radius <- 7px;
                    enabled <- root.can-fork;
                    clicked => { root.create-fork(root.fork-name, root.fork-cutoff, root.fork-worktree, root.fork-copy-changes); }
                }
            }
        }
    }

    plan-question := Dialog {
        title <- @tr("clarify-the-plan");
        open <- root.question-open && !root.question-deferred;
        close-on-escape <- false;
        close-on-outside <- false;
        width <- 480px;
        height <- Model.count(root.question-options) > 0 && root.question-allows-text ? 278px : 235px;
        VerticalLayout {
            padding <- 12px;
            spacing <- 7px;
            Label {
                text <- root.question-heading;
                color <- Palette.accent;
                font-size <- 12px;
                font-weight <- 650;
                overflow <- elide;
            }
            ScrollView {
                height <- 57px;
                horizontal-scroll-bar-policy <- always-off;
                Text {
                    width <- 100%;
                    text <- root.question-text;
                    wrap <- word-wrap;
                    color <- Palette.text;
                }
            }
            question-option := ComboBox {
                height <- 32px;
                visible <- Model.count(root.question-options) > 0;
                model <- root.question-options;
                text-role <- "label";
                value-role <- "key";
                current-value <-> root.question-choice;
                accessible-name <- @tr("choose-an-answer");
            }
            question-input := LineEdit {
                height <- 34px;
                placeholder-text <- @tr("enter-an-answer");
                accessible-name <- @tr("write-your-own-answer");
                text <-> root.question-draft;
                input-type <- root.question-secret ? InputType.password : InputType.text;
                visible <- root.question-allows-text;
                enabled <- root.question-choice == "";
            }
            HorizontalLayout {
                height <- 33px;
                alignment <- end;
                spacing <- 8px;
                stop-plan := Button {
                    text <- @tr("stop-turn-short");
                    height <- 33px;
                    padding <- 6px;
                    flat <- true;
                    enabled <- root.busy && !root.switching && !root.stopping;
                    clicked => { root.interrupt(); }
                }
                defer-question := Button {
                    text <- @tr("answer-later");
                    height <- 33px;
                    padding <- 6px;
                    flat <- true;
                    clicked => { root.question-deferred = true; }
                }
                skip-question := Button {
                    text <- @tr("skip");
                    height <- 33px;
                    padding <- 6px;
                    flat <- true;
                    enabled <- !root.stopping;
                    clicked => { root.answer-question(root.question-token, root.question-index, "", true); }
                }
                confirm-question := Button {
                    text <- @tr("ok");
                    height <- 33px;
                    padding <- 6px;
                    primary <- true;
                    enabled <- !root.stopping && (root.question-choice != "" || root.question-draft != "");
                    clicked => {
                        root.answer-question(root.question-token, root.question-index,
                            root.question-choice == "" ? root.question-draft : root.question-choice, false);
                    }
                }
            }
        }
    }

    shell := SplitView {
        handle-size <- 4px;
        fill-pane <- content;
        SplitHandle {
            background <- handle-hovered || handle-pressed ? Palette.split-focus : Palette.border;
        }
        rail := Rectangle {
            visible <- root.sessions-open && !root.expanded-inspector;
            preferred-width <- 236px;
            min-width <- 188px;
            max-width <- 310px;
            background <- Palette.rail;
            VerticalLayout {
                padding <- 14px;
                padding-top <- 18px;
                spacing <- 12px;

                HorizontalLayout {
                    height <- 29px;
                    padding-left <- 5px;
                    spacing <- 8px;
                    cross-axis-alignment <- center;
                    WorkbenchIcon {
                        tint <- Palette.accent;
                        shape <- "M4 5 H20 V19 H4 Z M8 5 V19 M10.5 10 H17 M10.5 14 H15";
                    }
                    Label {
                        text <- root.activity-open ? @tr("activity") : @tr("workbench");
                        color <- Palette.text;
                        font-size <- 16px;
                        font-weight <- 700;
                        horizontal-stretch <- 1;
                        min-width <- 0px;
                        overflow <- elide;
                    }
                    activity-toggle := Button {
                        text <- root.activity-open ? @tr("conversations") : @tr("activity");
                        accessible-name <- root.activity-open ? @tr("back-to-project-conversations") : (@tr("view-conversation-activity-with-detail") + " ") + Model.count(root.activity-rows);
                        width <- 30px;
                        height <- 27px;
                        padding <- 4px;
                        flat <- true;
                        background <- root.activity-open || root.activity-waiting > 0 ? Palette.selection : #00000000;
                        ButtonContent {
                            CenteredWorkbenchIcon {
                                shape <- root.activity-open ? "M4 5 H20 V16 H9 L4 20 Z M8 9 H16 M8 12 H14" :
                                    "M3 12 H7 L10 6 L14 18 L17 12 H21";
                            }
                        }
                        Tooltip { text <- root.activity-open ? @tr("conversations") : @tr("activity"); }
                        clicked => { root.toggle-activity(); }
                    }
                    open-palette-button := Button {
                        text <- @tr("commands");
                        accessible-name <- @tr("open-command-palette");
                        width <- 30px;
                        height <- 27px;
                        padding <- 4px;
                        enabled <- root.can-open-palette;
                        flat <- true;
                        ButtonContent {
                            CenteredWorkbenchIcon {
                                shape <- "M8 9 V6 C8 3 4 3 4 6 C4 8 5 9 7 9 H17 C19 9 20 8 20 6 C20 3 16 3 16 6 V18 C16 21 20 21 20 18 C20 16 19 15 17 15 H7 C5 15 4 16 4 18 C4 21 8 21 8 18 Z";
                            }
                        }
                        Tooltip { text <- @tr("open-command-palette"); }
                        clicked => { root.open-workbench-palette(false); }
                    }
                }
                VerticalLayout {
                    visible <- !root.activity-open;
                    vertical-stretch <- 1;
                    spacing <- 12px;
                    reset := Button {
                        text <- @tr("new-conversation");
                        height <- 35px;
                        border-radius <- 8px;
                        background <- self.pressed ? Palette.pressed-selection : Palette.selection;
                        enabled <- root.can-switch-conversation && root.workspace != "";
                        ButtonContent {
                            HorizontalLayout {
                                padding-left <- 9px;
                                spacing <- 8px;
                                cross-axis-alignment <- center;
                                WorkbenchIcon { tint <- Palette.accent; shape <- "M12 5 V19 M5 12 H19"; }
                                Label { text <- @tr("new-conversation"); color <- Palette.text; horizontal-stretch <- 1; font-weight <- 650; }
                            }
                        }
                        clicked => { root.new-conversation(); }
                    }
                    VerticalLayout {
                        spacing <- 5px;
                        HorizontalLayout {
                            height <- 23px;
                            cross-axis-alignment <- center;
                            Label {
                                text <- @tr("projects");
                                color <- Palette.muted;
                                font-size <- 12px;
                                horizontal-stretch <- 1;
                            }
                            project-groups-toggle := Button {
                                text <- root.project-groups-open ? @tr("current-project") : @tr("all-projects");
                                accessible-name <- root.project-groups-open ? @tr("browse-conversations-in-the-current-project") : @tr("browse-conversations-by-project");
                                height <- 22px;
                                flat <- true;
                                padding <- 3px;
                                font-size <- 11px;
                                enabled <- Model.count(root.project-choices) > 0;
                                clicked => {
                                    root.project-groups-open = !root.project-groups-open;
                                    if root.project-groups-open {
                                        root.show-project-groups();
                                        if root.project-search-active && !root.project-search-ready { project-search-debounce.restart(); }
                                        project-group-tree.focus();
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height <- 34px;
                            spacing <- 6px;
                            cross-axis-alignment <- center;
                            project-choice := ComboBox {
                                visible <- Model.count(root.project-choices) > 0;
                                accessible-name <- @tr("switch-project");
                                enabled <- root.can-switch-conversation;
                                model <- root.project-choices;
                                text-role <- "label";
                                value-role <- "key";
                                current-value <-> root.project-selection;
                                min-width <- 0px;
                                height <- 34px;
                                horizontal-stretch <- 1;
                                ComboPopup {
                                    width <- 300px;
                                    border-color <- Palette.border;
                                    border-radius <- 8px;
                                    scroll-indicator <- true;
                                }
                                value-selected(path) => { root.select-workspace(path); }
                            }
                            Label {
                                text <- @tr("no-projects-added");
                                color <- Palette.muted;
                                font-size <- 12px;
                                horizontal-stretch <- 1;
                                visible <- Model.count(root.project-choices) == 0;
                            }
                            open-folder := Button {
                                text <- @tr("add-project");
                                accessible-name <- @tr("add-project-folder");
                                width <- 34px;
                                height <- 34px;
                                border-radius <- 7px;
                                border-color <- Palette.border;
                                border-width <- 1px;
                                background <- self.pressed ? Palette.selection : Palette.surface;
                                enabled <- root.can-switch-conversation;
                                ButtonContent {
                                    WorkbenchIcon {
                                        tint <- Palette.accent;
                                        shape <- "M3 7 H9 L11 9 H21 V20 H3 Z M12 11 V17 M9 14 H15";
                                    }
                                }
                                clicked => { picker.open(); }
                            }
                        }
                        Label {
                            text <- root.project-status;
                            color <- Palette.error;
                            font-size <- 11px;
                            overflow <- elide;
                            visible <- root.project-status != "";
                        }
                        Label {
                            text <- root.sidebar-action-status;
                            color <- Palette.muted;
                            font-size <- 11px;
                            overflow <- elide;
                            visible <- root.sidebar-action-status != "";
                        }
                    }
                    VerticalLayout {
                        spacing <- 12px;
                        vertical-stretch <- 1;
                        visible <- !root.project-groups-open;
                        Rectangle { height <- 1px; background <- Palette.border; }
                        HorizontalLayout {
                            height <- 26px;
                            spacing <- 4px;
                            cross-axis-alignment <- center;
                            active-sessions := Button {
                                text <- @tr("conversations");
                                accessible-name <- @tr("view-active-conversations");
                                height <- 26px;
                                padding <- 5px;
                                border-radius <- 6px;
                                font-size <- 11px;
                                flat <- true;
                                background <- root.archive-view ? #00000000 : Palette.selection;
                                enabled <- root.connected && root.workspace != "" && !root.archive-pending;
                                clicked => {
                                    if root.archive-view {
                                        root.view-archived-sessions(false);
                                    }
                                }
                            }
                            archived-sessions := Button {
                                text <- @tr("archived");
                                accessible-name <- @tr("view-archived-conversations");
                                height <- 26px;
                                padding <- 5px;
                                border-radius <- 6px;
                                font-size <- 11px;
                                flat <- true;
                                background <- root.archive-view ? Palette.selection : #00000000;
                                enabled <- root.connected && root.workspace != "" && !root.archive-pending;
                                clicked => {
                                    if !root.archive-view {
                                        root.view-archived-sessions(true);
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch <- 1; }
                            refresh-sessions := Button {
                                text <- root.history-loading ? @tr("loading") : @tr("refresh");
                                accessible-name <- @tr("refresh-workspace-conversations");
                                height <- 26px;
                                padding <- 4px;
                                font-size <- 11px;
                                flat <- true;
                                enabled <- root.connected && root.workspace != "" && !root.history-loading && root.session-search-text == root.history-query;
                                clicked => { root.load-session-history(false); }
                            }
                        }
                        session-search := SearchField {
                            accessible-name <- @tr("search-workspace-conversations");
                            placeholder-text <- @tr("search-conversations");
                            height <- 34px;
                            text <-> root.session-search-text;
                            live <- true;
                            enabled <- root.connected && root.workspace != "";
                            search-triggered(query) => { search-debounce.restart(); }
                        }
                        Label {
                            text <- root.session-search-text != root.history-query ? @tr("searching") :
                                root.history-status != "" ? root.history-status :
                                root.history-loading ? @tr("loading") :
                                root.history-query != "" ? @tr("no-matching-conversations") : @tr("no-archived-conversations");
                            color <- Palette.muted;
                            font-size <- 11px;
                            visible <- root.session-search-text != root.history-query || root.history-status != "" ||
                                (root.history-query != "" || root.archive-view) &&
                                (root.history-loading || root.history-hit-count == 0);
                            overflow <- elide;
                        }
                        Label {
                            text <- root.pin-status;
                            visible <- root.pin-status != "";
                            color <- Palette.error;
                            font-size <- 11px;
                            overflow <- elide;
                        }
                        pinned-sessions-title := Label {
                            text <- @tr("pin");
                            visible <- root.pinned-count > 0 && root.session-search-text == root.history-query;
                            color <- Palette.muted;
                            font-size <- 11px;
                            font-weight <- 650;
                        }
                        pinned-session-list := ListView {
                            height <- Math.min(root.pinned-count, 3) * 38px;
                            row-height <- 38px;
                            row-key-field <- "id";
                            row-visible-field <- "pinned-shown";
                            current-key <- -1;
                            enabled <- root.can-switch-conversation;
                            visible <- root.pinned-count > 0 && root.session-search-text == root.history-query;
                            background <- #00000000;
                            accessible-name <- @tr("pinned-conversations");
                            for row in root.conversations : ConversationTile {
                                menu-rename <- root.session-menu-flag(row.id, "rename");
                                menu-pin <- root.session-menu-flag(row.id, "pin");
                                menu-archive <- root.session-menu-flag(row.id, "archive");
                                menu-pinned <- root.session-menu-flag(row.id, "pinned");
                                menu-archived <- root.session-menu-flag(row.id, "archived");
                                manage(action) => { root.manage-sidebar-session(row.id, action); }
                                heading <- row.title;
                                folder <- row.folder;
                                activity <- row.activity;
                                pinned <- true;
                                selected <- row.id == root.conversation-id;
                                choose => { root.select-conversation(row.id); }
                            }
                        }
                        session-list := ListView {
                            vertical-stretch <- 1;
                            row-height <- 44px;
                            row-key-field <- "id";
                            row-visible-field <- "shown";
                            current-key <- -1;
                            enabled <- root.can-switch-conversation;
                            visible <- root.session-search-text == root.history-query;
                            background <- #00000000;
                            accessible-name <- @tr("conversation-list");
                            for row in root.conversations : ConversationTile {
                                menu-rename <- root.session-menu-flag(row.id, "rename");
                                menu-pin <- root.session-menu-flag(row.id, "pin");
                                menu-archive <- root.session-menu-flag(row.id, "archive");
                                menu-pinned <- root.session-menu-flag(row.id, "pinned");
                                menu-archived <- root.session-menu-flag(row.id, "archived");
                                manage(action) => { root.manage-sidebar-session(row.id, action); }
                                heading <- row.title;
                                folder <- row.folder;
                                activity <- row.activity;
                                pinned <- row.pinned;
                                selected <- row.id == root.conversation-id;
                                choose => { root.select-conversation(row.id); }
                            }
                        }
                        more-sessions := Button {
                            text <- root.history-query != "" ? @tr("more-results") : root.archive-view ? @tr("more-archived") : @tr("more-conversations");
                            height <- 30px;
                            padding <- 5px;
                            flat <- true;
                            visible <- root.history-more && root.session-search-text == root.history-query;
                            enabled <- root.connected && !root.history-loading;
                            clicked => { root.load-session-history(true); }
                        }
                    }
                    VerticalLayout {
                        visible <- root.project-groups-open;
                        spacing <- 8px;
                        vertical-stretch <- 1;
                        project-search-field := SearchField {
                            accessible-name <- @tr("search-all-project-conversations");
                            placeholder-text <- @tr("search-all-projects");
                            height <- 33px;
                            text <-> root.project-search-input;
                            live <- true;
                            enabled <- root.connected;
                            search-triggered(query) => { project-search-debounce.restart(); }
                        }
                        HorizontalLayout {
                            height <- 25px;
                            spacing <- 4px;
                            visible <- root.project-search-active;
                            project-search-active-button := Button {
                                text <- @tr("active");
                                accessible-name <- @tr("search-active-conversations");
                                height <- 25px;
                                padding <- 3px;
                                flat <- true;
                                border-radius <- 5px;
                                background <- !root.project-search-archived ? Palette.selection : #00000000;
                                enabled <- root.connected;
                                clicked => {
                                    if root.project-search-archived {
                                        root.project-search-archived = false;
                                        project-search-debounce.stop();
                                        root.search-all-projects(root.project-search-term, false, false);
                                    }
                                }
                            }
                            project-search-archived-button := Button {
                                text <- @tr("archived");
                                accessible-name <- @tr("search-archived-conversations");
                                height <- 25px;
                                padding <- 3px;
                                flat <- true;
                                border-radius <- 5px;
                                background <- root.project-search-archived ? Palette.selection : #00000000;
                                enabled <- root.connected;
                                clicked => {
                                    if !root.project-search-archived {
                                        root.project-search-archived = true;
                                        project-search-debounce.stop();
                                        root.search-all-projects(root.project-search-term, true, false);
                                    }
                                }
                            }
                        }
                        Label {
                            text <- !root.connected ? @tr("codex-disconnected") :
                                !root.project-search-ready || root.project-search-loading ? @tr("searching") :
                                root.project-search-status != "" ? root.project-search-status : @tr("no-conversations-found");
                            color <- Palette.muted;
                            font-size <- 11px;
                            height <- 22px;
                            overflow <- elide;
                            visible <- root.project-search-active && (!root.connected || !root.project-search-ready || root.project-search-loading ||
                                root.project-search-status != "" || Model.count(root.project-search-results) == 0);
                        }
                        project-search-results := ListView {
                            row-height <- 48px;
                            vertical-stretch <- 1;
                            row-key-field <- "id";
                            current-key <- -1;
                            background <- #00000000;
                            accessible-name <- @tr("cross-project-conversation-search-results");
                            enabled <- root.can-switch-conversation;
                            visible <- root.project-search-active && root.project-search-ready;
                            for row in root.project-search-results : ConversationTile {
                                menu-rename <- root.session-menu-flag(row.id, "rename");
                                menu-pin <- root.session-menu-flag(row.id, "pin");
                                menu-archive <- root.session-menu-flag(row.id, "archive");
                                menu-pinned <- root.session-menu-flag(row.id, "pinned");
                                menu-archived <- root.session-menu-flag(row.id, "archived");
                                manage(action) => { root.manage-sidebar-session(row.id, action); }
                                stacked-detail <- true;
                                heading <- row.title;
                                folder <- row.folder;
                                activity <- row.activity;
                                pinned <- row.pinned;
                                selected <- row.id == root.conversation-id;
                                choose => { root.select-conversation(row.id); }
                            }
                        }
                        more-project-search := Button {
                            text <- root.project-search-more ? @tr("load-more-results") : @tr("retry-search");
                            height <- 28px;
                            padding <- 5px;
                            flat <- true;
                            visible <- root.project-search-active && root.project-search-ready
                                && (root.project-search-more || root.project-search-status != "");
                            enabled <- root.connected && !root.project-search-loading;
                            clicked => { root.search-all-projects(root.project-search-term, root.project-search-archived, root.project-search-more); }
                        }
                        project-group-tree := TreeView {
                            visible <- root.project-groups-open && !root.project-search-active;
                            vertical-stretch <- 1;
                            row-height <- 31px;
                            indentation <- 12px;
                            preserve-scroll-anchor <- true;
                            current-key <-> root.project-group-key;
                            background <- #00000000;
                            accessible-name <- @tr("conversations-across-all-projects");
                            enabled <- !root.switching;
                            expanded(key) => { root.expand-project-group(key); }
                            changed(index) => { root.activate-project-group-row(root.project-group-key); }
                            for row in root.project-groups : TreeRow {
                                key <- row.key;
                                parent-key <- row.parent;
                                HorizontalLayout {
                                    spacing <- 5px;
                                    padding-right <- 6px;
                                    cross-axis-alignment <- center;
                                    WorkbenchIcon {
                                        width <- 14px;
                                        height <- 14px;
                                        visible <- row.kind == "project" || row.kind == "thread";
                                        tint <- row.selected ? Palette.accent : Palette.muted;
                                        shape <- row.kind == "project" ? "M3 7 H9 L11 9 H21 V20 H3 Z" :
                                            "M4 5 H20 V16 H9 L4 20 Z";
                                    }
                                    TreeCell {
                                        text <- row.title;
                                        height <- 27px;
                                        horizontal-stretch <- 1;
                                        color <- row.selected ? Palette.accent :
                                            row.kind == "status" ? Palette.muted : Palette.text;
                                    }
                                    Label {
                                        text <- row.detail;
                                        visible <- row.detail != "";
                                        font-size <- 10px;
                                        color <- Palette.muted;
                                        max-width <- 71px;
                                        overflow <- elide;
                                    }
                                    Button {
                                        text <- "⋯";
                                        accessible-name <- (@tr("manage-conversation") + " ") + row.title;
                                        width <- 23px;
                                        height <- 25px;
                                        padding <- 2px;
                                        flat <- true;
                                        checkable <- true;
                                        checked <- root.sidebar-menu-open && root.sidebar-menu-target == row.conversation;
                                        visible <- row.kind == "thread" && root.sidebar-menu-available(row.conversation);
                                        clicked => {
                                            root.sidebar-menu-target = row.conversation;
                                            root.sidebar-menu-title = row.title;
                                            root.sidebar-menu-open = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                activity-panel := VerticalLayout {
                    visible <- root.activity-open;
                    min-height <- 120px;
                    vertical-stretch <- 1;
                    spacing <- 8px;
                    Shortcut {
                        sequence <- "Escape";
                        focus-within <- true;
                        enabled <- root.activity-open;
                        activated => { root.close-activity(); }
                    }
                    activity-filter-choice := ComboBox {
                        height <- 32px;
                        model <- root.activity-filters;
                        current-value <-> root.activity-filter;
                        text-role <- "label";
                        value-role <- "key";
                        accessible-name <- @tr("filter-conversation-activity");
                    }
                    activity-empty := Label {
                        text <- root.activity-filter == "" ? @tr("no-conversations-need-attention") : @tr("no-matching-conversations");
                        color <- Palette.muted;
                        font-size <- 12px;
                        visible <- Model.count(root.visible-activity) == 0;
                    }
                    activity-list := ListView {
                        vertical-stretch <- 1;
                        row-height <- 52px;
                        row-key-field <- "id";
                        preserve-scroll-anchor <- true;
                        current-key <- -1;
                        background <- #00000000;
                        accessible-name <- @tr("conversation-activity-across-projects");
                        enabled <- root.can-switch-conversation;
                        for row in root.visible-activity : ActivityTile {
                            heading <- row.title;
                            project <- row.project;
                            activity <- row.activity;
                            selected <- row.id == root.conversation-id;
                            choose => { root.select-conversation(row.id); }
                        }
                    }
                    HorizontalLayout {
                        height <- 30px;
                        spacing <- 6px;
                        alignment <- end;
                        mark-activity-read-button := Button {
                            text <- @tr("mark-all-as-read");
                            height <- 30px;
                            flat <- true;
                            padding <- 5px;
                            visible <- root.activity-updated > 0;
                            clicked => { root.mark-activity-read(); activity-filter-choice.focus(); }
                        }
                        open-notification-settings-button := Button {
                            text <- @tr("notifications");
                            accessible-name <- @tr("open-notification-settings");
                            height <- 30px;
                            width <- 44px;
                            flat <- true;
                            padding <- 5px;
                            clicked => { root.open-notification-settings(); }
                        }
                    }
                }
                HorizontalLayout {
                    height <- 32px;
                    padding-left <- 4px;
                    spacing <- 7px;
                    cross-axis-alignment <- center;
                    Rectangle {
                        width <- 7px;
                        height <- 7px;
                        border-radius <- 4px;
                        background <- root.connected ? Palette.online : Palette.offline;
                    }
                    Label {
                        text <- root.connected ? @tr("local-codex-connected") : @tr("codex-disconnected");
                        color <- Palette.muted;
                        font-size <- 12px;
                        horizontal-stretch <- 1;
                        overflow <- elide;
                    }
                    open-appearance := Button {
                        text <- @tr("appearance");
                        accessible-name <- @tr("change-workbench-appearance");
                        width <- 30px;
                        height <- 28px;
                        padding <- 4px;
                        flat <- true;
                        enabled <- root.can-open-palette && !root.palette-open;
                        ButtonContent {
                            CenteredWorkbenchIcon {
                                shape <- "M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M5 5 L7 7 M17 17 L19 19 M5 19 L7 17 M17 7 L19 5 M17 12 A5 5 0 1 1 7 12 A5 5 0 1 1 17 12";
                            }
                        }
                        Tooltip { text <- @tr("appearance"); }
                        clicked => { root.appearance-open = true; }
                    }
                }
            }
        }

        content := Rectangle {
            visible <- !root.expanded-inspector;
            min-width <- root.review-open ? 360px : 0px;
            background <- Palette.canvas;
            VerticalLayout {
                spacing <- 0px;

                conversation-tab-strip := Rectangle {
                    height <- 36px;
                    visible <- root.show-conversation-tabs;
                    background <- Palette.rail;
                    VerticalLayout {
                        spacing <- 0px;
                        HorizontalLayout {
                            height <- 35px;
                            padding-left <- 10px;
                            padding-right <- 14px;
                            spacing <- 7px;
                            cross-axis-alignment <- center;
                            open-conversation-tabs := TabBar {
                                height <- 34px;
                                min-width <- 0px;
                                horizontal-stretch <- 1;
                                background <- Palette.rail;
                                accessible-name <- @tr("open-conversations");
                                enabled <- root.can-use-conversation-tabs;
                                current-value <-> root.conversation-tab;
                                tabs-closable <- true;
                                reorderable <- true;
                                changed(index) => { root.select-conversation-tab(root.conversation-tab); }
                                tab-close-requested(index, value) => { root.close-conversation-tab(value); }
                                tab-moved(from, to) => { root.reorder-conversation-tabs(from, to); }
                                for tab in root.conversation-tabs : TabButton {
                                    text <- tab.title + (tab.activity == "" ? "" : "  •");
                                    value <- tab.id;
                                    max-width <- 204px;
                                    accessible-name <- tab.title + " · " + tab.workspace +
                                        (tab.archived ? (" " + @tr("archived-suffix")) :
                                            tab.activity == "running" ? (" " + @tr("running-suffix")) :
                                            tab.activity == "needs-input" ? (" " + @tr("needs-input-suffix")) :
                                            tab.activity == "updated" ? (" " + @tr("updated-suffix")) : "");
                                }
                            }
                            new-conversation-tab := Button {
                                text <- @tr("new-conversation");
                                accessible-name <- @tr("new-conversation-in-current-workspace");
                                width <- 31px;
                                height <- 28px;
                                flat <- true;
                                padding <- 3px;
                                enabled <- root.can-use-conversation-tabs && root.workspace != "";
                                ButtonContent { CenteredWorkbenchIcon { shape <- "M12 5 V19 M5 12 H19"; } }
                                Tooltip { text <- @tr("new-conversation"); }
                                clicked => { root.new-conversation(); }
                            }
                        }
                        Rectangle { height <- 1px; background <- Palette.border; }
                    }
                }
                conversation-header := ConversationHeader {
                    can-fork <- root.can-fork;
                    can-manage-current-conversation <- root.can-manage-current-conversation;
                    can-open-handoff <- root.can-open-handoff;
                    can-open-palette <- root.can-open-palette;
                    can-pin-session <- root.can-pin-session;
                    can-start-code-review <- root.can-start-code-review;
                    can-travel <- root.can-travel;
                    conversation-archived <- root.conversation-archived;
                    conversation-menu-open <-> root.conversation-menu-open;
                    conversation-pinned <- root.conversation-pinned;
                    conversation-title <- root.conversation-title;
                    external-open-pending <- root.external-open-pending;
                    external-project-in-menu <- root.external-project-in-menu;
                    files-active <- root.files-active;
                    git-branch-in-menu <- root.git-branch-in-menu;
                    git-checkout-detached <- root.git-checkout-detached;
                    git-checkout-label <- root.git-checkout-label;
                    navigation-back <- root.navigation-back;
                    navigation-forward <- root.navigation-forward;
                    palette-open <- root.palette-open;
                    renamable <- root.renamable;
                    rename-draft <-> root.rename-draft;
                    rename-open <-> root.rename-open;
                    review-open <- root.review-open;
                    sessions-open <-> root.sessions-open;
                    show-header-code-review <- root.show-header-code-review;
                    show-navigation <- root.show-navigation;
                    switching <- root.switching;
                    terminal-open <- root.terminal-open;
                    workspace <- root.workspace;
                    close-inspector => { root.close-inspector(); }
                    navigate-conversation(forward) => { root.navigate-conversation(forward); }
                    open-fork(cutoff) => { root.open-fork(cutoff); }
                    open-git-branches => { root.open-git-branches(); }
                    open-handoff => { root.open-handoff(); }
                    open-review-scope => { root.open-review-scope(); }
                    present-external(origin, path, line, column) => { root.present-external(origin, path, line, column); }
                    set-session-archived(archived) => { root.set-session-archived(archived); }
                    set-session-pinned(pinned) => { root.set-session-pinned(pinned); }
                    show-workspace-files => { root.show-workspace-files(); }
                    toggle-review => { root.toggle-review(); }
                    toggle-terminal => { root.toggle-terminal(); }
                    focus-rename => { rename-dialog-content.focus-input(); }
                }
                Rectangle { height <- 1px; background <- Palette.border; }

                chat-find-bar := ConversationFindBar {
                    busy <- root.busy;
                    chat-find-count <- root.chat-find-count;
                    chat-find-open <- root.chat-find-open;
                    chat-find-position <- root.chat-find-position;
                    chat-find-query <-> root.chat-find-query;
                    chat-find-ready <- root.chat-find-ready;
                    connected <- root.connected;
                    earlier-turns <- root.earlier-turns;
                    switching <- root.switching;
                    close-chat-find => { root.close-chat-find(); }
                    load-earlier-turns => { root.load-earlier-turns(); }
                    move-chat-find(step) => { root.move-chat-find(step); }
                    query-edited => { chat-find-debounce.restart(); }
                    return-to-input => { input.focus(); }
                }

                Rectangle {
                    vertical-stretch <- 1;
                    min-height <- root.has-attachments || root.has-queue ? 72px : 140px;
                    transcript := ScrollView {
                        width <- 100%;
                        height <- 100%;
                        visible <- Model.count(root.entries) > 0 || root.earlier-turns;
                        content-y <-> root.transcript-position;
                        horizontal-scroll-bar-policy <- always-off;
                        accessible-name <- @tr("conversation-transcript");
                        scrolled => {
                            root.restore-reading-pending = false;
                            root.history-anchor-pending = false;
                            root.scroll-pending = false;
                            root.follow-output = root.transcript-gap <= 2px;
                            root.reading-history = !root.follow-output;
                        }
                        transcript-content := HorizontalLayout {
                            width <- 100%;
                            alignment <- center;
                            padding-left <- 20px;
                            padding-right <- 20px;
                            transcript-rows := VerticalLayout {
                                min-width <- 0px;
                                preferred-width <- 740px;
                                max-width <- 740px;
                                padding-top <- 25px;
                                padding-bottom <- 14px;
                                alignment <- start;
                                spacing <- 12px;
                                earlier-messages := Button {
                                    text <- root.switching ? @tr("loading") : @tr("earlier-messages");
                                    height <- 31px;
                                    padding <- 5px;
                                    flat <- true;
                                    visible <- root.earlier-turns && !root.chat-find-open;
                                    enabled <- root.connected && !root.busy && !root.switching;
                                    clicked => {
                                        root.scroll-pending = false;
                                        root.follow-output = false;
                                        root.load-earlier-turns();
                                    }
                                }
                                for entry[index] in root.entries : VerticalLayout {
                                    visible <- root.turn-activity-summary(index) != "" || root.show-transcript-entry(index, entry.kind);
                                    vertical-stretch <- 0;
                                    spacing <- 0px;
                                    if root.turn-activity-summary(index) != "" : HorizontalLayout {
                                        alignment <- start;
                                        height <- 34px;
                                        padding-left <- 14px;
                                        padding-bottom <- 3px;
                                        Button {
                                            text <- root.turn-activity-summary(index);
                                            accessible-name <- (root.turn-activity-expanded(index) ? (@tr("collapse-prefix") + " ") : (@tr("expand-prefix") + " ")) + root.turn-activity-summary(index);
                                            checkable <- true;
                                            checked <- root.turn-activity-expanded(index);
                                            height <- 31px;
                                            padding <- 3px;
                                            border-radius <- 7px;
                                            flat <- true;
                                            background <- root.turn-activity-expanded(index) ? Palette.selection : Palette.surface;
                                            border-color <- Palette.border;
                                            border-width <- 1px;
                                            ButtonContent {
                                                HorizontalLayout {
                                                    padding-left <- 7px;
                                                    padding-right <- 7px;
                                                    spacing <- 6px;
                                                    cross-axis-alignment <- center;
                                                    Path {
                                                        width <- 15px;
                                                        height <- 15px;
                                                        viewbox-width <- 24;
                                                        viewbox-height <- 24;
                                                        fill <- #00000000;
                                                        stroke <- Palette.accent;
                                                        stroke-width <- 1.7px;
                                                        commands <- "M4 6 H20 V18 H4 Z M7 9 L10 12 L7 15 M12 15 H17";
                                                    }
                                                    Label {
                                                        text <- root.turn-activity-summary(index);
                                                        color <- root.turn-activity-attention(index) ? Palette.warning : Palette.muted;
                                                        overflow <- elide;
                                                        min-width <- 0px;
                                                        font-size <- 12px;
                                                    }
                                                    Path {
                                                        width <- 12px;
                                                        height <- 12px;
                                                        viewbox-width <- 24;
                                                        viewbox-height <- 24;
                                                        fill <- #00000000;
                                                        stroke <- Palette.muted;
                                                        stroke-width <- 1.7px;
                                                        commands <- root.turn-activity-expanded(index) ? "M6 14 L12 8 L18 14" : "M6 10 L12 16 L18 10";
                                                    }
                                                }
                                            }
                                            clicked => {
                                                root.follow-output = false;
                                                root.scroll-pending = false;
                                                root.toggle-turn-activity(index);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        visible <- root.show-transcript-entry(index, entry.kind);
                                        alignment <- entry.kind == "user" ? LayoutAlignment.end :
                                            entry.kind == "compaction" ? LayoutAlignment.center : LayoutAlignment.start;
                                        vertical-stretch <- 0;
                                        padding-bottom <- 8px;
                                        if entry.kind == "command" : Pane {
                                            min-width <- 0px;
                                            preferred-width <- 740px;
                                            max-width <- 740px;
                                            background <- Palette.surface;
                                            border-radius <- 9px;
                                            border-color <- Palette.border;
                                            border-width <- 1px;
                                            padding <- 0px;
                                            VerticalLayout {
                                                alignment <- start;
                                                spacing <- 0px;
                                                if root.is-command-group-first(index) : Button {
                                                    text <- root.command-group-title(index);
                                                    accessible-name <- (root.command-group-open(root.command-group(index)) ? (@tr("collapse-section") + " ") : (@tr("expand-prefix") + " "))
                                                        + root.command-group-title(index) + " · " + root.command-group-status(index);
                                                    checkable <- true;
                                                    checked <- root.command-group-open(root.command-group(index));
                                                    flat <- true;
                                                    height <- 38px;
                                                    padding <- 3px;
                                                    border-radius <- 8px;
                                                    background <- #00000000;
                                                    ButtonContent {
                                                        HorizontalLayout {
                                                            padding-left <- 9px;
                                                            padding-right <- 9px;
                                                            spacing <- 8px;
                                                            cross-axis-alignment <- center;
                                                            Path {
                                                                width <- 16px;
                                                                height <- 16px;
                                                                viewbox-width <- 24;
                                                                viewbox-height <- 24;
                                                                fill <- #00000000;
                                                                stroke <- Palette.accent;
                                                                stroke-width <- 1.7px;
                                                                commands <- "M4 5 H20 V19 H4 Z M7 9 L10 12 L7 15 M12 15 H16";
                                                            }
                                                            Label {
                                                                text <- root.command-group-title(index);
                                                                horizontal-stretch <- 1;
                                                                font-weight <- 650;
                                                                font-size <- 12px;
                                                                color <- root.command-group-open(root.command-group(index)) ? Palette.accent : Palette.text;
                                                            }
                                                            Label {
                                                                text <- root.command-group-status(index);
                                                                color <- root.command-group-color(index);
                                                                font-size <- 11px;
                                                            }
                                                            Path {
                                                                width <- 12px;
                                                                height <- 12px;
                                                                viewbox-width <- 24;
                                                                viewbox-height <- 24;
                                                                fill <- #00000000;
                                                                stroke <- Palette.muted;
                                                                stroke-width <- 1.7px;
                                                                commands <- root.command-group-open(root.command-group(index)) ? "M6 14 L12 8 L18 14" : "M6 10 L12 16 L18 10";
                                                            }
                                                        }
                                                    }
                                                    clicked => { root.toggle-command-group(index); }
                                                }
                                                Button {
                                                    visible <- root.command-output-toggle-visible(index);
                                                    checkable <- true;
                                                    checked <- root.expanded-command == index;
                                                    text <- entry.heading;
                                                    accessible-name <- (root.expanded-command == index ? (@tr("collapse-command-output") + " ") : (@tr("expand-command-output") + " ")) + entry.heading + " · " + entry.status;
                                                    flat <- true;
                                                    height <- 36px;
                                                    padding <- 3px;
                                                    border-radius <- 8px;
                                                    background <- #00000000;
                                                    ButtonContent {
                                                        HorizontalLayout {
                                                            padding-left <- 8px;
                                                            padding-right <- 8px;
                                                            spacing <- 8px;
                                                            cross-axis-alignment <- center;
                                                            Path {
                                                                width <- 17px;
                                                                height <- 17px;
                                                                viewbox-width <- 24;
                                                                viewbox-height <- 24;
                                                                fill <- #00000000;
                                                                stroke <- Palette.accent;
                                                                stroke-width <- 1.7px;
                                                                commands <- "M4 5 H20 V19 H4 Z M7 9 L10 12 L7 15 M12 15 H16";
                                                            }
                                                            Label {
                                                                text <- entry.heading;
                                                                horizontal-stretch <- 1;
                                                                overflow <- elide;
                                                                font-family <- "monospace";
                                                                font-size <- 12px;
                                                                color <- root.expanded-command == index ? Palette.accent : Palette.text;
                                                            }
                                                            Label {
                                                                text <- entry.status;
                                                                font-size <- 11px;
                                                                color <- entry.status-tone == "error" ? Palette.error : entry.status-tone == "done" ? Palette.success : entry.status-tone == "running" ? Palette.accent : Palette.muted;
                                                            }
                                                            Path {
                                                                width <- 12px;
                                                                height <- 12px;
                                                                viewbox-width <- 24;
                                                                viewbox-height <- 24;
                                                                fill <- #00000000;
                                                                stroke <- Palette.muted;
                                                                stroke-width <- 1.7px;
                                                                commands <- root.expanded-command == index ? "M6 14 L12 8 L18 14" : "M6 10 L12 16 L18 10";
                                                            }
                                                        }
                                                    }
                                                    clicked => {
                                                        if root.expanded-command == index {
                                                            root.expanded-command = -1;
                                                        } else {
                                                            root.expanded-command = index;
                                                            root.follow-output = false;
                                                        }
                                                        root.transcript-updated();
                                                    }
                                                }
                                                VerticalLayout {
                                                    visible <- root.expanded-command == index;
                                                    spacing <- 0px;
                                                    Rectangle { height <- 1px; background <- Palette.border; }
                                                    VerticalLayout {
                                                        padding <- 10px;
                                                        StyledText {
                                                            text <- root.transcript-body(index, entry.body);
                                                            color <- Palette.text;
                                                            font-family <- "monospace";
                                                            font-size <- 11px;
                                                            selectable <- true;
                                                            wrap <- char-wrap;
                                                            vertical-alignment <- top;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if entry.kind == "changes" : Button {
                                            checkable <- true;
                                            checked <- root.review-open && root.review-turn == index;
                                            text <- entry.heading;
                                            accessible-name <- (@tr("view-turn-changes") + " ") + entry.status;
                                            height <- 37px;
                                            padding <- 5px;
                                            border-radius <- 8px;
                                            flat <- true;
                                            enabled <- !root.switching;
                                            background <- Palette.selection;
                                            ButtonContent {
                                                HorizontalLayout {
                                                    padding-left <- 6px;
                                                    padding-right <- 6px;
                                                    spacing <- 8px;
                                                    cross-axis-alignment <- center;
                                                    Path {
                                                        width <- 17px;
                                                        height <- 17px;
                                                        viewbox-width <- 24;
                                                        viewbox-height <- 24;
                                                        fill <- #00000000;
                                                        stroke <- Palette.accent;
                                                        stroke-width <- 1.7px;
                                                        commands <- "M6 4 H15 L19 8 V20 H6 Z M14 4 V9 H19 M9 13 H15 M9 16 H15";
                                                    }
                                                    Label { text <- entry.heading; color <- Palette.accent; font-size <- 12px; font-weight <- 650; }
                                                    Label { text <- entry.status; color <- Palette.muted; font-size <- 11px; }
                                                }
                                            }
                                            clicked => { root.show-turn-review(index); }
                                        }
                                        if entry.kind == "compaction" : Label {
                                            text <- entry.heading;
                                            color <- Palette.muted;
                                            font-size <- 11px;
                                            height <- 22px;
                                        }
                                        if entry.kind != "command" && entry.kind != "changes" && entry.kind != "compaction" : Pane {
                                            min-width <- 0px;
                                            preferred-width <- entry.kind == "user" ? 620px : 740px;
                                            max-width <- entry.kind == "user" ? 620px : 740px;
                                            background <- entry.kind == "user" ? Palette.user-message : entry.kind == "plan" || entry.kind == "proposal" || entry.kind == "code-review" ? Palette.surface : #00000000;
                                            border-color <- Palette.border;
                                            border-width <- entry.kind == "plan" || entry.kind == "proposal" || entry.kind == "code-review" ? 1px : 0px;
                                            border-radius <- 12px;
                                            vertical-stretch <- 0;
                                            padding <- 0px;
                                            VerticalLayout {
                                                alignment <- start;
                                                padding <- 14px;
                                                spacing <- 7px;
                                                HorizontalLayout {
                                                    spacing <- 8px;
                                                    cross-axis-alignment <- center;
                                                    if entry.kind == "plan" || entry.kind == "proposal" || entry.kind == "code-review" : Rectangle {
                                                        width <- 4px;
                                                        height <- 12px;
                                                        border-radius <- 2px;
                                                        background <- Palette.accent;
                                                    }
                                                    Label {
                                                        text <- entry.heading;
                                                        font-size <- 12px;
                                                        font-weight <- 700;
                                                        horizontal-stretch <- 1;
                                                        color <- entry.kind == "assistant" ? Palette.muted : Palette.accent;
                                                    }
                                                    if entry.kind == "plan" || entry.kind == "proposal" || entry.kind == "code-review" : Label {
                                                        text <- entry.status;
                                                        font-size <- 11px;
                                                        color <- Palette.muted;
                                                    }
                                                    if entry.kind == "user" && entry.status == "可编辑" : Button {
                                                        text <- @tr("edit");
                                                        accessible-name <- @tr("edit-this-earlier-prompt");
                                                        height <- 25px;
                                                        padding <- 3px;
                                                        font-size <- 11px;
                                                        flat <- true;
                                                        checkable <- true;
                                                        checked <- false;
                                                        enabled <- !root.switching && !root.conversation-archived;
                                                        clicked => { root.edit-historical-prompt(index); }
                                                    }
                                                }
                                                if root.section-owner(index) == "" : StyledText {
                                                    text <- root.transcript-body(index, entry.body);
                                                    color <- Palette.text;
                                                    selectable <- true;
                                                    vertical-alignment <- top;
                                                    wrap <- word-wrap;
                                                    link-activated(href) => {
                                                        if entry.kind == "assistant" || entry.kind == "proposal" {
                                                            root.open-workspace-reference(href);
                                                        }
                                                    }
                                                }
                                                if root.section-owner(index) != "" : VerticalLayout {
                                                    min-width <- 0px;
                                                    alignment <- start;
                                                    spacing <- 9px;
                                                    for section in Model.lookup(root.transcript-sections, "owner", root.section-owner(index)) : VerticalLayout {
                                                        min-width <- 0px;
                                                        alignment <- start;
                                                        if section.language == "" : StyledText {
                                                            text <- root.chat-find-open && root.chat-find-ready && root.chat-find-count > 0 ? section.annotated : section.body;
                                                            color <- Palette.text;
                                                            selectable <- true;
                                                            vertical-alignment <- top;
                                                            wrap <- word-wrap;
                                                            link-activated(href) => { root.open-workspace-reference(href); }
                                                        }
                                                        if section.language != "" : Pane {
                                                            min-width <- 0px;
                                                            background <- Palette.surface;
                                                            border-color <- Palette.border;
                                                            border-width <- 1px;
                                                            border-radius <- 8px;
                                                            padding <- 0px;
                                                            VerticalLayout {
                                                                alignment <- start;
                                                                spacing <- 0px;
                                                                HorizontalLayout {
                                                                    height <- 31px;
                                                                    padding-left <- 10px;
                                                                    padding-right <- 5px;
                                                                    spacing <- 5px;
                                                                    cross-axis-alignment <- center;
                                                                    Label {
                                                                        text <- section.language;
                                                                        min-width <- 0px;
                                                                        horizontal-stretch <- 1;
                                                                        overflow <- elide;
                                                                        color <- Palette.muted;
                                                                        font-family <- "monospace";
                                                                        font-size <- 11px;
                                                                    }
                                                                    Button {
                                                                        text <- root.message-copy-index == index && root.message-copy-offset == section.start ? root.message-copy-status : @tr("copy-code");
                                                                        accessible-name <- (@tr("copy-code-prefix") + " ") + section.language + (" " + @tr("code-suffix"));
                                                                        height <- 26px;
                                                                        padding <- 4px;
                                                                        flat <- true;
                                                                        checkable <- true;
                                                                        checked <- false;
                                                                        enabled <- !root.switching;
                                                                        clicked => { root.copy-code-section(index, section.start, section.body); }
                                                                    }
                                                                }
                                                                Rectangle { height <- 1px; background <- Palette.border; }
                                                                VerticalLayout {
                                                                    padding <- 10px;
                                                                    alignment <- start;
                                                                    StyledText {
                                                                        text <- root.chat-find-open && root.chat-find-ready && root.chat-find-count > 0 ? section.annotated : section.body;
                                                                        color <- Palette.text;
                                                                        font-family <- "monospace";
                                                                        font-size <- 12px;
                                                                        selectable <- true;
                                                                        vertical-alignment <- top;
                                                                        wrap <- char-wrap;
                                                                        link-activated(href) => { root.open-workspace-reference(href); }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                if entry.kind == "assistant" && entry.status == "已完成" : HorizontalLayout {
                                                    height <- 28px;
                                                    alignment <- start;
                                                    spacing <- 4px;
                                                    Button {
                                                        text <- root.message-copy-index == index && root.message-copy-offset == -1 ? root.message-copy-status : @tr("copy-code-prefix");
                                                        accessible-name <- @tr("copy-reply-as-markdown");
                                                        height <- 28px;
                                                        padding <- 3px;
                                                        flat <- true;
                                                        border-radius <- 5px;
                                                        checkable <- true;
                                                        checked <- false;
                                                        enabled <- !root.switching;
                                                        ButtonContent {
                                                            HorizontalLayout {
                                                                padding-left <- 4px;
                                                                padding-right <- 4px;
                                                                spacing <- 5px;
                                                                cross-axis-alignment <- center;
                                                                Path {
                                                                    width <- 14px;
                                                                    height <- 14px;
                                                                    viewbox-width <- 24;
                                                                    viewbox-height <- 24;
                                                                    fill <- #00000000;
                                                                    stroke <- root.message-copy-index == index && root.message-copy-offset == -1 && root.message-copy-status == "已复制" ? Palette.success : Palette.muted;
                                                                    stroke-width <- 1.7px;
                                                                    commands <- root.message-copy-index == index && root.message-copy-offset == -1 && root.message-copy-status == "已复制" ? "M5 12 L10 17 L19 7" : "M9 9 H20 V20 H9 Z M15 9 V4 H4 V15 H9";
                                                                }
                                                                Label {
                                                                    text <- root.message-copy-index == index && root.message-copy-offset == -1 ? root.message-copy-status : @tr("copy-code-prefix");
                                                                    font-size <- 11px;
                                                                    color <- Palette.muted;
                                                                }
                                                            }
                                                        }
                                                        clicked => { root.copy-message(index); }
                                                    }
                                                    Button {
                                                        text <- @tr("quote");
                                                        accessible-name <- @tr("select-reply-text-to-quote");
                                                        height <- 28px;
                                                        padding <- 3px;
                                                        flat <- true;
                                                        border-radius <- 5px;
                                                        checkable <- true;
                                                        checked <- false;
                                                        enabled <- !root.switching && !root.conversation-archived;
                                                        ButtonContent {
                                                            HorizontalLayout {
                                                                padding-left <- 4px;
                                                                padding-right <- 4px;
                                                                spacing <- 5px;
                                                                cross-axis-alignment <- center;
                                                                Path {
                                                                    width <- 14px;
                                                                    height <- 14px;
                                                                    viewbox-width <- 24;
                                                                    viewbox-height <- 24;
                                                                    fill <- #00000000;
                                                                    stroke <- Palette.muted;
                                                                    stroke-width <- 1.7px;
                                                                    commands <- "M9 6 H5 L4 12 V17 H10 V12 H5 M19 6 H15 L14 12 V17 H20 V12 H15";
                                                                }
                                                                Label { text <- @tr("quote"); font-size <- 11px; color <- Palette.muted; }
                                                            }
                                                        }
                                                        clicked => {
                                                            root.message-quote-body = entry.body;
                                                            root.message-quote-open = true;
                                                            message-quote-dialog.focus-selection();
                                                        }
                                                    }
                                                    if Model.at(root.message-forks, index, "") != "" : Button {
                                                        text <- @tr("fork-here");
                                                        accessible-name <- @tr("fork-from-this-reply");
                                                        height <- 28px;
                                                        padding <- 3px;
                                                        flat <- true;
                                                        border-radius <- 5px;
                                                        checkable <- true;
                                                        checked <- false;
                                                        enabled <- root.can-fork;
                                                        ButtonContent {
                                                            HorizontalLayout {
                                                                padding-left <- 4px;
                                                                padding-right <- 4px;
                                                                spacing <- 5px;
                                                                cross-axis-alignment <- center;
                                                                Path {
                                                                    width <- 14px;
                                                                    height <- 14px;
                                                                    viewbox-width <- 24;
                                                                    viewbox-height <- 24;
                                                                    fill <- #00000000;
                                                                    stroke <- Palette.muted;
                                                                    stroke-width <- 1.7px;
                                                                    commands <- "M7 7 V17 M16 9 V11 C16 15 7 12 7 17 M7 3 A2 2 0 1 0 7 7 A2 2 0 1 0 7 3 M16 5 A2 2 0 1 0 16 9 A2 2 0 1 0 16 5 M7 17 A2 2 0 1 0 7 21 A2 2 0 1 0 7 17";
                                                                }
                                                                Label { text <- @tr("fork-here"); font-size <- 11px; color <- Palette.muted; }
                                                            }
                                                        }
                                                        clicked => { root.open-fork(Model.at(root.message-forks, index, "")); }
                                                    }
                                                }
                                                if entry.kind == "proposal" && entry.status == "已完成" : HorizontalLayout {
                                                    alignment <- end;
                                                    Button {
                                                        text <- @tr("implement-plan");
                                                        checkable <- true;
                                                        checked <- false;
                                                        height <- 29px;
                                                        padding <- 5px;
                                                        border-radius <- 6px;
                                                        flat <- true;
                                                        background <- Palette.selection;
                                                        enabled <- !root.busy && !root.switching && !root.conversation-archived;
                                                        clicked => { root.use-plan(index); }
                                                    }
                                                }
                                                if entry.kind == "code-review" : HorizontalLayout {
                                                    alignment <- end;
                                                    Button {
                                                        text <- @tr("view-report");
                                                        checkable <- true;
                                                        checked <- false;
                                                        height <- 29px;
                                                        padding <- 5px;
                                                        border-radius <- 6px;
                                                        flat <- true;
                                                        background <- Palette.selection;
                                                        clicked => { root.show-review-report(index); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.busy : HorizontalLayout {
                                    height <- 25px;
                                    padding-left <- 12px;
                                    spacing <- 8px;
                                    cross-axis-alignment <- center;
                                    BusyIndicator {
                                        width <- 14px;
                                        height <- 14px;
                                        running <- true;
                                        color <- Palette.accent;
                                        stroke-width <- 2px;
                                    }
                                    Label {
                                        text <- root.stopping ? @tr("stopping") : root.reviewing ? @tr("reviewing-code") : @tr("codex-is-working");
                                        color <- Palette.muted;
                                        font-size <- 12px;
                                        horizontal-stretch <- 1;
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        width <- 100%;
                        height <- 100%;
                        alignment <- end;
                        cross-axis-alignment <- center;
                        padding-bottom <- 12px;
                        latest-message := Button {
                            width <- 112px;
                            height <- 34px;
                            visible <- root.reading-history && !root.history-anchor-pending && !root.switching;
                            text <- @tr("jump-to-latest");
                            accessible-name <- @tr("jump-to-latest-message");
                            flat <- true;
                            focus-on-click <- false;
                            padding <- 0px;
                            border-width <- 1px;
                            border-color <- Palette.border;
                            border-radius <- 17px;
                            background <- self.pressed ? Palette.selection : Palette.surface;
                            ButtonContent {
                                HorizontalLayout {
                                    alignment <- center;
                                    cross-axis-alignment <- center;
                                    spacing <- 6px;
                                    WorkbenchIcon { tint <- Palette.accent; shape <- "M12 5 V19 M6 13 L12 19 L18 13"; }
                                    Label { text <- @tr("jump-to-latest"); color <- Palette.text; font-size <- 12px; }
                                }
                            }
                            clicked => {
                                root.reveal-latest();
                                if self.has-focus {
                                    input.focus();
                                }
                            }
                        }
                    }

                    if Model.count(root.entries) == 0 && !root.earlier-turns && root.switching : HorizontalLayout {
                        width <- 100%;
                        height <- 100%;
                        alignment <- center;
                        cross-axis-alignment <- center;
                        spacing <- 8px;
                        BusyIndicator {
                            width <- 16px;
                            height <- 16px;
                            running <- true;
                            color <- Palette.accent;
                        }
                        Label { text <- @tr("loading-conversation"); color <- Palette.muted; }
                    }
                    if Model.count(root.entries) == 0 && !root.earlier-turns && !root.switching : ConversationWelcome {
                        draft <-> root.draft;
                        workspace-name <- root.workspace-name;
                        focus-draft => { input.focus(); }
                    }
                }

                HorizontalLayout {
                    height <- 155px +
                        (root.show-worktree-start ? 31px : 0px) +
                        (root.show-worktree-start && root.worktree-start-error != "" ? 22px : 0px) +
                        (root.stacked-composer-actions ? 42px : 0px) +
                        (root.has-queue ? (Model.count(root.queued-messages) > 1 ? 95px : 64px) : 0px) +
                        (root.has-attachments ? root.attachment-height + 6px : 0px) +
                        (root.show-attachment-status ? 22px : 0px) +
                        (root.draft-storage-status != "" ? 22px : 0px) +
                        (root.show-file-mention ? root.file-mention-height + 6px : 0px);
                    vertical-stretch <- 0;
                    alignment <- center;
                    padding-left <- 20px;
                    padding-right <- 20px;
                    padding-bottom <- 17px;
                    composer-panel := Pane {
                        min-width <- 0px;
                        preferred-width <- 740px;
                        max-width <- 740px;
                        background <- root.attachment-hover ? Palette.selection : Palette.surface;
                        border-color <- input.has-focus || root.attachment-hover ? Palette.accent : Palette.border;
                        border-width <- 1px;
                        border-radius <- 16px;
                        padding <- 9px;
                        VerticalLayout {
                            alignment <- start;
                            spacing <- 6px;
                            HorizontalLayout {
                                height <- 25px;
                                spacing <- 5px;
                                alignment <- start;
                                cross-axis-alignment <- center;
                                visible <- root.show-worktree-start;
                                composer-worktree-location := Button {
                                    text <- root.worktree-start-label == "" ? @tr("composer-local-location") :
                                        @tr("composer-worktree-location", branch: root.worktree-start-label);
                                    accessible-name <- @tr("choose-conversation-location") + " · " +
                                        (root.worktree-start-label == "" ? @tr("composer-local-location") :
                                            @tr("composer-worktree-location", branch: root.worktree-start-label));
                                    height <- 25px;
                                    padding <- 5px;
                                    flat <- true;
                                    border-radius <- 6px;
                                    background <- Palette.rail;
                                    enabled <- root.can-configure-worktree-start;
                                    clicked => { root.open-worktree-start(); }
                                }
                                show-worktree-output := Button {
                                    text <- @tr("view-worktree-setup-output");
                                    visible <- root.worktree-setup-output != "" && !root.worktree-preparing;
                                    height <- 25px;
                                    flat <- true;
                                    padding <- 5px;
                                    clicked => { root.worktree-setup-log-open = true; }
                                }
                                Label {
                                    text <- @tr("preparing-worktree-and-environment");
                                    visible <- root.worktree-preparing && root.worktree-start-label != "";
                                    color <- Palette.muted;
                                    font-size <- 11px;
                                    horizontal-stretch <- 1;
                                }
                            }
                            worktree-start-status := Label {
                                text <- root.worktree-start-error;
                                visible <- root.show-worktree-start && root.worktree-start-error != "";
                                color <- Palette.error;
                                font-size <- 11px;
                                height <- 16px;
                                overflow <- elide;
                            }
                            VerticalLayout {
                                spacing <- 3px;
                                alignment <- start;
                                visible <- root.has-queue;
                                HorizontalLayout {
                                    height <- 24px;
                                    padding-left <- 5px;
                                    cross-axis-alignment <- center;
                                    Label {
                                        text <- (@tr("queued") + " ") + Model.count(root.queued-messages);
                                        color <- Palette.muted;
                                        font-size <- 11px;
                                        horizontal-stretch <- 1;
                                    }
                                    resume-queue-button := Button {
                                        text <- @tr("resume-queue");
                                        height <- 24px;
                                        padding <- 4px;
                                        flat <- true;
                                        visible <- !root.queue-resumed && !root.busy;
                                        enabled <- root.connected && !root.switching && !root.queue-pending;
                                        clicked => { root.resume-queue(); }
                                    }
                                }
                                queued-list := ListView {
                                    height <- Model.count(root.queued-messages) > 1 ? 62px : 31px;
                                    row-height <- 31px;
                                    current-index <- -1;
                                    accessible-name <- @tr("queued-messages");
                                    for row[index] in root.queued-messages : QueuedTile {
                                        prompt <- row.text;
                                        can-edit <- root.can-manage-queue;
                                        has-editable-text <- row.editable;
                                        can-start <- root.queue-resumed && !root.busy;
                                        can-move-up <- index > 0;
                                        can-move-down <- index + 1 < Model.count(root.queued-messages);
                                        open-editor => { root.open-queued-editor(row.id); }
                                        move(step) => { root.move-queued(row.id, step); }
                                        remove => { root.remove-queued(row.id); }
                                        start => { root.start-queued(row.id); }
                                    }
                                }
                            }
                            attachment-list := ListView {
                                height <- root.attachment-height;
                                row-height <- 39px;
                                current-index <- -1;
                                visible <- root.has-attachments;
                                accessible-name <- @tr("message-attachments");
                                for file in root.attachment-rows : AttachmentTile {
                                    name <- file.name;
                                    kind <- file.kind;
                                    preview <- file.preview;
                                    has-preview <- file.has-preview;
                                    can-remove <- root.can-edit-attachments;
                                    show => { root.preview-attachment(file.path); }
                                    remove => { root.remove-attachment(file.path); }
                                }
                            }
                            Label {
                                height <- 16px;
                                text <- root.attachment-loading ? @tr("loading-attachments") : root.attachment-status;
                                font-size <- 11px;
                                color <- Palette.muted;
                                overflow <- elide;
                                visible <- root.show-attachment-status;
                            }
                            composer-draft-status := Label {
                                height <- 16px;
                                text <- root.draft-storage-status;
                                font-size <- 11px;
                                color <- Palette.muted;
                                overflow <- elide;
                                visible <- root.draft-storage-status != "";
                            }
                            if root.show-file-mention : Pane {
                                height <- root.file-mention-height;
                                padding <- 5px;
                                border-width <- 1px;
                                border-color <- Palette.border;
                                border-radius <- 8px;
                                background <- Palette.surface;
                                VerticalLayout {
                                    spacing <- 0px;
                                    Label {
                                        text <- root.mention-status-text;
                                        color <- Palette.muted;
                                        height <- 20px;
                                        font-size <- 11px;
                                        overflow <- elide;
                                        visible <- root.mention-status-text != "";
                                    }
                                    file-mention-list := ListView {
                                        height <- (root.file-mention-count * 30) * 1px;
                                        row-height <- 30px;
                                        current-index <-> root.file-mention-index;
                                        background <- Palette.surface;
                                        accessible-name <- root.skill-mention ? @tr("skills-available-to-attach") :
                                            @tr("workspace-files-available-to-attach");
                                        visible <- root.file-mention-count > 0;
                                        for file[index] in root.file-mention-items : PaletteResult {
                                            title <- file.title;
                                            detail <- file.detail;
                                            current <- index == root.file-mention-index;
                                            ready <- true;
                                            keep-focus <- true;
                                            choose => { root.attach-file-mention(index); }
                                        }
                                    }
                                }
                            }
                            attachment-drop := DropArea {
                                height <- 76px;
                                accept-files <- root.can-attach;
                                files-entered(paths) => { root.attachment-hover = true; }
                                exited => { root.attachment-hover = false; }
                                files-dropped(paths) => { root.attachment-hover = false; root.attach-files(paths); }
                                files-failed(reason) => { root.attachment-hover = false; root.attachment-status = reason; }
                                slash-commands := PopupWindow {
                                    open <-> root.slash-commands-open;
                                    visible <- root.slash-commands-current;
                                    focus <- false;
                                    placement <- above;
                                    anchor-gap <- 4px;
                                    width <- 366px;
                                    height <- (Math.min(root.slash-command-count, 5) * 32 + 36) * 1px;
                                    background <- #00000000;
                                    accessible-name <- @tr("slash-commands");
                                    Pane {
                                        width <- 100%;
                                        height <- 100%;
                                        padding <- 6px;
                                        border-radius <- 10px;
                                        border-width <- 1px;
                                        border-color <- Palette.border;
                                        background <- Palette.surface;
                                        VerticalLayout {
                                            width <- 100%;
                                            height <- 100%;
                                            alignment <- start;
                                            spacing <- 2px;
                                            slash-command-hint := Label {
                                                text <- @tr("select-enter-run-esc-close");
                                                font-size <- 10px;
                                                color <- Palette.muted;
                                                height <- 20px;
                                                vertical-alignment <- center;
                                            }
                                            slash-command-results := ListView {
                                                height <- (Math.min(root.slash-command-count, 5) * 32) * 1px;
                                                vertical-stretch <- 0;
                                                row-height <- 32px;
                                                current-index <-> root.slash-command-index;
                                                background <- Palette.surface;
                                                accessible-name <- @tr("matching-slash-commands");
                                                for item[index] in root.slash-command-items : PaletteResult {
                                                    title <- item.title;
                                                    detail <- item.detail;
                                                    current <- index == root.slash-command-index;
                                                    ready <- item.enabled;
                                                    keep-focus <- true;
                                                    choose => { root.activate-slash-command(index); }
                                                }
                                            }
                                        }
                                    }
                                }
                                composer-key-scope := FocusScope {
                                    width <- 100%;
                                    height <- 100%;
                                    focus-within-changed(focused, reason) => {
                                        if !focused { root.slash-commands-open = false; }
                                    }
                                    capture-key-pressed(event) => {
                                        let dismiss = (root.show-file-mention || root.slash-commands-current) && event.key == "Escape";
                                        let plain = !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta;
                                        let navigate = root.show-file-mention && root.file-mention-count > 0 && plain;
                                        let slash = root.slash-commands-current && plain;
                                        let slash-navigation = slash && (event.key == "ArrowDown" || event.key == "ArrowUp");
                                        let slash-choice = slash && event.key == "Enter";
                                        let primary = event.modifiers.primary && !event.modifiers.alt
                                            && (!event.modifiers.control || !event.modifiers.meta);
                                        let submit = event.key == "Enter" && (primary && (!event.modifiers.shift || root.can-followup)
                                            || plain && root.enter-sends && !root.show-file-mention && !slash);
                                        let browsing = root.composer-recalling &&
                                            input.cursor-offset == root.composer-recall-caret && input.selected-text == "";
                                        let history-key = event.key == "ArrowUp" || event.key == "ArrowDown";
                                        let recall = plain && root.can-recall-composer &&
                                            (browsing && (history-key || event.key == "Escape")
                                                || event.key == "ArrowUp" && root.draft == "");
                                        let recalled = recall && root.recall-composer-prompt(
                                            event.key == "ArrowUp" ? 1 : event.key == "ArrowDown" ? -1 : 0);
                                        if root.composer-recalling && !recalled
                                            && (history-key || event.key == "ArrowLeft" || event.key == "ArrowRight"
                                                || event.key == "Home" || event.key == "End" || event.key == "Escape") {
                                            root.end-composer-recall();
                                        }
                                        if event.key == "Escape" {
                                            root.dismiss-file-mention();
                                            root.slash-commands-open = false;
                                        }
                                        if slash-navigation {
                                            root.slash-command-index = Math.clamp(root.slash-command-index +
                                                (event.key == "ArrowDown" ? 1 : -1), 0, root.slash-command-count - 1);
                                            slash-command-results.position-view-at-index(root.slash-command-index, ScrollAlignment.center);
                                        }
                                        if slash-choice && !event.repeat {
                                            root.activate-slash-command(root.slash-command-index);
                                        }
                                        if navigate && event.key == "ArrowDown" && root.file-mention-index + 1 < root.file-mention-count {
                                            root.file-mention-index += 1;
                                        }
                                        if navigate && event.key == "ArrowUp" && root.file-mention-index > 0 {
                                            root.file-mention-index -= 1;
                                        }
                                        if navigate && event.key == "Enter" {
                                            root.attach-file-mention(root.file-mention-index);
                                        }
                                        if submit && !event.repeat {
                                            root.submit-composer(primary && event.modifiers.shift);
                                        }
                                        dismiss || submit || recalled || slash-navigation || slash-choice ||
                                            (navigate && (event.key == "ArrowDown" || event.key == "ArrowUp" || event.key == "Enter"))
                                            ? EventResult.accept : EventResult.reject
                                    }
                                    input := TextArea {
                                        width <- 100%;
                                        height <- 100%;
                                        accessible-name <- @tr("message");
                                        placeholder-text <- root.conversation-archived ? @tr("conversation-draft") : @tr("message-codex");
                                        text <-> root.draft;
                                        padding <- 8px;
                                        border-width <- 0px;
                                        background <- #00000000;
                                        color <- Palette.text;
                                        wrap <- word-wrap;
                                        read-only <- root.followup-pending || root.sending-prompt || root.worktree-preparing;
                                        edited(text) => {
                                            if root.composer-recalling { root.end-composer-recall(); }
                                            root.file-mention-open = false;
                                            file-mention-debounce.restart();
                                            root.filter-slash-commands(text);
                                        }
                                    }
                                }
                            }
                            FlexboxLayout {
                                height <- root.stacked-composer-actions ? 82px : 40px;
                                flex-direction <- root.stacked-composer-actions ? FlexboxLayoutDirection.column : FlexboxLayoutDirection.row;
                                flex-wrap <- no-wrap;
                                alignment <- stretch;
                                cross-axis-alignment <- stretch;
                                spacing <- root.stacked-composer-actions ? 2px : 6px;
                                HorizontalLayout {
                                    min-width <- 0px;
                                    horizontal-stretch <- 1;
                                    height <- 40px;
                                    padding-left <- root.compact-composer ? 2px : 8px;
                                    spacing <- root.compact-composer ? 4px : 8px;
                                    cross-axis-alignment <- center;
                                    add-attachment := Button {
                                        text <- @tr("attachments");
                                        accessible-name <- @tr("add-message-attachments");
                                        width <- 32px;
                                        height <- 29px;
                                        padding <- 3px;
                                        flat <- true;
                                        enabled <- root.can-attach;
                                        ButtonContent {
                                            CenteredWorkbenchIcon { shape <- "M12 5 V19 M5 12 H19"; }
                                        }
                                        Tooltip { text <- @tr("add-attachments"); }
                                        clicked => { attachment-picker.open(); }
                                    }
                                    generation-picker-trigger := Button {
                                        text <- root.compact-composer ? root.generation-label : root.generation-description;
                                        accessible-name <- (@tr("model-reasoning-effort-and-mode") + " ") + root.generation-description;
                                        visible <- root.show-model-settings;
                                        enabled <- root.can-open-generation-picker && !root.palette-open;
                                        width <- root.compact-composer ? 113px : 171px;
                                        height <- 29px;
                                        padding <- 3px;
                                        flat <- true;
                                        border-radius <- 7px;
                                        background <- root.generation-picker-open || root.plan-mode ? Palette.selection : Palette.canvas;
                                        ButtonContent {
                                            HorizontalLayout {
                                                padding-left <- 5px;
                                                padding-right <- 4px;
                                                cross-axis-alignment <- center;
                                                spacing <- 4px;
                                                Label {
                                                    text <- root.compact-composer ? root.generation-label : root.generation-description;
                                                    overflow <- elide;
                                                    min-width <- 0px;
                                                    horizontal-stretch <- 1;
                                                    color <- Palette.text;
                                                    font-size <- 12px;
                                                    font-weight <- 650;
                                                }
                                                WorkbenchIcon {
                                                    width <- 13px;
                                                    height <- 13px;
                                                    shape <- "M6 14 L12 8 L18 14";
                                                }
                                            }
                                        }
                                        Tooltip { text <- root.generation-description + " · Ctrl + Shift + M"; }
                                        clicked => { root.generation-picker-open = !root.generation-picker-open; }

                                        generation-picker := PopupWindow {
                                            open <-> root.generation-picker-open;
                                            accessible-name <- @tr("generation-settings");
                                            placement <- above;
                                            anchor-gap <- 8px;
                                            width <- 288px;
                                            background <- #00000000;
                                            Pane {
                                                background <- Palette.surface;
                                                border-width <- 1px;
                                                border-color <- Palette.border;
                                                border-radius <- 10px;
                                                padding <- 0px;
                                                VerticalLayout {
                                                    alignment <- start;
                                                    spacing <- 7px;
                                                    padding <- 10px;
                                                    HorizontalLayout {
                                                        height <- 34px;
                                                        visible <- root.has-models;
                                                        cross-axis-alignment <- center;
                                                        spacing <- 6px;
                                                        Label { width <- 70px; text <- @tr("model"); color <- Palette.muted; font-size <- 12px; }
                                                        model-choice := ComboBox {
                                                            model <- root.model-choices;
                                                            text-role <- "label";
                                                            value-role <- "key";
                                                            current-value <-> root.generation-model;
                                                            accessible-name <- @tr("select-a-model");
                                                            min-width <- 0px;
                                                            height <- 34px;
                                                            horizontal-stretch <- 1;
                                                            enabled <- root.can-choose-model;
                                                            value-selected(value) => { root.choose-model(value); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        height <- 34px;
                                                        visible <- root.has-models;
                                                        cross-axis-alignment <- center;
                                                        spacing <- 6px;
                                                        Label { width <- 70px; text <- @tr("reasoning-effort"); color <- Palette.muted; font-size <- 12px; }
                                                        effort-choice := ComboBox {
                                                            model <- root.effort-choices;
                                                            text-role <- "label";
                                                            value-role <- "key";
                                                            current-value <-> root.generation-effort;
                                                            accessible-name <- @tr("select-reasoning-effort");
                                                            min-width <- 0px;
                                                            height <- 34px;
                                                            horizontal-stretch <- 1;
                                                            enabled <- root.can-choose-model && root.generation-model != "" && Model.count(root.effort-choices) > 1;
                                                            value-selected(value) => { root.choose-effort(value); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        height <- 32px;
                                                        visible <- root.plan-available;
                                                        spacing <- 6px;
                                                        cross-axis-alignment <- center;
                                                        Label { width <- 70px; text <- @tr("mode"); color <- Palette.muted; font-size <- 12px; }
                                                        plan-mode-choice := Button {
                                                            text <- root.plan-mode ? @tr("plan") : @tr("execute");
                                                            accessible-name <- root.plan-mode ? @tr("switch-to-execution-mode") : @tr("switch-to-plan-mode");
                                                            height <- 30px;
                                                            padding <- 5px;
                                                            border-radius <- 6px;
                                                            flat <- true;
                                                            background <- root.plan-mode ? Palette.selection : Palette.canvas;
                                                            enabled <- root.can-choose-model;
                                                            clicked => { root.choose-plan-mode(!root.plan-mode); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        height <- 34px;
                                                        visible <- root.models-loading || root.models-status != "";
                                                        spacing <- 4px;
                                                        cross-axis-alignment <- center;
                                                        Label {
                                                            text <- root.models-loading ? @tr("loading-models") : root.models-status;
                                                            color <- root.models-loading ? Palette.muted : Palette.error;
                                                            font-size <- 11px;
                                                            min-width <- 0px;
                                                            horizontal-stretch <- 1;
                                                            wrap <- word-wrap;
                                                            max-lines <- 2;
                                                            overflow <- elide;
                                                        }
                                                        reload-models := Button {
                                                            text <- @tr("retry");
                                                            height <- 28px;
                                                            padding <- 4px;
                                                            flat <- true;
                                                            visible <- root.models-status != "" && !root.models-loading;
                                                            enabled <- root.connected;
                                                            clicked => { root.load-models(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    WorkbenchIcon {
                                        width <- 15px;
                                        height <- 15px;
                                        shape <- root.workspace-write ? "M7 10 V7 Q7 3 12 3 Q17 3 17 7 M5 10 H19 V21 H5 Z" : "M7 10 V7 Q7 3 12 3 Q17 3 17 7 V10 M5 10 H19 V21 H5 Z";
                                    }
                                    Label {
                                        text <- root.compact-composer ? (root.workspace-write ? @tr("write") : @tr("read-only")) :
                                            (root.workspace-write ? @tr("codex-can-write") : @tr("codex-read-only"));
                                        accessible-name <- root.workspace-write ? @tr("codex-can-write") : @tr("codex-read-only");
                                        color <- Palette.muted;
                                        font-size <- 12px;
                                    }
                                    status-line := Label {
                                        text <- root.status;
                                        color <- Palette.muted;
                                        font-size <- 12px;
                                        overflow <- elide;
                                        min-width <- 0px;
                                        horizontal-stretch <- 1;
                                        visible <- !root.question-open || !root.question-deferred;
                                    }
                                    resume-question := Button {
                                        text <- @tr("answer-question");
                                        height <- 29px;
                                        padding <- 5px;
                                        border-radius <- 6px;
                                        flat <- true;
                                        background <- Palette.selection;
                                        horizontal-stretch <- 1;
                                        visible <- root.question-open && root.question-deferred;
                                        enabled <- !root.switching;
                                        clicked => { root.question-deferred = false; }
                                    }
                                    context-button := Button {
                                        text <- root.compact-composer ? @tr("usage") : root.context-button-text;
                                        accessible-name <- @tr("view-context-usage");
                                        width <- root.compact-composer ? 31px : 91px;
                                        height <- 28px;
                                        padding <- 3px;
                                        border-radius <- 6px;
                                        font-size <- 11px;
                                        flat <- true;
                                        visible <- root.renamable;
                                        ButtonContent {
                                            if root.compact-composer : CenteredWorkbenchIcon {
                                                shape <- "M4 15 V18 H20 V15 M7 13 V10 M12 13 V6 M17 13 V8";
                                            }
                                            if !root.compact-composer : Label {
                                                text <- root.context-button-text;
                                                color <- Palette.muted;
                                                horizontal-alignment <- center;
                                                overflow <- elide;
                                                font-size <- 11px;
                                            }
                                        }
                                        Tooltip { text <- root.context-button-text; }
                                        clicked => { root.context-open = true; }
                                    }
                                    composer-history-indicator := Label {
                                        text <- @tr("prompt-history");
                                        color <- Palette.accent;
                                        font-size <- 11px;
                                        visible <- root.composer-recalling && !root.review-open;
                                    }
                                    open-composer-settings := Button {
                                        text <- root.compact-composer ? @tr("settings") : root.composer-submit-hint;
                                        accessible-name <- @tr("open-send-settings");
                                        width <- root.compact-composer ? 31px : 116px;
                                        height <- 28px;
                                        padding <- 3px;
                                        flat <- true;
                                        visible <- !root.review-open && !root.conversation-archived;
                                        enabled <- root.can-open-palette && !root.palette-open;
                                        ButtonContent {
                                            if root.compact-composer : CenteredWorkbenchIcon {
                                                shape <- "M4 6 H20 M4 12 H20 M4 18 H20 M8 4 V8 M16 10 V14 M11 16 V20";
                                            }
                                            if !root.compact-composer : Label {
                                                text <- root.composer-submit-hint;
                                                color <- Palette.muted;
                                                horizontal-alignment <- center;
                                                font-size <- 12px;
                                            }
                                        }
                                        Tooltip { text <- root.composer-submit-hint; }
                                        clicked => { root.composer-settings-open = true; }
                                    }
                                }
                                HorizontalLayout {
                                    alignment <- end;
                                    horizontal-stretch <- 0;
                                    height <- 40px;
                                    spacing <- root.compact-composer ? 4px : 8px;
                                    cross-axis-alignment <- center;
                                    stop := Button {
                                        text <- root.stopping ? @tr("stopping-short") : @tr("stop");
                                        visible <- root.busy;
                                        enabled <- root.busy && !root.switching && !root.stopping;
                                        primary <- false;
                                        padding <- root.compact-composer ? 5px : 10px;
                                        clicked => { root.interrupt(); }
                                    }
                                    steer-button := Button {
                                        text <- root.composer-steers ? @tr("queue") : @tr("steer");
                                        accessible-name <- root.composer-steers ? @tr("queue-for-next-turn") : @tr("send-guidance-to-the-current-turn");
                                        visible <- root.busy && !root.question-open && root.active-turn-id != "";
                                        enabled <- root.can-followup;
                                        flat <- true;
                                        padding <- root.compact-composer ? 5px : 10px;
                                        clicked => { root.submit-composer(true); }
                                    }
                                    send-button := Button {
                                        text <- root.sending-prompt || root.followup-pending ? @tr("submitting") : root.busy ?
                                            (root.composer-steers ? @tr("steer") : @tr("queue")) : @tr("send");
                                        primary <- true;
                                        padding <- root.compact-composer ? 5px : 10px;
                                        enabled <- root.can-send || root.can-followup;
                                        clicked => { root.submit-composer(false); }
                                    }
                                }
                            }
                        }
                    }
                }
                terminal-panel := TerminalPanel {
                    height <- root.viewport-height < 620px ? 206px : 283px;
                    visible <- root.terminal-open;
                    attach-terminal-output(start, end, selection) => { root.attach-terminal-output(start, end, selection); }
                    can-attach <- root.can-attach;
                    new-terminal-tab => { root.new-terminal-tab(); }
                    open-project-actions => { root.open-project-actions(); }
                    switching <- root.switching;
                    sync-terminal(restart) => { root.sync-terminal(restart); }
                    terminal-history <- root.terminal-history;
                    terminal-input-buffer <-> root.terminal-input-buffer;
                    terminal-key(event) => { root.terminal-key(event) }
                    terminal-output-available <- root.terminal-output-available;
                    terminal-running <- root.terminal-running;
                    terminal-screen <- root.terminal-screen;
                    terminal-scroll(pages) => { root.terminal-scroll(pages); }
                    terminal-status <- root.terminal-status;
                    terminal-tab <- root.terminal-tab;
                    terminal-text(text) => { root.terminal-text(text); }
                    toggle-terminal => { root.toggle-terminal(); }
                    workspace <- root.workspace;
                    slot tabs {
                        terminal-tabs := TabBar {
                            height <- 29px;
                            horizontal-stretch <- 1;
                            min-width <- 0px;
                            background <- Palette.rail;
                            visible <- Model.count(root.terminal-tabs) > 0;
                            enabled <- !root.switching;
                            accessible-name <- @tr("terminal-tabs");
                            current-value <-> root.terminal-tab;
                            tabs-closable <- true;
                            reorderable <- true;
                            changed(index) => { root.select-terminal-tab(root.terminal-tab); }
                            tab-close-requested(index, value) => {
                                root.close-terminal-tab(value);
                                if !root.terminal-open { root.focus-composer(); root.transcript-updated(); }
                            }
                            tab-moved(from, to) => { root.reorder-terminal-tabs(from, to); }
                            for tab in root.terminal-tabs : TabButton {
                                text <- tab.title;
                                value <- tab.id;
                                accessible-name <- (@tr("terminal") + " ") + tab.title;
                            }
                        }
                    }
                }
            }
        }

        review-panel := Rectangle {
            visible <- root.review-open;
            preferred-width <- root.split-review-active ? 628px : 426px;
            min-width <- root.split-review-active ? 500px : 247px;
            max-width <- root.expanded-inspector ? root.viewport-width : 760px;
            background <- Palette.surface;
            Shortcut {
                sequence <- "Escape";
                focus-within <- true;
                enabled <- root.expanded-inspector && root.can-open-palette && !root.palette-open && !root.review-find-open
                    && !(root.files-active && root.workspace-file-editing) && root.review-note-reference == "";
                activated => { root.close-inspector(); }
            }
            review-focus-scope := FocusScope {
                width <- 100%;
                height <- 100%;
                focus-within-changed(focused, reason) => { root.review-focused = focused; }
                capture-key-pressed(event) => {
                    let dismiss = root.review-find-open && event.key == "Escape";
                    let move = root.show-review-matches && review-find-input.has-focus && event.key == "Enter"
                        && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta;
                    if dismiss { root.close-review-find(true); }
                    if move && !event.repeat { root.move-review-find(event.modifiers.shift ? -1 : 1); }
                    dismiss || move ? EventResult.accept : EventResult.reject
                }
                VerticalLayout {
                    spacing <- 0px;
                    HorizontalLayout {
                        height <- 62px;
                        padding-left <- 14px;
                        padding-right <- 12px;
                        spacing <- 6px;
                        cross-axis-alignment <- center;
                        VerticalLayout {
                            horizontal-stretch <- 1;
                            alignment <- center;
                            spacing <- 3px;
                            review-title := Label {
                                text <- root.files-active ? @tr("workspace-files") : root.review-turn >= 0 ? @tr("turn-changes") :
                                    root.review-comparison-mode == "branch" ? @tr("branch-comparison") :
                                    root.review-comparison-mode == "commit" ? @tr("commit-changes") : @tr("workspace-changes");
                                color <- Palette.text;
                                font-size <- 15px;
                                font-weight <- 700;
                            }
                            review-status-label := Label {
                                text <- root.files-active ? root.workspace-tree-status : root.review-status;
                                color <- Palette.muted;
                                font-size <- 11px;
                                overflow <- elide;
                            }
                        }
                        open-code-review := Button {
                            text <- @tr("start-review");
                            height <- 30px;
                            padding <- 6px;
                            primary <- true;
                            border-radius <- 7px;
                            visible <- !root.files-active && root.workspace-review-active;
                            enabled <- root.can-start-code-review;
                            clicked => { root.open-review-scope(); }
                        }
                        refresh-review-button := Button {
                            text <- @tr("refresh");
                            height <- 30px;
                            flat <- true;
                            padding <- 6px;
                            visible <- !root.files-active && root.review-turn < 0;
                            enabled <- !root.review-index-busy;
                            clicked => { root.refresh-review(); }
                        }
                        workspace-review-button := Button {
                            text <- @tr("view-workspace");
                            height <- 30px;
                            flat <- true;
                            padding <- 6px;
                            visible <- !root.files-active && !root.workspace-review-active;
                            clicked => {
                                let comparing = root.review-comparison-mode != "";
                                root.review-turn = -1;
                                root.review-comparison-mode = "";
                                root.review-comparison-target = "";
                                root.review-offset = 0px;
                                if comparing { root.select-review-filter(); }
                                else { root.refresh-review(); }
                            }
                        }
                        refresh-files-button := Button {
                            text <- @tr("refresh");
                            accessible-name <- @tr("refresh-workspace-files");
                            height <- 30px;
                            flat <- true;
                            padding <- 6px;
                            visible <- root.files-active;
                            clicked => { root.reset-workspace-files(); }
                        }
                        close-review := Button {
                            text <- root.expanded-inspector ? @tr("back-to-conversation") : @tr("close");
                            height <- 30px;
                            flat <- true;
                            padding <- 6px;
                            clicked => { root.close-inspector(); }
                        }
                    }
                    Rectangle { height <- 1px; background <- Palette.border; }
                    HorizontalLayout {
                        height <- 39px;
                        padding-left <- 10px;
                        padding-right <- 10px;
                        spacing <- 6px;
                        cross-axis-alignment <- center;
                        workspace-changes-tab := Button {
                            text <- @tr("changes");
                            flat <- true;
                            padding <- 6px;
                            height <- 27px;
                            border-radius <- 6px;
                            background <- root.files-active ? #00000000 : Palette.selection;
                            clicked => { root.show-workspace-changes(); }
                        }
                        workspace-files-tab := Button {
                            text <- @tr("files");
                            flat <- true;
                            padding <- 6px;
                            height <- 27px;
                            border-radius <- 6px;
                            background <- root.files-active ? Palette.selection : #00000000;
                            clicked => { root.show-workspace-files(); }
                        }
                        compare-review := Button {
                            text <- @tr("compare-revisions");
                            height <- 27px;
                            padding <- 6px;
                            flat <- true;
                            visible <- !root.files-active && root.workspace != "";
                            enabled <- !root.review-index-busy && !root.switching;
                            clicked => { root.open-review-comparison(); }
                        }
                        open-git-push-button := Button {
                            text <- @tr("push-commit");
                            accessible-name <- @tr("push-commit");
                            height <- 27px;
                            width <- 32px;
                            padding <- 3px;
                            flat <- true;
                            visible <- !root.files-active && root.workspace-review-active && root.workspace != "";
                            enabled <- !root.review-index-busy && !root.switching;
                            ButtonContent {
                                CenteredWorkbenchIcon {
                                    shape <- "M12 5 V16 M7 10 L12 5 L17 10 M4 15 V20 H20 V15";
                                }
                            }
                            Tooltip { text <- @tr("push-commit"); }
                            clicked => { root.open-git-push(); }
                        }
                        open-git-pr-button := Button {
                            text <- @tr("create-git-pr");
                            accessible-name <- @tr("create-git-pr");
                            height <- 27px;
                            width <- 31px;
                            padding <- 3px;
                            flat <- true;
                            visible <- !root.files-active && root.workspace-review-active && root.workspace != "";
                            enabled <- !root.review-index-busy && !root.switching;
                            ButtonContent {
                                CenteredWorkbenchIcon {
                                    shape <- "M7 8 V16 M7 4 A2 2 0 1 1 7 8 A2 2 0 1 1 7 4 M7 16 A2 2 0 1 1 7 20 A2 2 0 1 1 7 16 M16 16 V11 Q16 6 11 6 M16 16 A2 2 0 1 1 16 20 A2 2 0 1 1 16 16";
                                }
                            }
                            Tooltip { text <- @tr("create-git-pr"); }
                            clicked => { root.open-git-pr(false); }
                        }
                    }
                    workspace-files-panel := SplitView {
                        visible <- root.files-active;
                        vertical-stretch <- 1;
                        orientation <- vertical;
                        handle-size <- 4px;
                        fill-pane <- workspace-file-preview;
                        SplitHandle { background <- handle-hovered || handle-pressed ? Palette.split-focus : Palette.border; }
                        workspace-tree := TreeView {
                            preferred-height <- 214px;
                            min-height <- 96px;
                            row-height <- 26px;
                            indentation <- 16px;
                            preserve-scroll-anchor <- true;
                            current-key <-> root.workspace-file-key;
                            content-y <-> root.workspace-tree-offset;
                            background <- Palette.surface;
                            accessible-name <- @tr("workspace-file-tree");
                            expanded(key) => { root.expand-workspace-directory(key); }
                            changed(index) => { root.open-workspace-selection(root.workspace-file-key); }
                            for file in root.workspace-files : TreeRow {
                                key <- file.id;
                                parent-key <- file.parent-id;
                                HorizontalLayout {
                                    spacing <- 5px;
                                    padding-right <- 8px;
                                    cross-axis-alignment <- center;
                                    WorkbenchIcon {
                                        width <- 14px;
                                        height <- 14px;
                                        visible <- file.kind != "status";
                                        tint <- file.kind == "directory" ? Palette.accent : Palette.muted;
                                        shape <- file.kind == "directory" ? "M3 7 H9 L11 9 H21 V19 H3 Z" :
                                            "M6 4 H15 L19 8 V20 H6 Z M14 4 V9 H19";
                                    }
                                    TreeCell {
                                        text <- file.name;
                                        horizontal-stretch <- 1;
                                        height <- 24px;
                                        color <- file.kind == "status" ? Palette.muted : Palette.text;
                                    }
                                }
                            }
                        }
                        workspace-file-preview := Rectangle {
                            visible <- Model.count(root.workspace-preview-tabs) > 0 || root.workspace-file-path != "";
                            min-height <- 137px;
                            background <- Palette.canvas;
                            VerticalLayout {
                                spacing <- 0px;
                                workspace-preview-tabs := TabBar {
                                    visible <- Model.count(root.workspace-preview-tabs) > 0;
                                    height <- 34px;
                                    background <- Palette.surface;
                                    accessible-name <- @tr("open-files");
                                    current-value <-> root.workspace-preview-tab;
                                    tabs-closable <- true;
                                    reorderable <- true;
                                    changed(index) => { root.select-workspace-preview-tab(root.workspace-preview-tab); }
                                    tab-close-requested(index, value) => { root.close-workspace-preview-tab(value); }
                                    tab-moved(from, to) => { root.reorder-workspace-preview-tabs(from, to); }
                                    for file in root.workspace-preview-tabs : TabButton {
                                        text <- file.title + (file.dirty ? " •" : "");
                                        value <- file.id;
                                        accessible-name <- file.path + (file.dirty ? @tr("unsaved") : "");
                                    }
                                }
                                HorizontalLayout {
                                    visible <- root.workspace-file-path != "";
                                    height <- 35px;
                                    padding-left <- 10px;
                                    padding-right <- 8px;
                                    spacing <- 6px;
                                    cross-axis-alignment <- center;
                                    Label {
                                        text <- root.workspace-file-path;
                                        font-family <- "monospace";
                                        font-size <- 11px;
                                        color <- Palette.text;
                                        overflow <- elide;
                                        horizontal-stretch <- 1;
                                    }
                                    workspace-file-from-start := Button {
                                        text <- @tr("view-from-start");
                                        height <- 27px;
                                        flat <- true;
                                        padding <- 5px;
                                        visible <- root.workspace-file-positioned && !root.workspace-file-editing;
                                        clicked => { root.load-workspace-file-from-start(); }
                                    }
                                    external-open-file := ExternalOpenButton {
                                        available <- root.can-open-palette && !root.external-open-pending && !root.workspace-file-edit-saving;
                                        label <- @tr("open-file-in-editor");
                                        activate => { root.open-preview-external(); }
                                    }
                                    start-file-edit := Button {
                                        text <- @tr("edit");
                                        height <- 27px;
                                        flat <- true;
                                        padding <- 5px;
                                        visible <- !root.workspace-file-editing
                                            && (root.workspace-file-kind == "text" || root.workspace-file-kind == "markdown");
                                        enabled <- !root.workspace-file-edit-loading && !root.switching;
                                        clicked => { root.start-workspace-file-edit(); }
                                    }
                                    leave-file-edit := Button {
                                        text <- @tr("preview");
                                        height <- 27px;
                                        flat <- true;
                                        padding <- 5px;
                                        visible <- root.workspace-file-editing;
                                        enabled <- !root.workspace-file-edit-saving;
                                        clicked => { root.leave-workspace-file-edit(); }
                                    }
                                    save-file-edit := Button {
                                        text <- @tr("save");
                                        height <- 27px;
                                        padding <- 5px;
                                        primary <- true;
                                        border-radius <- 5px;
                                        visible <- root.workspace-file-editing;
                                        enabled <- root.workspace-file-edit-dirty && !root.workspace-file-edit-saving && !root.switching;
                                        clicked => { root.save-workspace-file-edit(); }
                                    }
                                }
                                HorizontalLayout {
                                    visible <- root.workspace-file-edit-status != "" || (!root.workspace-file-editing && root.workspace-file-status != "");
                                    height <- 24px;
                                    padding-left <- 10px;
                                    Label {
                                        text <- root.workspace-file-edit-status != "" ? root.workspace-file-edit-status : root.workspace-file-status;
                                        font-size <- 11px;
                                        color <- Palette.muted;
                                        overflow <- elide;
                                        horizontal-stretch <- 1;
                                    }
                                }
                                workspace-file-editor-pages := StackLayout {
                                    visible <- root.workspace-file-editing;
                                    vertical-stretch <- 1;
                                    current-value <- root.workspace-preview-tab;
                                    for file in root.workspace-preview-tabs : StackItem {
                                        value <- file.id;
                                        WorkspaceFileEditor {
                                            draft <-> root.workspace-file-edit-text;
                                            saving <- root.workspace-file-edit-saving;
                                            grab-focus <- root.workspace-file-edit-focus;
                                            can-attach <- root.can-attach;
                                            edited(text) => { root.change-workspace-file-edit(text); }
                                            attach-selection(start, end, text) => { root.attach-workspace-editor-excerpt(start, end, text); }
                                            attach-disk-file => { root.attach-workspace-file(); }
                                            focus-complete => { root.workspace-file-edit-focus = false; }
                                        }
                                    }
                                }
                                workspace-image-preview := Image {
                                    visible <- !root.workspace-file-editing && root.workspace-file-kind == "image";
                                    source <- root.workspace-file-image;
                                    image-fit <- contain;
                                    vertical-stretch <- 1;
                                }
                                workspace-text-preview := ScrollView {
                                    visible <- !root.workspace-file-editing && (root.workspace-file-kind == "text" || root.workspace-file-kind == "markdown");
                                    vertical-stretch <- 1;
                                    content-y <-> root.workspace-file-offset;
                                    horizontal-scroll-bar-policy <- always-off;
                                    accessible-name <- @tr("workspace-file-content");
                                    VerticalLayout {
                                        width <- 100%;
                                        alignment <- start;
                                        padding <- 10px;
                                        workspace-file-preview-document := StyledText {
                                            text <- root.workspace-file-text;
                                            color <- Palette.text;
                                            font-family <- root.workspace-file-kind == "text" ? "monospace" : "";
                                            font-size <- 12px;
                                            wrap <- char-wrap;
                                            selectable <- true;
                                            persistent-selection <- true;
                                            vertical-alignment <- top;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    height <- 34px;
                                    visible <- root.workspace-file-path != "" && !root.workspace-file-editing;
                                    padding-right <- 8px;
                                    alignment <- end;
                                    spacing <- 6px;
                                    cross-axis-alignment <- center;
                                    attach-current-workspace-file := Button {
                                        text <- @tr("attach-file");
                                        height <- 27px;
                                        flat <- true;
                                        padding <- 5px;
                                        enabled <- root.can-attach;
                                        focus-on-click <- false;
                                        clicked => { root.attach-workspace-file(); }
                                    }
                                    attach-preview-excerpt := Button {
                                        text <- @tr("attach-selection");
                                        accessible-name <- @tr("add-selected-preview-text-to-the-conversation");
                                        height <- 27px;
                                        flat <- true;
                                        padding <- 5px;
                                        visible <- root.workspace-file-kind == "text" || root.workspace-file-kind == "markdown";
                                        enabled <- root.can-attach && workspace-file-preview-document.selected-text != "";
                                        focus-on-click <- false;
                                        clicked => {
                                            root.attach-workspace-preview-excerpt(workspace-file-preview-document.selection-start-offset,
                                                workspace-file-preview-document.selection-end-offset, workspace-file-preview-document.selected-text);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    workspace-changes-panel := VerticalLayout {
                        visible <- !root.files-active;
                        vertical-stretch <- 1;
                        spacing <- 0px;
                        HorizontalLayout {
                            height <- 35px;
                            visible <- root.workspace-review-active;
                            padding-right <- 6px;
                            spacing <- 5px;
                            cross-axis-alignment <- center;
                            git-change-filters := TabBar {
                                height <- 35px;
                                min-width <- 0px;
                                horizontal-stretch <- 1;
                                visible <- root.workspace-review-active;
                                enabled <- !root.switching && !root.review-index-busy;
                                background <- Palette.surface;
                                accessible-name <- @tr("filter-changes-by-staging-status");
                                current-value <-> root.review-filter;
                                changed(index) => {
                                    root.review-offset = 0px;
                                    root.select-review-filter();
                                }
                                review-filter-all := TabButton {
                                    value <- "all";
                                    text <- (@tr("all-filter-count") + " ") + root.review-all-count;
                                }
                                review-filter-unstaged := TabButton {
                                    value <- "unstaged";
                                    text <- (@tr("unstaged-filter-count") + " ") + root.review-unstaged-count;
                                }
                                review-filter-staged := TabButton {
                                    value <- "staged";
                                    text <- (@tr("staged-filter-count") + " ") + root.review-staged-count;
                                }
                            }
                            open-git-commit-button := Button {
                                text <- @tr("commit");
                                accessible-name <- @tr("commit-staged-changes");
                                padding <- 6px;
                                height <- 28px;
                                primary <- true;
                                border-radius <- 6px;
                                enabled <- root.review-staged-count > 0 && !root.review-index-busy && !root.switching;
                                clicked => { root.open-git-commit(); }
                            }
                        }
                        if Model.count(root.review-files) > 0 : VerticalLayout {
                            height <- Math.min(Model.count(root.review-files), 4) * 30px + 14px;
                            vertical-stretch <- 0;
                            padding <- 7px;
                            review-files := ListView {
                                row-height <- 30px;
                                enabled <- !root.switching && !root.review-index-busy;
                                accessible-name <- @tr("changed-files");
                                for file in root.review-files : ReviewTile {
                                    file-path <- file.path;
                                    change <- file.status;
                                    selected <- file.path == root.review-selection;
                                    choose => {
                                        if file.path != root.review-selection {
                                            root.review-offset = 0px;
                                        }
                                        root.select-review-file(file.path);
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height <- 36px;
                            visible <- root.review-selection != "";
                            background <- Palette.rail;
                            HorizontalLayout {
                                padding-left <- 12px;
                                padding-right <- 12px;
                                cross-axis-alignment <- center;
                                review-path := Label {
                                    text <- root.review-selection;
                                    color <- Palette.text;
                                    font-family <- "monospace";
                                    font-size <- 11px;
                                    overflow <- elide;
                                    horizontal-stretch <- 1;
                                }
                                inspect-diff-source := Button {
                                    text <- root.review-comparison-mode == "" ? @tr("view-source") : @tr("view-revision-source");
                                    height <- 27px;
                                    flat <- true;
                                    padding <- 5px;
                                    enabled <- !root.switching && (root.review-comparison-mode == "" || root.review-comparison-source-tree != "");
                                    clicked => {
                                        if root.review-comparison-mode == "" {
                                            root.show-workspace-files();
                                            root.preview-diff-source(root.review-selection);
                                        } else {
                                            root.open-comparison-source();
                                        }
                                    }
                                }
                                external-open-diff := ExternalOpenButton {
                                    visible <- root.workspace-review-active;
                                    available <- root.can-open-palette && !root.external-open-pending;
                                    label <- @tr("open-file-in-editor");
                                    activate => { root.open-diff-external(); }
                                }
                                split-patch := Button {
                                    text <- root.review-split ? @tr("unified") : @tr("split");
                                    accessible-name <- root.review-split ? @tr("switch-to-unified-diff") : @tr("switch-to-split-diff");
                                    height <- 27px;
                                    padding <- 5px;
                                    flat <- true;
                                    visible <- !root.review-raw && Model.count(root.review-pairs) > 0;
                                    enabled <- !root.switching;
                                    clicked => { root.toggle-review-split(); }
                                }
                                review-find-button := Button {
                                    text <- @tr("find");
                                    accessible-name <- @tr("find-in-this-file-diff");
                                    height <- 27px;
                                    padding <- 5px;
                                    flat <- true;
                                    visible <- Model.count(root.review-lines) > 0;
                                    enabled <- root.can-find-review;
                                    background <- root.review-find-open ? Palette.selection : #00000000;
                                    clicked => {
                                        if root.review-find-open { root.close-review-find(true); }
                                        else { root.open-review-find(); }
                                    }
                                }
                                raw-patch := Button {
                                    text <- root.review-raw ? @tr("line-numbers") : @tr("raw");
                                    accessible-name <- root.review-raw ? @tr("show-line-numbers") : @tr("show-raw-diff-text");
                                    height <- 27px;
                                    padding <- 5px;
                                    flat <- true;
                                    visible <- Model.count(root.review-lines) > 0;
                                    clicked => {
                                        root.review-raw = !root.review-raw;
                                        root.review-offset = 0px;
                                        root.schedule-review-find-reveal();
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height <- 33px;
                            visible <- root.review-selection != "" && (root.show-stage-file || root.show-unstage-file || root.show-revert-file);
                            padding-right <- 7px;
                            padding-left <- 7px;
                            spacing <- 5px;
                            alignment <- end;
                            cross-axis-alignment <- center;
                            revert-review-file := Button {
                                text <- @tr("revert-file");
                                accessible-name <- (@tr("preview-file-revert") + " ") + root.review-selection;
                                height <- 25px;
                                padding <- 4px;
                                flat <- true;
                                visible <- root.show-revert-file;
                                enabled <- !root.switching && !root.review-index-busy;
                                clicked => { root.propose-review-file-revert(); }
                            }
                            unstage-review-file := Button {
                                text <- @tr("unstage");
                                accessible-name <- (@tr("unstage") + " ") + root.review-selection;
                                height <- 25px;
                                padding <- 4px;
                                flat <- true;
                                visible <- root.show-unstage-file;
                                enabled <- !root.switching && !root.review-index-busy;
                                clicked => { root.update-review-index(false); }
                            }
                            stage-review-file := Button {
                                text <- @tr("stage-file");
                                accessible-name <- (@tr("stage") + " ") + root.review-selection;
                                height <- 25px;
                                padding <- 4px;
                                flat <- true;
                                border-radius <- 5px;
                                background <- Palette.selection;
                                visible <- root.show-stage-file;
                                enabled <- !root.switching && !root.review-index-busy;
                                clicked => { root.update-review-index(true); }
                            }
                        }
                        review-find-bar := HorizontalLayout {
                            height <- 36px;
                            visible <- root.review-find-open && root.review-selection != "";
                            padding-left <- 7px;
                            padding-right <- 7px;
                            spacing <- 4px;
                            cross-axis-alignment <- center;
                            review-find-input := SearchField {
                                height <- 28px;
                                min-width <- 50px;
                                horizontal-stretch <- 1;
                                placeholder-text <- @tr("find-in-this-diff");
                                accessible-name <- @tr("find-in-diff");
                                text <-> root.review-find-query;
                                edited(text) => { review-find-debounce.restart(); }
                            }
                            Label {
                                text <- root.review-find-query == "" ? "" : !root.review-find-ready ? @tr("finding") :
                                    root.review-find-count == 0 ? @tr("no-matches") : "" + root.review-find-position + " / " + root.review-find-count;
                                min-width <- 0px;
                                color <- Palette.muted;
                                font-size <- 11px;
                            }
                            review-find-previous := Button {
                                text <- "↑";
                                accessible-name <- @tr("previous-diff-match");
                                width <- 26px;
                                height <- 28px;
                                flat <- true;
                                padding <- 3px;
                                focus-on-click <- false;
                                enabled <- root.show-review-matches;
                                clicked => { root.move-review-find(-1); }
                            }
                            review-find-next := Button {
                                text <- "↓";
                                accessible-name <- @tr("next-diff-match");
                                width <- 26px;
                                height <- 28px;
                                flat <- true;
                                padding <- 3px;
                                focus-on-click <- false;
                                enabled <- root.show-review-matches;
                                clicked => { root.move-review-find(1); }
                            }
                            close-review-find-button := Button {
                                text <- "×";
                                accessible-name <- @tr("close-diff-search");
                                width <- 26px;
                                height <- 28px;
                                flat <- true;
                                padding <- 3px;
                                clicked => { root.close-review-find(true); }
                            }
                        }
                        HorizontalLayout {
                            height <- 24px;
                            visible <- !root.review-raw && !root.split-review-active && Model.count(root.review-lines) > 0;
                            padding-left <- 7px;
                            spacing <- 6px;
                            cross-axis-alignment <- center;
                            Label { width <- 30px; text <- @tr("old-line"); color <- Palette.muted; font-size <- 10px; }
                            Label { width <- 30px; text <- @tr("new-line"); color <- Palette.muted; font-size <- 10px; }
                            Label { text <- @tr("select-a-line-number-to-comment"); color <- Palette.muted; font-size <- 10px; }
                        }
                        review-line-list := ListView {
                            vertical-stretch <- 1;
                            row-height <- 23px;
                            row-key-field <- "id";
                            current-key <- -1;
                            content-y <-> root.review-offset;
                            visible <- !root.review-raw && !root.split-review-active && Model.count(root.review-lines) > 0;
                            background <- Palette.surface;
                            accessible-name <- @tr("file-diff-select-a-line-number-to-add-a-comment");
                            for row in root.review-lines : ReviewLineTile {
                                old-line <- row.old-line;
                                new-line <- row.new-line;
                                kind <- row.kind;
                                content <- row.content;
                                active <- row.id == root.review-line-id;
                                match-marked <- root.diff-match-marked(row.id);
                                match-current <- root.diff-match-current(row.id);
                                match-body <- root.diff-match-body(row.id);
                                can-edit <- root.can-edit-review-line(row);
                                edit => { root.edit-review-line(row.id); }
                                can-comment <- !root.switching && (root.review-note-text == "" || row.id == root.review-line-id);
                                hunk-action <- root.review-hunk-action(row);
                                hunk-action-enabled <- !root.switching && !root.review-index-busy;
                                can-revert <- root.can-revert-hunk(row);
                                update-hunk => { root.update-review-hunk(row.id); }
                                revert-hunk => { root.propose-review-hunk-revert(row.id); }
                                comment => {
                                    root.select-review-line(row.id);
                                    root.review-note-focus-pending = root.review-note-reference != "";
                                }
                            }
                        }
                        HorizontalLayout {
                            height <- 24px;
                            visible <- root.split-review-active;
                            padding-left <- 8px;
                            padding-right <- 8px;
                            spacing <- 10px;
                            cross-axis-alignment <- center;
                            Label {
                                text <- @tr("old-version");
                                horizontal-stretch <- 1;
                                preferred-width <- 0px;
                                color <- Palette.muted;
                                font-size <- 11px;
                            }
                            Label {
                                text <- @tr("new-version");
                                horizontal-stretch <- 1;
                                preferred-width <- 0px;
                                color <- Palette.muted;
                                font-size <- 11px;
                            }
                        }
                        review-pair-list := ListView {
                            vertical-stretch <- 1;
                            row-height <- 23px;
                            row-key-field <- "id";
                            current-key <- -1;
                            content-y <-> root.review-offset;
                            visible <- root.split-review-active;
                            background <- Palette.surface;
                            accessible-name <- @tr("split-diff-select-a-line-number-in-either-version-to-comment");
                            for pair in root.review-pairs : ReviewPairTile {
                                pair <- pair;
                                selected <- root.review-line-id;
                                old-selected <- root.review-line-old;
                                left-mark <- root.review-mark(pair.left.id);
                                right-mark <- root.review-mark(pair.right.id);
                                can-edit <- root.can-edit-review-line(pair.right);
                                edit(id) => { root.edit-review-line(id); }
                                can-comment <- !root.switching;
                                no-comment-text <- root.review-note-text == "";
                                hunk-action <- pair.full ? root.review-hunk-action(pair.left) : "";
                                hunk-action-enabled <- !root.switching && !root.review-index-busy;
                                can-revert <- pair.full && root.can-revert-hunk(pair.left);
                                update-hunk(id) => { root.update-review-hunk(id); }
                                revert-hunk(id) => { root.propose-review-hunk-revert(id); }
                                comment(id, old) => {
                                    root.select-review-side(id, old);
                                    root.review-note-focus-pending = root.review-note-reference != "";
                                }
                            }
                        }
                        patch-scroll := ScrollView {
                            vertical-stretch <- 1;
                            content-y <-> root.review-offset;
                            horizontal-scroll-bar-policy <- always-off;
                            visible <- root.review-raw || Model.count(root.review-lines) == 0;
                            accessible-name <- @tr("file-diff");
                            VerticalLayout {
                                width <- 100%;
                                padding <- 10px;
                                alignment <- start;
                                review-diff := StyledText {
                                    text <- root.show-review-matches ? root.review-find-raw-body : root.review-body;
                                    color <- Palette.text;
                                    font-size <- 12px;
                                    font-family <- "monospace";
                                    wrap <- char-wrap;
                                    vertical-alignment <- top;
                                    selectable <- true;
                                }
                            }
                        }
                        staged-notes-strip := HorizontalLayout {
                            height <- 35px;
                            visible <- root.review-note-count > 0;
                            padding-left <- 9px;
                            padding-right <- 9px;
                            cross-axis-alignment <- center;
                            alignment <- end;
                            show-staged-review-notes := Button {
                                text <- "" + root.review-note-count + (" " + @tr("pending-comments-count-unit"));
                                accessible-name <- (@tr("review-count-prefix") + " ") + root.review-note-count + (" " + @tr("pending-comments-count-unit"));
                                height <- 29px;
                                padding <- 5px;
                                flat <- true;
                                border-radius <- 6px;
                                background <- Palette.selection;
                                enabled <- !root.switching;
                                clicked => { root.review-notes-open = true; }
                            }
                        }
                        review-note-panel := Pane {
                            visible <- root.review-note-reference != "";
                            vertical-stretch <- 0;
                            background <- Palette.rail;
                            padding <- 9px;
                            VerticalLayout {
                                alignment <- start;
                                spacing <- 6px;
                                Label {
                                    text <- root.review-note-reference;
                                    color <- Palette.text;
                                    font-size <- 11px;
                                    font-weight <- 650;
                                    overflow <- elide;
                                }
                                review-note-input := TextArea {
                                    accessible-name <- @tr("code-review-comment");
                                    placeholder-text <- @tr("write-a-review-comment");
                                    text <-> root.review-note-text;
                                    height <- 61px;
                                    padding <- 6px;
                                    wrap <- word-wrap;
                                }
                                HorizontalLayout {
                                    height <- 32px;
                                    alignment <- end;
                                    spacing <- 7px;
                                    cancel-review-note-button := Button {
                                        text <- @tr("cancel");
                                        padding <- 6px;
                                        flat <- true;
                                        clicked => { root.cancel-review-note(); }
                                    }
                                    stage-review-note-button := Button {
                                        text <- root.review-note-queued-id >= 0 ? @tr("save-comment") : @tr("queue-comment");
                                        padding <- 5px;
                                        flat <- true;
                                        enabled <- Strings.trim(root.review-note-text) != "" && !root.switching;
                                        clicked => {
                                            root.stage-review-note();
                                            if root.review-note-reference == "" { show-staged-review-notes.focus(); }
                                        }
                                    }
                                    add-review-note-button := Button {
                                        text <- @tr("add-to-draft");
                                        padding <- 6px;
                                        primary <- true;
                                        enabled <- root.review-note-text != "" && !root.switching;
                                        clicked => { root.add-review-note(); root.focus-composer(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
