    private property <bool> can-followup <- root.composer-available && root.connected && root.busy && !root.switching && !root.stopping && !root.question-open && !root.compacting && !root.reviewing && !root.review-dialog-open && !root.palette-open && !root.followup-pending && !root.queue-pending && root.active-turn-id != "" && root.prompt-ready;
    private property <bool> can-compact-context <- root.connected && root.renamable && !root.busy && !root.switching && !root.archive-pending && !root.rename-pending && !root.conversation-archived && !root.queue-loading && !root.queue-pending && !root.followup-pending && !root.fork-pending && !root.has-queue;
    private property <bool> can-fork <- root.connected && !root.busy && root.renamable && root.can-switch-conversation && !root.conversation-archived;
    private property <bool> can-start-code-review <- root.connected && root.workspace != "" && !root.busy && !root.switching && !root.archive-pending && !root.rename-pending && !root.conversation-archived && !root.fork-pending && !root.worktree-preparing && !root.queue-loading && !root.queue-pending && !root.followup-pending && !root.has-queue;
    private property <bool> show-header-code-review <- !root.review-open && root.workspace != "" && !root.conversation-archived;
    private property <bool> external-project-in-menu <- root.compact-composer && root.workspace != "";
    private property <bool> git-branch-in-menu <- root.workspace != "" && (root.compact-composer || root.git-checkout-label == "");
    private property <bool> can-manage-current-conversation <- root.connected && root.renamable && !root.busy && !root.switching && !root.rename-pending && !root.archive-pending && !root.fork-pending;
    out property <[PaletteItem]> palette-commands <- [
        PaletteItem { key: "quick-open", title: @tr("quick-open-file"), detail: "⌘ / Ctrl + P", enabled: root.workspace != "" },
        PaletteItem { key: "open-folder", title: @tr("choose-a-workspace"), detail: "", enabled: root.can-switch-conversation },
        PaletteItem { key: "notifications", title: @tr("notification-settings"), detail: "", enabled: true },
        PaletteItem { key: "activity", title: @tr("view-conversation-activity"), detail: "⌘ / Ctrl + Alt + U", enabled: true },
        PaletteItem { key: "next-attention", title: @tr("open-the-next-conversation-that-needs-input"), detail: "⌘ / Ctrl + Alt + A", enabled: root.can-switch-conversation && root.activity-can-jump },
        PaletteItem { key: "back", title: @tr("go-to-previous-conversation"), detail: "⌘ / Ctrl + [", enabled: root.can-travel && root.navigation-back },
        PaletteItem { key: "forward", title: @tr("go-to-next-conversation"), detail: "⌘ / Ctrl + ]", enabled: root.can-travel && root.navigation-forward },
        PaletteItem { key: "new-conversation", title: @tr("new-conversation-action"), detail: "", enabled: root.can-switch-conversation && root.workspace != "" },
        PaletteItem { key: "reopen-conversation-tab", title: @tr("reopen-closed-conversation-tab"), detail: "⌘ / Ctrl + Shift + T", enabled: root.can-reopen-conversation-tab && root.can-travel },
        PaletteItem { key: "search-sessions", title: @tr("search-conversations"), detail: "⌘ / Ctrl + K", enabled: root.connected && root.workspace != "" },
        PaletteItem { key: "search-all-projects", title: @tr("search-all-project-conversations"), detail: "", enabled: root.connected && Model.count(root.project-choices) > 0 },
        PaletteItem { key: "workspace-files", title: @tr("show-file-tree"), detail: "⌘ / Ctrl + Shift + E", enabled: root.workspace != "" },
        PaletteItem { key: "project-actions", title: @tr("run-project-action"), detail: "", enabled: root.workspace != "" && !root.switching },
        PaletteItem { key: "terminal", title: root.terminal-open ? @tr("hide-terminal") : @tr("open-terminal"), detail: "⌘ / Ctrl + J", enabled: root.workspace != "" && root.can-open-palette },
        PaletteItem { key: "generation-settings", title: @tr("choose-model-and-reasoning-effort"), detail: "Ctrl + Shift + M", enabled: root.can-open-generation-picker },
        PaletteItem { key: "plan-mode", title: root.plan-mode ? @tr("return-to-execution-mode") : @tr("enable-plan-mode"), detail: "", enabled: root.plan-available && root.can-choose-model && !root.conversation-archived },
        PaletteItem { key: "fork-current", title: @tr("fork-current-conversation"), detail: "", enabled: root.can-fork },
        PaletteItem { key: "workspace-changes", title: @tr("view-workspace-changes"), detail: "⌘ / Ctrl + Shift + D", enabled: root.workspace != "" },
        PaletteItem { key: "review-code", title: @tr("review-code"), detail: "⌘ / Ctrl + Shift + R", enabled: root.can-start-code-review },
        PaletteItem { key: "find-chat", title: @tr("find-in-conversation"), detail: "⌘ / Ctrl + F", enabled: root.can-find-chat },
        PaletteItem { key: "focus-composer", title: @tr("focus-message-composer"), detail: "", enabled: root.workspace != "" && !root.conversation-archived },
        PaletteItem { key: "latest-message", title: @tr("jump-to-latest-message"), detail: "", enabled: root.reading-history },
        PaletteItem { key: "pin-session", title: root.conversation-pinned ? @tr("unpin-conversation") : @tr("pin-current-conversation"), detail: "⌘ / Ctrl + Alt + P", enabled: root.can-pin-session },
        PaletteItem { key: "composer-settings", title: @tr("send-settings"), detail: "", enabled: true },
        PaletteItem { key: "appearance", title: @tr("change-appearance"), detail: "", enabled: true },
        PaletteItem { key: "stop", title: @tr("stop-this-turn"), detail: "", enabled: root.busy && !root.stopping && !root.switching },
    ];
    private property <bool> has-models <- Model.count(root.model-choices) > 1;
    private property <bool> show-model-settings <- !root.conversation-archived && (root.has-models || root.models-loading || root.models-status != "" || root.plan-available);
    private property <bool> can-choose-model <- root.connected && !root.busy && !root.switching && !root.archive-pending && !root.queue-pending && !root.followup-pending;
    private property <bool> can-open-generation-picker <- root.show-model-settings && !root.expanded-inspector && root.can-open-palette;
    private property <string> model-label <- root.generation-model == "" ? @tr("conversation-default") :
        model-choice.current-text == "" ? root.generation-model : model-choice.current-text;
    private property <string> generation-label <- (root.plan-mode ? (@tr("plan-prefix") + " ") : "") +
        (root.models-loading && !root.has-models ? @tr("loading-models-short") : root.model-label);
    private property <string> generation-description <- root.generation-label +
        (root.generation-model != "" && effort-choice.current-text != "" ? " · " + effort-choice.current-text : "");
    callback attach();
    callback select-appearance(mode: ColorScheme);
    callback system-appearance-changed(mode: ColorScheme);
    callback save-appearance(mode: ColorScheme);
    select-appearance(mode) => {
        if mode != Palette.mode || root.appearance-status != "" {
            Palette.choose(mode);
            root.save-appearance(mode);
        }
    }
    system-appearance-changed(mode) => { Palette.update-system(mode); }

    callback select-workspace(path: string);
