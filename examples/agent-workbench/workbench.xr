        && !root.review-dialog-open && !root.context-open && !root.question-open && !root.message-quote-open && !root.historical-prompt-open && !root.review-line-edit-open && !root.review-notes-open && !root.review-revert-open
        && !root.notification-settings-open && !root.attachment-preview-open && !root.appearance-open && !root.composer-settings-open && !root.queue-edit-open && !root.external-open && !root.git-commit-open && !root.git-push-open && !root.git-pr-open && !root.git-branch-open && !root.worktree-start-open && !root.handoff-open && !root.workspace-edit-confirm-open && !root.workspace-window-confirm-open;
