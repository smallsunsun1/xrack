    private property <bool> can-attach <- root.can-edit-attachments && !root.conversation-archived && !root.question-open && !attachment-picker.pending;
    private property <bool> prompt-ready <- (root.draft != "" || root.has-attachments) && !root.attachment-loading && !attachment-picker.pending && !root.attachment-preview-open;
    private property <bool> can-switch-conversation <- !root.switching && !root.sending-prompt && !root.followup-pending && !root.queue-pending && !root.fork-pending && !root.worktree-preparing && !root.archive-pending && !root.rename-pending && !root.review-line-edit-open && !root.git-commit-pending && !root.git-push-pending && !root.git-pr-pending && !root.git-branch-pending && !root.handoff-preparing && !root.handoff-pending && !picker.pending && !attachment-picker.pending;
