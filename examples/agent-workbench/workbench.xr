    callback open-notification-settings();
    callback request-notification-access();
    callback refresh-notification-access();
    callback save-notification-settings();
    callback restore-notification-window();
    open-notification-settings => {
        root.notification-settings-open = true;
        root.refresh-notification-access();
    }
    restore-notification-window => {
        if root.minimized {
            root.restore();
        }
    }
    callback close-activity();
    callback toggle-activity();
    callback mark-activity-read();
    callback open-next-attention();
    open-activity => {
        root.sessions-open = true;
        if root.expanded-inspector { root.review-open = false; }
        root.activity-open = true;
        activity-filter-choice.focus();
    }
    close-activity => {
        root.activity-open = false;
        activity-toggle.focus();
    }
    toggle-activity => {
        if root.activity-open && root.sessions-open {
            root.close-activity();
        } else {
            root.open-activity();
        }
    }
    callback restore-reading-position(offset: length);
    callback load-session-history(more: bool);
