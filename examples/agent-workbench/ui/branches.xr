import { Palette } from "theme.xr";

export component GitBranchRow inherits Rectangle {
    in property <string> name;
    in property <string> state;
    in property <bool> selected;
    in property <bool> available;
    callback choose();
    private property <string> description: root.state == "current" ? @tr("current-git-branch") :
        root.state == "occupied" ? @tr("git-branch-in-another-worktree") : "";

    git-branch-row-button := Button {
        width: 100%;
        height: 100%;
        text: root.name;
        accessible-name: root.description == "" ? root.name : root.name + " · " + root.description;
        enabled: root.available && root.state == "";
        flat: true;
        padding: 0px;
        background: root.selected ? Palette.selection : Palette.rail;
        ButtonContent {
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                cross-axis-alignment: center;
                Label {
                    text: root.name;
                    font-family: "monospace";
                    font-size: 11px;
                    horizontal-stretch: 1;
                    overflow: elide;
                    color: Palette.text;
                }
                Label {
                    text: root.description;
                    visible: root.description != "";
                    font-size: 11px;
                    color: Palette.muted;
                }
            }
        }
        clicked => { root.choose(); }
    }
}

export component GitBranchContent inherits VerticalLayout {
    in property <string> location;
    in property <bool> detached;
    in-out property <string> mode;
    in-out property <string> query;
    in-out property <string> new-name;
    in property <bool> loading;
    in property <bool> pending;
    in property <bool> done;
    in property <bool> ready;
    in property <string> error;
    callback filter(text: string);
    callback confirm();
    callback reload();
    callback dismiss();

    padding: 14px;
    spacing: 8px;
    alignment: start;
    git-branch-location := Label {
        text: root.loading ? @tr("reading-git") : root.location == "" ? "" :
            root.detached ? @tr("commit-detached-head", revision: root.location) :
            @tr("commit-current-branch", branch: root.location);
        height: 23px;
        color: Palette.text;
        font-weight: 650;
        font-size: 13px;
        overflow: elide;
    }
    git-branch-mode-choice := RadioGroup {
        height: 35px;
        orientation: Orientation.horizontal;
        current-value: root.mode;
        accessible-name: @tr("git-branch-operation");
        visible: !root.done;
        enabled: !root.loading && !root.pending;
        selected(value) => { root.mode = value; }
        git-branch-mode-switch := RadioButton {
            text: @tr("switch-local-branch");
            value: "switch";
        }
        git-branch-mode-create := RadioButton {
            text: @tr("create-branch-here");
            value: "create";
        }
    }
    git-branch-query-input := TextInput {
        text <=> root.query;
        height: 33px;
        placeholder-text: @tr("filter-local-branches");
        accessible-name: @tr("filter-local-branches");
        visible: root.mode == "switch" && !root.done;
        enabled: !root.loading && !root.pending;
        edited => { root.filter(root.query); }
    }
    VerticalLayout {
        height: 139px;
        visible: root.mode == "switch" && !root.done;
        @slot(branches)
    }
    git-branch-name-input := TextInput {
        text <=> root.new-name;
        height: 33px;
        placeholder-text: @tr("new-local-branch-name");
        accessible-name: @tr("new-local-branch-name");
        visible: root.mode == "create" && !root.done;
        enabled: !root.loading && !root.pending;
    }
    git-branch-complete := Label {
        text: @tr("git-branch-checked-out", branch: root.location);
        visible: root.done;
        color: Palette.success;
        font-size: 12px;
        height: 29px;
        overflow: elide;
    }
    git-branch-error-label := Label {
        text: root.error;
        visible: root.error != "";
        color: root.done ? Palette.muted : Palette.error;
        font-size: 11px;
        height: 34px;
        wrap: word-wrap;
        max-lines: 2;
        overflow: elide;
    }
    HorizontalLayout {
        height: 33px;
        cross-axis-alignment: center;
        spacing: 7px;
        reload-git-branches-button := Button {
            text: @tr("refresh");
            visible: !root.done;
            enabled: !root.loading && !root.pending;
            flat: true;
            padding: 6px;
            clicked => { root.reload(); }
        }
        Rectangle { horizontal-stretch: 1; }
        cancel-git-branch := Button {
            text: root.done ? @tr("done") : @tr("cancel");
            primary: root.done;
            flat: !root.done;
            enabled: !root.pending;
            padding: 6px;
            clicked => { root.dismiss(); }
        }
        confirm-git-branch-button := Button {
            text: root.pending ? @tr("updating-git-branch") :
                root.mode == "create" ? @tr("create-branch-here") : @tr("switch-local-branch");
            visible: !root.done;
            enabled: root.ready;
            primary: true;
            border-radius: 6px;
            padding: 6px;
            clicked => { root.confirm(); }
        }
    }
}
