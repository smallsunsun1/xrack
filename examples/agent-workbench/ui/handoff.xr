import { Palette } from "theme.xr";

export component HandoffContent inherits VerticalLayout {
    in property <string> source;
    in property <string> source-commit;
    in property <string> destination;
    in-out property <bool> copy;
    in property <bool> can-copy;
    in property <int> include-count;
    in property <bool> loading;
    in property <bool> ready;
    in property <bool> preparing;
    in property <bool> pending;
    in property <bool> prepared;
    in property <string> error;
    callback confirm();
    callback reload();
    callback cancel();

    padding: 14px;
    spacing: 8px;
    alignment: start;
    VerticalLayout {
        spacing: 3px;
        height: 49px;
        Label {
            text: root.source-commit == "" ? @tr("handoff-source") :
                @tr("handoff-source-with-commit", revision: root.source-commit);
            color: Palette.muted;
            font-size: 11px;
            height: 17px;
        }
        Label {
            text: root.source;
            font-family: "monospace";
            font-size: 12px;
            color: Palette.text;
            overflow: elide;
            height: 19px;
        }
    }
    VerticalLayout {
        spacing: 3px;
        height: 49px;
        Label {
            text: @tr("handoff-destination");
            color: Palette.muted;
            font-size: 11px;
            height: 17px;
        }
        handoff-target-label := Label {
            text: root.loading ? @tr("reading-git") :
                root.destination != "" ? root.destination :
                root.ready ? @tr("handoff-new-worktree") : "";
            font-family: "monospace";
            font-size: 12px;
            color: Palette.text;
            overflow: elide;
            height: 19px;
        }
    }
    handoff-copy-option := CheckBox {
        text: @tr("handoff-copy-tracked");
        checked <=> root.copy;
        enabled: root.can-copy && !root.loading && !root.preparing && !root.pending && !root.prepared;
        height: 26px;
    }
    handoff-include-status := Label {
        text: @tr("worktree-include-summary", count: root.include-count);
        visible: root.include-count > 0 && !root.prepared;
        height: 20px;
        font-size: 11px;
        color: Palette.muted;
    }
    Label {
        text: @tr("handoff-destination-ready");
        color: Palette.muted;
        font-size: 11px;
        height: 20px;
        visible: root.prepared;
    }
    handoff-error-label := Label {
        text: root.error;
        visible: root.error != "";
        color: Palette.error;
        font-size: 11px;
        height: 36px;
        wrap: word-wrap;
        max-lines: 2;
        overflow: elide;
    }
    HorizontalLayout {
        height: 33px;
        spacing: 7px;
        cross-axis-alignment: center;
        reload-handoff-button := Button {
            text: @tr("refresh");
            enabled: !root.loading && !root.preparing && !root.pending;
            flat: true;
            padding: 5px;
            clicked => { root.reload(); }
        }
        Rectangle { horizontal-stretch: 1; }
        cancel-handoff-button := Button {
            text: @tr("cancel");
            enabled: !root.preparing && !root.pending;
            flat: true;
            padding: 6px;
            clicked => { root.cancel(); }
        }
        confirm-handoff-button := Button {
            text: root.preparing || root.pending ? @tr("handoff-in-progress") : @tr("handoff-conversation");
            enabled: root.ready;
            primary: true;
            border-radius: 6px;
            padding: 6px;
            clicked => { root.confirm(); }
        }
    }
}
