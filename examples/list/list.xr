export struct DelegateSetting {
    label: string,
    selected: CheckState,
    enabled: bool,
}

export struct ListVisibilityFlags {
    shown: bool,
}

export struct ListVisibilityRecord {
    label: string,
    height: length,
    flags: ListVisibilityFlags,
}

component VisibilityTile inherits Button {
    in property <string> caption;
    property <int> presses: 0;
    callback activated();
    text: root.caption + " · " + root.presses;
    clicked => { root.presses += 1; root.activated(); }
}

export component ListVisibilityDemo inherits Window {
    title: "XRack · 列表与网格的记录可见性";
    width: 660px; height: 320px;
    background: #182331;
    in-out property <[ListVisibilityRecord]> records: [
        ListVisibilityRecord { label: "文档", height: 30px, flags: ListVisibilityFlags { shown: true } },
        ListVisibilityRecord { label: "临时项", height: 30px, flags: ListVisibilityFlags { shown: false } },
        ListVisibilityRecord { label: "图片", height: 52px, flags: ListVisibilityFlags { shown: true } },
        ListVisibilityRecord { label: "音频", height: 30px, flags: ListVisibilityFlags { shown: true } },
    ];
    in-out property <int> standard-index: 0;
    in property <int> inspected-source: 2;
    out property <int> visible-index: entries.view-index-for-source(root.inspected-source);
    out property <int> selected-source: summary.source-index-for-view(root.standard-index);
    out property <int> last-source-index: -1;
    callback reveal-all();
    callback select-source(int);
    select-source(source) => {
        entries.select-source-index(source);
        tiles.select-source-index(source);
        summary.select-source-index(source);
    }
    callback locate-source(int);
    locate-source(source) => {
        entries.position-view-at-source-index(source, beginning);
        tiles.position-view-at-source-index(source, beginning);
        summary.position-view-at-source-index(source, beginning);
    }

    HorizontalLayout {
        x: 12px; y: 8px; width: 636px; height: 32px;
        spacing: 8px;
        reveal := Button { text: "显示全部记录"; clicked => { root.reveal-all(); } }
        Text { text: "取消左侧勾选会隐藏记录 · 网格点击次数随记录保留"; }
    }
    entries := ListView {
        x: 12px; y: 48px; width: 200px; height: 254px;
        row-height: 30px; row-height-field: "height";
        row-visible-field: "flags.shown";
        preserve-scroll-anchor: true;
        for entry[source] in root.records : CheckDelegate {
            text: entry.label;
            checked <=> entry.flags.shown;
            toggled => { root.last-source-index = source; }
        }
    }
    tiles := GridView {
        x: 228px; y: 48px; width: 204px; height: 254px;
        cell-width: 94px; cell-height: 44px; spacing: 6px;
        row-visible-field: "flags.shown";
        for entry[source] in root.records : VisibilityTile {
            caption: entry.label;
            activated => { root.last-source-index = source; }
        }
    }
    summary := StandardListView {
        x: 448px; y: 48px; width: 200px; height: 254px;
        model: root.records; text-role: "label";
        row-height: 30px; row-height-field: "height";
        row-visible-field: "flags.shown";
        current-index <=> root.standard-index;
    }
}

component NestedTrack inherits Button {
    in property <string> caption;
    property <int> plays: 0;
    callback played(string);
    text: root.caption + " · " + root.plays;
    clicked => {
        root.plays += 1;
        root.played(root.caption);
    }
}

component NestedAlbum inherits Rectangle {
    in property <string> name;
    in property <[string]> tracks;
    callback played(string);
    background: #26374e;
    Text { x: 10px; y: 7px; text: root.name; }
    tracks-view := ListView {
        x: 10px; y: 31px;
        width: 95%; height: 96px;
        row-height: 24px;
        preserve-scroll-anchor: true;
        for track in root.tracks : NestedTrack {
            caption: track;
            played(caption) => { root.played(caption); }
        }
    }
}

export component NestedListsDemo inherits Window {
    title: "XRack · 嵌套虚拟列表";
    width: 580px; height: 330px;
    background: #182331;
    in property <[string]> albums: ["文档", "图片", "音频", "视频"];
    in property <[string]> tracks: ["条目 0", "条目 1", "条目 2", "条目 3", "条目 4", "条目 5"];
    out property <string> last-played: "请选择一项";
    Text { x: 14px; y: 9px; text: root.last-played; }
    albums-view := ListView {
        x: 10px; y: 38px;
        width: 96%; height: 280px;
        row-height: 140px;
        for album in root.albums : NestedAlbum {
            name: album;
            tracks: root.tracks;
            played(caption) => { root.last-played = album + " · " + caption; }
        }
    }
}

export struct WorkspaceRecord {
    key: int,
    parent: int,
    title: string,
    quantity: int,
    note: string,
}

component WorkspaceRow inherits Rectangle {
    in property <string> label;
    in-out property <[WorkspaceRecord]> records;
    in property <int> branch: -1;
    background: #26374e;
    Text { x: 10px; y: 5px; text: root.label; }
    entries := StandardTableView {
        x: 10px; y: 30px; width: 52%; height: 120px;
        accessible-name: "工作表";
        row-height: 24px; header-height: 24px;
        row-header-width: 30px;
        current-row: 0;
        selection-target: SelectionTarget.cells;
        copyable: true;
        pasteable: true;
        undoable: true;
        edit-on-tab: true;
        movable-rows: true;
        frozen-columns: 1;
        model: root.records;
        TableColumn { title: "名称"; field: "title"; width: 150px; editable: true; }
        TableColumn { title: "数量"; field: "quantity"; width: 110px; editable: true; }
        TableColumn { title: "备注"; field: "note"; width: 230px; editable: true; }
    }
    folders := TreeView {
        x: 390px; y: 30px; width: 41%; height: 120px;
        accessible-name: "目录";
        row-height: 24px;
        root-key: root.branch;
        for record in root.records : TreeRow {
            key: record.key;
            parent-key: record.parent;
            TreeCell { text <=> record.title; }
        }
    }
}

export component NestedDataDemo inherits Window {
    title: "XRack · 嵌套表格和树";
    width: 720px; height: 364px;
    background: #182331;
    in property <[string]> groups: ["项目 A", "项目 B", "项目 C"];
    in-out property <[WorkspaceRecord]> records: [
        WorkspaceRecord { key: 1, parent: -1, title: "资料", quantity: 1, note: "目录" },
        WorkspaceRecord { key: 2, parent: 1, title: "需求", quantity: 2, note: "文档" },
        WorkspaceRecord { key: 3, parent: 1, title: "设计", quantity: 3, note: "文档" },
        WorkspaceRecord { key: 4, parent: -1, title: "测试", quantity: 4, note: "目录" },
        WorkspaceRecord { key: 5, parent: 4, title: "报告", quantity: 5, note: "文档" },
        WorkspaceRecord { key: 6, parent: -1, title: "归档", quantity: 6, note: "目录" },
    ];
    in property <int> branch: -1;
    Text { x: 14px; y: 8px; text: "工作表和目录共用记录 · 双击名称编辑"; }
    projects := ListView {
        x: 10px; y: 34px; width: 97%; height: 320px;
        row-height: 160px;
        for group in root.groups : WorkspaceRow {
            label: group;
            records: root.records;
            branch: root.branch;
        }
    }
}

export component ItemDelegatesDemo inherits Window {
    title: "XRack · 列表委托";
    width: 644px;
    height: 398px;
    background: #182331;

    in-out property <int> current-action: 0;
    in-out property <int> current-mode: 0;
    in-out property <[DelegateSetting]> settings: [
        DelegateSetting { label: "文档", selected: CheckState.unchecked, enabled: true },
        DelegateSetting { label: "图片", selected: CheckState.partially-checked, enabled: false },
        DelegateSetting { label: "音频", selected: CheckState.checked, enabled: true },
    ];
    out property <string> last-action: "打开工作区";
    out property <int> edits: 0;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 6px;
                Text { text: "常用操作"; }
                actions := ListView {
                    row-height: 36px;
                    current-index <=> root.current-action;
                    for label[index] in ["打开工作区", "显示最近文件", "查看归档"] : ItemDelegate {
                        text: label;
                        clicked => { root.last-action = label + " · " + (index + 1); }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "显示模式"; }
                modes := ListView {
                    row-height: 36px;
                    current-index <=> root.current-mode;
                    for label in ["详细", "紧凑", "仅文件名"] : RadioDelegate { text: label; }
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 6px;
                Text { text: "同步范围"; }
                checks := ListView {
                    row-height: 36px;
                    for setting in root.settings : CheckDelegate {
                        text: setting.label;
                        tristate: true;
                        check-state <=> setting.selected;
                        check-state-changed(state) => { root.edits += 1; }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "离线可用"; }
                switches := ListView {
                    row-height: 36px;
                    for setting in root.settings : SwitchDelegate {
                        text: setting.label;
                        checked <=> setting.enabled;
                        toggled => { root.edits += 1; }
                    }
                }
            }
        }
        Text { text: root.last-action; color: #acc0db; }
    }
}

export component ListDemo inherits Window {
    title: "XRack · ListView";
    width: 540px;
    height: 380px;
    background: #182331;

    in-out property <int> count: 100000;
    in-out property <int> current: -1;
    out property <int> selections: 0;
    pure callback row-caption(int) -> string;
    row-caption(row) => { "记录 " + (row + 1) }

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: "虚拟列表 · " + root.count + " 条记录"; font-size: 20px; }
        Text { text: "滚轮浏览，点击选择，Home / End 跳到首尾"; color: #acc0db; }
        records := ListView {
            row-height: 32px;
            background: #223249;
            current-index <=> root.current;
            changed(row) => { root.selections += 1; }

            for item[index] in root.count : Rectangle {
                background: index % 2 == 0 ? #263750 : #223249;
                Text { x: 12px; y: 6px; text: root.row-caption(item); }
            }
        }
        Text { text: root.current < 0 ? "尚未选择" : "已选择第 " + (root.current + 1) + " 条记录"; color: #b8caff; }
    }
}

export component ScrollBarsDemo inherits Window {
    title: "XRack · External scroll controls";
    width: 352px;
    height: 272px;
    background: #f0f3fa;
    in-out property <length> horizontal: 0px;
    in-out property <length> vertical: 0px;
    in property <length> canvas-height: 588px;
    in property <bool> scroll-enabled: true;
    in property <bool> canvas-visible: true;
    in property <Orientation> readout-axis: Orientation.vertical;
    in property <ScrollSnapMode> snap-mode: ScrollSnapMode.none;
    out property <int> scrolls: 0;
    out property <float> vertical-position: vertical-bar.position;
    out property <float> vertical-size: vertical-bar.size;
    out property <float> readout-position: readout.position;
    out property <float> readout-size: readout.size;
    out property <float> last-scroll-position: 0;

    canvas := ScrollView {
        x: 16px; y: 16px; width: 260px; height: 196px;
        content-width: 520px; content-height: root.canvas-height;
        content-x <=> root.horizontal;
        content-y <=> root.vertical;
        enabled: root.scroll-enabled;
        visible: root.canvas-visible;
        horizontal-scroll-bar-policy: always-off;
        vertical-scroll-bar-policy: always-off;
        scrolled() => {
            root.scrolls += 1;
            root.last-scroll-position = vertical-bar.position;
        }
        Rectangle { width: 100%; height: 100%; background: #263750; }
        Rectangle { x: 24px; y: 24px; width: 88px; height: 64px; background: #59bf94; }
        Rectangle { x: 340px; y: 24px; width: 88px; height: 64px; background: #efab56; }
        if root.canvas-height >= 496px : Rectangle {
            x: 24px; y: 432px; width: 88px; height: 64px; background: #72a9ee;
        }
    }
    vertical-bar := ScrollBar {
        target: canvas;
        snap-mode: root.snap-mode;
        step-size: 0.3;
        x: 288px; y: 16px; width: 14px; height: 196px;
        accessible-name: "Canvas vertical scroll";
    }
    vertical-indicator := ScrollIndicator {
        target: canvas;
        x: 316px; y: 16px; width: 8px; height: 196px;
    }
    horizontal-bar := ScrollBar {
        target: canvas;
        orientation: Orientation.horizontal;
        x: 16px; y: 224px; width: 260px; height: 14px;
        accessible-name: "Canvas horizontal scroll";
    }
    readout := ScrollIndicator {
        target: canvas;
        orientation: root.readout-axis;
        policy: always-off;
    }
    ScrollIndicator {
        position: readout.position;
        size: readout.size;
        orientation: Orientation.horizontal;
        visible: root.canvas-visible;
        x: 16px; y: 248px; width: 260px; height: 8px;
    }
}

export component StandaloneScrollDemo inherits Window {
    title: "XRack · Standalone scroll controls";
    width: 352px;
    height: 272px;
    background: #f0f3fa;
    in-out property <float> offset: 0;
    in property <float> thumb-size: 0.25;
    in property <bool> interactive: true;
    in property <ScrollSnapMode> snap-mode: ScrollSnapMode.none;
    in-out property <bool> snap-on-release: false;
    out property <float> position: bar.position;
    out property <float> size: bar.size;
    out property <float> horizontal-position: horizontal-bar.position;
    out property <int> changes: 0;
    out property <float> last-change: 0;
    out property <float> before-jump: 0;
    out property <float> after-jump: 0;
    callback jump();
    jump() => {
        root.before-jump = bar.position;
        root.offset = 0.5;
        root.after-jump = bar.position;
    }

    Rectangle {
        x: 16px; y: 16px; width: 260px; height: 196px; clip: true;
        canvas := Rectangle {
            x: -horizontal-bar.position * 520px;
            y: -bar.position * 784px;
            width: 520px; height: 784px; background: #263750;
            Rectangle { x: 24px; y: 24px; width: 88px; height: 64px; background: #59bf94; }
            Rectangle { x: 24px; y: 612px; width: 88px; height: 64px; background: #72a9ee; }
            Rectangle { x: 340px; y: 24px; width: 88px; height: 64px; background: #efab56; }
        }
    }
    bar := ScrollBar {
        x: 288px; y: 16px; width: 14px; height: 196px;
        position <=> root.offset;
        size: root.thumb-size;
        minimum-size: 0.4;
        step-size: 0.125;
        snap-mode: root.snap-on-release ? ScrollSnapMode.on-release : root.snap-mode;
        interactive: root.interactive;
        accessible-name: "Canvas position";
        changed(value) => { root.changes += 1; root.last-change = value; }
    }
    indicator := ScrollIndicator {
        x: 316px; y: 16px; width: 8px; height: 196px;
        position: bar.position;
        size: bar.size;
    }
    horizontal-bar := ScrollBar {
        x: 16px; y: 224px; width: 260px; height: 14px;
        orientation: horizontal;
        size: 0.5;
        accessible-name: "Canvas horizontal position";
    }
    snap-toggle := CheckBox {
        x: 16px; y: 242px; width: 172px; height: 24px;
        checked <=> root.snap-on-release;
        text: "Snap on release";
    }
}

export component ScrollPositionDemo inherits Window {
    title: "XRack · 滚动定位";
    width: 540px; height: 300px;
    background: #182331;
    in-out property <int> count: 10000;
    in-out property <int> current: 0;
    in-out property <length> records-target: 0px;
    in property <bool> preview-enabled: true;
    in property <bool> pan-enabled: true;
    out property <length> preview-x: preview.content-x;
    out property <length> preview-y: preview.content-y;
    out property <length> records-y: records.content-y;
    out property <length> records-height: records.visible-height;
    out property <int> preview-scrolls: 0;
    out property <int> records-scrolls: 0;
    out property <length> last-preview-x: 0px;
    out property <length> last-preview-y: 0px;
    out property <int> preview-clicks: 0;

    callback scroll-preview(length, length);
    scroll-preview(x, y) => { preview.scroll-to(x, y); }
    callback position(int, ScrollAlignment);
    position(row, alignment) => { records.position-view-at-index(row, alignment); }
    callback resize-and-position(int, int);
    resize-and-position(count, row) => {
        root.count = count;
        records.position-view-at-index(row, end);
    }

    Text { x: 16px; y: 12px; text: "滚动定位 · 虚拟列表"; font-size: 20px; }
    preview := ScrollView {
        x: 16px; y: 50px; width: 160px; height: 120px;
        content-width: 320px; content-height: 240px;
        enabled: root.preview-enabled;
        mouse-drag-pan-enabled: root.pan-enabled;
        scrolled() => {
            root.preview-scrolls += 1;
            root.last-preview-x = self.content-x;
            root.last-preview-y = self.content-y;
        }
        Rectangle { width: 320px; height: 240px; background: #263750; }
        Rectangle {
            x: 96px; y: 60px; width: 88px; height: 80px;
            background: root.preview-scrolls > 0 ? #49b989 : #4687da;
        }
        Text { x: 104px; y: 66px; text: "目标区"; }
        canvas-button := Button {
            x: 10px; y: 8px; width: 82px; height: 28px;
            text: "点或拖";
            clicked() => { root.preview-clicks += 1; }
        }
    }
    records := ListView {
        x: 190px; y: 50px; width: 334px; height: 120px; row-height: 24px;
        current-index <=> root.current;
        content-y <=> root.records-target;
        mouse-drag-pan-enabled: root.pan-enabled;
        scrolled() => { root.records-scrolls += 1; }
        for item in root.count : Rectangle {
            background: item % 2 == 0 ? #263750 : #304565;
            Text { x: 12px; y: 2px; text: "记录 " + item; }
        }
    }
    preview-offset := Text {
        x: 16px; y: 184px;
        text: "画布 " + (root.preview-x / 1px) + ", " + (root.preview-y / 1px);
    }
    list-offset := Text {
        x: 190px; y: 184px;
        text: "列表 Y " + (root.records-y / 1px);
    }
    jump := Button {
        x: 16px; y: 226px; width: 202px; height: 40px;
        text: "定位到第 9000 行";
        clicked() => {
            root.scroll-preview(96px, 60px);
            root.position(9000, ScrollAlignment.center);
        }
    }
    reset := Button {
        x: 228px; y: 226px; width: 136px; height: 40px;
        text: "回到起点";
        clicked() => { root.scroll-preview(0px, 0px); root.position(0, beginning); }
    }
    scroll-status := Text {
        x: 16px; y: 274px; color: #acc0db;
        text: "用户滚动  画布 " + root.preview-scrolls + " · 列表 " + root.records-scrolls + " · 点击 " + root.preview-clicks;
    }
}

export component LinkedScrollDemo inherits Window {
    title: "XRack · 双向滚动绑定";
    width: 540px; height: 270px;
    background: #182331;
    in-out property <length> vertical: -36px;
    in-out property <length> horizontal: 0px;
    in property <length> small-content: 180px;
    out property <length> large-y: large.content-y;
    out property <length> small-y: small.content-y;
    out property <length> follower-y: follower.content-y;
    out property <int> large-scrolls: 0;
    out property <int> small-scrolls: 0;
    out property <length> large-writeback: 0px;

    Text { x: 16px; y: 12px; text: "目标 Y " + (root.vertical / 1px); font-size: 20px; }
    Text { x: 16px; y: 45px; text: "共享位置 · 大画布"; }
    Text { x: 190px; y: 45px; text: "共享位置 · 小画布"; }
    Text { x: 364px; y: 45px; text: "单向初值"; }

    large := ScrollView {
        x: 16px; y: 75px; width: 160px; height: 120px;
        content-width: 320px; content-height: 420px;
        content-x <=> root.horizontal;
        content-y <=> root.vertical;
        scrolled() => {
            root.large-scrolls += 1;
            root.large-writeback = root.vertical;
        }
        Rectangle { width: 100%; height: 100%; background: #263750; }
        Rectangle { x: 45px; y: 95px; width: 80px; height: 40px; background: #49b989; }
    }
    small := ScrollView {
        x: 190px; y: 75px; width: 160px; height: 120px;
        content-height: root.small-content;
        content-y <=> root.vertical;
        scrolled() => { root.small-scrolls += 1; }
        Rectangle { width: 100%; height: 100%; background: #304565; }
        Rectangle { x: 35px; y: 75px; width: 80px; height: 40px; background: #efab56; }
    }
    follower := ScrollView {
        x: 364px; y: 75px; width: 160px; height: 120px;
        content-height: 420px;
        content-y: root.vertical;
        Rectangle { width: 100%; height: 100%; background: #263750; }
        Rectangle { x: 35px; y: 95px; width: 80px; height: 40px; background: #4687da; }
    }
    move-small := Button {
        x: 16px; y: 216px; width: 158px; height: 36px;
        text: "小画布定位到 40";
        clicked() => { small.scroll-to(0px, 40px); }
    }
    set-deep := Button {
        x: 190px; y: 216px; width: 160px; height: 36px;
        text: "共享目标设为 -170";
        clicked() => { root.vertical = -170px; }
    }
}

export struct DirectoryItem {
    label: string,
    rank: int,
}

export component AnchoredListDemo inherits Window {
    title: "XRack · 保留虚拟列表阅读位置";
    width: 560px; height: 274px;
    background: #182331;
    in-out property <[DirectoryItem]> records: [];
    in property <length> anchor-row-height: 32px;
    in property <bool> anchor-comparison: false;
    out property <length> anchored-y: anchored.content-y;
    out property <length> plain-y: plain.content-y;
    out property <int> scroll-events: 0;
    callback prepend();
    callback reverse-order();
    callback position(int);
    position(index) => {
        anchored.position-view-at-index(index, beginning);
        plain.position-view-at-index(index, beginning);
    }

    Text { x: 16px; y: 12px; text: "保留可见记录"; font-size: 18px; }
    Text { x: 288px; y: 12px; text: "保留像素偏移"; font-size: 18px; }
    anchored := ListView {
        x: 16px; y: 48px; width: 256px; height: 160px; row-height: root.anchor-row-height;
        preserve-scroll-anchor: true;
        scrolled() => { root.scroll-events += 1; }
        for item in root.records : Rectangle {
            background: item.rank % 2 == 0 ? #263750 : #405971;
            Text { x: 12px; y: 5px; text: item.label; }
        }
    }
    plain := StandardListView {
        x: 288px; y: 48px; width: 256px; height: 160px; row-height: 32px;
        preserve-scroll-anchor: root.anchor-comparison;
        model: root.records; text-role: "label";
    }
    jump := Button {
        x: 16px; y: 224px; width: 162px; height: 34px;
        text: "定位到记录 12000";
        clicked() => { root.position(12000); }
    }
    prepend := Button {
        x: 190px; y: 224px; width: 156px; height: 34px;
        text: "在开头插入";
        clicked() => { root.prepend(); }
    }
    reverse := Button {
        x: 358px; y: 224px; width: 156px; height: 34px;
        text: "反转排序";
        clicked() => { root.reverse-order(); }
    }
}

export component StandardListDemo inherits Window {
    title: "XRack · 默认行列表";
    width: 584px;
    height: 355px;
    background: #182331;

    in-out property <[string]> categories: ["全部", "最近", "收藏"];
    in-out property <[DirectoryItem]> records: [
        DirectoryItem { label: "接口文档", rank: 0 },
        DirectoryItem { label: "布局示例", rank: 1 },
        DirectoryItem { label: "键盘导航", rank: 2 },
    ];
    in-out property <int> category: 0;
    in-out property <int> current: -1;
    in-out property <int> jump-index: 2;
    out property <int> selections: 0;

    Text { x: 20px; y: 16px; text: "默认行 · 字符串与记录模型"; font-size: 22px; }
    categories-view := StandardListView {
        x: 20px; y: 58px; width: 146px; height: 222px;
        accessible-name: "分类";
        model: root.categories;
        current-index <=> root.category;
        row-height: 34px;
    }
    records-view := StandardListView {
        x: 180px; y: 58px; width: 384px; height: 222px;
        accessible-name: "目录";
        model: root.records;
        text-role: "label";
        current-index <=> root.current;
        row-height: 32px;
        changed(index) => { root.selections += 1; }
    }
    jump := Button {
        x: 20px; y: 294px; width: 146px; height: 40px;
        text: "跳到目标行";
        clicked() => { root.current = root.jump-index; }
    }
    Text { x: 180px; y: 305px; text: "当前索引 " + root.current + " · 用户选择 " + root.selections + " 次"; color: #acc0db; }
}
component GridCard inherits Rectangle {
    in property <string> label;
    in property <int> rank;
    property <bool> pinned: false;

    accessible-name: root.label;
    background: root.rank % 2 == 0 ? #263750 : #304565;
    Text { x: 10px; y: 8px; text: root.label; color: #edf3ff; }
    pin := CheckBox { x: 10px; y: 42px; text: "收藏"; checked <=> root.pinned; }
}

export component GridDemo inherits Window {
    title: "XRack · 虚拟网格";
    width: 620px; height: 420px;
    background: #182331;

    in-out property <[DirectoryItem]> records: [
        DirectoryItem { label: "条目 00000", rank: 0 },
        DirectoryItem { label: "条目 00001", rank: 1 },
    ];
    in-out property <int> current: -1;
    in property <int> jump-index: 1;
    in property <bool> preserve-viewport: false;
    out property <int> selections: 0;

    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: "虚拟网格 · 调整窗口宽度重新排列"; font-size: 20px; }
        tiles := GridView {
            preserve-scroll-anchor: root.preserve-viewport;
            accessible-name: "资源网格";
            cell-width: 128px; cell-height: 84px; spacing: 8px;
            current-index <=> root.current;
            changed(index) => { root.selections += 1; }
            for item in root.records : GridCard { label: item.label; rank: item.rank; }
        }
        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;
            jump-grid := Button { text: "跳到目标"; clicked() => { root.current = root.jump-index; } }
            Text { text: "索引 " + root.current + " · 用户选择 " + root.selections + " 次"; color: #acc0db; }
        }
    }
}
