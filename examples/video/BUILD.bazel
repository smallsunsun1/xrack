load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:xrack.bzl", "xr_ui_library")

exports_files(
    [
        "video.xr",
    ],
    visibility = [
        "//crates/xrack-media:__pkg__",
        "//tests:__pkg__",
    ],
)

xr_ui_library(
    name = "video_ui",
    src = "video.xr",
    visibility = ["//tests:__pkg__"],
)

rust_binary(
    name = "video",
    srcs = ["main.rs"],
    data = ["//crates/xrack-media:tests/sync.mp4"],
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":video_ui",
        "//crates/xrack-platform-winit:xrack_platform_winit",
    ],
)

xr_ui_library(
    name = "live_ui",
    src = "live.xr",
    sources = ["video.xr"],
)

rust_binary(
    name = "live",
    srcs = ["live_main.rs"],
    edition = "2024",
    tags = ["manual"],
    deps = [
        ":live_ui",
        "//crates/xrack-platform-winit:xrack_platform_winit",
    ],
)
