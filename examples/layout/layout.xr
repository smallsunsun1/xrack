component Tile inherits Rectangle {
    in property <string> caption;
    in property <string> detail;
    in property <color> tint: #364d76;

    background: root.tint;
    border-radius: 14px;

    VerticalLayout {
        padding: 14px;
        spacing: 7px;
        alignment: center;
        Text { text: root.caption; font-size: 18px; color: #ffffff; }
        Text { text: root.detail; font-size: 13px; color: #e2eaff; }
    }
}

export component LayoutDemo inherits Window {
    in-out property <bool> centered: false;
    out property <int> canvas-activations: 0;

    title: "XRack 约束布局";
    width: 620px;
    height: 590px;
    background: #101725;

    VerticalLayout {
        padding: 22px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 14px;
        alignment: start;

        Text { text: "XRack 约束布局"; font-size: 26px; color: #f0f4ff; }
        Text { text: "调整窗口宽度，观察伸缩比例和最大宽度"; font-size: 15px; color: #a7b6ce; }

        row := HorizontalLayout {
            height: 144px;
            padding-left: 8px;
            padding-right: 12px;
            spacing: 12px;
            alignment: root.centered ? LayoutAlignment.center : LayoutAlignment.stretch;
            cross-axis-alignment: center;

            fixed := Tile {
                width: 128px;
                height: 120px;
                caption: "固定";
                detail: "128px";
                tint: #314b80;
            }
            capped := Tile {
                min-width: 92px;
                preferred-width: 124px;
                max-width: 150px;
                horizontal-stretch: 1;
                height: 104px;
                cross-axis-self-alignment: end;
                caption: "上限";
                detail: "最大 150px";
                tint: #513b86;
            }
            elastic := Tile {
                min-width: 110px;
                preferred-width: 140px;
                horizontal-stretch: 2;
                height: 120px;
                caption: "弹性";
                detail: "伸缩权重 2";
                tint: #14665c;
            }
        }

        toggle := Button {
            height: 38px;
            padding: 6px;
            background: #273a5b;
            font-size: 15px;
            text: root.centered ? "居中 · 点击切换为伸缩" : "伸缩 · 点击切换为居中";
            clicked() => { root.centered = !root.centered; }
        }

        Text {
            text: "二维滚动区 · 中键拖动 · 点击次数 " + root.canvas-activations;
            font-size: 17px;
            color: #c5d3eb;
        }
        canvas := ScrollView {
            height: 220px;
            content-width: 880px;
            content-height: 340px;
            Rectangle {
                width: 100%; height: 100%;
                background: #1c293e;
                upper-left := Tile {
                    x: 18px; y: 18px; width: 240px; height: 148px;
                    caption: "左上";
                    detail: "拖动滚动条浏览画布";
                }
                upper-right := Tile {
                    x: 552px; y: 18px; width: 300px; height: 148px;
                    caption: "右上";
                    detail: "横向滚动后显示";
                    tint: #513b86;
                }
                lower-left := Tile {
                    x: 18px; y: 198px; width: 240px; height: 114px;
                    caption: "左下";
                    detail: "纵向滚动后显示";
                    tint: #14665c;
                }
                canvas-action := Button {
                    x: 664px; y: 240px; width: 188px; height: 46px;
                    text: "点击右下角";
                    clicked() => { root.canvas-activations += 1; }
                }
            }
        }
    }
}

export component FlowDemo inherits Window {
    out property <string> selected: "请选择命令";

    title: "XRack · 换行布局";
    width: 570px;
    height: 260px;
    background: #101725;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;

        Text { text: "缩小窗口，观察按钮换行"; font-size: 22px; color: #edf3ff; }
        commands := FlowLayout {
            horizontal-spacing: 8px;
            vertical-spacing: 12px;
            cross-axis-alignment: center;

            open := Button {
                text: "打开文件";
                width: 140px; height: 38px;
                background: #314b80;
                clicked() => { root.selected = "已打开"; }
            }
            save := Button {
                text: "保存草稿";
                width: 145px; height: 44px;
                background: #14665c;
                clicked() => { root.selected = "已保存"; }
            }
            export-button := Button {
                text: "导出预览";
                width: 158px; height: 38px;
                background: #513b86;
                clicked() => { root.selected = "已导出"; }
            }
        }
        status := Text { text: root.selected; color: #acc0db; }
    }
}
export component FlexDemo inherits Window {
    title: "XRack · FlexboxLayout";
    width: 740px; height: 390px;
    background: #101725;
    in-out property <FlexboxLayoutDirection> direction: row;
    in-out property <FlexboxLayoutWrap> wrapping: wrap;
    out property <string> status: "请选择命令";

    VerticalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: "调整窗口宽度，观察命令伸缩和换行"; font-size: 22px; }
        HorizontalLayout {
            alignment: start; spacing: 8px;
            change-direction := Button {
                text: "换方向";
                clicked() => { root.direction = root.direction == FlexboxLayoutDirection.row ? FlexboxLayoutDirection.row-reverse
                    : root.direction == FlexboxLayoutDirection.row-reverse ? FlexboxLayoutDirection.column
                    : root.direction == FlexboxLayoutDirection.column ? FlexboxLayoutDirection.column-reverse : FlexboxLayoutDirection.row; }
            }
            change-wrap := Button {
                text: "换行模式";
                clicked() => { root.wrapping = root.wrapping == FlexboxLayoutWrap.wrap ? FlexboxLayoutWrap.no-wrap
                    : root.wrapping == FlexboxLayoutWrap.no-wrap ? FlexboxLayoutWrap.wrap-reverse : FlexboxLayoutWrap.wrap; }
            }
        }
        flex-commands := FlexboxLayout {
            height: 192px;
            flex-direction: root.direction;
            flex-wrap: root.wrapping;
            alignment: stretch;
            cross-axis-alignment: center;
            cross-axis-line-alignment: space-between;
            spacing-horizontal: 10px;
            spacing-vertical: 14px;
            flex-open := Button {
                text: "打开文件"; preferred-width: 150px; min-width: 100px; max-width: 180px; height: 40px;
                horizontal-stretch: 1;
                background: #314b80;
                clicked() => { root.status = "已打开"; }
            }
            flex-save := Button {
                text: "保存草稿"; preferred-width: 160px; min-width: 100px; height: 48px;
                horizontal-stretch: 2; layout-order: -1;
                background: #14665c;
                clicked() => { root.status = "已保存"; }
            }
            flex-export := Button {
                text: "导出预览"; preferred-width: 180px; min-width: 120px; max-width: 220px; height: 42px;
                horizontal-stretch: 1;
                background: #513b86;
                clicked() => { root.status = "已导出"; }
            }
            flex-options := Button {
                text: "设置"; preferred-width: 120px; min-width: 90px; height: 40px;
                horizontal-stretch: 0;
                background: #384966;
                clicked() => { root.status = "已打开设置"; }
            }
        }
        Text { text: root.status; color: #acc0db; }
    }
}
export component LabelsDemo inherits Window {
    title: "XRack · 标签排版";
    width: 520px; height: 310px;
    background: #101725;
    in-out property <bool> elided: true;

    VerticalLayout {
        padding: 20px; spacing: 14px; alignment: start;
        Text { text: "缩窄窗口，查看标签排版"; font-size: 21px; }
        Rectangle {
            height: 52px;
            background: #263750;
            job-title := Label {
                width: 100%; height: 100%; font-size: 18px;
                text: "发布任务 👩‍💻 构建、签名并推送到测试环境，等待最后一轮验证";
                overflow: root.elided ? TextOverflow.elide : TextOverflow.clip;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 90px;
            background: #214a48;
            description := Text {
                width: 100%; height: 100%; font-size: 17px;
                text: "这里的摘要最多显示两行。调整窗口宽度时，行数和截断位置一起变化。";
                wrap: word-wrap; overflow: elide; max-lines: 2;
                horizontal-alignment: center;
                vertical-alignment: bottom;
            }
        }
        Label { text: "مرحبا بالعالم"; horizontal-alignment: start; font-size: 18px; }
        toggle-overflow := Button { text: "切换省略"; clicked() => { root.elided = !root.elided; } }
    }
}

export component FontsDemo inherits Window {
    title: "XRack · 字体与排版";
    width: 500px; height: 390px;
    background: #101725;
    in-out property <bool> mono: false;
    in-out property <bool> large: false;
    default-font-family: root.mono ? "monospace" : "";
    default-font-size: root.large ? 26px : 18px;
    default-font-weight: 400;

    VerticalLayout {
        padding: 20px; spacing: 10px; alignment: start; cross-axis-alignment: start;
        sample := Label { text: "WWWW iiiii · 字体"; }
        override-sample := Label {
            text: "Bold italic · fixed size";
            font-family: "monospace"; font-size: 16px;
            font-weight: 700; font-italic: true;
        }
        entry := LineEdit { width: 360px; text: "WWWWiiii"; }
        paragraph := TextArea {
            width: 156px; height: 88px;
            text: "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii";
            wrap: char-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            toggle-font := Button {
                text: "切换等宽字体";
                clicked() => { root.mono = !root.mono; }
            }
            toggle-size := Button {
                text: "切换字号";
                clicked() => { root.large = !root.large; }
            }
        }
    }
}

export component AnimationsDemo inherits Window {
    title: "XRack · 控件过渡";
    width: 546px; height: 288px;
    background: #141d2c;
    in-out property <bool> expanded: false;
    in-out property <bool> motion: true;
    in-out property <int> changes: 0;

    Label { x: 24px; y: 18px; text: "同一目标，不同过渡时间线"; font-size: 20px; }
    Label { x: 24px; y: 57px; text: "线性 · 600ms"; }
    linear := Rectangle {
        x: 24px; y: 84px; height: 27px;
        width: root.expanded ? 320px : 80px;
        accessible-name: "线性进度条";
        background: #3a6fa4;
        animate width { duration: 600ms; enabled: root.motion; }
    }
    Label { x: 24px; y: 122px; text: "缓动 · 先等待 120ms"; }
    eased := Rectangle {
        x: root.expanded ? 64px : 24px;
        y: 149px; height: 27px;
        width: root.expanded ? 320px : 80px;
        accessible-name: "缓动进度条";
        background: root.expanded ? @linear-gradient(90deg, #b82c69, #dc805a) : @linear-gradient(0deg, #316b78, #54bdab);
        animate x, width, background {
            duration: 600ms;
            delay: 120ms;
            easing: cubic-bezier(0, 0.8, 1, 0.8);
            enabled: root.motion;
        }
    }
    toggle := Button {
        x: 24px; y: 202px; width: 112px; height: 38px;
        text: "反转目标";
        clicked() => { root.expanded = !root.expanded; }
    }
    motion := CheckBox {
        x: 151px; y: 202px; width: 126px; height: 38px;
        text: "播放过渡";
        checked <=> root.motion;
    }
    change-label := Button {
        x: 296px; y: 202px; width: 174px; height: 38px;
        text: "只更新计数";
        clicked() => { root.changes = root.changes + 1; }
    }
    Label { x: 24px; y: 253px; text: "独立状态更新 " + root.changes + " 次"; }
}

export component StatesDemo inherits Window {
    title: "XRack · 声明式状态";
    width: 518px; height: 234px;
    background: #141d2c;
    in-out property <int> level: 0;
    in-out property <length> baseline: 96px;
    pure callback base-width() -> length;
    base-width() => { root.baseline }

    tile := Rectangle {
        x: 24px; y: 60px; height: 54px;
        width: root.base-width();
        background: #3a6fa4;
        accessible-name: "状态指示块";
        border-radius: 6px;
    }
    caption := Label { x: 24px; y: 24px; text: "正常"; font-size: 20px; }
    badge := Rectangle {
        x: 340px; y: 60px; width: 16px; height: 16px;
        visible: false; background: #e97c71; border-radius: 8px;
    }
    states [
        alarm when root.level >= 2: {
            tile.width: 280px;
            tile.background: #ba4b5d;
            caption.text: "告警";
            badge.visible: true;
            in {
                animate tile.width { duration: 400ms; }
                animate tile.background { duration: 180ms; }
            }
            out { animate tile.width { duration: 200ms; } }
        }
        warm when root.level >= 1: {
            tile.width: 168px;
            tile.background: #b08346;
            caption.text: "预警";
            in-out {
                animate tile.width { duration: 300ms; easing: ease-out; }
            }
        }
    ]
    normal := Button { x: 24px; y: 150px; width: 116px; height: 42px; text: "正常"; clicked() => { root.level = 0; } }
    warning := Button { x: 151px; y: 150px; width: 116px; height: 42px; text: "预警"; clicked() => { root.level = 1; } }
    critical := Button { x: 278px; y: 150px; width: 116px; height: 42px; text: "告警"; clicked() => { root.level = 2; } }
    status-leds := VerticalLayout {
        x: 428px; y: 150px; width: 16px; height: 42px; alignment: start;
        for index in 3 : Rectangle {
            width: 12px; height: 12px; background: #314051; border-radius: 6px;
            states [ lit when index == root.level: { background: #9adcb7; } ]
        }
    }
}

component EditorPane inherits FocusScope {
    width: 218px; height: 148px;
    background: root.focus-within ? #355372 : #26364e;
    in property <string> name;
    in property <bool> query-enabled: true;
    out property <bool> active: root.focus-within;
    out property <int> visits: 0;
    out property <FocusReason> last-focus-reason: programmatic;
    callback enter-pane();
    callback clear-pane();
    enter-pane() => { root.focus(); }
    clear-pane() => { root.clear-focus(); }
    initial-focus: query;
    focus-within-changed(focused, reason) => {
        root.visits = focused ? root.visits + 1 : root.visits;
        root.last-focus-reason = reason;
    }
    Label { x: 12px; y: 9px; text: root.name; }
    notes := LineEdit {
        x: 12px; y: 43px; width: 194px; height: 34px;
        accessible-name: root.name + " 备注";
        placeholder-text: "备注";
        background: self.has-focus ? #203a52 : #19293c;
    }
    query := LineEdit {
        x: 12px; y: 87px; width: 194px; height: 34px;
        accessible-name: root.name + " 查询";
        enabled: root.query-enabled;
        placeholder-text: "查询";
        background: self.has-focus ? #203a52 : #19293c;
    }
    clear-shortcut := Shortcut { sequence: "Escape"; focus-within: true; activated() => { root.clear-focus(); } }
}

export component FocusScopesDemo inherits Window {
    title: "XRack · 焦点作用域";
    width: 492px; height: 272px;
    background: #141d2c;
    in-out property <bool> left-query-enabled: true;
    in-out property <bool> left-visible: true;
    out property <bool> left-active: left.active;
    out property <bool> right-active: right.active;
    out property <int> left-visits: left.visits;
    out property <int> right-visits: right.visits;
    out property <FocusReason> right-focus-reason: right.last-focus-reason;
    callback clear-left();
    clear-left() => { left.clear-pane(); }

    left := EditorPane {
        x: 18px; y: 18px; name: "左侧";
        query-enabled: root.left-query-enabled;
        visible: root.left-visible;
    }
    right := EditorPane { x: 254px; y: 18px; name: "右侧"; }
    jump-left := Button {
        x: 18px; y: 186px; width: 150px; height: 38px; text: "进入左侧";
        clicked() => { left.enter-pane(); }
    }
    jump-right := Button {
        x: 179px; y: 186px; width: 150px; height: 38px; text: "进入右侧";
        clicked() => { right.enter-pane(); }
    }
    disable-left := Button {
        x: 340px; y: 186px; width: 134px; height: 38px; text: "禁用查询";
        clicked() => { root.left-query-enabled = false; left.enter-pane(); }
    }
    Label {
        x: 18px; y: 241px;
        text: root.left-active ? "左区有焦点" : root.right-active ? "右区有焦点" : "编辑区无焦点";
    }
}

export component ScopedKeysDemo inherits Window {
    title: "XRack · 键盘事件路由";
    width: 512px; height: 254px;
    background: #141d2c;
    in-out property <bool> block-x: true;
    in-out property <string> text: "";
    in-out property <string> trace: "";
    out property <int> accepted-releases: 0;

    outer := FocusScope {
        x: 24px; y: 20px; width: 464px; height: 138px;
        background: #25334a;
        initial-focus: inner;
        capture-key-pressed(event) => {
            root.trace = root.trace + "外层捕获 ";
            event.modifiers.primary && event.key == "k" ? EventResult.accept : EventResult.reject
        }
        key-pressed(event) => {
            root.trace = root.trace + "外层冒泡 ";
            event.key == "F2" ? accept : reject
        }
        key-released(event) => {
            root.trace = root.trace + "外层释放 ";
            event.key == "F2" ? accept : reject
        }
        inner := FocusScope {
            x: 12px; y: 12px; width: 440px; height: 110px;
            initial-focus: field;
            capture-key-pressed(event) => {
                root.trace = root.trace + "内层捕获 ";
                event.text == "x" && root.block-x ? accept : reject
            }
            capture-key-released(event) => {
                root.accepted-releases = event.key == "x" && root.block-x
                    ? root.accepted-releases + 1 : root.accepted-releases;
                event.key == "x" && root.block-x ? accept : reject
            }
            key-pressed(event) => {
                root.trace = root.trace + "内层冒泡 ";
                reject
            }
            field := LineEdit {
                x: 12px; y: 12px; width: 400px; height: 36px;
                text <=> root.text;
                placeholder-text: "输入 a，尝试 x 和 F2";
                accessible-name: "键盘路由输入框";
            }
        }
    }
    enable-block := CheckBox {
        x: 24px; y: 174px; width: 190px; height: 36px;
        text: "拦截 x";
        checked <=> root.block-x;
    }
    start-typing := Button {
        x: 258px; y: 174px; width: 210px; height: 36px;
        text: "聚焦输入框";
        clicked() => { root.trace = ""; outer.focus(); }
    }
    status := Label {
        x: 24px; y: 220px; width: 464px;
        text: root.trace;
        overflow: elide;
    }
}

export component StyledTextDemo inherits Window {
    title: "XRack · 富文本";
    width: 460px; height: 268px;
    background: #141d2c;
    in-out property <styled-text> body: @markdown("# 发布说明\n\n**粗体**、*斜体*、[`xrackc`](#compiler) 和 ~~已弃用~~。\n\n**مرحبا** بكم في XRack · [阅读手册](#manual)");
    in-out property <bool> compact: false;
    in-out property <bool> links-enabled: true;
    out property <string> last-link: "";

    Label {
        x: 24px; y: 20px; text: "带内联样式的文字";
        font-size: 15px; color: #acc1d9;
    }
    body-label := StyledText {
        x: 24px; y: 52px; width: 412px;
        font-size: 22px;
        color: #e8f2ff;
        link-color: #84d8ff;
        enabled: root.links-enabled;
        max-lines: root.compact ? 2 : 5;
        overflow: elide;
        text: root.body;
        link-activated(target) => { root.last-link = target; }
    }
    Label {
        x: 24px; y: 212px; width: 412px; overflow: elide;
        text: root.last-link == "" ? "用 Tab 和 Enter 打开链接" : "已激活 " + root.last-link;
    }
    CheckBox {
        x: 24px; y: 236px; width: 412px; height: 30px;
        text: "只显示两行";
        checked <=> root.compact;
    }
}

export component CompositingDemo inherits Window {
    title: "XRack · 叠放与整组透明度";
    width: 460px; height: 292px;
    background: #101725;
    in-out property <float> fade: 0.5;
    in-out property <float> first-layer: 2.0;
    in-out property <float> first-opacity: 1.0;
    out property <int> first-clicks: 0;
    out property <int> second-clicks: 0;

    Label { x: 24px; y: 22px; text: "整组淡出"; color: #e8f2ff; }
    Label { x: 240px; y: 22px; text: "绘制与命中共用叠放顺序"; color: #e8f2ff; }
    composite := Rectangle {
        x: 24px; y: 56px; width: 172px; height: 124px;
        background: #ff0000;
        opacity: root.fade;
        Rectangle {
            x: 42px; y: 24px; width: 90px; height: 78px;
            background: #0000ff;
            Rectangle {
                x: 31px; y: 20px; width: 44px; height: 42px;
                opacity: 0.5; background: #00ff00;
            }
        }
    }
    stage := Rectangle {
        x: 240px; y: 56px; width: 184px; height: 124px;
        background: #263653;
        first := Button {
            x: 10px; y: 12px; width: 132px; height: 68px;
            z: root.first-layer;
            opacity: root.first-opacity;
            background: #39d6bc; color: #102132; text: "第一项";
            clicked() => { root.first-clicks = root.first-clicks + 1; }
        }
        second := Button {
            x: 42px; y: 30px; width: 132px; height: 68px;
            z: 1.0;
            background: #ffd177; color: #102132; text: "第二项";
            clicked() => { root.second-clicks = root.second-clicks + 1; }
        }
    }
    Slider {
        x: 24px; y: 201px; width: 172px; height: 28px;
        minimum: 0.0; maximum: 1.0;
        value <=> root.fade;
        accessible-name: "整组透明度";
    }
    swap-order := Button {
        x: 240px; y: 198px; width: 184px; height: 31px; text: "交换叠放顺序";
        clicked() => { root.first-layer = root.first-layer > 1.0 ? 0.0 : 2.0; }
    }
    toggle-first := Button {
        x: 240px; y: 237px; width: 184px; height: 31px; text: "切换第一项透明度";
        clicked() => { root.first-opacity = root.first-opacity == 0.0 ? 1.0 : 0.0; }
    }
    Label {
        x: 24px; y: 242px; width: 184px;
        color: #a7b6ce;
        text: "第一项 " + root.first-clicks + " · 第二项 " + root.second-clicks;
    }
}
