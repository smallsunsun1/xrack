component Tile inherits Rectangle {
    in property <string> caption;
    in property <string> detail;
    in property <color> tint: #364d76;

    background: root.tint;
    border-radius: 14px;

    VerticalLayout {
        padding: 14px;
        spacing: 7px;
        alignment: center;
        Text { text: root.caption; font-size: 18px; color: #ffffff; }
        Text { text: root.detail; font-size: 13px; color: #e2eaff; }
    }
}

export component LayoutDemo inherits Window {
    in-out property <bool> centered: false;
    out property <int> canvas-activations: 0;

    title: "XRack 约束布局";
    width: 620px;
    height: 590px;
    background: #101725;

    VerticalLayout {
        padding: 22px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 14px;
        alignment: start;

        Text { text: "XRack 约束布局"; font-size: 26px; color: #f0f4ff; }
        Text { text: "调整窗口宽度，观察伸缩比例和最大宽度"; font-size: 15px; color: #a7b6ce; }

        row := HorizontalLayout {
            height: 144px;
            padding-left: 8px;
            padding-right: 12px;
            spacing: 12px;
            alignment: root.centered ? LayoutAlignment.center : LayoutAlignment.stretch;
            cross-axis-alignment: center;

            fixed := Tile {
                width: 128px;
                height: 120px;
                caption: "固定";
                detail: "128px";
                tint: #314b80;
            }
            capped := Tile {
                min-width: 92px;
                preferred-width: 124px;
                max-width: 150px;
                horizontal-stretch: 1;
                height: 104px;
                cross-axis-self-alignment: end;
                caption: "上限";
                detail: "最大 150px";
                tint: #513b86;
            }
            elastic := Tile {
                min-width: 110px;
                preferred-width: 140px;
                horizontal-stretch: 2;
                height: 120px;
                caption: "弹性";
                detail: "伸缩权重 2";
                tint: #14665c;
            }
        }

        toggle := Button {
            height: 38px;
            padding: 6px;
            background: #273a5b;
            font-size: 15px;
            text: root.centered ? "居中 · 点击切换为伸缩" : "伸缩 · 点击切换为居中";
            clicked() => { root.centered = !root.centered; }
        }

        Text {
            text: "二维滚动区 · 中键拖动 · 点击次数 " + root.canvas-activations;
            font-size: 17px;
            color: #c5d3eb;
        }
        canvas := ScrollView {
            height: 220px;
            content-width: 880px;
            content-height: 340px;
            Rectangle {
                width: 100%; height: 100%;
                background: #1c293e;
                upper-left := Tile {
                    x: 18px; y: 18px; width: 240px; height: 148px;
                    caption: "左上";
                    detail: "拖动滚动条浏览画布";
                }
                upper-right := Tile {
                    x: 552px; y: 18px; width: 300px; height: 148px;
                    caption: "右上";
                    detail: "横向滚动后显示";
                    tint: #513b86;
                }
                lower-left := Tile {
                    x: 18px; y: 198px; width: 240px; height: 114px;
                    caption: "左下";
                    detail: "纵向滚动后显示";
                    tint: #14665c;
                }
                canvas-action := Button {
                    x: 664px; y: 240px; width: 188px; height: 46px;
                    text: "点击右下角";
                    clicked() => { root.canvas-activations += 1; }
                }
            }
        }
    }
}

export component FlowDemo inherits Window {
    out property <string> selected: "请选择命令";

    title: "XRack · 换行布局";
    width: 570px;
    height: 260px;
    background: #101725;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;

        Text { text: "缩小窗口，观察按钮换行"; font-size: 22px; color: #edf3ff; }
        commands := FlowLayout {
            horizontal-spacing: 8px;
            vertical-spacing: 12px;
            cross-axis-alignment: center;

            open := Button {
                text: "打开文件";
                width: 140px; height: 38px;
                background: #314b80;
                clicked() => { root.selected = "已打开"; }
            }
            save := Button {
                text: "保存草稿";
                width: 145px; height: 44px;
                background: #14665c;
                clicked() => { root.selected = "已保存"; }
            }
            export-button := Button {
                text: "导出预览";
                width: 158px; height: 38px;
                background: #513b86;
                clicked() => { root.selected = "已导出"; }
            }
        }
        status := Text { text: root.selected; color: #acc0db; }
    }
}
export component FlexDemo inherits Window {
    title: "XRack · FlexboxLayout";
    width: 740px; height: 390px;
    background: #101725;
    in-out property <FlexboxLayoutDirection> direction: row;
    in-out property <FlexboxLayoutWrap> wrapping: wrap;
    out property <string> status: "请选择命令";

    VerticalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: "调整窗口宽度，观察命令伸缩和换行"; font-size: 22px; }
        HorizontalLayout {
            alignment: start; spacing: 8px;
            change-direction := Button {
                text: "换方向";
                clicked() => { root.direction = root.direction == FlexboxLayoutDirection.row ? FlexboxLayoutDirection.row-reverse
                    : root.direction == FlexboxLayoutDirection.row-reverse ? FlexboxLayoutDirection.column
                    : root.direction == FlexboxLayoutDirection.column ? FlexboxLayoutDirection.column-reverse : FlexboxLayoutDirection.row; }
            }
            change-wrap := Button {
                text: "换行模式";
                clicked() => { root.wrapping = root.wrapping == FlexboxLayoutWrap.wrap ? FlexboxLayoutWrap.no-wrap
                    : root.wrapping == FlexboxLayoutWrap.no-wrap ? FlexboxLayoutWrap.wrap-reverse : FlexboxLayoutWrap.wrap; }
            }
        }
        flex-commands := FlexboxLayout {
            height: 192px;
            flex-direction: root.direction;
            flex-wrap: root.wrapping;
            alignment: stretch;
            cross-axis-alignment: center;
            cross-axis-line-alignment: space-between;
            spacing-horizontal: 10px;
            spacing-vertical: 14px;
            flex-open := Button {
                text: "打开文件"; preferred-width: 150px; min-width: 100px; max-width: 180px; height: 40px;
                horizontal-stretch: 1;
                background: #314b80;
                clicked() => { root.status = "已打开"; }
            }
            flex-save := Button {
                text: "保存草稿"; preferred-width: 160px; min-width: 100px; height: 48px;
                horizontal-stretch: 2; layout-order: -1;
                background: #14665c;
                clicked() => { root.status = "已保存"; }
            }
            flex-export := Button {
                text: "导出预览"; preferred-width: 180px; min-width: 120px; max-width: 220px; height: 42px;
                horizontal-stretch: 1;
                background: #513b86;
                clicked() => { root.status = "已导出"; }
            }
            flex-options := Button {
                text: "设置"; preferred-width: 120px; min-width: 90px; height: 40px;
                horizontal-stretch: 0;
                background: #384966;
                clicked() => { root.status = "已打开设置"; }
            }
        }
        Text { text: root.status; color: #acc0db; }
    }
}
export component LabelsDemo inherits Window {
    title: "XRack · 标签排版";
    width: 520px; height: 310px;
    background: #101725;
    in-out property <bool> elided: true;

    VerticalLayout {
        padding: 20px; spacing: 14px; alignment: start;
        Text { text: "缩窄窗口，查看标签排版"; font-size: 21px; }
        Rectangle {
            height: 52px;
            background: #263750;
            job-title := Label {
                width: 100%; height: 100%; font-size: 18px;
                text: "发布任务 👩‍💻 构建、签名并推送到测试环境，等待最后一轮验证";
                overflow: root.elided ? TextOverflow.elide : TextOverflow.clip;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 90px;
            background: #214a48;
            description := Text {
                width: 100%; height: 100%; font-size: 17px;
                text: "这里的摘要最多显示两行。调整窗口宽度时，行数和截断位置一起变化。";
                wrap: word-wrap; overflow: elide; max-lines: 2;
                horizontal-alignment: center;
                vertical-alignment: bottom;
            }
        }
        Label { text: "مرحبا بالعالم"; horizontal-alignment: start; font-size: 18px; }
        toggle-overflow := Button { text: "切换省略"; clicked() => { root.elided = !root.elided; } }
    }
}

export component FontsDemo inherits Window {
    title: "XRack · 字体与排版";
    width: 500px; height: 390px;
    background: #101725;
    in-out property <bool> mono: false;
    in-out property <bool> large: false;
    default-font-family: root.mono ? "monospace" : "";
    default-font-size: root.large ? 26px : 18px;
    default-font-weight: 400;

    VerticalLayout {
        padding: 20px; spacing: 10px; alignment: start; cross-axis-alignment: start;
        sample := Label { text: "WWWW iiiii · 字体"; }
        override-sample := Label {
            text: "Bold italic · fixed size";
            font-family: "monospace"; font-size: 16px;
            font-weight: 700; font-italic: true;
        }
        entry := LineEdit { width: 360px; text: "WWWWiiii"; }
        paragraph := TextArea {
            width: 156px; height: 88px;
            text: "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii";
            wrap: char-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            toggle-font := Button {
                text: "切换等宽字体";
                clicked() => { root.mono = !root.mono; }
            }
            toggle-size := Button {
                text: "切换字号";
                clicked() => { root.large = !root.large; }
            }
        }
    }
}

export component AnimationsDemo inherits Window {
    title: "XRack · 控件过渡";
    width: 546px; height: 288px;
    background: #141d2c;
    in-out property <bool> expanded: false;
    in-out property <bool> motion: true;
    in-out property <int> changes: 0;

    Label { x: 24px; y: 18px; text: "同一目标，不同过渡时间线"; font-size: 20px; }
    Label { x: 24px; y: 57px; text: "线性 · 600ms"; }
    linear := Rectangle {
        x: 24px; y: 84px; height: 27px;
        width: root.expanded ? 320px : 80px;
        accessible-name: "线性进度条";
        background: #3a6fa4;
        animate width { duration: 600ms; enabled: root.motion; }
    }
    Label { x: 24px; y: 122px; text: "缓动 · 先等待 120ms"; }
    eased := Rectangle {
        x: root.expanded ? 64px : 24px;
        y: 149px; height: 27px;
        width: root.expanded ? 320px : 80px;
        accessible-name: "缓动进度条";
        background: root.expanded ? @linear-gradient(90deg, #b82c69, #dc805a) : @linear-gradient(0deg, #316b78, #54bdab);
        animate x, width, background {
            duration: 600ms;
            delay: 120ms;
            easing: cubic-bezier(0, 0.8, 1, 0.8);
            enabled: root.motion;
        }
    }
    toggle := Button {
        x: 24px; y: 202px; width: 112px; height: 38px;
        text: "反转目标";
        clicked() => { root.expanded = !root.expanded; }
    }
    motion := CheckBox {
        x: 151px; y: 202px; width: 126px; height: 38px;
        text: "播放过渡";
        checked <=> root.motion;
    }
    change-label := Button {
        x: 296px; y: 202px; width: 174px; height: 38px;
        text: "只更新计数";
        clicked() => { root.changes = root.changes + 1; }
    }
    Label { x: 24px; y: 253px; text: "独立状态更新 " + root.changes + " 次"; }
}

export component StatesDemo inherits Window {
    title: "XRack · 声明式状态";
    width: 518px; height: 234px;
    background: #141d2c;
    in-out property <int> level: 0;
    in-out property <length> baseline: 96px;
    pure callback base-width() -> length;
    base-width() => { root.baseline }

    tile := Rectangle {
        x: 24px; y: 60px; height: 54px;
        width: root.base-width();
        background: #3a6fa4;
        accessible-name: "状态指示块";
        border-radius: 6px;
    }
    caption := Label { x: 24px; y: 24px; text: "正常"; font-size: 20px; }
    badge := Rectangle {
        x: 340px; y: 60px; width: 16px; height: 16px;
        visible: false; background: #e97c71; border-radius: 8px;
    }
    states [
        alarm when root.level >= 2: {
            tile.width: 280px;
            tile.background: #ba4b5d;
            caption.text: "告警";
            badge.visible: true;
            in {
                animate tile.width { duration: 400ms; }
                animate tile.background { duration: 180ms; }
            }
            out { animate tile.width { duration: 200ms; } }
        }
        warm when root.level >= 1: {
            tile.width: 168px;
            tile.background: #b08346;
            caption.text: "预警";
            in-out {
                animate tile.width { duration: 300ms; easing: ease-out; }
            }
        }
    ]
    normal := Button { x: 24px; y: 150px; width: 116px; height: 42px; text: "正常"; clicked() => { root.level = 0; } }
    warning := Button { x: 151px; y: 150px; width: 116px; height: 42px; text: "预警"; clicked() => { root.level = 1; } }
    critical := Button { x: 278px; y: 150px; width: 116px; height: 42px; text: "告警"; clicked() => { root.level = 2; } }
    status-leds := VerticalLayout {
        x: 428px; y: 150px; width: 16px; height: 42px; alignment: start;
        for index in 3 : Rectangle {
            width: 12px; height: 12px; background: #314051; border-radius: 6px;
            states [ lit when index == root.level: { background: #9adcb7; } ]
        }
    }
}

component StatusBadge inherits Rectangle {
    in-out property <string> caption: "就绪";
    in property <brush> tint: #3a6fa4;
    height: 42px;
    border-radius: 6px;
    background: root.tint;
    badge-text := Label { x: 10px; y: 12px; text: root.caption; }
}

component StatusFrame inherits Rectangle {
    in-out property <string> caption <=> badge.caption;
    in property <brush> tint: #3a6fa4;
    height: 48px;
    badge := StatusBadge { width: 100%; tint: root.tint; }
}

export component ComponentStatesDemo inherits Window {
    title: "XRack · 跨组件状态";
    width: 520px; height: 306px;
    background: #141d2c;
    in-out property <bool> warning: false;
    in-out property <string> baseline: "一切正常";
    out property <string> effective-caption: banner.caption;
    pure callback warning-active(bool) -> bool;
    warning-active(active) => { active }
    pure callback normal-caption(string) -> string;
    normal-caption(text) => { text }
    callback set-banner(string);
    set-banner(text) => { banner.caption = text; }

    banner := StatusFrame { x: 24px; y: 32px; width: 200px; caption: root.normal-caption(root.baseline); }
    status := Label { x: 24px; y: 88px; text: root.effective-caption; }
    toggle := CheckBox {
        x: 24px; y: 116px; width: 172px; height: 38px;
        text: "显示预警";
        checked <=> root.warning;
    }
    states [ attention when root.warning-active(root.warning): {
        banner.caption: "需要检查";
        banner.tint: #ba4b5d;
        banner.width: 300px;
        status.color: #ffd5c6;
        in-out { animate banner.width { duration: 260ms; } }
    } ]
    queue := ListView {
        x: 24px; y: 166px; width: 310px; height: 120px; row-height: 38px;
        for item[index] in ["监控", "存储", "网络"] : StatusBadge {
            caption: item;
            states [ attention when root.warning && index == 1: {
                caption: item + " · 待检查";
                tint: #ba4b5d;
            } ]
        }
    }
}

export component FramelessDemo inherits Window {
    title: "XRack · 自定义标题栏";
    width: 540px; height: 320px;
    min-width: 400px; min-height: 260px;
    max-width: 960px; max-height: 640px;
    background: #141d2c;
    no-frame: root.frameless;
    resize-border-width: 8px;
    resizable: root.can-resize;
    in-out property <bool> frameless: true;
    in-out property <bool> can-resize: true;
    in-out property <bool> can-move: true;
    in-out property <bool> modal: false;
    out property <int> header-clicks: 0;

    title-area := WindowMoveArea {
        height: 56px;
        enabled: root.can-move;
        Rectangle { background: #223650; }
        HorizontalLayout {
            padding: 10px; spacing: 8px;
            Label { text: "XRack 标题栏"; font-size: 19px; horizontal-stretch: 1; }
            header-action := Button {
                width: 76px;
                text: "计数";
                clicked => { root.header-clicks += 1; }
            }
            minimize-window := Button { width: 38px; text: "−"; accessible-name: "最小化窗口"; clicked => { root.minimize(); } }
            maximize-window := Button {
                width: 38px;
                text: root.maximized ? "❐" : "□";
                accessible-name: root.maximized ? "还原窗口" : "最大化窗口";
                clicked => { root.toggle-maximized(); }
            }
            close-window := Button { width: 68px; text: "关闭"; clicked => { root.close(); } }
        }
    }
    VerticalLayout {
        x: 18px; y: 72px; width: 360px; height: 176px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            CheckBox { text: "自定义边框"; checked <=> root.frameless; }
            CheckBox { text: "允许边缘缩放"; checked <=> root.can-resize; }
        }
        CheckBox { text: "允许标题栏拖动"; checked <=> root.can-move; }
        HorizontalLayout {
            spacing: 8px;
            open-dialog := Button { text: "打开模态层"; clicked => { root.modal = true; } }
            toggle-full-screen := Button {
                text: root.full-screen ? "退出全屏" : "进入全屏";
                clicked => { root.toggle-full-screen(); }
            }
            restore-window := Button { text: "还原"; clicked => { root.restore(); } }
        }
        Label { text: "标题栏按钮已点击 " + root.header-clicks + " 次"; }
        window-status := Label {
            text: (root.full-screen ? "全屏" : root.maximized ? "最大化" : root.minimized ? "最小化" : "普通")
                + (root.window-active ? " · 当前窗口" : " · 非活动")
                + (root.minimized-known ? "" : " · 宿主未报告最小化状态");
        }
    }
    dialog := Dialog {
        width: 280px; height: 132px;
        title: "模态层";
        open <=> root.modal;
        dismiss-dialog := Button { x: 24px; y: 52px; text: "返回"; clicked => { root.modal = false; } }
    }
}

component EditorPane inherits FocusScope {
    width: 218px; height: 148px;
    background: root.focus-within ? #355372 : #26364e;
    in property <string> name;
    in property <bool> query-enabled: true;
    out property <bool> active: root.focus-within;
    out property <int> visits: 0;
    out property <FocusReason> last-focus-reason: programmatic;
    callback enter-pane();
    callback clear-pane();
    enter-pane() => { root.focus(); }
    clear-pane() => { root.clear-focus(); }
    initial-focus: query;
    focus-within-changed(focused, reason) => {
        root.visits = focused ? root.visits + 1 : root.visits;
        root.last-focus-reason = reason;
    }
    Label { x: 12px; y: 9px; text: root.name; }
    notes := LineEdit {
        x: 12px; y: 43px; width: 194px; height: 34px;
        accessible-name: root.name + " 备注";
        placeholder-text: "备注";
        background: self.has-focus ? #203a52 : #19293c;
    }
    query := LineEdit {
        x: 12px; y: 87px; width: 194px; height: 34px;
        accessible-name: root.name + " 查询";
        enabled: root.query-enabled;
        placeholder-text: "查询";
        background: self.has-focus ? #203a52 : #19293c;
    }
    clear-shortcut := Shortcut { sequence: "Escape"; focus-within: true; activated() => { root.clear-focus(); } }
}

export component FocusScopesDemo inherits Window {
    title: "XRack · 焦点作用域";
    width: 492px; height: 272px;
    background: #141d2c;
    in-out property <bool> left-query-enabled: true;
    in-out property <bool> left-visible: true;
    out property <bool> left-active: left.active;
    out property <bool> right-active: right.active;
    out property <int> left-visits: left.visits;
    out property <int> right-visits: right.visits;
    out property <FocusReason> right-focus-reason: right.last-focus-reason;
    callback clear-left();
    clear-left() => { left.clear-pane(); }

    left := EditorPane {
        x: 18px; y: 18px; name: "左侧";
        query-enabled: root.left-query-enabled;
        visible: root.left-visible;
    }
    right := EditorPane { x: 254px; y: 18px; name: "右侧"; }
    jump-left := Button {
        x: 18px; y: 186px; width: 150px; height: 38px; text: "进入左侧";
        clicked() => { left.enter-pane(); }
    }
    jump-right := Button {
        x: 179px; y: 186px; width: 150px; height: 38px; text: "进入右侧";
        clicked() => { right.enter-pane(); }
    }
    disable-left := Button {
        x: 340px; y: 186px; width: 134px; height: 38px; text: "禁用查询";
        clicked() => { root.left-query-enabled = false; left.enter-pane(); }
    }
    Label {
        x: 18px; y: 241px;
        text: root.left-active ? "左区有焦点" : root.right-active ? "右区有焦点" : "编辑区无焦点";
    }
}

export component ScopedKeysDemo inherits Window {
    title: "XRack · 键盘事件路由";
    width: 512px; height: 254px;
    background: #141d2c;
    in-out property <bool> block-x: true;
    in-out property <string> text: "";
    in-out property <string> trace: "";
    out property <int> accepted-releases: 0;

    outer := FocusScope {
        x: 24px; y: 20px; width: 464px; height: 138px;
        background: #25334a;
        initial-focus: inner;
        capture-key-pressed(event) => {
            root.trace = root.trace + "外层捕获 ";
            event.modifiers.primary && event.key == "k" ? EventResult.accept : EventResult.reject
        }
        key-pressed(event) => {
            root.trace = root.trace + "外层冒泡 ";
            event.key == "F2" ? accept : reject
        }
        key-released(event) => {
            root.trace = root.trace + "外层释放 ";
            event.key == "F2" ? accept : reject
        }
        inner := FocusScope {
            x: 12px; y: 12px; width: 440px; height: 110px;
            initial-focus: field;
            capture-key-pressed(event) => {
                root.trace = root.trace + "内层捕获 ";
                event.text == "x" && root.block-x ? accept : reject
            }
            capture-key-released(event) => {
                root.accepted-releases = event.key == "x" && root.block-x
                    ? root.accepted-releases + 1 : root.accepted-releases;
                event.key == "x" && root.block-x ? accept : reject
            }
            key-pressed(event) => {
                root.trace = root.trace + "内层冒泡 ";
                reject
            }
            field := LineEdit {
                x: 12px; y: 12px; width: 400px; height: 36px;
                text <=> root.text;
                placeholder-text: "输入 a，尝试 x 和 F2";
                accessible-name: "键盘路由输入框";
            }
        }
    }
    enable-block := CheckBox {
        x: 24px; y: 174px; width: 190px; height: 36px;
        text: "拦截 x";
        checked <=> root.block-x;
    }
    start-typing := Button {
        x: 258px; y: 174px; width: 210px; height: 36px;
        text: "聚焦输入框";
        clicked() => { root.trace = ""; outer.focus(); }
    }
    status := Label {
        x: 24px; y: 220px; width: 464px;
        text: root.trace;
        overflow: elide;
    }
}

export component StyledTextDemo inherits Window {
    title: "XRack · 富文本";
    width: 460px; height: 268px;
    background: #141d2c;
    in-out property <styled-text> body: @markdown("# 发布说明\n\n**粗体**、*斜体*、[`xrackc`](#compiler) 和 ~~已弃用~~。\n\n**مرحبا** بكم في XRack · [阅读手册](#manual)");
    in-out property <bool> compact: false;
    in-out property <bool> links-enabled: true;
    out property <string> last-link: "";

    Label {
        x: 24px; y: 20px; text: "带内联样式的文字";
        font-size: 15px; color: #acc1d9;
    }
    body-label := StyledText {
        x: 24px; y: 52px; width: 412px;
        font-size: 22px;
        color: #e8f2ff;
        link-color: #84d8ff;
        enabled: root.links-enabled;
        max-lines: root.compact ? 2 : 5;
        overflow: elide;
        text: root.body;
        link-activated(target) => { root.last-link = target; }
    }
    Label {
        x: 24px; y: 212px; width: 412px; overflow: elide;
        text: root.last-link == "" ? "用 Tab 和 Enter 打开链接" : "已激活 " + root.last-link;
    }
    CheckBox {
        x: 24px; y: 236px; width: 412px; height: 30px;
        text: "只显示两行";
        checked <=> root.compact;
    }
}

export component CompositingDemo inherits Window {
    title: "XRack · 叠放与整组透明度";
    width: 460px; height: 292px;
    background: #101725;
    in-out property <float> fade: 0.5;
    in-out property <float> first-layer: 2.0;
    in-out property <float> first-opacity: 1.0;
    out property <int> first-clicks: 0;
    out property <int> second-clicks: 0;

    Label { x: 24px; y: 22px; text: "整组淡出"; color: #e8f2ff; }
    Label { x: 240px; y: 22px; text: "绘制与命中共用叠放顺序"; color: #e8f2ff; }
    composite := Rectangle {
        x: 24px; y: 56px; width: 172px; height: 124px;
        background: #ff0000;
        opacity: root.fade;
        Rectangle {
            x: 42px; y: 24px; width: 90px; height: 78px;
            background: #0000ff;
            Rectangle {
                x: 31px; y: 20px; width: 44px; height: 42px;
                opacity: 0.5; background: #00ff00;
            }
        }
    }
    stage := Rectangle {
        x: 240px; y: 56px; width: 184px; height: 124px;
        background: #263653;
        first := Button {
            x: 10px; y: 12px; width: 132px; height: 68px;
            z: root.first-layer;
            opacity: root.first-opacity;
            background: #39d6bc; color: #102132; text: "第一项";
            clicked() => { root.first-clicks = root.first-clicks + 1; }
        }
        second := Button {
            x: 42px; y: 30px; width: 132px; height: 68px;
            z: 1.0;
            background: #ffd177; color: #102132; text: "第二项";
            clicked() => { root.second-clicks = root.second-clicks + 1; }
        }
    }
    Slider {
        x: 24px; y: 201px; width: 172px; height: 28px;
        minimum: 0.0; maximum: 1.0;
        value <=> root.fade;
        accessible-name: "整组透明度";
    }
    swap-order := Button {
        x: 240px; y: 198px; width: 184px; height: 31px; text: "交换叠放顺序";
        clicked() => { root.first-layer = root.first-layer > 1.0 ? 0.0 : 2.0; }
    }
    toggle-first := Button {
        x: 240px; y: 237px; width: 184px; height: 31px; text: "切换第一项透明度";
        clicked() => { root.first-opacity = root.first-opacity == 0.0 ? 1.0 : 0.0; }
    }
    Label {
        x: 24px; y: 242px; width: 184px;
        color: #a7b6ce;
        text: "第一项 " + root.first-clicks + " · 第二项 " + root.second-clicks;
    }
}

export component RectangleShadowDemo inherits Window {
    title: "XRack · 矩形阴影";
    width: 460px; height: 268px;
    background: #101725;
    in-out property <length> blur: 0px;
    in-out property <length> inset-blur: 0px;
    in-out property <length> inset-spread: 0px;
    in-out property <length> spread: 0px;
    in-out property <length> shift: 16px;
    in-out property <length> outline: 0px;
    in-out property <float> card-alpha: 1.0;
    in-out property <brush> surface: #e0e8ff;
    out property <int> clicks: 0;

    Label { x: 24px; y: 20px; text: "外阴影 · 随父容器裁剪"; color: #e8f2ff; }
    Label { x: 238px; y: 20px; text: "内阴影 · 沿圆角收边"; color: #e8f2ff; }
    Rectangle {
        x: 24px; y: 56px; width: 184px; height: 116px; background: #263653;
        card := Rectangle {
            x: 24px; y: 16px; width: 116px; height: 72px;
            background: root.surface;
            border-width: root.outline;
            border-color: #a7b6ce;
            border-radius: 5px;
            opacity: root.card-alpha;
            drop-shadow-color: #39d6bc;
            drop-shadow-offset-x: root.shift;
            drop-shadow-offset-y: 16px;
            drop-shadow-spread: root.spread;
            drop-shadow-blur: root.blur;
            hit-card := TouchArea {
                width: 100%; height: 100%;
                clicked() => { root.clicks = root.clicks + 1; }
                accessible-name: "点击卡片";
            }
        }
    }
    Rectangle {
        x: 238px; y: 56px; width: 184px; height: 116px; background: #263653;
        Rectangle {
            x: 24px; y: 16px; width: 116px; height: 72px;
            background: #e0e8ff;
            border-radius: 18px;
            inner-shadow-color: #203056;
            inner-shadow-offset-x: 13px;
            inner-shadow-offset-y: 10px;
            inner-shadow-blur: root.inset-blur;
            inner-shadow-spread: root.inset-spread;
        }
    }
    soften := Button {
        x: 24px; y: 187px; width: 184px; height: 30px;
        text: root.blur == 0px ? "柔化阴影" : "恢复硬边";
        clicked() => {
            root.blur = root.blur == 0px ? 12px : 0px;
            root.inset-blur = root.blur;
        }
    }
    shift-shadow := Button {
        x: 238px; y: 187px; width: 184px; height: 30px;
        text: "切换偏移";
        clicked() => { root.shift = root.shift == 16px ? 48px : 16px; }
    }
    Label {
        x: 24px; y: 231px; text: "卡片点击次数 " + root.clicks;
        color: #a7b6ce;
    }
}

export component ClippingDemo inherits Window {
    title: "XRack · 圆角裁剪与溢出";
    width: 468px; height: 264px;
    background: #101725;
    in-out property <bool> clipped: true;
    in-out property <float> fade: 1.0;
    out property <int> hits: 0;

    Label {
        x: 24px; y: 20px;
        text: root.clipped ? "沿边框内侧裁剪" : "允许子项溢出";
        color: #e8f2ff; font-size: 19px;
    }
    clipper := Rectangle {
        x: 48px; y: 60px; width: 132px; height: 110px;
        background: #263653;
        border-color: #778dab; border-width: 8px;
        border-top-left-radius: 36px;
        border-top-right-radius: 20px;
        border-bottom-left-radius: 18px;
        border-bottom-right-radius: 28px;
        clip: root.clipped;
        opacity: root.fade;
        spill := Button {
            x: 96px; y: 32px; width: 96px; height: 44px;
            border-radius: 0px;
            background: #39d6bc; color: #102132;
            accessible-name: "跨出边框的按钮";
            clicked() => { root.hits = root.hits + 1; }
        }
        corner := Button {
            x: 9px; y: 9px; width: 6px; height: 6px; z: 1;
            border-radius: 0px;
            background: #ffd177;
            accessible-name: "圆角内的标记";
            clicked() => { root.hits = root.hits + 10; }
        }
    }
    Label { x: 280px; y: 20px; text: "未声明 clip 的矩形"; color: #e8f2ff; }
    Rectangle {
        x: 280px; y: 60px; width: 132px; height: 110px;
        background: #263653;
        border-color: #778dab; border-width: 8px;
        border-radius: 18px;
        Rectangle {
            x: 96px; y: 32px; width: 96px; height: 44px;
            background: #7c93f7;
        }
    }
    toggle-clip := Button {
        x: 24px; y: 192px; width: 200px; height: 31px;
        text: "切换裁剪 / 溢出";
        clicked() => { root.clipped = !root.clipped; }
    }
    toggle-fade := Button {
        x: 244px; y: 192px; width: 200px; height: 31px;
        text: "切换整组透明度";
        clicked() => { root.fade = root.fade == 1.0 ? 0.5 : 1.0; }
    }
    Label { x: 24px; y: 233px; color: #a7b6ce; text: "点击计数 " + root.hits; }
}

export component FlickableDemo inherits Window {
    width: 360px;
    height: 280px;
    title: "XRack · Flickable canvas";
    background: #192438;
    in-out property <bool> pan-enabled: true;
    in-out property <bool> shift-content: true;
    in property <FlickBoundsBehavior> edge-behavior: FlickBoundsBehavior.drag-and-overshoot-bounds;
    in property <FlickDirection> pan-direction: FlickDirection.both;
    in-out property <length> x-offset: 0px;
    in-out property <length> y-offset: 0px;
    out property <int> flicks: 0;
    out property <int> taps: 0;
    out property <bool> dragging: canvas.dragging;
    out property <bool> flicking: canvas.flicking;
    out property <bool> moving: canvas.moving;
    out property <bool> rebounding: canvas.rebounding;
    out property <length> overshoot-x: canvas.horizontal-overshoot;
    out property <length> overshoot-y: canvas.vertical-overshoot;
    callback stop();
    stop() => { canvas.cancel-flick(); }
    callback reset();
    reset() => { canvas.scroll-to(0px, 0px); }
    callback return-to-edge();
    return-to-edge() => { canvas.return-to-bounds(); }

    canvas := Flickable {
        x: 16px; y: 16px; width: 268px; height: 196px;
        content-width: 536px;
        content-x <=> root.x-offset;
        content-y <=> root.y-offset;
        interactive: root.pan-enabled;
        flick-direction: root.pan-direction;
        bounds-behavior: root.edge-behavior;
        bounds-movement: root.shift-content ? FlickBoundsMovement.follow-bounds-behavior : FlickBoundsMovement.stop-at-bounds;
        flicked() => { root.flicks += 1; }
        Rectangle { width: 536px; height: 392px; background: #25334c; }
        Rectangle { x: 110px; y: 40px; width: 100px; height: 72px; background: #77d6b3; }
        Rectangle { x: 365px; y: 40px; width: 100px; height: 72px; background: #f0b667; }
        Rectangle { x: 110px; y: 252px; width: 100px; height: 72px; background: #8ab3fc; }
        tap := Button { x: 8px; y: 8px; text: "Tap"; clicked() => { root.taps += 1; } }
    }
    ScrollBar {
        target: canvas; orientation: horizontal;
        x: 16px; y: 222px; width: 268px; height: 12px;
        accessible-name: "Canvas horizontal position";
    }
    ScrollIndicator { target: canvas; x: 304px; y: 16px; width: 8px; height: 196px; }
    CheckBox { x: 16px; y: 244px; width: 110px; height: 26px; text: "Pan"; checked <=> root.pan-enabled; }
    CheckBox { x: 232px; y: 244px; width: 110px; height: 26px; text: "Elastic content"; checked <=> root.shift-content; }
    Text { x: 132px; y: 248px; color: #e5edff; text: canvas.rebounding ? "Rebound" : (canvas.flicking ? "Flicking" : (canvas.dragging ? "Dragging" : "Idle")); }
}

export component SwipeGestureDemo inherits Window {
    width: 360px;
    height: 280px;
    title: "XRack · Directional swipe";
    background: #192438;
    in property <bool> gestures-enabled: true;
    out property <length> shift: 0px;
    out property <int> swipes: 0;
    out property <int> taps: 0;
    out property <int> cancellations: 0;
    out property <bool> swiping: swipe.swiping;
    out property <length> scroll-y: view.content-y;
    callback cancel-swipe();
    cancel-swipe() => { swipe.cancel(); }

    view := ScrollView {
        x: 16px; y: 16px; width: 328px; height: 220px;
        content-height: 440px;
        mouse-drag-pan-enabled: true;
        swipe := SwipeGestureHandler {
            width: 100%; height: 440px;
            enabled: root.gestures-enabled;
            handle-swipe-left: true;
            handle-swipe-right: true;
            swiped() => {
                root.shift += self.current-x - self.pressed-x;
                root.swipes += 1;
            }
            cancelled() => { root.cancellations += 1; }

            Rectangle { width: 100%; height: 440px; background: #25334c; }
            card := Rectangle {
                x: 80px + root.shift + (swipe.swiping ? swipe.current-x - swipe.pressed-x : 0px);
                y: 64px; width: 112px; height: 74px;
                border-radius: 8px; background: #77d6b3;
            }
            tap := Button { x: 12px; y: 12px; text: "Tap"; clicked() => { root.taps += 1; } }
            Text { x: 24px; y: 284px; color: #e5edff; text: "Vertical scrolling"; }
        }
    }
    Text { x: 16px; y: 244px; color: #e5edff; text: "Drag sideways to move the card"; }
}

export component ScaleRotateDemo inherits Window {
    width: 360px;
    height: 280px;
    title: "XRack · Pinch and rotate";
    background: #192438;
    in property <bool> gestures-enabled: true;
    out property <float> zoom: 1;
    out property <float> angle: 0;
    out property <int> taps: 0;
    out property <int> starts: 0;
    out property <int> ends: 0;
    out property <int> cancellations: 0;
    out property <bool> recognizing: gesture.active;
    out property <length> gesture-center-x: gesture.center-x;
    out property <length> gesture-center-y: gesture.center-y;
    property <float> initial-zoom: 1;
    property <float> initial-angle: 0;

    gesture := ScaleRotateGestureHandler {
        x: 16px; y: 16px; width: 328px; height: 220px;
        enabled: root.gestures-enabled;
        started() => {
            root.initial-zoom = root.zoom;
            root.initial-angle = root.angle;
            root.starts += 1;
        }
        updated() => {
            root.zoom = root.initial-zoom * self.scale;
            root.angle = root.initial-angle + self.rotation;
        }
        ended() => { root.ends += 1; }
        cancelled() => { root.cancellations += 1; }
        Rectangle {
            width: 100%; height: 100%; clip: true; background: #25334c;
            artwork := Rectangle {
                x: 124px; y: 70px; width: 80px; height: 80px;
                background: #77d6b3;
                transform-scale-x: root.zoom;
                transform-scale-y: root.zoom;
                transform-rotation: root.angle;
                Rectangle { x: 10px; y: 10px; width: 20px; height: 20px; background: #f0b667; }
            }
            tap := Button {
                x: 12px; y: 12px; text: "Tap";
                clicked() => { root.taps += 1; }
            }
        }
    }
    Text {
        x: 16px; y: 244px; color: #e5edff;
        text: gesture.active ? "Gesture active" : "Pinch or rotate with two fingers";
    }
}

export component TransformDemo inherits Window {
    title: "XRack · 视觉变换";
    width: 460px; height: 286px;
    background: #101725;
    in-out property <float> angle: 90.0;
    in-out property <float> scale-factor: 1.0;
    in-out property <float> amount: 0.0;
    out property <int> clicks: 0;

    Label { x: 24px; y: 18px; text: "旋转子树，点击跟随图形"; color: #e8f2ff; }
    Rectangle {
        x: 24px; y: 54px; width: 412px; height: 162px;
        background: #263653;
        tile := Rectangle {
            x: 86px; y: 26px; width: 88px; height: 56px;
            background: #203052; border-radius: 16px; clip: true;
            transform-rotation: root.angle;
            transform-scale: root.scale-factor;
            transform-origin-x: 0px; transform-origin-y: 0px;
            hot := Button {
                x: 8px; y: 8px; width: 44px; height: 26px;
                background: #39d6bc; border-radius: 0px;
                accessible-name: "跟随变换的按钮";
                clicked() => { root.clicks = root.clicks + 1; }
            }
            Rectangle {
                x: 0px; y: 0px; width: 3px; height: 3px; background: #ff3060;
            }
            Rectangle {
                x: 56px; y: 13px; width: 20px; height: 20px;
                transform-scale-x: -1.0;
                Rectangle { x: 0px; y: 0px; width: 8px; height: 20px; background: #ffd177; }
            }
        }
        ruler := Slider {
            x: 274px; y: 26px; width: 118px; height: 28px;
            transform-rotation: 90.0;
            transform-origin-x: 0px; transform-origin-y: 0px;
            minimum: 0.0; maximum: 1.0;
            value <=> root.amount;
            accessible-name: "旋转后的滑块";
        }
    }
    turn := Button {
        x: 24px; y: 232px; width: 160px; height: 32px; text: "切换旋转";
        clicked() => { root.angle = root.angle == 90.0 ? 0.0 : 90.0; }
    }
    zoom := Button {
        x: 200px; y: 232px; width: 112px; height: 32px; text: "切换缩放";
        clicked() => { root.scale-factor = root.scale-factor == 1.0 ? 0.75 : 1.0; }
    }
    Label { x: 327px; y: 240px; text: "点击 " + root.clicks; color: #a7b6ce; }
}
export component GeometryDemo inherits Window {
    title: "XRack · 实际布局几何";
    width: 500px; height: 290px;
    background: #182331;
    in property <bool> show-panel: true;
    in property <bool> rotated: false;
    out property <bool> panel-ready: panel.layout-ready;
    out property <length> panel-x: panel.layout-x;
    out property <length> panel-width: panel.layout-width;
    out property <length> panel-window-width: panel.window-bounds-width;
    out property <length> component-width: panel.measured-width;
    out property <length> tip-width: details.layout-width;
    out property <bool> tip-ready: details.layout-ready;
    callback show-details;
    show-details => { details.show(); }

    VerticalLayout {
        padding: 20px; spacing: 12px;
        HorizontalLayout {
            width: 100%; height: 80px; spacing: 8px;
            if root.show-panel : panel := GeometryPanel {
                transform-rotation: root.rotated ? 90 : 0;
            }
            Rectangle { width: 72px; height: 54px; background: #40547c; }
        }
        status := Text {
            width: 420px; height: 28px;
            text: root.panel-ready
                ? "布局宽度 " + (root.panel-width / 1px) + " · 窗口宽度 " + (root.panel-window-width / 1px)
                : "面板未布局";
        }
        trigger := Button {
            text: "显示按面板宽度布局的浮层";
            clicked => { root.show-details(); }
            details := PopupWindow {
                width: panel.layout-width;
                height: 36px;
                background: #35516b;
                Text { text: "浮层宽度来自已排版的面板"; }
            }
        }
    }
}

component GeometryPanel inherits Rectangle {
    height: 54px;
    horizontal-stretch: 1;
    background: #16857d;
    out property <length> measured-width: root.layout-width;
}
