export component SelectionDemo inherits Window {
    in-out property <int> quantity: 12;
    in-out property <int> choice: 1;
    in-out property <[string]> workspaces: ["首页", "项目", "任务", "设计", "终端", "构建", "测试", "文档", "反馈", "设置", "关于", "帮助"];
    in-out property <bool> locked: false;
    out property <string> selected-label: "";
    out property <int> edit-count: 0;
    out property <int> underlay-clicks: 0;

    title: "XRack 数字输入与选择";
    width: 560px;
    height: 350px;
    background: #101725;

    Text {
        x: 24px; y: 20px;
        text: "XRack 数字输入与选择";
        font-size: 25px;
        color: #f0f4ff;
    }
    Text {
        x: 24px; y: 56px;
        text: "整数提交 · 范围约束 · 可滚动弹层";
        font-size: 15px;
        color: #a7b6ce;
    }

    Rectangle {
        x: 24px; y: 92px; width: 248px; height: 118px;
        background: #1d293d; border-radius: 14px;
        Text { x: 16px; y: 12px; text: "数量"; color: #e7efff; }
        quantity-box := SpinBox {
            x: 16px; y: 42px; width: 216px; height: 36px;
            minimum: -20;
            maximum: 99;
            step-size: 3;
            wrap: true;
            read-only: root.locked;
            value <=> root.quantity;
            edited(value) => { root.edit-count += 1; }
        }
        Text { x: 16px; y: 88px; text: "方向键调节 · Enter 提交"; font-size: 13px; color: #a7b6ce; }
    }
    Rectangle {
        x: 288px; y: 92px; width: 248px; height: 118px;
        background: #1d293d; border-radius: 14px;
        Text { x: 16px; y: 12px; text: "工作区"; color: #e7efff; }
        workspace-box := ComboBox {
            x: 16px; y: 42px; width: 216px; height: 36px;
            enabled: !root.locked;
            model: root.workspaces;
            current-index <=> root.choice;
            selected(value) => { root.selected-label = value; }
        }
        Text { x: 16px; y: 88px; text: "方向键导航 · Escape 关闭"; font-size: 13px; color: #a7b6ce; }
    }

    underlay := Button {
        x: 288px; y: 222px; width: 248px; height: 36px;
        background: #314b80;
        text: "底层按钮";
        clicked => { root.underlay-clicks += 1; }
    }
    lock-toggle := Switch {
        x: 24px; y: 224px; width: 248px; height: 30px;
        text: "锁定输入";
        checked <=> root.locked;
    }
    Text {
        x: 24px; y: 281px;
        text: "数量 " + root.quantity + " · 提交 " + root.edit-count + " 次";
        font-size: 14px;
        color: #a7b6ce;
    }
    Text {
        x: 24px; y: 308px;
        text: "选择：" + root.selected-label + " · 底层按钮 " + root.underlay-clicks + " 次";
        font-size: 14px;
        color: #a7b6ce;
    }
}

export struct WorkspaceOption { code: int, title: string, notes: string }

export component RecordComboDemo inherits Window {
    title: "XRack · 记录下拉框";
    width: 472px; height: 296px;
    color-scheme: system;

    in-out property <[WorkspaceOption]> options: [
        WorkspaceOption { code: 200, title: "共享工作区", notes: "团队 B" },
        WorkspaceOption { code: 100, title: "共享工作区", notes: "团队 A" },
        WorkspaceOption { code: 300, title: "归档", notes: "只读归档" }
    ];
    in-out property <int> code: 200;
    in-out property <bool> editable: false;
    out property <int> selected-code: -1;
    out property <string> selected-label: "";
    out property <string> accepted-text: "";
    callback reorder;

    Text { x: 20px; y: 16px; text: "记录模型与业务编号"; font-size: 22px; }
    choice := ComboBox {
        x: 20px; y: 62px; width: 258px; height: 38px;
        accessible-name: "工作区选择";
        model: root.options;
        text-role: "title";
        value-role: "code";
        current-value <=> root.code;
        editable: root.editable;
        selected(label) => { root.selected-label = label; }
        value-selected(value) => { root.selected-code = value; }
        accepted(text) => { root.accepted-text = text; }
    }
    reorder-options := Button {
        x: 294px; y: 62px; width: 156px; height: 38px;
        text: "按编号重排";
        clicked => { root.reorder(); }
    }
    enable-editing := CheckBox { x: 20px; y: 136px; text: "允许编辑"; checked <=> root.editable; }
    Text { x: 20px; y: 182px; text: "当前编号 · " + root.code; }
    Text { x: 20px; y: 213px; text: "已选择编号 · " + root.selected-code; }
    Text { x: 20px; y: 246px; text: "已提交文本 · " + root.accepted-text; }
}

export component EditableChoiceDemo inherits Window {
    in-out property <[string]> workspaces: ["总部", "设计", "研发", "研发预览"];
    in-out property <int> active: 0;
    in-out property <string> active-value: "总部";
    in-out property <string> draft: "总部";
    out property <string> last-accepted: "";
    out property <int> edits: 0;
    out property <int> accepts: 0;
    out property <int> selections: 0;

    title: "XRack · 可编辑下拉框";
    width: 470px;
    height: 278px;
    background: #101725;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        alignment: start;
        Text { text: "输入名称 · → 补全 · Enter 提交"; font-size: 22px; color: #e7efff; }
        linked := ComboBox {
            editable: true;
            auto-complete: true;
            height: 38px;
            model: root.workspaces;
            current-index <=> root.active;
            edit-text <=> root.draft;
            placeholder-text: "选择或输入名称";
            edited(value) => { root.edits += 1; }
            selected(value) => { root.selections += 1; }
            accepted(value) => { root.last-accepted = value; root.accepts += 1; }
        }
        Text { text: "跟随已选项，也可单独编辑"; color: #a7b6ce; }
        automatic := ComboBox {
            editable: true;
            auto-complete: true;
            height: 38px;
            model: root.workspaces;
            current-value <=> root.active-value;
            placeholder-text: "尚未选择";
        }
        Text { text: "最近提交 · " + root.last-accepted; color: #acc0db; }
    }
}
