export component TextOperationsDemo inherits Window {
    title: "XRack · 程序化文本编辑";
    width: 520px; height: 238px;
    background: #142035;
    in-out property <string> document = "éclair 👩‍💻";
    in-out property <string> date = "2026-11-17";
    out property <string> edits = "";

    body := LineEdit {
        x: 20px; y: 18px; width: 480px; height: 36px;
        accessible-name: "正文";
        text <=> root.document;
        edited => { root.edits = root.edits + "[" + root.document + "]"; }
    }
    masked := LineEdit {
        x: 20px; y: 68px; width: 480px; height: 36px;
        accessible-name: "日期";
        input-mask: "9999-99-99";
        text <=> root.date;
    }
    format-tool := Button {
        x: 20px; y: 125px; width: 146px; height: 34px;
        text: "编辑正文";
        clicked => {
            body.replace-text(2, 3, "É");
            body.insert-text(0, "#");
            body.remove-text(0, 1);
            body.append-text("!");
        }
    }
    date-tool := Button {
        x: 178px; y: 125px; width: 151px; height: 34px;
        text: "更新月份";
        clicked => { masked.replace-text(5, 7, "12"); masked.insert-text(0, "!"); }
    }
    undo-tool := Button {
        x: 341px; y: 125px; width: 159px; height: 34px;
        text: "撤销正文编辑";
        clicked => { body.focus(); body.undo(); }
    }
    clear-tool := Button {
        x: 20px; y: 174px; width: 146px; height: 34px;
        text: "清空正文";
        clicked => { body.clear-text(); }
    }
    Label {
        x: 178px; y: 179px; width: 322px;
        text: "工具栏操作逐笔进入撤销历史";
    }
}

export component PatternValidationDemo inherits Window {
    title: "XRack · 正则输入校验";
    width: 488px; height: 224px;
    background: #142035;
    in-out property <string> code = "";
    in-out property <string> pattern = "[A-Z]{2}-[0-9]{3}";
    out property <bool> ready: field.acceptable-input;
    out property <InputValidity> validation: field.input-validity;
    out property <int> submissions = 0;

    Label {
        x: 20px; y: 18px; width: 448px;
        text: root.pattern == "[A-Z]{2}-[0-9]{3}" ? "格式 AB-123" : "格式 甲乙-123";
    }
    field := LineEdit {
        x: 20px; y: 56px; width: 448px; height: 38px;
        accessible-name: "设备编号";
        placeholder-text: root.pattern == "[A-Z]{2}-[0-9]{3}" ? "AB-123" : "甲乙-123";
        input-pattern: root.pattern;
        text <=> root.code;
        accepted => { root.submissions += 1; }
    }
    status := Label {
        x: 20px; y: 117px; width: 448px;
        text: root.validation == InputValidity.acceptable ? "可提交"
            : root.validation == InputValidity.intermediate ? "请补全编号" : "编号格式错误";
    }
    pattern-tool := Button {
        x: 20px; y: 163px; width: 186px; height: 34px;
        text: "切换编号格式";
        focus-on-click: false;
        clicked => {
            root.pattern = root.pattern == "[A-Z]{2}-[0-9]{3}"
                ? "[甲乙]{2}-[0-9]{3}" : "[A-Z]{2}-[0-9]{3}";
        }
    }
    submit := Button {
        x: 220px; y: 163px; width: 120px; height: 34px;
        text: "提交";
        enabled: root.ready;
        clicked => { root.submissions += 1; }
    }
}

export component DragDropDemo inherits Window {
    title: "XRack · 拖放";
    width: 560px; height: 258px;
    background: #141d2c;
    in-out property <string> payload = "XR-42";
    in-out property <bool> source-enabled = true;
    in-out property <bool> target-enabled = true;
    in-out property <bool> card-present = true;
    out property <int> clicks = 0;
    out property <string> received = "";
    out property <string> trace = "";
    out property <DragAction> result = DragAction.none;
    out property <length> last-x = 0px;

    Label {
        x: 24px; y: 24px;
        text: "拖动编号到右侧。按 Ctrl 复制，Esc 取消。";
    }
    source := DragArea {
        x: 24px; y: 76px; width: 174px; height: 82px;
        enabled: root.source-enabled;
        visible: root.card-present;
        data: root.payload;
        drag-key: "inventory";
        allow-copy: true; allow-move: true;
        drag-started() => { root.trace = "start"; }
        drag-finished(action) => {
            root.result = action;
            root.card-present = action != DragAction.move;
            root.trace = root.trace + "-finish";
        }
        card := Button {
            width: 100%; height: 100%;
            text: root.payload;
            clicked() => { root.clicks = root.clicks + 1; }
        }
    }
    target := DropArea {
        x: 326px; y: 76px; width: 210px; height: 82px;
        enabled: root.target-enabled;
        keys: ["inventory"];
        entered(data, action) => { root.trace = root.trace + "-enter"; }
        position-changed(x, y) => { root.last-x = x; }
        exited() => { root.trace = root.trace + "-exit"; }
        dropped(data, action) => {
            root.received = data;
            root.trace = root.trace + "-drop";
        }
        Rectangle {
            width: 100%; height: 100%;
            background: #28414e; border-radius: 8px;
            Label { x: 14px; y: 28px; text: "接收区"; }
        }
        rejected-child := DropArea {
            x: 24px; y: 18px; width: 158px; height: 50px;
            keys: ["unrelated"];
            dropped(data, action) => { root.received = "unexpected"; }
        }
    }
    status := Label {
        x: 24px; y: 182px;
        text: root.received == "" ? "尚未接收" : root.result == DragAction.move
            ? "已移动 " + root.received : "已复制 " + root.received;
    }
    reset-card := Button {
        x: 400px; y: 174px; width: 136px; height: 40px;
        text: "恢复编号";
        clicked() => { root.card-present = true; root.received = ""; }
    }
}

component DragInboxRow inherits DropArea {
    in property <string> title;
    property <string> received = "";
    keys: ["inventory"];
    dropped(data, action) => { root.received = data; }
    Label { text: root.title + ":" + root.received; }
}

export component VirtualDragDemo inherits Window {
    width: 360px; height: 180px;
    in-out property <[string]> items = ["old", "new"];
    source := DragArea {
        x: 12px; y: 12px; width: 128px; height: 54px;
        data: "ticket"; drag-key: "inventory"; allow-copy: true;
        Rectangle { width: 100%; height: 100%; background: #314b80; }
    }
    inbox := ListView {
        x: 156px; y: 12px; width: 172px; height: 78px;
        row-height: 36px;
        for item in root.items : DragInboxRow { title: item; }
    }
}

export component FileDropDemo inherits Window {
    title: "XRack · 拖入文件";
    width: 536px; height: 310px;
    in-out property <bool> images-enabled = true;
    out property <[string]> paths = [];
    out property <[string]> preview = [];
    out property <int> batches = 0;
    out property <string> zone = "";
    out property <string> failure = "";
    private property <string> hovered-zone = "";
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;
        Label { height: 36px; text: "拖入图片或文档"; font-size: 20px; }
        HorizontalLayout {
            height: 82px;
            spacing: 20px;
            images := DropArea {
                preferred-width: 0px;
                horizontal-stretch: 1;
                enabled: root.images-enabled;
                accept-files: true;
                file-extensions: ["png", "jpeg", "jpg"];
                files-entered(paths) => { root.preview = paths; }
                position-changed(x, y) => { root.hovered-zone = "images"; }
                exited() => { root.preview = []; root.hovered-zone = ""; }
                files-dropped(paths) => {
                    root.preview = [];
                    root.hovered-zone = "";
                    root.failure = "";
                    root.paths = paths;
                    root.batches = root.batches + 1;
                    root.zone = "图片";
                }
                files-failed(reason) => { root.failure = reason; }
                Rectangle {
                    width: 100%; height: 100%;
                    background: root.hovered-zone == "images" ? #386779 : #28414e; border-radius: 8px;
                    Label { width: 100%; height: 100%; text: "PNG / JPEG"; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            documents := DropArea {
                preferred-width: 0px;
                horizontal-stretch: 1;
                accept-files: true;
                file-extensions: [".txt", "md"];
                files-entered(paths) => { root.preview = paths; }
                position-changed(x, y) => { root.hovered-zone = "documents"; }
                exited() => { root.preview = []; root.hovered-zone = ""; }
                files-dropped(paths) => {
                    root.preview = [];
                    root.hovered-zone = "";
                    root.failure = "";
                    root.paths = paths;
                    root.batches = root.batches + 1;
                    root.zone = "文档";
                }
                files-failed(reason) => { root.failure = reason; }
                Rectangle {
                    width: 100%; height: 100%;
                    background: root.hovered-zone == "documents" ? #4b6095 : #34405e; border-radius: 8px;
                    Label { width: 100%; height: 100%; text: "TXT / Markdown"; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Label {
            height: 24px;
            text: root.batches == 0 ? "尚未接收" : root.zone + " · 已接收 " + root.batches + " 批";
        }
        Label {
            visible: root.failure != "";
            height: 24px;
            accessible-name: "接收失败 · " + root.failure;
            text: "接收失败 · " + root.failure;
            overflow: elide;
        }
        ScrollView {
            height: 96px;
            VerticalLayout {
                alignment: start;
                for path in root.paths : Label { text: path; height: 24px; }
            }
        }
    }
}

