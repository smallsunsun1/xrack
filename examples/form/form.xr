import { DateField, LabelCard as BaseLabel, TimeField } from "widgets.xr";

component SearchLabel inherits BaseLabel {
    caption: "搜索关键词";
    background: #304777;
}

export component FileDialogDemo inherits Window {
    title: "XRack · 系统文件对话框";
    width: 548px; height: 286px;

    in-out property <string> start-directory = "";
    in-out property <FileDialogMode> mode = FileDialogMode.open-file;
    out property <[string]> paths: picker.selected-files;
    out property <string> first-path: picker.selected-file;
    out property <bool> pending: picker.pending;
    out property <string> callback-path = "";
    out property <string> status = "请选择一个操作";

    callback choose(next: FileDialogMode);
    choose(next) => { root.mode = next; picker.open(); }
    callback choose-folders;
    choose-folders => { root.choose(FileDialogMode.select-folders); }

    picker := FileDialog {
        mode: root.mode;
        title: "选择文件或目录";
        directory: root.start-directory;
        file-name: root.mode == FileDialogMode.save-file ? "notes.txt" : "";
        name-filters: ["Text files (*.txt *.md)"];
        accepted(selection) => {
            root.callback-path = picker.selected-file;
            root.status = picker.pending ? "仍在等待" : "已选择";
        }
        canceled => { root.status = "已取消"; }
        failed(message) => { root.status = message; }
    }

    VerticalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: "系统文件对话框"; font-size: 22px; }
        HorizontalLayout {
            spacing: 8px;
            open-one := Button { enabled: !picker.pending; text: "打开文件"; clicked => { root.choose(FileDialogMode.open-file); } }
            open-many := Button { enabled: !picker.pending; text: "打开多个"; clicked => { root.choose(FileDialogMode.open-files); } }
            save-as := Button { enabled: !picker.pending; text: "另存为"; clicked => { root.choose(FileDialogMode.save-file); } }
            select-folder := Button { enabled: !picker.pending; text: "选择目录"; clicked => { root.choose(FileDialogMode.select-folder); } }
            select-folders := Button { enabled: !picker.pending; text: "多个目录"; clicked => { root.choose-folders(); } }
        }
        status := Text { text: picker.pending ? "等待系统面板…" : root.status; }
        ScrollView {
            height: 112px;
            VerticalLayout {
                alignment: start;
                for path in root.paths : Text { text: path; height: 24px; }
            }
        }
    }
}

export component MessageDialogDemo inherits Window {
    title: "XRack · 系统消息对话框";
    width: 490px; height: 206px;

    in-out property <bool> confirm-enabled = true;
    out property <int> accepts = 0;
    out property <int> rejects = 0;
    out property <StandardButtonKind> answer = StandardButtonKind.cancel;
    out property <string> status = "请选择一个操作";

    callback ask;
    ask => { confirmation.open(); }

    confirmation := MessageDialog {
        title: "恢复设置";
        text: "要恢复默认设置吗？";
        informative-text: "当前修改将在确认后清除。";
        level: warning;
        buttons: yes-no-cancel;
        enabled: root.confirm-enabled;
        accepted => { root.accepts += 1; }
        rejected => { root.rejects += 1; }
        finished(button) => {
            root.answer = button;
            root.status = button == StandardButtonKind.yes ? "已确认" :
                          button == StandardButtonKind.no ? "已拒绝" : "已取消";
        }
        failed(message) => { root.status = message; }
    }
    notice := MessageDialog {
        text: "设置已同步";
        informative-text: "这条消息由系统对话框显示。";
        finished(button) => { root.answer = button; root.status = "已知晓"; }
        failed(message) => { root.status = message; }
    }

    VerticalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: "系统消息对话框"; font-size: 22px; }
        HorizontalLayout {
            spacing: 8px;
            confirm := Button { text: "确认恢复设置"; clicked => { root.ask(); } }
            show-notice := Button { text: "显示通知"; clicked => { notice.open(); } }
        }
        status := Text { text: root.status; }
        Text { text: "确认 " + root.accepts + " 次 · 拒绝或取消 " + root.rejects + " 次"; }
    }
}

export component CloseGuardDemo inherits Window {
    title: "XRack · 草稿窗口";
    width: 510px; height: 318px;

    in-out property <bool> dirty = false;
    in-out property <string> draft = "";
    out property <string> status = "输入一些文字，再试着关闭窗口";
    out property <int> requests = 0;
    callback close-from-rust;
    callback ask-discard() -> bool;
    ask-discard() => { discard.open(); false }

    close-requested() => {
        root.requests += 1;
        root.dirty ? root.ask-discard() : true
    }

    discard := MessageDialog {
        title: "放弃未保存的草稿？";
        text: "确认后关闭窗口。";
        level: warning;
        buttons: ok-cancel;
        accepted => { root.dirty = false; root.close(); }
        rejected => { root.status = "继续编辑"; }
        failed(message) => { root.status = message; }
    }

    VerticalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        Text { text: "关闭前确认"; font-size: 22px; }
        entry := TextEdit {
            height: 110px;
            accessible-name: "草稿";
            text <=> root.draft;
            edited(value) => { root.dirty = true; root.status = "未保存"; }
        }
        status := Text { text: root.status; }
        Text { text: "关闭请求 · " + root.requests; }
        HorizontalLayout {
            spacing: 8px;
            close-window := Button { text: "关闭窗口"; clicked => { root.close(); } }
            rust-close := Button { text: "Rust 请求关闭"; clicked => { root.close-from-rust(); } }
        }
    }
}

export component BidiEditorDemo inherits Window {
    title: "XRack · 双向文字编辑";
    width: 520px;
    height: 300px;
    in-out property <string> line = "Order אבג 123 — مرحبا";
    in-out property <string> document = "Order אבג 123 — مرحبا\nעברית 45 text — العربية";

    VerticalLayout {
        padding: 16px; spacing: 10px;
        Text { text: "单行 · Option / Ctrl + 方向键按词移动"; }
        entry := LineEdit {
            accessible-name: "混排单行";
            text <=> root.line;
            font-size: 22px;
        }
        Text { text: "多行 · 上下键保留屏幕横坐标"; }
        paragraph := TextArea {
            accessible-name: "混排段落";
            text <=> root.document;
            font-size: 22px;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
    }
}

export component EditorCommandsDemo inherits Window {
    title: "XRack · 编辑命令";
    width: 620px;
    height: 240px;
    in property <bool> locked = false;
    in-out property <string> document = "任务：在这里编辑文本";
    callback select-prefix;
    select-prefix => { entry.focus(); entry.set-selection-offsets(0, 9); }
    callback paste-selected;
    paste-selected => { entry.paste(); }
    callback undo-edit;
    undo-edit => { entry.undo(); }
    callback redo-edit;
    redo-edit => { entry.redo(); }

    VerticalLayout {
        padding: 16px; spacing: 12px;
        HorizontalLayout {
            spacing: 6px;
            prefix-tool := Button { text: "选前缀"; focus-on-click: false; clicked => { root.select-prefix(); } }
            select-tool := Button { text: "全选"; focus-on-click: false; clicked => { entry.select-all(); } }
            clear-tool := Button { text: "取消选区"; focus-on-click: false; clicked => { entry.clear-selection(); } }
            cut-selection := Button { text: "剪切"; focus-on-click: false; enabled: entry.can-cut; clicked => { entry.cut(); } }
            copy-selection := Button { text: "复制"; focus-on-click: false; enabled: entry.can-copy; clicked => { entry.copy(); } }
            paste-tool := Button { text: "粘贴"; focus-on-click: false; clicked => { root.paste-selected(); } }
            undo-tool := Button { text: "撤销"; focus-on-click: false; enabled: entry.can-undo; clicked => { root.undo-edit(); } }
            redo-tool := Button { text: "重做"; focus-on-click: false; enabled: entry.can-redo; clicked => { root.redo-edit(); } }
        }
        entry := TextEdit {
            accessible-name: "正文";
            read-only: root.locked;
            vertical-stretch: 1;
            text <=> root.document;
        }
    }
}

export component EditorMenuDemo inherits Window {
    title: "XRack · 编辑器右键菜单";
    width: 540px; height: 420px;
    background: #182331;
    in-out property <string> document = "Select a word, then right-click";
    in-out property <int> quantity = 42;
    out property <int> custom-actions = 0;

    VerticalLayout {
        padding: 16px; spacing: 8px;
        Label { text: "右键或 Shift+F10 打开编辑菜单"; font-size: 21px; }
        entry := LineEdit { text <=> root.document; accessible-name: "笔记标题"; }
        read-only := LineEdit { text: "Copy from this read-only field"; read-only: true; }
        secret := LineEdit { text: "sample-password"; input-type: password; }
        quantity := SpinBox { value <=> root.quantity; minimum: 0; maximum: 999; }
        body := TextArea { text: "A multi-line draft.\nEdits can be undone."; vertical-stretch: 1; }
        ContextMenuArea {
            custom := LineEdit { text: "Application menu"; }
            Menu { MenuItem { text: "Custom action"; activated => { root.custom-actions += 1; } } }
        }
        quiet := LineEdit { text: "Context menu disabled"; context-menu-enabled: false; }
    }
}

export component FormDemo inherits Window {
    in-out property <string> query = "";
    out property <int> edits = 0;
    out property <int> submissions = 0;
    out property <int> last-result = 0;
    in-out property <[string]> suggestions = ["设计系统", "构建工具", "文本编辑", "组件组合", "GPU 绘制"];
    in-out property <bool> show-suggestions = true;
    callback result-length(value: int) -> int;
    result-length(value) => { value + root.submissions }
    callback record-submit;
    record-submit => { root.submissions += 1; }

    title: "XRack 交互表单";
    width: 560px;
    height: 428px;
    background: #111927;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;

        Text { text: "XRack 交互表单"; font-size: 26px; color: #f0f4ff; }
        Text { text: "跨文件组件 · 网格布局 · 双向绑定"; font-size: 15px; color: #a7b6ce; }

        GridLayout {
            horizontal-spacing: 12px;
            vertical-spacing: 10px;
            height: 98px;
            Row {
                label := SearchLabel { width: 132px; height: 42px; }
                query-input := LineEdit {
                    height: 42px;
                    preferred-width: 280px;
                    horizontal-stretch: 2;
                    text <=> root.query;
                    placeholder-text: "输入关键词，按 Enter 提交";
                    font-size: 16px;
                    edited() => { root.edits += 1; }
                    accepted => {
                        label.record();
                        root.record-submit();
                        root.last-result = root.result-length(label.activations);
                    }
                }
            }
            Row {
                if root.query != "" : preview := Text {
                    colspan: 2;
                    height: 27px;
                    text: label.preview-text(root.query);
                    color: #a8ddff;
                    font-size: 17px;
                }
            }
        }

        status := Text {
            text: "编辑 " + root.edits + " 次 · 提交 " + root.submissions + " 次 · 结果 " + root.last-result;
            color: #a7b6ce;
            font-size: 15px;
        }
        Rectangle {
            height: 8px;
            background: #25314a;
            border-radius: 4px;
            meter := Rectangle {
                width: root.query == "" ? 50% : 75%;
                background: #58d6bf;
                border-radius: 4px;
                animate width { duration: 220ms; }
            }
        }
        show-list := CheckBox {
            text: "显示建议";
            height: 27px;
            checked <=> root.show-suggestions;
        }
        if root.show-suggestions : suggestions-view := ScrollView {
            height: 84px;
            VerticalLayout {
                alignment: start;
                for suggestion[index] in root.suggestions : Text {
                    height: 26px;
                    text: (index + 1) + "  " + suggestion;
                    font-size: 15px;
                    color: #c5d3eb;
                }
            }
        }
    }
}

export component DateFieldDemo inherits Window {
    title: "XRack · 日期字段";
    width: 452px;
    height: 464px;
    background: #162034;

    in-out property <[Date]> closed-dates = [Date { year: 2024, month: 2, day: 29 }];
    out property <Date> committed-date: booking.date;
    out property <string> draft: booking.draft-text;
    out property <bool> acceptable: booking.acceptable-input;
    out property <int> commits = 0;

    Label { x: 24px; y: 18px; text: "预约日期"; font-size: 20px; }
    booking := DateField {
        x: 24px; y: 56px; width: 404px;
        caption: "预约日期";
        initial-date: Date { year: 2024, month: 2, day: 28 };
        minimum-date: Date { year: 2024, month: 2, day: 5 };
        maximum-date: Date { year: 2024, month: 4, day: 15 };
        disabled-weekdays: [6, 7];
        disabled-dates: root.closed-dates;
        committed(day) => { root.commits += 1; }
    }
    Label {
        x: 24px; y: 113px;
        text: root.acceptable ? "可提交" : "请检查日期或停约规则";
    }
    Label {
        x: 24px; y: 145px;
        text: "已提交 · " + root.committed-date;
    }
    next-appointment := Button {
        x: 24px; y: 184px; width: 200px; height: 36px;
        text: "载入 3 月 4 日预约";
        clicked => { booking.set-date(Date { year: 2024, month: 3, day: 4 }); }
    }
}

export component TimeFieldDemo inherits Window {
    title: "XRack · 时间字段";
    width: 452px;
    height: 440px;
    background: #162034;

    in-out property <bool> show-seconds = false;
    in-out property <Time> latest = Time { hour: 17, minute: 0, second: 0 };
    out property <Time> committed-time: appointment.time;
    out property <string> draft: appointment.draft-text;
    out property <bool> acceptable: appointment.acceptable-input;
    out property <int> commits = 0;

    Label { x: 24px; y: 18px; text: "预约时间"; font-size: 20px; }
    appointment := TimeField {
        x: 24px; y: 56px; width: 404px;
        caption: "预约时间";
        initial-time: Time { hour: 13, minute: 30, second: 42 };
        minimum-time: Time { hour: 9, minute: 0, second: 0 };
        maximum-time: root.latest;
        show-seconds: root.show-seconds;
        use-24-hour-format: false;
        committed(value) => { root.commits += 1; }
    }
    Label { x: 24px; y: 113px; text: root.acceptable ? "可提交" : "请检查时间或营业时段"; }
    Label { x: 24px; y: 145px; text: "已提交 · " + root.committed-time; }
    seconds-toggle := Button {
        x: 24px; y: 184px; width: 150px; height: 36px;
        text: root.show-seconds ? "隐藏秒数" : "显示秒数";
        clicked => { root.show-seconds = !root.show-seconds; }
    }
    preset-time := Button {
        x: 184px; y: 184px; width: 218px; height: 36px;
        text: "载入 16:05:45 预约";
        clicked => { appointment.set-time(Time { hour: 16, minute: 5, second: 45 }); }
    }
}

export component EditorInsetsDemo inherits Window {
    title: "XRack · 输入框内边距";
    width: 432px;
    height: 350px;

    in-out property <bool> spacious = true;
    in-out property <color> hint = #ffb554;
    in-out property <string> account = "";

    account-field := LineEdit {
        x: 24px; y: 42px; width: 384px; height: 64px;
        accessible-name: "账户";
        text <=> root.account;
        placeholder-text: "请输入账户名称";
        placeholder-text-color: root.hint;
        padding: 6px;
        padding-left: root.spacious ? 48px : 6px;
        padding-top: root.spacious ? 24px : 6px;
    }
    Label { x: 24px; y: 16px; text: "账户"; }
    note-field := TextArea {
        x: 24px; y: 124px; width: 384px; height: 114px;
        accessible-name: "备注";
        placeholder-text: "填写备注，可输入多行";
        placeholder-text-color: root.hint;
        padding-top: root.spacious ? 22px : 6px;
        padding-left: root.spacious ? 24px : 6px;
        padding-right: root.spacious ? 78px : 6px;
        padding-bottom: root.spacious ? 16px : 6px;
    }
    choice := ComboBox {
        x: 24px; y: 254px; width: 384px; height: 44px;
        editable: true;
        model: ["本地账户", "团队账户"];
        placeholder-text: "选择或输入团队";
        placeholder-text-color: root.hint;
        padding-left: root.spacious ? 24px : 6px;
    }
    padding-toggle := CheckBox {
        x: 24px; y: 310px; width: 214px; height: 28px;
        text: "使用自定义内边距";
        checked <=> root.spacious;
    }
}

export component PasswordDemo inherits Window {
    title: "XRack · 密码输入";
    width: 392px;
    height: 254px;
    background: #162034;

    in-out property <string> secret = "";
    in-out property <bool> reveal = false;
    in-out property <string> mask-character = "•";
    in-out property <bool> briefly-reveal = false;
    out property <int> submissions = 0;

    Text { x: 24px; y: 18px; text: "密码输入"; font-size: 22px; }
    passphrase := LineEdit {
        x: 24px; y: 60px; width: 344px; height: 44px;
        accessible-name: "口令";
        placeholder-text: "输入测试口令";
        input-type: password;
        password-visible: root.reveal;
        password-character: root.mask-character;
        password-mask-delay: root.briefly-reveal ? 750 : 0;
        text <=> root.secret;
        accepted => { root.submissions += 1; }
    }
    reveal-toggle := CheckBox {
        x: 24px; y: 117px; width: 154px; height: 34px;
        text: "显示口令";
        checked <=> root.reveal;
    }
    mask-toggle := Button {
        x: 184px; y: 117px; width: 184px; height: 34px;
        text: "切换遮罩 " + root.mask-character;
        clicked => { root.mask-character = root.mask-character == "•" ? "*" : "•"; }
    }
    timed-reveal-toggle := CheckBox {
        x: 24px; y: 154px; width: 256px; height: 34px;
        text: "短暂显示刚键入的字符";
        checked <=> root.briefly-reveal;
    }
    Text { x: 24px; y: 206px; text: "提交 " + root.submissions + " 次"; color: #acc0db; }
}

export component ValidationDemo inherits Window {
    title: "XRack · 表单输入限制";
    width: 424px;
    height: 338px;
    background: #162034;

    in-out property <string> code = "12";
    in-out property <string> amount = "";
    in-out property <string> note = "";
    in-out property <int> note-limit = 6;
    out property <int> amount-edits = 0;
    out property <string> submitted-amount = "";

    Text { x: 24px; y: 16px; text: "表单输入限制"; font-size: 22px; }
    code-field := LineEdit {
        x: 24px; y: 58px; width: 376px; height: 42px;
        accessible-name: "验证码";
        placeholder-text: "验证码 · 最多 4 位数字";
        input-type: number;
        maximum-length: 4;
        text <=> root.code;
    }
    amount-field := TextInput {
        x: 24px; y: 114px; width: 376px; height: 42px;
        accessible-name: "金额";
        placeholder-text: "金额 · 用逗号分隔小数，按 Enter 提交";
        input-type: decimal;
        decimal-separator: ",";
        text <=> root.amount;
        edited() => { root.amount-edits += 1; }
        accepted => { root.submitted-amount = root.amount; }
    }
    note-field := TextArea {
        x: 24px; y: 170px; width: 376px; height: 102px;
        accessible-name: "备注";
        placeholder-text: "备注 · 最多 " + root.note-limit + " 个字素簇";
        maximum-length: root.note-limit;
        text <=> root.note;
    }
    submission := Text {
        x: 24px; y: 289px;
        text: "已提交金额：" + root.submitted-amount;
        color: #acc0db;
    }
}

export component SubmissionValidationDemo inherits Window {
    title: "XRack · 提交校验";
    width: 420px; height: 300px;
    background: #162034;

    in-out property <string> code = "";
    in-out property <string> note = "";
    in-out property <bool> accepting = true;
    out property <bool> can-send: entry.acceptable-input;
    out property <bool> note-ready: note-field.acceptable-input;
    out property <int> submissions = 0;

    callback submit();
    submit => { root.submissions += 1; }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        entry := LineEdit {
            accessible-name: "验证码";
            placeholder-text: "输入 4 位验证码，不能全为 0";
            input-type: number;
            minimum-length: 4;
            maximum-length: 4;
            submit-when: root.accepting && root.code != "0000";
            text <=> root.code;
            accepted => { root.submit(); }
        }
        note-field := TextArea {
            accessible-name: "备注";
            placeholder-text: "备注（至少两个字素簇）";
            minimum-length: 2;
            text <=> root.note;
        }
        permission := CheckBox { text: "允许提交验证码"; checked <=> root.accepting; }
        send := Button {
            text: "提交验证码";
            enabled: root.can-send;
            clicked => { root.submit(); }
        }
        Label { text: "已提交 " + root.submissions + " 次"; }
    }
}

export component NumericValidationDemo inherits Window {
    title: "XRack · 数值校验";
    width: 440px; height: 260px;
    background: #162034;

    in-out property <string> draft = "";
    in-out property <InputType> mode = decimal;
    in-out property <float> lower = -20.50;
    in-out property <float> upper = 100.25;
    in-out property <int> fraction-digits = 2;
    out property <bool> can-submit: field.acceptable-input;
    out property <string> submitted = "";

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Label { text: "金额范围：-20,50 到 100,25，最多两位小数"; }
        field := TextInput {
            accessible-name: "金额";
            placeholder-text: "使用逗号作为小数点";
            input-type: root.mode;
            decimal-separator: ",";
            minimum-value: root.lower;
            maximum-value: root.upper;
            decimals: root.fraction-digits;
            text <=> root.draft;
            accepted => { root.submitted = root.draft; }
        }
        send := Button {
            text: "提交金额";
            enabled: root.can-submit;
            clicked => { root.submitted = root.draft; }
        }
        Label { text: "已提交：" + root.submitted; }
    }
}

export component InputMaskDemo inherits Window {
    title: "XRack · 输入掩码";
    width: 440px; height: 320px;
    background: #162034;

    in-out property <string> date = "";
    in-out property <string> device = "";
    in-out property <string> date-mask = "9999-99-99";
    out property <bool> date-ready: date-field.acceptable-input;
    out property <bool> device-ready: device-field.acceptable-input;
    out property <string> submitted = "";

    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Label { text: "日期 · YYYY-MM-DD"; }
        date-field := LineEdit {
            accessible-name: "日期";
            input-mask: root.date-mask;
            placeholder-text: "输入或粘贴 20261117";
            text <=> root.date;
            accepted => { root.submitted = root.date; }
        }
        Label { text: "设备编号 · 两个字母与三位数字"; }
        device-field := TextInput {
            accessible-name: "设备编号";
            input-mask: "AA-999";
            placeholder-text: "例如 AB123";
            text <=> root.device;
        }
        send := Button {
            text: "提交记录";
            enabled: root.date-ready && root.device-ready;
            clicked => { root.submitted = root.date + " / " + root.device; }
        }
        result := Label { text: root.submitted; }
    }
}

export component EditingLifecycleDemo inherits Window {
    title: "XRack · 结束编辑";
    width: 488px; height: 386px;
    background: #162034;

    in-out property <string> code = "";
    in-out property <string> note = "";
    out property <int> finishes = 0;
    out property <int> accepts = 0;
    out property <string> trace = "";
    out property <string> last-result = "";
    callback finish(string, bool);

    finish(text, acceptable) => {
        root.finishes += 1;
        root.last-result = (acceptable ? "已保存 " : "待补全 ") + text;
    }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        label := Label { text: "输入编号后按 Enter 或 Tab"; }
        code-field := LineEdit {
            accessible-name: "编号";
            input-mask: "999-999";
            placeholder-text: "六位数字";
            text <=> root.code;
            accepted => {
                root.accepts += 1;
                root.trace += "accept;";
            }
            editing-finished(text, acceptable) => {
                root.trace += (acceptable ? "code:valid;" : "code:draft;");
                root.finish(text, acceptable);
            }
        }
        note-field := TextArea {
            height: 100px;
            accessible-name: "备注";
            placeholder-text: "备注（至少 4 个字素簇）";
            minimum-length: 4;
            text <=> root.note;
            editing-finished(text, acceptable) => {
                root.trace += (acceptable ? "note:valid;" : "note:draft;");
                root.finish(text, acceptable);
            }
        }
        reset := Button {
            text: "载入示例编号";
            clicked => { root.code = "987-654"; }
        }
        result := Label { text: root.last-result; }
        totals := Label { text: "结束编辑 " + root.finishes + " 次 · Enter 确认 " + root.accepts + " 次"; }
    }
}

export component EditorSelectionDemo inherits Window {
    title: "XRack · 文本选区";
    width: 456px; height: 330px;
    background: #162034;

    in-out property <string> document = "任务：é👩‍💻";
    in-out property <bool> concealed = false;
    in-out property <bool> overwrite = false;
    in-out property <MouseSelectionMode> mouse-mode = MouseSelectionMode.characters;
    out property <int> caret: entry.cursor-offset;
    out property <int> selection-start: entry.selection-start-offset;
    out property <int> selection-end: entry.selection-end-offset;
    out property <string> selected: entry.selected-text;

    callback select-prefix;
    select-prefix => { entry.focus(); entry.set-selection-offsets(9, 0); }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        entry := LineEdit {
            accessible-name: "正文";
            input-type: root.concealed ? password : text;
            mouse-selection-mode: root.mouse-mode;
            overwrite-mode: root.overwrite;
            text <=> root.document;
        }
        select-prefix-tool := Button {
            text: "向左选择前缀";
            focus-on-click: false;
            clicked => { root.select-prefix(); }
        }
        selection-info := Label {
            text: "光标 " + root.caret + " · 选区 [" + root.selection-start + ", " + root.selection-end + ")";
        }
        selection-text := Label { text: "选中文字：" + root.selected; }
        mode-button := Button {
            text: root.mouse-mode == MouseSelectionMode.characters ? "鼠标选区：按字"
                : root.mouse-mode == MouseSelectionMode.words ? "鼠标选区：按词" : "鼠标选区：只放置光标";
            focus-on-click: false;
            clicked => {
                root.mouse-mode = root.mouse-mode == MouseSelectionMode.characters ? MouseSelectionMode.words
                    : root.mouse-mode == MouseSelectionMode.words ? MouseSelectionMode.caret : MouseSelectionMode.characters;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            CheckBox { text: "覆盖输入"; checked <=> root.overwrite; }
            select-word-tool := Button {
                text: "选择光标处的词";
                focus-on-click: false;
                clicked => { entry.focus(); entry.select-word(); }
            }
        }
    }
}

export component PersistentSelectionDemo inherits Window {
    title: "XRack · 保留文本选区";
    width: 480px; height: 264px;
    background: #162034;
    in-out property <string> document = "éclair 和猫";
    in-out property <bool> retain = true;
    out property <string> selected: entry.selected-text;
    out property <int> selection-start: entry.selection-start-offset;
    out property <int> selection-end: entry.selection-end-offset;
    out property <string> recorded = "";
    entry := TextArea {
        x: 20px; y: 16px; width: 440px; height: 104px;
        accessible-name: "正文";
        text <=> root.document;
        persistent-selection: root.retain;
    }
    select-tool := Button {
        x: 20px; y: 136px; width: 126px; height: 34px;
        text: "选择开头";
        clicked => { entry.focus(); entry.set-selection-offsets(0, 3); }
    }
    toolbar := Button {
        x: 156px; y: 136px; width: 146px; height: 34px;
        text: "记录选区";
        clicked => { root.recorded = entry.selected-text; }
    }
    return-tool := Button {
        x: 312px; y: 136px; width: 148px; height: 34px;
        text: "回到编辑器";
        clicked => { entry.focus(); }
    }
    CheckBox {
        x: 20px; y: 182px; width: 154px; height: 28px;
        text: "失焦保留选区";
        checked <=> root.retain;
    }
    selection-text := Label {
        x: 20px; y: 222px; width: 440px;
        text: "选中：" + root.selected + " · 已记录：" + root.recorded;
    }
}

export component LongTextSelectionDemo inherits Window {
    title: "XRack · 滚动选取长文本";
    width: 496px; height: 342px;
    background: #162034;
    in-out property <MouseSelectionMode> mouse-mode = MouseSelectionMode.characters;
    out property <string> selected: entry.selected-text;
    out property <string> line-selected: single-line.selected-text;
    in-out property <string> line =
        "Project Atlas • éclair 👩‍💻 • Select across a long line and keep the pointer held past the edge • Displayed scroll follows the selection";
    in-out property <string> document =
        "01  Project Atlas    Review: éclair emoji 👩‍💻 and Unicode in a long source line\n"
        + "02  Project Atlas    Design review and integration tests across the desktop backend\n"
        + "03  Project Atlas    Release artifacts and the nightly preview are ready for check\n"
        + "04  Project Atlas    Commit updated translations and the keyboard navigation guide\n"
        + "05  Project Atlas    Confirm the differences across the renderer and interpreter\n"
        + "06  Project Atlas    Audit text ranges in documents with mixed Unicode scripts\n"
        + "07  Project Atlas    Read-only views support selection, copy and accessible ranges\n"
        + "08  Project Atlas    Set up the example workspace and open the form component\n"
        + "09  Project Atlas    Review source location and binding diagnostics for editors\n"
        + "10  Project Atlas    Confirm branch and version before preparing distribution\n"
        + "11  Project Atlas    Export documentation and check the reference page locally\n"
        + "12  Project Atlas    Gather final notes on initial load and startup timing\n"
        + "13  Project Atlas    Check stable model keys for mapped and filtered delegates\n"
        + "14  Project Atlas    Verify the popups restore focus to the previous editor\n"
        + "15  Project Atlas    Record the observed keyboard behavior for each platform\n"
        + "16  Project Atlas    Check final line and confirm the selected range is correct";

    entry := TextArea {
        x: 20px; y: 18px; width: 456px; height: 164px;
        accessible-name: "长文档";
        font-family: "monospace";
        wrap: no-wrap;
        read-only: true;
        text: root.document;
        mouse-selection-mode: root.mouse-mode;
    }
    single-line := LineEdit {
        x: 20px; y: 195px; width: 456px; height: 34px;
        accessible-name: "单行长文本";
        font-family: "monospace";
        read-only: true;
        text: root.line;
        mouse-selection-mode: root.mouse-mode;
    }
    mode-button := Button {
        x: 20px; y: 244px; width: 180px; height: 34px;
        text: root.mouse-mode == MouseSelectionMode.words ? "拖选单位：词段" : "拖选单位：字素";
        clicked => {
            root.mouse-mode = root.mouse-mode == MouseSelectionMode.words
                ? MouseSelectionMode.characters : MouseSelectionMode.words;
        }
    }
    Label {
        x: 20px; y: 294px; width: 456px;
        text: "多行选区 [" + entry.selection-start-offset + ", " + entry.selection-end-offset
            + ") · 单行选区 [" + single-line.selection-start-offset + ", " + single-line.selection-end-offset + ")";
    }
}

