struct HandoffActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
}

export component PhysicsKinematicDemo inherits Window {
    title: "XRack · 刚体接管与释放";
    width: 736px; height: 462px; resizable: false; background: #172735;

    property <physicsworld3d> world: Physics3D.new(Vector3D.new(0, -4, 0), 0.05);
    property <vector3d> zero: Vector3D.new(0, 0, 0);
    property <vector3d> arm-size: Vector3D.new(1.8, 0.35, 0.48);
    property <point3d> start: Point3D.new(-1.05, 0.9, 0);
    property <vector3d> pivot: Vector3D.new(-0.8, 0, 0);
    property <point3d> hinge: Point3D.new(root.start.x + root.pivot.x, root.start.y, root.start.z);
    out property <int> arm = 0;
    out property <int> sensor = 0;
    out property <int> entries = 0;
    out property <int> ticks = 0;
    out property <float> target-yaw = 0;
    in-out property <bool> running = false;
    out property <bool> controlled: Physics3D.is-kinematic(root.world, root.arm);
    out property <float> mass: Physics3D.mass(root.world, root.arm);
    out property <point3d> position: root.arm == 0 ? root.start : Physics3D.position(root.world, root.arm);
    out property <vector3d> rotation: Physics3D.rotation(root.world, root.arm);
    out property <vector3d> speed: Physics3D.velocity(root.world, root.arm);
    out property <vector3d> spin: Physics3D.angular-velocity(root.world, root.arm);

    callback reset();
    reset() => {
        Physics3D.clear(root.world);
        Physics3D.add-box(root.world, Point3D.new(0, -0.11, 0), Vector3D.new(8.65, 0.22, 5.8), 0, 0.3, 0);
        root.sensor = Physics3D.add-box-trigger(root.world, Point3D.new(-1.5, 0.9, -0.15),
            Vector3D.new(3.8, 2.1, 3.55), root.zero);
        root.arm = Physics3D.add-box(root.world, root.start, root.arm-size, 2.5, 0.25, 0);
        root.target-yaw = 0;
        root.entries = 0;
        root.ticks = 0;
        root.running = false;
    }
    callback take();
    take() => {
        if root.arm == 0 { root.reset(); }
        root.running = false;
        Physics3D.set-kinematic(root.world, root.arm, true);
    }
    callback queue-next();
    queue-next() => {
        if root.controlled && root.target-yaw < 72 {
            root.target-yaw += 8;
            Physics3D.set-kinematic-target-with-pivot(root.world, root.arm, root.start,
                Vector3D.new(root.target-yaw, 0, 0), root.pivot);
        }
    }
    callback release();
    release() => {
        if root.controlled && Physics3D.set-kinematic(root.world, root.arm, false) {
            root.ticks = 0;
        }
    }
    callback advance();
    advance() => {
        if root.arm == 0 { root.reset(); }
        if Physics3D.step(root.world) {
            root.ticks += 1;
            for body in Physics3D.trigger-entered(root.world, root.sensor) {
                if body == root.arm { root.entries += 1; }
            }
            if root.ticks >= 16 { root.running = false; }
        }
    }
    clock := Timer { interval: 50; repeat: true; running: root.running; triggered => { root.advance(); } }

    pure function part(id: string, mesh: string, point: point3d, size: vector3d, rotation: vector3d, tint: color) -> HandoffActor {
        HandoffActor {
            id: id, mesh: mesh, x: point.x, y: point.y, z: point.z,
            scale-x: size.x, scale-y: size.y, scale-z: size.z,
            yaw: rotation.x, pitch: rotation.y, roll: rotation.z, color: tint,
        }
    }
    property <[HandoffActor]> actors: [
        root.part("ground", "primitive:box", Point3D.new(0, -0.11, 0), Vector3D.new(8.65, 0.22, 5.8), root.zero, #304958),
        root.part("sensor-marker", "primitive:box", Point3D.new(-1.5, 0.002, -0.15),
            Vector3D.new(3.8, 0.015, 3.55), root.zero, root.entries > 0 ? #2d6964 : #27535c),
        root.part("pivot", "primitive:sphere", root.hinge, Vector3D.new(0.2, 0.2, 0.2), root.zero, #ffe190),
        root.part("arm", "primitive:box", root.position, root.arm-size, root.rotation,
            root.controlled ? #72dcc6 : #f7ab67),
    ];
    SceneView3D {
        width: 736px; height: 378px; model: root.actors;
        camera-yaw: -14; camera-pitch: 34; camera-distance: 10.5;
        scene-background: #20394a; ambient-intensity: 0.56; multisampling: true;
    }
    handoff-status := Text {
        x: 18px; y: 15px; color: #f1ebdd;
        text: (root.controlled ? "运动学" : "动力学") + "   ·   句柄 " + root.arm
            + "   ·   质量 " + root.mass + "   ·   进入 " + root.entries;
    }
    motion-status := Text {
        x: 18px; y: 44px; color: #cfeced;
        text: "偏航 " + Math.round(root.rotation.x * 10) / 10.0
            + "   ·   角速度 Y " + Math.round(root.spin.y * 100) / 100.0
            + "   ·   高度 " + Math.round(root.position.y * 100) / 100.0;
    }
    HorizontalLayout {
        x: 16px; y: 397px; width: 704px; height: 44px; spacing: 9px;
        take := Button { text: "接管"; clicked => { root.take(); } }
        pivot-step := Button { text: "绕枢轴转动"; enabled: root.controlled; clicked => { root.queue-next(); root.advance(); } }
        release := Button { text: "释放"; enabled: root.controlled; clicked => { root.release(); } }
        continue-motion := Button { text: "继续模拟"; enabled: !root.controlled; clicked => { root.running = true; } }
        reset := Button { text: "重置"; clicked => { root.reset(); } }
    }
}
