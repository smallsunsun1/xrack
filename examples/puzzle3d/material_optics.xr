struct OpticsSampler { source: string, min-filter: string, mag-filter: string, mip-filter: string }
struct OpticalFinish {
    enabled: bool, unlit: bool, base-color: color, metalness: float, roughness: float,
    transmission: float, index-of-refraction: float, thickness: float,
    thickness-map: string, thickness-channel: string,
    attenuation-color: color, attenuation-distance: float, dispersion: float,
    specular-amount: float, specular-color: color, specular-map: string,
    specular-color-map: OpticsSampler, specular-channel: string,
    occlusion-amount: float, occlusion-map: string, occlusion-channel: string,
}
struct OpticalActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float, material: OpticalFinish,
}
struct OpticalLamp {
    kind: string, x: float, y: float, z: float, yaw: float, elevation: float,
    intensity: float, color: color, range: float, inner-angle: float, outer-angle: float,
}

export component MaterialOpticsDemo inherits Window {
    title <- "XRack · Optical materials";
    width <- 600px; height <- 372px; background <- #192330;

    in-out property <string> look: "glass";
    in-out property <float> thickness: 0.0;
    in-out property <float> attenuation: 1.0;
    in-out property <float> dispersion: 0.0;
    in-out property <float> specular: 1.0;
    in-out property <color> specular-tint: #fff;
    in-out property <float> occlusion: 1.0;
    in-out property <string> channel: "r";
    in-out property <bool> mapped: false;
    in-out property <bool> patterned: false;
    in-out property <bool> imported: false;
    in-out property <bool> inherit: false;
    in-out property <float> depth-scale: 1.0;

    property <string> swatch <- @texture-url("models/channel-swatch.png");
    property <OpticsSampler> no-map: OpticsSampler {
        source: "", min-filter: "linear", mag-filter: "linear", mip-filter: "linear",
    };
    property <OpticalFinish> flat <- OpticalFinish {
        enabled: true, unlit: true, base-color: #fff, metalness: 0, roughness: 0.5,
        transmission: 0, index-of-refraction: 1.5, thickness: 0,
        thickness-map: "", thickness-channel: "g",
        attenuation-color: #fff, attenuation-distance: 0, dispersion: 0,
        specular-amount: 0, specular-color: #fff, specular-map: "",
        specular-color-map: root.no-map, specular-channel: "a",
        occlusion-amount: 1, occlusion-map: "", occlusion-channel: "b",
    };
    property <OpticalActor> base <- OpticalActor {
        id: "", mesh: "primitive:rectangle", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, camera-kind: "", camera-height: 4, material: root.flat,
    };
    property <[OpticalActor]> world <- [
        OpticalActor { id: "eye", mesh: "", z: 8, camera-kind: "orthographic", ..root.base },
        OpticalActor {
            id: "glass",
            mesh: root.imported ? @mesh-url("models/volume-blocks.gltf")
                : root.look == "glass" ? "primitive:box" : "primitive:rectangle",
            scale-x: root.imported ? 1 : 2.6, scale-y: root.imported ? 1 : 1.9,
            scale-z: root.depth-scale, yaw: root.patterned ? 32 : 0,
            material: OpticalFinish {
                enabled: !root.inherit, unlit: false,
                base-color: root.look == "highlights" ? #111111 : #fff,
                roughness: root.look == "glass" ? 0 : 0.6,
                transmission: root.look == "glass" ? 1 : 0,
                thickness: root.thickness,
                thickness-map: root.mapped && root.look == "glass" ? root.swatch : "",
                thickness-channel: root.channel,
                attenuation-color: #ed804a, attenuation-distance: root.attenuation,
                dispersion: root.dispersion,
                specular-amount: root.look == "highlights" ? root.specular : 0,
                specular-color: root.specular-tint,
                specular-map: root.mapped && root.look == "highlights" ? root.swatch : "",
                specular-color-map: OpticsSampler {
                    source: root.mapped && root.look == "highlights" ? root.swatch : "", ..root.no-map
                },
                specular-channel: root.channel,
                occlusion-amount: root.occlusion,
                occlusion-map: root.look == "occlusion" ? root.swatch : "",
                ..root.flat
            }, ..root.base
        },
        OpticalActor {
            id: "wall", mesh: root.patterned ? @mesh-url("models/dispersion-stripes.gltf") : "primitive:rectangle",
            z: -4, scale-x: 7.6, scale-y: 4.2,
            material: OpticalFinish { enabled: !root.patterned, ..root.flat }, ..root.base
        }
    ];
    property <[OpticalLamp]> none;
    property <[OpticalLamp]> lights <- root.look == "highlights" ? [
        OpticalLamp {
            kind: "directional", x: 0, y: 0, z: 0, yaw: 0, elevation: 0, intensity: 3.0,
            color: #fff, range: 1, inner-angle: 0, outer-angle: 20,
        }
    ] : root.none;

    SceneView3D {
        width <- 600px; height <- 320px; model <- root.world; camera <- "eye";
        lights <- root.lights; ambient-intensity <- 0.6; scene-background <- #22334b;
    }
    thickness-button := Button {
        x <- 12px; y <- 334px; width <- 135px; height <- 30px; text <- root.thickness == 0 ? "Thin" : "Thick";
        clicked => { root.thickness = root.thickness == 0 ? 1.6 : 0; }
    }
    looks := Button {
        x <- 161px; y <- 334px; width <- 130px; height <- 30px; text <- root.look;
        clicked => {
            root.look = root.look == "glass" ? "highlights" : root.look == "highlights" ? "occlusion" : "glass";
        }
    }
    CheckBox { x <- 305px; y <- 334px; width <- 135px; text <- "Maps"; checked <-> root.mapped; }
    CheckBox { x <- 449px; y <- 334px; width <- 147px; text <- "Striped wall"; checked <-> root.patterned; }
}
