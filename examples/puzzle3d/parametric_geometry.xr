struct ShapeSpec {
    shape: string, width: float, height: float, depth: float,
    radius: float, tube-radius: float, top-radius: float, segments: int, rings: int, capped: bool,
}
struct ShapeFinish { base-color: color, unlit: bool, depth-draw-mode: string }
struct GeometryActor {
    id: string, geometry: ShapeSpec, material: ShapeFinish,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, visible: bool, casts-shadow: bool, camera-kind: string, camera-height: float,
    instance-of: string,
}

export component ParametricGeometryDemo inherits Window {
    title: "XRack · Parametric geometry";
    width: 600px; height: 372px; background: #192330;

    in-out property <string> shape: "torus";
    in-out property <float> radius: 0.9;
    in-out property <int> resolution: 32;
    in-out property <float> offset: 0.0;
    in-out property <color> tint: #ec843f;
    in-out property <bool> shadows: false;
    in-out property <bool> duplicate: false;
    in-out property <bool> auxiliary: false;

    property <ShapeSpec> input: ShapeSpec {
        shape: root.shape, width: 2.2, height: 2.25, depth: 0.75,
        radius: root.radius, tube-radius: 0.23, top-radius: root.shape == "cylinder" ? root.radius : 0.0,
        segments: root.resolution, rings: 14, capped: true,
    };
    property <GeometryActor> defaults: GeometryActor {
        id: "", geometry: ShapeSpec { shape: "", ..root.input },
        material: ShapeFinish {
            base-color: #fff, unlit: true, depth-draw-mode: root.auxiliary ? "opaque-prepass" : "opaque-only",
        },
        x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, visible: true, casts-shadow: false, camera-kind: "", camera-height: 4,
        instance-of: "",
    };
    property <[GeometryActor]> world: [
        GeometryActor { id: "eye", camera-kind: "orthographic", z: 8, ..root.defaults },
        GeometryActor {
            id: "piece", geometry: root.input, x: root.offset, color: root.tint, casts-shadow: true, ..root.defaults
        },
        GeometryActor {
            id: "copy", instance-of: "piece", x: 2.4, visible: root.duplicate, color: #66b8ff, ..root.defaults
        },
        GeometryActor {
            id: "wall", geometry: ShapeSpec { shape: "plane", width: 8, height: 5, segments: 1, rings: 1, ..root.input },
            material: ShapeFinish { base-color: #516689, unlit: false, depth-draw-mode: "opaque-only" },
            visible: root.shadows, z: -1.9, ..root.defaults
        }
    ];
    out property <string> center-hit: Scene3D.pick-camera(
        root.world, "eye", Point2D.new(600px, 320px), Point2D.new(300px, 160px));
    out property <string> ring-hit: Scene3D.pick-camera(
        root.world, "eye", Point2D.new(600px, 320px), Point2D.new(372px, 160px));

    out property <hit3d> center-sweep: Scene3D.sphere-cast(
        root.world, Point3D.new(0, 0, 5), Vector3D.new(0, 0, -1), 8, 0.18);

    SceneView3D {
        width: 600px; height: 320px; model: root.world; camera: "eye";
        scene-background: #22334b; shadows: root.shadows; shadow-map-size: 256;
        light-yaw: -45; light-elevation: 25; ambient-intensity: 0.4;
        temporal-aa: root.auxiliary; temporal-aa-mode: "motion-vectors";
    }
    shape-button := Button {
        x: 12px; y: 334px; width: 130px; height: 30px; text: root.shape;
        clicked => {
            root.shape = root.shape == "torus" ? "sphere" : root.shape == "sphere" ? "capsule"
                : root.shape == "capsule" ? "cylinder" : root.shape == "cylinder" ? "cone"
                : root.shape == "cone" ? "box" : root.shape == "box" ? "plane" : "torus";
        }
    }
    Slider { x: 158px; y: 334px; width: 155px; height: 30px; minimum: 0.5; maximum: 1.1; value <=> root.radius; }
    CheckBox { x: 335px; y: 334px; width: 109px; text: "Shadows"; checked <=> root.shadows; }
    CheckBox { x: 457px; y: 334px; width: 130px; text: "Instance"; checked <=> root.duplicate; }
}
