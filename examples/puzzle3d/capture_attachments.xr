struct CaptureInput {
    capture: string, attachment: string, enabled: bool, filter: string,
}

struct CaptureMaterial {
    unlit: bool, roughness: float, material-shader: string, shader-parameters: vector3d,
    base-color: color, alpha-mode: string, shader-textures: [CaptureInput],
}

struct DataActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, layers: int,
    camera-kind: string, camera-height: float, camera-near: float, camera-far: float,
    material: CaptureMaterial,
}

struct AttachmentFeed { name: string, camera: string, layers: int, scale: float }
struct AttachmentEffect { shader: string, strength: float, buffers: [CaptureInput] }

export component CaptureAttachmentsDemo inherits Window {
    title <- "XRack · 命名深度与法线附件";
    width <- 520px; height <- 362px; resizable <- false;
    background <- #172437;
    in-out property <float> source-z: 2;
    in-out property <bool> diagnostic-strip: true;
    in-out property <bool> normals: true;
    in-out property <bool> color-inset: false;

    property <CaptureMaterial> stock <- CaptureMaterial {
        unlit: true, roughness: 0.76, material-shader: "", shader-parameters: Vector3D.new(0, 0, 0),
        base-color: #fff, alpha-mode: "opaque", shader-textures: [],
    };
    property <CaptureInput> depth-input: CaptureInput {
        capture: "data", attachment: "depth", enabled: true, filter: "linear",
    };
    property <CaptureInput> normal-input: CaptureInput {
        capture: "data", attachment: "normal-roughness", enabled: true, filter: "nearest",
    };
    property <DataActor> base <- DataActor {
        id: "", mesh: "primitive:rectangle", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, layers: 1, camera-kind: "", camera-height: 4,
        camera-near: 1, camera-far: 9, material: root.stock,
    };

    SceneView3D {
        width <- 520px; height <- 280px; camera <- "main"; layer-mask <- 1;
        scene-background <- #23384f; scene-tone-map <- none; cache-rendering <- true;
        model <- [
            DataActor { id: "main", mesh: "", z: 7, camera-kind: "orthographic", ..root.base },
            DataActor { id: "data-eye", mesh: "", z: 7, camera-kind: "orthographic", ..root.base },
            DataActor {
                id: "depth-view", x: -1.38, scale-x: 2.3, scale-y: 1.82,
                material: CaptureMaterial {
                    material-shader: @material-shader-url("effects/capture_attachment_material.wgsl"),
                    shader-textures: [root.depth-input], ..root.stock
                },
                ..root.base
            },
            DataActor {
                id: "normal-view", x: 1.38, scale-x: 2.3, scale-y: 1.82,
                material: CaptureMaterial {
                    material-shader: @material-shader-url("effects/capture_attachment_material.wgsl"),
                    shader-parameters: Vector3D.new(1, 0, 0),
                    shader-textures: [CaptureInput { enabled: root.normals, ..root.normal-input }],
                    ..root.stock
                },
                ..root.base
            },
            DataActor {
                id: "sample", layers: 2, z: root.source-z, scale-x: 4.5, scale-y: 3.6,
                color: #bb7d5a,
                material: CaptureMaterial {
                    unlit: false,
                    material-shader: @material-shader-url("effects/effect_surface_material.wgsl"),
                    ..root.stock
                },
                ..root.base
            },
            DataActor {
                id: "glass", layers: 2, z: 4.5, scale-x: 3.7, scale-y: 3.1,
                material: CaptureMaterial { base-color: #208ca080, alpha-mode: "blend", ..root.stock },
                ..root.base
            },
            DataActor {
                id: "cutout", layers: 2, z: 5, scale-x: 3.3, scale-y: 2.8,
                material: CaptureMaterial { base-color: #ffffff00, alpha-mode: "mask", ..root.stock },
                ..root.base
            },
        ];
        scene-captures <- [
            AttachmentFeed { name: "data", camera: "data-eye", layers: 2, scale: 0.5 }
        ];
        scene-effects <- [
            AttachmentEffect {
                shader: @shader-url("effects/capture_attachment_strip.wgsl"),
                strength: root.diagnostic-strip ? 1 : 0, buffers: [root.depth-input, root.normal-input],
            },
            AttachmentEffect {
                shader: @shader-url("effects/probe_capture_inset.wgsl"),
                strength: root.color-inset ? 1 : 0,
                buffers: [CaptureInput { attachment: "color", ..root.depth-input }],
            },
        ];
    }

    slide := Button {
        x <- 14px; y <- 297px; width <- 105px; height <- 31px;
        text <- "移动源模型"; clicked => { root.source-z = root.source-z == 2 ? 4 : 2; }
    }
    CheckBox {
        x <- 131px; y <- 297px; width <- 122px; height <- 31px;
        text <- "后处理数据"; checked <-> root.diagnostic-strip;
    }
    CheckBox {
        x <- 266px; y <- 297px; width <- 119px; height <- 31px;
        text <- "材质法线"; checked <-> root.normals;
    }
    CheckBox {
        x <- 393px; y <- 297px; width <- 116px; height <- 31px;
        text <- "颜色小窗"; checked <-> root.color-inset;
    }
}
