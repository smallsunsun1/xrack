struct Material { metalness: float, roughness: float }
struct PaintedSky { enabled: bool, sky-top-color: color, sky-horizon-color: color, sun-energy: float }
struct Actor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, material: Material, camera-kind: string,
}

export component SkyboxDemo inherits Window {
    title <- "XRack · 独立天空盒";
    width <- 420px; height <- 256px; resizable <- false; background <- #172436;
    in-out property <bool> cube: true;
    in-out property <bool> painted: false;
    in-out property <bool> lighting: true;
    in-out property <bool> show-sky: true;
    in-out property <float> turn: 0;
    in-out property <float> tilt: 0;
    in-out property <float> roll: 0;
    in-out property <float> gain: 1;
    in-out property <float> blur: 0;

    property <Actor> unit: Actor {
        id: "", mesh: "primitive:sphere", x: 0, y: -0.19, z: 0,
        scale-x: 0.83, scale-y: 0.83, scale-z: 0.83, yaw: 0, pitch: 0, roll: 0,
        color: #ecf4ff, material: Material { metalness: 0, roughness: 0.76 }, camera-kind: "",
    };
    SceneView3D {
        width <- 420px; height <- 202px; camera <- "eye"; cache-rendering <- true;
        scene-background <- #213148; ambient-intensity <- 0.08;
        model <- [
            Actor { id: "eye", mesh: "", y: 0.12, z: 6.3, camera-kind: "perspective", ..root.unit },
            Actor { id: "diffuse", x: -1.30, ..root.unit },
            Actor {
                id: "chrome", x: 1.30, material: Material { metalness: 1, roughness: 0.16 }, ..root.unit
            },
        ];
        environment <- root.lighting ? @environment-url("models/studio.hdr") : "";
        environment-skybox <- root.show-sky;
        skybox-source <- root.cube ? @environment-url("models/skybox-cross.hdr") : "";
        skybox-sky <- PaintedSky {
            enabled: root.painted, sky-top-color: #754ab6, sky-horizon-color: #ffbd8e, sun-energy: 0,
        };
        skybox-yaw <- root.turn; skybox-pitch <- root.tilt; skybox-roll <- root.roll;
        skybox-intensity <- root.gain; skybox-blur <- root.blur;
    }
    cube-toggle := CheckBox { x <- 10px; y <- 212px; width <- 100px; height <- 34px; text <- "HDR 背景"; checked <-> root.cube; }
    painted-toggle := CheckBox { x <- 113px; y <- 212px; width <- 112px; height <- 34px; text <- "程序天空"; checked <-> root.painted; }
    rotate-sky := Button {
        x <- 229px; y <- 212px; width <- 101px; height <- 34px; text <- "旋转背景";
        clicked => { root.turn = root.turn == 0 ? 90 : 0; }
    }
    blur-toggle := CheckBox {
        x <- 337px; y <- 212px; width <- 71px; height <- 34px; text <- "模糊";
        checked <- root.blur > 0;
        toggled => { root.blur = root.blur > 0 ? 0 : 0.75; }
    }
}
