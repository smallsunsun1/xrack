import { BakeActor, BakeLamp, BakeRoom } from "lightmap_bake_scene.xr";
import { BakedLightmaps } from "baked/lighting.xr";

export component BakedRoomDemo inherits Window {
    title <- "XRack · 混合光照";
    width <- 600px; height <- 436px;
    resizable <- false;
    background <- #141d29;

    in-out property <bool> baked: true;
    in-out property <bool> live-shadows: false;
    in-out property <bool> fill-on: true;
    in-out property <float> sphere-shift: 0;
    in-out property <float> key-intensity: BakeRoom.key.intensity;
    property <[BakeLamp]> lights <- [
        BakeLamp { intensity: root.key-intensity, ..BakeRoom.key },
        BakeLamp { intensity: root.fill-on ? BakeRoom.fill.intensity : 0, ..BakeRoom.fill },
    ];
    property <BakeActor> plate <- BakeActor {
        lightmap: BakedLightmaps.atlas,
        lightmap-mode: BakedLightmaps.mode,
        lightmap-intensity: BakedLightmaps.intensity,
        lightmap-u: BakedLightmaps.region-plate.u,
        lightmap-v: BakedLightmaps.region-plate.v,
        lightmap-width: BakedLightmaps.region-plate.width,
        lightmap-height: BakedLightmaps.region-plate.height,
        ..BakeRoom.plate
    };

    property <BakeActor> figure <- BakeActor {
        lightmap: BakedLightmaps.atlas,
        lightmap-mode: BakedLightmaps.mode,
        lightmap-intensity: BakedLightmaps.intensity,
        lightmap-u: BakedLightmaps.region-figure.u,
        lightmap-v: BakedLightmaps.region-figure.v,
        lightmap-width: BakedLightmaps.region-figure.width,
        lightmap-height: BakedLightmaps.region-figure.height,
        ..BakeRoom.figure
    };
    property <BakeActor> sphere <- BakeActor {
        x: BakeRoom.sphere.x + root.sphere-shift,
        ..BakeRoom.sphere
    };

    room := SceneView3D {
        width <- 600px; height <- 340px;
        camera-yaw <- 20; camera-pitch <- 12; camera-distance <- 8.4;
        scene-background <- #172638;
        ambient-intensity <- 0.17; shadows <- !root.baked || root.live-shadows;
        environment <- BakeRoom.probe;
        environment-yaw <- BakeRoom.probe-yaw;
        environment-intensity <- BakeRoom.probe-intensity;
        bake-denoise-passes <- BakeRoom.denoise-passes;
        bake-indirect-factor <- BakeRoom.indirect-factor;
        model <- [root.baked ? root.plate : BakeRoom.plate, root.sphere, BakeRoom.luminous,
            root.baked ? root.figure : BakeRoom.figure];
        lights <- root.lights;
        cache-rendering <- true;
    }

    bake-switch := CheckBox {
        x <- 20px; y <- 352px; width <- 220px; height <- 31px;
        text <- "使用离线烘焙光照";
        checked <-> root.baked;
    }
    fill-switch := CheckBox {
        x <- 220px; y <- 352px; width <- 150px; height <- 31px;
        text <- "实时冷色补光";
        checked <-> root.fill-on;
    }
    shadow-switch := CheckBox {
        x <- 385px; y <- 352px; width <- 150px; height <- 31px;
        text <- "实时阴影";
        checked <-> root.live-shadows;
    }
    Text {
        x <- 24px; y <- 395px; height <- 26px;
        text <- "球体位置"; color <- #e2eaf4;
    }
    Slider {
        x <- 140px; y <- 394px; width <- 402px; height <- 29px;
        minimum <- -1.3; maximum <- 1.3;
        value <-> root.sphere-shift;
    }
}
