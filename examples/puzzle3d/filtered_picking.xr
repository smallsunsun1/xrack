struct PickingActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, layers: int, pickable: bool,
    camera-kind: string, camera-height: float, camera-near: float, camera-far: float,
}

export component FilteredPickingDemo inherits Window {
    title: "XRack · 候选拾取";
    width: 600px; height: 420px;
    resizable: false;
    background: #182638;

    in-out property <point2d> pointer: Point2D.new(269px, 166px);
    in-out property <bool> rear-only: true;
    in-out property <bool> orbit: false;
    in-out property <int> mask: 1;
    in-out property <int> target-row: 2;
    in-out property <[int]> candidates: [2, 1, 2, 3, -1, 1000];
    property <point2d> view-size: Point2D.new(600px, 332px);
    property <hit3d> miss;
    property <PickingActor> base: PickingActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #8ab1d1, pickable: true, layers: 1,
        camera-kind: "", camera-height: 5.4, camera-near: 0.1, camera-far: 24,
    };
    property <[PickingActor]> world: [
        PickingActor { id: "eye", mesh: "", z: 8, camera-kind: "orthographic", ..root.base },
        PickingActor {
            id: "front", x: -0.5, z: 1.13, scale-x: 1.14, scale-y: 1.32,
            scale-z: 0.45, color: #6b90ba, ..root.base
        },
        PickingActor {
            id: "rear", x: -0.5, z: -0.72, scale-x: 1.92, scale-y: 1.78,
            scale-z: 0.65, color: #31b7a4, ..root.base
        },
        PickingActor {
            mesh: "primitive:sphere", x: 1.75, scale-x: 0.7, scale-y: 0.7, scale-z: 0.7,
            color: #e9a153, layers: 2, ..root.base
        },
        PickingActor {
            id: "floor", y: -1.3, scale-x: 9.7, scale-y: 0.12, scale-z: 5.4,
            pickable: false, color: #3f576f, ..root.base
        },
    ];
    property <[int]> rows: root.rear-only ? [2] : root.candidates;
    out property <[hit3d]> hits: root.orbit
        ? Scene3D.hit-subset(root.world, 0, 0, 8, root.view-size, root.pointer, root.rows, root.mask)
        : Scene3D.hit-subset-camera(root.world, "eye", root.view-size, root.pointer, root.rows, root.mask);
    out property <hit3d> target: root.orbit
        ? Scene3D.hit-row(root.world, 0, 0, 8, root.view-size, root.pointer, root.target-row, root.mask)
        : Scene3D.hit-row-camera(root.world, "eye", root.view-size, root.pointer, root.target-row, root.mask);
    property <point3d> origin: Point3D.new(-0.5, 0, 6);
    property <vector3d> direction: Vector3D.new(0, 0, -1);
    out property <hit3d> ray-target: Scene3D.ray-hit-row(root.world, root.origin, root.direction, 10, root.target-row, root.mask);
    out property <[hit3d]> ray-hits: Scene3D.ray-hit-subset(root.world, root.origin, root.direction, 10, root.rows, root.mask);
    property <hit3d> first: Model.at(root.hits, 0, root.miss);
    property <string> hit-label: root.first.valid
        ? (root.first.object-id == "" ? "行 " + root.first.row-index : root.first.object-id)
        : "未命中";
    pick-area := TouchArea {
        width: 600px; height: 332px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.inside {
                root.pointer = Point2D.new(event.x, event.y);
            }
        }
        SceneView3D {
            width: 600px; height: 332px; model: root.world;
            camera: root.orbit ? "" : "eye"; camera-yaw: 0; camera-pitch: 0; camera-distance: 8;
            layer-mask: root.mask; selected-object: root.first.object-id;
            cache-rendering: true; scene-background: #253b53;
        }
        Rectangle {
            x: root.pointer.x - 4px; y: root.pointer.y - 4px; width: 8px; height: 8px;
            background: #ffd795; border-radius: 4px;
        }
    }
    Label { x: 14px; y: 338px; width: 560px; height: 32px; text: "最近候选  " + root.hit-label + "    命中数  " + Model.count(root.hits); }
    filter-toggle := CheckBox { x: 14px; y: 374px; width: 131px; height: 32px; text: "只拾取后方"; checked <=> root.rear-only; }
    camera-toggle := CheckBox { x: 166px; y: 374px; width: 132px; height: 32px; text: "绕视相机"; checked <=> root.orbit; }
    layer-toggle := CheckBox {
        x: 320px; y: 374px; width: 200px; height: 32px; text: "包含右侧匿名模型"; checked: root.mask == 3;
        toggled => { root.mask = root.mask == 3 ? 1 : 3; }
    }
}
