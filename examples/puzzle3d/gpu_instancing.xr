struct SharedCoat { roughness: float }
struct InstancedActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float,
    animation: string, animation-time: float, material-variant: string, material: SharedCoat,
}

export component GpuInstancingDemo inherits Window {
    title <- "XRack · glTF GPU instancing";
    width <- 640px; height <- 374px;
    background <- #1a2638;

    in-out property <float> time: 0;
    in-out property <bool> blue: false;
    property <InstancedActor> base: InstancedActor {
        id: "", mesh: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, camera-kind: "", camera-height: 4,
        animation: "", animation-time: 0, material-variant: "",
        material: SharedCoat { roughness: 0.7 },
    };
    property <[InstancedActor]> world <- [
        InstancedActor { id: "eye", z: 8, camera-kind: "orthographic", ..root.base },
        InstancedActor {
            id: "triangles", mesh: @mesh-url("models/gpu-instances.gltf"),
            animation: "Slide", animation-time: root.time, material-variant: root.blue ? "Blue" : "",
            ..root.base
        },
    ];
    property <hit3d> picked-left <- Scene3D.hit-camera(
        root.world, "eye", Point2D.new(640px, 320px), Point2D.new(132px, 172px));
    out property <string> left-hit <- root.picked-left.object-id;
    out property <int> left-instance <- root.picked-left.instance-index;
    out property <int> left-node <- root.picked-left.mesh-node-index;
    out property <string> base-hit <- Scene3D.pick-camera(
        root.world, "eye", Point2D.new(640px, 320px), Point2D.new(400px, 240px));
    SceneView3D {
        width <- 640px; height <- 320px; model <- root.world; camera <- "eye";
        scene-background <- #263b54; frustum-culling <- true;
    }
    slide-button := Button {
        x <- 12px; y <- 332px; width <- 140px; text <- "Move group";
        clicked => { root.time = root.time == 0 ? 1 : 0; }
    }
    tint-toggle := CheckBox { x <- 164px; y <- 332px; width <- 130px; text <- "Blue coat"; checked <-> root.blue; }
}

struct CatalogActor {
    id: string, mesh: string, mesh-asset: meshasset3d,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, material-variant: string, animation: string, animation-time: float,
}

export component MeshCatalogDemo inherits Window {
    title <- "XRack · 3D 资产目录";
    width <- 440px; height <- 312px; background <- #1a2638;
    resizable <- false;
    in-out property <string> path: "models/gpu-instances.gltf";
    in-out property <bool> use-variant: false;
    in-out property <float> time: 0;
    out property <string> status <- importer.status;
    property <string> embedded: @mesh-url("models/gpu-instances.gltf");

    out property <[string]> variants <- Scene3D.mesh-material-variants(importer.asset);
    out property <[string]> clips <- Scene3D.mesh-animation-clips(importer.asset);
    out property <[string]> compiled-variants <- Scene3D.mesh-material-variants(root.embedded);
    out property <[string]> compiled-clips <- Scene3D.mesh-animation-clips(root.embedded);
    out property <string> chosen <- root.use-variant ? Model.at(root.variants, 0, "") : "";
    out property <[string]> slots <- Scene3D.mesh-material-slots(importer.asset, root.chosen);
    out property <[string]> compiled-slots <- Scene3D.mesh-material-slots(root.embedded, root.chosen);
    property <string> active-clip <- Model.at(root.clips, 0, "");
    out property <float> duration <- Scene3D.mesh-animation-duration(importer.asset, root.active-clip);
    out property <float> compiled-duration <- Scene3D.mesh-animation-duration(root.embedded, root.active-clip);
    importer := MeshLoader3D { source <- root.path; }

    SceneView3D {
        width <- 440px; height <- 226px;
        camera-yaw <- 0; camera-pitch <- 0; camera-distance <- 6;
        scene-background <- #263b54; cache-rendering <- true;
        model <- [
            CatalogActor {
                id: "asset", mesh: root.embedded, mesh-asset: importer.asset,
                x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
                yaw: 0, pitch: 0, roll: 0, color: #fff,
                material-variant: root.chosen, animation: root.active-clip, animation-time: root.time,
            },
        ];
    }
    Text {
        x <- 12px; y <- 236px; width <- 416px; color <- #d2ebff;
        text <- root.status != "ready" ? root.status
            : Model.at(root.slots, 0, "无材质") + "  ·  " + root.active-clip + "  " + root.duration + " s";
    }
    HorizontalLayout {
        x <- 12px; y <- 270px; width <- 416px; height <- 30px; spacing <- 8px;
        pick-variant := Button {
            text <- root.use-variant ? root.chosen : "原始材质";
            clicked => { root.use-variant = !root.use-variant; }
        }
        sample-clip := Button {
            text <- "切换动画时刻";
            clicked => { root.time = root.time == 0 ? root.duration : 0; }
        }
    }
}
