struct RigObject {
    id: string, mesh: string, parent: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color, visible: bool,
    animation: string, animation-time: float, animation-loop: bool,
    camera-kind: string, camera-height: float,
}

struct RigLamp {
    kind: string, x: float, y: float, z: float,
    yaw: float, elevation: float, intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float,
    casts-shadow: bool,
}

export component PunctualLightsDemo inherits Window {
    title: "XRack · glTF 布光";
    width: 460px;
    height: 280px;
    background: #141d29;

    in-out property <bool> imported: true;
    in-out property <bool> manual: false;
    in-out property <bool> shadows: false;
    in-out property <float> time: 0;
    in-out property <float> camera-x: 0;
    in-out property <float> rig-yaw: 0;
    in-out property <bool> rig-visible: true;
    property <RigObject> defaults: RigObject {
        id: "", mesh: "", parent: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff, visible: true,
        animation: "", animation-time: 0, animation-loop: false,
        camera-kind: "", camera-height: 5.4,
    };
    property <[RigObject]> scene: [
        RigObject {
            id: "mount", scale-x: 1.3, scale-y: 0.9,
            yaw: root.rig-yaw, visible: root.rig-visible, ..root.defaults
        },
        RigObject {
            id: "lights", parent: "mount", mesh: @mesh-url("models/punctual-rig.gltf"),
            animation: "Sweep", animation-time: root.time, ..root.defaults
        },
        RigObject {
            id: "wall", mesh: "primitive:box", scale-x: 8.0, scale-y: 4.5,
            scale-z: 0.18, color: #bfc9dc, ..root.defaults
        },
        RigObject {
            id: "pillar", mesh: "primitive:box", z: 0.55, x: 0.22, y: 0.15,
            scale-x: 0.7, scale-y: 1.65, scale-z: 0.9,
            yaw: 18, color: #a7b5cc, ..root.defaults
        },
        RigObject {
            id: "eye", x: root.camera-x, z: 9, camera-kind: "orthographic", ..root.defaults
        },
    ];
    property <[RigLamp]> empty;
    property <[RigLamp]> manual-lamps: [
        RigLamp {
            kind: "directional", x: 0, y: 0, z: 0, yaw: 0, elevation: 0,
            intensity: 1, color: #bce5ef, range: 0, inner-angle: 0, outer-angle: 45,
            casts-shadow: false,
        },
    ];

    SceneView3D {
        width: 460px;
        height: 222px;
        model: root.scene;
        camera: "eye";
        lights: root.manual ? root.manual-lamps : root.empty;
        imported-lights: root.imported;
        shadows: root.shadows;
        shadow-map-size: 256;
        ambient-intensity: 0;
        scene-background: #172333;
    }
    imported-toggle := CheckBox { x: 15px; y: 228px; width: 110px; height: 42px; text: "导入灯光"; checked <=> root.imported; }
    manual-toggle := CheckBox { x: 130px; y: 228px; width: 104px; height: 42px; text: "手写补光"; checked <=> root.manual; }
    Label { x: 242px; y: 228px; width: 65px; height: 42px; text: "时间"; }
    timeline := Slider { x: 306px; y: 228px; width: 138px; height: 42px; minimum: 0; maximum: 2; value <=> root.time; }
}
