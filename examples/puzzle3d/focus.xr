struct FocusActor {
    id: string, mesh: string,
    x: float, y: float, z: float, scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color, visible: bool,
    camera-kind: string, camera-height: float,
}

export component FocusDemo inherits Window {
    title: "XRack · 景深";
    width: 480px;
    height: 300px;
    background: #141d29;

    in-out property <bool> enabled: true;
    in-out property <bool> orthographic: true;
    in-out property <bool> glass: false;
    in-out property <bool> hdr: false;
    in-out property <float> focus: 12;
    in-out property <length> radius: 24px;
    in-out property <float> aa-scale: 1;

    property <FocusActor> defaults: FocusActor {
        id: "", mesh: "", x: 0, y: 0.3, z: 0, scale-x: 0.37, scale-y: 0.52, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff, visible: true,
        camera-kind: "", camera-height: 6.4,
    };
    property <string> card: @mesh-url("models/focus-card.gltf");
    property <[FocusActor]> models: [
        FocusActor { id: "near", mesh: root.card, x: -3.05, z: 4, color: #f9bdad, ..root.defaults },
        FocusActor { id: "middle", mesh: root.card, x: 0, color: #dce3ff, ..root.defaults },
        FocusActor { id: "far", mesh: root.card, x: 3.05, z: -5, color: #9dddef, ..root.defaults },
        FocusActor {
            id: "glass", mesh: @mesh-url("models/oit-sheet.gltf"), visible: root.glass,
            y: 0.3, z: 5.5, scale-x: 0.16, scale-y: 0.31, color: #8acbf8, ..root.defaults
        },
        FocusActor {
            id: "pin", mesh: @mesh-url("models/bloom-emitter.gltf"), visible: root.hdr,
            x: 0, y: 1.55, scale-x: 0.036, scale-y: 0.067, ..root.defaults
        },
        FocusActor {
            id: "eye", y: 0, z: 12, camera-kind: root.orthographic ? "orthographic" : "perspective",
            ..root.defaults
        },
    ];
    out property <string> picked: Scene3D.pick-camera(root.models, "eye",
        Point2D.new(480px, 248px), Point2D.new(240px, 113px));

    view := SceneView3D {
        width: 480px;
        height: 248px;
        model: root.models;
        camera: "eye";
        scene-background: #172339;
        depth-of-field: root.enabled;
        dof-focus-distance: root.focus;
        dof-focus-range: 0.8;
        dof-blur-radius: root.radius;
        scene-hdr: root.hdr;
        bloom: root.hdr;
        multisampling: root.glass;
        supersampling: root.aa-scale;
        order-independent-transparency: root.glass;
    }

    HorizontalLayout {
        y: 248px;
        width: 480px;
        height: 52px;
        padding: 12px;
        spacing: 12px;
        focus-toggle := CheckBox { width: 74px; text: "景深"; checked <=> root.enabled; }
        ortho-toggle := CheckBox { width: 72px; text: "正交"; checked <=> root.orthographic; }
        glass-toggle := CheckBox { width: 72px; text: "玻璃"; checked <=> root.glass; }
        hdr-toggle := CheckBox { width: 68px; text: "HDR"; checked <=> root.hdr; }
        Label { width: 36px; text: "对焦"; }
        focus-slider := Slider { width: 74px; minimum: 8; maximum: 17; value <=> root.focus; }
    }
}
