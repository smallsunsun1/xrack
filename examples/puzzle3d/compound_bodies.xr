struct ColliderPart {
    shape: string,
    position: point3d,
    size: vector3d,
}

struct CompoundVisual {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
}

export component CompoundBodiesDemo inherits Window {
    title: "XRack · 复合碰撞形状";
    width: 690px; height: 474px;
    resizable: false; background: #172738;

    in-out property <bool> running: false;
    property <physicsworld3d> world: Physics3D.new(Vector3D.new(0, -9.81, 0), 0.016);
    property <point3d> origin: Point3D.new(0, 0, 0);
    property <vector3d> identity: Vector3D.new(0, 0, 0);
    property <float> radius: 0.25;
    out property <int> gate: 0;
    out property <int> ball: 0;
    out property <int> sensor: 0;
    out property <int> ticks: 0;
    out property <int> entries: 0;
    out property <int> exits: 0;
    out property <bool> raised: false;
    out property <bool> open-lane: true;
    out property <int> occupants: Physics3D.trigger-count(root.world, root.sensor);
    out property <point3d> ball-position: root.ball == 0 ? root.launch-position : Physics3D.position(root.world, root.ball);
    out property <point3d> gate-position: Physics3D.position(root.world, root.gate);
    property <point3d> launch-position: Point3D.new(-3.2, root.radius, root.open-lane ? 0 : 1.04);
    property <point3d> sensor-center: Point3D.new(1.55, 0.35, 0);
    property <[ColliderPart]> gate-shapes: [
        ColliderPart { shape: "box", position: Point3D.new(0, 0.63, -1.04), size: Vector3D.new(0.46, 1.26, 0.7) },
        ColliderPart { shape: "box", position: Point3D.new(0, 0.63, 1.04), size: Vector3D.new(0.46, 1.26, 0.7) },
        ColliderPart { shape: "box", position: Point3D.new(0, 1.37, 0), size: Vector3D.new(0.46, 0.22, 2.78) },
    ];
    property <[ColliderPart]> sensor-shapes: [
        ColliderPart { shape: "box", position: Point3D.new(0, 0, -0.38), size: Vector3D.new(0.55, 0.46, 1.3) },
        ColliderPart { shape: "box", position: Point3D.new(0, 0, 0.38), size: Vector3D.new(0.55, 0.46, 1.3) },
    ];

    callback reset(open: bool);
    reset(open) => {
        Physics3D.clear(root.world);
        root.open-lane = open;
        root.raised = false;
        Physics3D.add-body(root.world, root.origin, root.identity,
            [ColliderPart { shape: "plane", position: root.origin, size: root.identity }], 0, 0, 0);
        root.gate = Physics3D.add-kinematic-body(root.world, root.origin, root.identity, root.gate-shapes, 0, 0);
        root.sensor = Physics3D.add-trigger(root.world, root.sensor-center, root.identity, root.sensor-shapes);
        root.ball = Physics3D.add-body(root.world, root.launch-position, root.identity, [
            ColliderPart { shape: "sphere", position: root.origin, size: Vector3D.new(0.5, 0.5, 0.5) },
        ], 1, 0, 0);
        // The sensor records the ball, independently of the floor or moving gate.
        Physics3D.set-collision-filter(root.world, root.sensor, 2, 1);
        Physics3D.set-collision-filter(root.world, root.ball, 1, 0);
        root.running = false;
        root.ticks = 0;
        root.entries = 0;
        root.exits = 0;
    }
    callback launch(open: bool);
    launch(open) => {
        root.reset(open);
        Physics3D.apply-impulse(root.world, root.ball, Vector3D.new(9, 0, 0));
    }
    callback set-gate-raised(raised: bool);
    set-gate-raised(raised) => {
        if root.gate == 0 { root.reset(true); }
        Physics3D.set-kinematic-target(root.world, root.gate,
            Point3D.new(0, raised ? 1.1 : 0, 0), root.identity);
        root.raised = raised;
    }
    callback advance();
    advance() => {
        if root.ball == 0 { root.reset(true); }
        if Physics3D.step(root.world) {
            root.ticks += 1;
            for body in Physics3D.trigger-entered(root.world, root.sensor) {
                if body == root.ball { root.entries += 1; }
            }
            for body in Physics3D.trigger-exited(root.world, root.sensor) {
                if body == root.ball { root.exits += 1; }
            }
            if root.ball-position.x > 3.45 || root.ticks >= 70 { root.running = false; }
        }
    }
    clock := Timer {
        interval: 16; repeat: true; running: root.running;
        triggered => { root.advance(); }
    }

    pure function box-part(id: string, center: point3d, size: vector3d, tint: color) -> CompoundVisual {
        CompoundVisual {
            id: id, mesh: "primitive:box", x: center.x, y: center.y, z: center.z,
            scale-x: size.x, scale-y: size.y, scale-z: size.z, yaw: 0, pitch: 0, roll: 0, color: tint,
        }
    }
    pure function gate-part(index: int, id: string) -> CompoundVisual {
        let part = Model.at(root.gate-shapes, index, ColliderPart { shape: "box", position: root.origin, size: root.identity });
        root.box-part(id,
            Point3D.new(part.position.x, part.position.y + root.gate-position.y, part.position.z),
            part.size, #8bb8dc)
    }
    property <[CompoundVisual]> visuals: [
        root.box-part("floor", Point3D.new(0, -0.12, 0), Vector3D.new(8.6, 0.24, 4.8), #35515d),
        root.box-part("open-lane", Point3D.new(-1.0, 0.002, 0), Vector3D.new(5.9, 0.004, 0.035), #577e85),
        root.box-part("blocked-lane", Point3D.new(-1.0, 0.002, 1.04), Vector3D.new(5.9, 0.004, 0.035), #876c53),
        root.gate-part(0, "left-column"),
        root.gate-part(1, "right-column"),
        root.gate-part(2, "lintel"),
        root.box-part("sensor-indicator", Point3D.new(root.sensor-center.x, 0.015, 0),
            Vector3D.new(0.55, 0.03, 2.06), root.occupants > 0 ? #58edb9 : #517d73),
        CompoundVisual {
            id: "ball", mesh: "primitive:sphere",
            x: root.ball-position.x, y: root.ball-position.y, z: root.ball-position.z,
            scale-x: root.radius, scale-y: root.radius, scale-z: root.radius,
            yaw: 0, pitch: 0, roll: 0, color: #f4ad64,
        },
    ];
    SceneView3D {
        width: 690px; height: 400px; model: root.visuals;
        camera-yaw: -23; camera-pitch: 32; camera-distance: 10.0;
        scene-background: #203a4e; ambient-intensity: 0.42; multisampling: true;
    }
    body-status := Text {
        x: 18px; y: 16px; color: #e1edf5;
        text: (root.open-lane ? "中央通道" : "侧面立柱") + "   ·   进入 " + root.entries + "   离开 "
            + root.exits + "   ·   步数 " + root.ticks;
    }
    HorizontalLayout {
        x: 14px; y: 412px; width: 662px; height: 44px; spacing: 10px;
        gap-button := Button {
            width: 122px; text: "穿过通道";
            clicked => { root.launch(true); root.running = true; }
        }
        collision-button := Button {
            width: 122px; text: "撞向立柱";
            clicked => { root.launch(false); root.running = true; }
        }
        lift-button := Button {
            width: 122px; text: root.raised ? "放下门框" : "抬起门框";
            clicked => { root.set-gate-raised(!root.raised); root.advance(); }
        }
        step-button := Button { width: 110px; text: "单步"; clicked => { root.advance(); } }
        reset-button := Button { width: 104px; text: "重置"; clicked => { root.reset(true); } }
    }
}
