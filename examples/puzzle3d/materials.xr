struct MaterialActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    camera-kind: string, camera-height: float,
}

struct MaterialLight {
    kind: string, x: float, y: float, z: float,
    yaw: float, elevation: float, intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float,
}

export component MaterialDemo inherits Window {
    title: "XRack · glTF 材质";
    width: 480px;
    height: 300px;
    background: #141d29;

    in-out property <bool> hdr: false;
    in-out property <bool> shadows: false;
    in-out property <bool> filtered: false;
    in-out property <float> light-yaw: 0;
    property <[MaterialActor]> models: [
        MaterialActor {
            id: "finish", mesh: @mesh-url("models/finish.gltf"),
            x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
            yaw: 0, pitch: 0, roll: 0, color: #ffffff,
            camera-kind: "", camera-height: 7.125,
        },
        MaterialActor {
            id: "camera", mesh: "", x: 0, y: 0, z: 8.6,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, camera-kind: "orthographic", camera-height: 7.125,
        },
    ];
    property <[MaterialLight]> lights: [
        MaterialLight {
            kind: "directional", x: 0, y: 0, z: 0,
            yaw: root.light-yaw, elevation: 0, intensity: 4, color: #ffffff,
            range: 0, inner-angle: 0, outer-angle: 45,
        },
    ];
    out property <string> picked: Scene3D.pick-camera(root.models, "camera",
        Point2D.new(480px, 248px), Point2D.new(240px, 82px));

    view := SceneView3D {
        width: 480px;
        height: 248px;
        model: root.models;
        lights: root.lights;
        camera: "camera";
        ambient-intensity: 0.2;
        shadows: root.shadows;
        specular-aa: root.filtered;
        scene-background: #172333;
        environment: root.hdr ? @environment-url("models/studio.hdr") : "";
    }

    HorizontalLayout {
        y: 248px;
        width: 480px;
        height: 52px;
        padding: 12px;
        spacing: 14px;
        hdr-toggle := CheckBox { text: "HDR"; checked <=> root.hdr; }
        shadows-toggle := CheckBox { text: "阴影"; checked <=> root.shadows; }
        light-slider := Slider { minimum: -40; maximum: 40; value <=> root.light-yaw; }
    }
}
