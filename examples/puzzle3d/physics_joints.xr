struct RigShape { shape: string, size: vector3d }
struct RigBody { id: string, body-kind: string, position: point3d, shapes: [RigShape], mass: float, friction: float }
struct RigJoint {
    id: string, joint-kind: string, first: string, second: string,
    first-anchor: point3d, second-anchor: point3d,
    first-rotation: vector3d, second-rotation: vector3d, min: float, max: float,
}

struct JointPart {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
}

export component PhysicsJointsDemo inherits Window {
    title: "XRack · 刚体关节";
    width: 720px; height: 492px;
    resizable: false;
    background: #15212d;

    in-out property <bool> running = false;
    in-out property <physicsworld3d> world = Physics3D.new(Vector3D.new(0, 0, 0), 0.016);
    out property <bool> forward = true;
    out property <int> ticks = 0;
    out property <bool> accepted = true;
    out property <bool> wide-post = false;
    out property <int> post: Physics3D.body-by-id(root.world, "post");
    out property <int> door: Physics3D.body-by-id(root.world, "door");
    out property <int> knob: Physics3D.body-by-id(root.world, "knob");
    out property <int> slider: Physics3D.body-by-id(root.world, "slider");
    out property <int> pendulum: Physics3D.body-by-id(root.world, "swing");
    out property <int> tethered: Physics3D.body-by-id(root.world, "tether");
    out property <int> hinge: Physics3D.joint-by-id(root.world, "hinge");
    out property <int> rail: Physics3D.joint-by-id(root.world, "rail");
    out property <int> tether: Physics3D.joint-by-id(root.world, "tether");
    out property <int> ball-joint: Physics3D.joint-by-id(root.world, "swing");
    out property <int> fixed-joint: Physics3D.joint-by-id(root.world, "knob");

    property <point3d> hinge-pin: Point3D.new(-2.9, 0.91, 0.6);
    property <point3d> door-start: Point3D.new(-2.05, 0.91, 0.6);
    property <point3d> knob-start: Point3D.new(-1.4, 0.91, 0.78);
    property <point3d> rail-start: Point3D.new(2.1, 0.21, 0.86);
    property <point3d> slider-start: Point3D.new(2.1, 0.5, 0.86);
    property <point3d> swing-pin: Point3D.new(-0.5, 2.04, -1.3);
    property <point3d> swing-start: Point3D.new(-0.5, 0.8, -1.3);
    property <point3d> tether-pin: Point3D.new(2.9, 2.04, -1.5);
    property <point3d> tether-start: Point3D.new(2.9, 1.05, -1.5);
    property <vector3d> door-size: Vector3D.new(1.7, 1.75, 0.16);
    property <vector3d> rail-size: Vector3D.new(3.05, 0.14, 0.43);
    property <vector3d> slider-size: Vector3D.new(0.56, 0.4, 0.61);
    property <point3d> origin: Point3D.new(0, 0, 0);
    property <vector3d> vertical-axis: Vector3D.new(0, 0, 90);
    property <vector3d> zero-angle: Vector3D.new(0, 0, 0);

    out property <float> door-angle: Physics3D.joint-position(root.world, root.hinge);
    out property <float> slider-travel: Physics3D.joint-position(root.world, root.rail);
    out property <float> tether-span: root.tether == 0 ? 0.99 : Physics3D.joint-position(root.world, root.tether);
    out property <point3d> door-position: root.door == 0 ? root.door-start : Physics3D.position(root.world, root.door);
    out property <point3d> knob-position: root.knob == 0 ? root.knob-start : Physics3D.position(root.world, root.knob);
    out property <point3d> slider-position: root.slider == 0 ? root.slider-start : Physics3D.position(root.world, root.slider);
    out property <point3d> swing-position: root.pendulum == 0 ? root.swing-start : Physics3D.position(root.world, root.pendulum);
    out property <point3d> tether-position: root.tethered == 0 ? root.tether-start : Physics3D.position(root.world, root.tethered);

    pure function body(id: string, shape: string, center: point3d, size: vector3d, mass: float, friction: float) -> RigBody {
        RigBody {
            id: id, body-kind: mass == 0 ? "fixed" : "dynamic", position: center,
            shapes: [RigShape { shape: shape, size: size }], mass: mass, friction: friction,
        }
    }
    pure function sphere(id: string, center: point3d, diameter: float, mass: float, friction: float) -> RigBody {
        root.body(id, "sphere", center, Vector3D.new(diameter, diameter, diameter), mass, friction)
    }
    pure function joint(id: string, kind: string, first: string, second: string,
        a: point3d, b: point3d, rotation: vector3d, minimum: float, maximum: float) -> RigJoint {
        RigJoint {
            id: id, joint-kind: kind, first: first, second: second,
            first-anchor: a, second-anchor: b, first-rotation: rotation, second-rotation: rotation,
            min: minimum, max: maximum,
        }
    }
    callback apply-rig(wide: bool, broken: bool);
    apply-rig(wide, broken) => {
        let old-hinge = root.hinge;
        let old-rail = root.rail;
        root.accepted = Physics3D.sync-scene(root.world, [
            root.sphere("post", root.hinge-pin, wide ? 0.39 : 0.24, 0, 0.4),
            root.body("door", "box", root.door-start, root.door-size, 1.7, 0.3),
            root.sphere("knob", root.knob-start, 0.24, 0.12, 0.2),
            root.body("track", "box", root.rail-start, root.rail-size, 0, 0.3),
            root.body("slider", "box", root.slider-start, root.slider-size, 0.8, 0.2),
            root.sphere("swing-top", root.swing-pin, 0.28, 0, 0),
            root.sphere("swing", root.swing-start, 0.48, 0.6, 0.2),
            root.sphere("tether-top", root.tether-pin, 0.28, 0, 0),
            root.sphere("tether", root.tether-start, 0.48, 0.6, 0.2),
        ], [
            root.joint("hinge", "revolute", "post", "door", root.origin,
                Point3D.new(-0.85, 0, 0), root.vertical-axis, -50, 70),
            root.joint("knob", "fixed", "door", "knob", Point3D.new(0.65, 0, 0.18),
                root.origin, root.zero-angle, 0, 0),
            root.joint("rail", "prismatic", "track", "slider", Point3D.new(0, 0.29, 0),
                root.origin, root.zero-angle, -1.2, 1.2),
            root.joint("swing", "spherical", "swing-top", "swing", root.origin,
                Point3D.new(0, 1.24, 0), root.zero-angle, 0, 0),
            root.joint("tether", "distance", "tether-top", broken ? "missing" : "tether",
                root.origin, root.origin, root.zero-angle, 0.8, 1.35),
        ]);
        if root.accepted {
            root.wide-post = wide;
            Physics3D.set-collision-filter(root.world, root.pendulum, 1, 3);
            Physics3D.set-collision-filter(root.world, root.tethered, 1, 3);
            if root.hinge != old-hinge {
                Physics3D.set-joint-motor(root.world, root.hinge, root.forward ? 95 : -95, 80);
            }
            if root.rail != old-rail {
                Physics3D.set-joint-motor(root.world, root.rail, root.forward ? 2.3 : -2.3, 80);
            }
        }
    }
    callback reset();
    reset() => {
        Physics3D.clear(root.world);
        root.forward = true;
        root.apply-rig(false, false);
        root.ticks = 0;
    }
    callback drive(forward: bool);
    drive(forward) => {
        root.forward = forward;
        Physics3D.set-joint-motor(root.world, root.hinge, forward ? 95 : -95, 80);
        Physics3D.set-joint-motor(root.world, root.rail, forward ? 2.3 : -2.3, 80);
    }
    callback tighten();
    tighten() => {
        Physics3D.set-joint-limits(root.world, root.hinge, -20, 25);
        Physics3D.set-joint-limits(root.world, root.rail, -0.5, 0.5);
    }
    callback nudge();
    nudge() => {
        if root.door == 0 { root.reset(); }
        Physics3D.apply-impulse(root.world, root.pendulum, Vector3D.new(1.5, 0, 0));
        Physics3D.apply-impulse(root.world, root.tethered, Vector3D.new(0, -1.5, 0));
    }
    callback advance();
    advance() => {
        if root.door == 0 { root.reset(); }
        if Physics3D.step(root.world) { root.ticks += 1; }
    }
    clock := Timer {
        interval: 16; repeat: true; running: root.running;
        triggered => { root.advance(); }
    }

    pure function part(id: string, shape: string, center: point3d, scale: vector3d, angles: vector3d, tint: color) -> JointPart {
        JointPart {
            id: id, mesh: shape, x: center.x, y: center.y, z: center.z,
            scale-x: scale.x, scale-y: scale.y, scale-z: scale.z,
            yaw: angles.x, pitch: angles.y, roll: angles.z, color: tint,
        }
    }
    pure function ball(id: string, center: point3d, radius: float, tint: color) -> JointPart {
        root.part(id, "primitive:sphere", center, Vector3D.new(radius, radius, radius), root.zero-angle, tint)
    }
    pure function line(id: string, top: point3d, bottom: point3d, tint: color) -> JointPart {
        let dx = bottom.x - top.x;
        let dy = bottom.y - top.y;
        root.part(id, "primitive:box",
            Point3D.new((top.x + bottom.x) / 2, (top.y + bottom.y) / 2, top.z),
            Vector3D.new(0.035, Math.sqrt(dx * dx + dy * dy), 0.035),
            Vector3D.new(0, 0, -Math.to-degrees(Math.atan2(dx, dy))), tint)
    }
    property <[JointPart]> parts: [
        root.part("stage", "primitive:box", Point3D.new(0, -0.16, 0), Vector3D.new(8.5, 0.2, 5.5), root.zero-angle, #30424a),
        root.part("door-post", "primitive:box", root.hinge-pin, Vector3D.new(root.wide-post ? 0.35 : 0.16, 1.82, root.wide-post ? 0.38 : 0.19), root.zero-angle, #c3cdd5),
        root.part("door", "primitive:box", root.door-position, root.door-size, Physics3D.rotation(root.world, root.door), #dd9664),
        root.ball("knob", root.knob-position, 0.12, #ffd788),
        root.part("track", "primitive:box", root.rail-start, root.rail-size, root.zero-angle, #6588bb),
        root.part("slider", "primitive:box", root.slider-position, root.slider-size, Physics3D.rotation(root.world, root.slider), #7be2d9),
        root.ball("swing-pin", root.swing-pin, 0.14, #d5cfe7),
        root.line("swing-arm", root.swing-pin, root.swing-position, #ddc7f3),
        root.ball("swing", root.swing-position, 0.24, #ad91d6),
        root.ball("tether-pin", root.tether-pin, 0.14, #e4d2af),
        root.line("tether-line", root.tether-pin, root.tether-position, #f2d49c),
        root.ball("tether", root.tether-position, 0.24, #f6cf7b),
    ];
    SceneView3D {
        width: 720px; height: 420px; model: root.parts;
        camera-yaw: 14; camera-pitch: 27; camera-distance: 10.8;
        scene-background: #1d3244; ambient-intensity: 0.42; multisampling: true;
    }
    joint-status := Text {
        x: 18px; y: 16px; color: #e6edf6;
        text: "门轴 " + Math.round(root.door-angle) + "°     滑轨 "
            + Math.round(root.slider-travel * 100) / 100.0 + "     吊挂 "
            + Math.round(root.tether-span * 100) / 100.0;
    }
    revision-status := Text {
        x: 18px; y: 46px; color: #b6c7d5;
        text: "门轴 ID " + root.hinge + "   ·   滑轨 ID " + root.rail
            + (root.accepted ? "" : "   ·   场景更新已拒绝");
    }
    ticks-status := Text { x: 595px; y: 16px; color: #b6c7d5; text: "步数 " + root.ticks; }
    HorizontalLayout {
        x: 14px; y: 432px; width: 692px; height: 44px; spacing: 10px;
        run-button := Button {
            width: 90px; text: root.running ? "暂停" : "运行";
            clicked => { root.running = !root.running; }
        }
        step-button := Button { width: 90px; text: "单步"; clicked => { root.advance(); } }
        reverse-button := Button {
            width: 90px; text: "反向驱动";
            clicked => { if root.door == 0 { root.reset(); } root.drive(!root.forward); }
        }
        tighten-button := Button {
            width: 90px; text: "收紧限位";
            clicked => { if root.door == 0 { root.reset(); } root.tighten(); }
        }
        nudge-button := Button { width: 90px; text: "推动吊挂"; clicked => { root.nudge(); } }
        post-button := Button {
            width: 90px; text: "替换门柱";
            clicked => { root.apply-rig(!root.wide-post, false); }
        }
        reset-button := Button { width: 72px; text: "重置"; clicked => { root.reset(); } }
    }
}
