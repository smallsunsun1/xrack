struct PassMaterial { unlit: bool }
struct PassActor {
    id: string, mesh: string, color: color, layers: int, material: PassMaterial,
    x: float, y: float, z: float, scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, camera-kind: string, camera-height: float,
}
struct RenderStage {
    name: string, camera: string, layers: int, scale: float, background: color,
    renderables: string, color-source: string,
}
struct PassInput { capture: string, attachment: string }
struct PassEffect { strength: float, shader: string, buffers: [PassInput] }

export component CustomPipelineDemo inherits Window {
    title: "XRack · 自定义视口管线";
    width: 282px; height: 138px; background: #000;
    in-out property <bool> custom: true;
    in-out property <bool> output: true;
    in-out property <bool> effect: false;

    property <PassActor> actor: PassActor {
        id: "", mesh: "primitive:box", color: #fff, layers: 1, material: PassMaterial { unlit: true },
        x: 0, y: 0, z: 0, scale-x: 0.8, scale-y: 0.8, scale-z: 0.8,
        yaw: 0, pitch: 0, roll: 0, camera-kind: "", camera-height: 2.0,
    };
    property <scenemodel3d> scene: Scene3D.prepare([
        PassActor { id: "eye", mesh: "", z: 5, camera-kind: "orthographic", ..root.actor },
        PassActor { id: "default", x: -1.40, color: #f00, ..root.actor },
        PassActor { id: "captured", x: 1.40, layers: 2, color: #0f0, ..root.actor },
    ]);

    viewport := SceneView3D {
        x: 8px; y: 8px; width: 266px; height: 84px;
        model: root.scene; camera: "eye"; layer-mask: 1;
        scene-background: #283c7a; cache-rendering: true;
        supersampling: 1.5;
        render-overrides: root.custom ? "disable-internal-passes" : "none";
        scene-color-capture: root.output ? "relay" : "";
        scene-captures: [
            RenderStage {
                name: "geometry", camera: "eye", layers: 2, scale: 0.5,
                background: #00000000, renderables: "opaque", color-source: "",
            },
            RenderStage {
                name: "relay", camera: "eye", layers: 0, scale: 0.5,
                background: #00000000, renderables: "none", color-source: "geometry",
            },
            RenderStage {
                name: "unused", camera: "eye", layers: 0, scale: 1,
                background: #f0f, renderables: "none", color-source: "",
            },
        ];
        scene-effects: [
            PassEffect {
                strength: root.effect ? 1.0 : 0.0,
                shader: @shader-url("effects/custom_pipeline_output.wgsl"),
                buffers: [PassInput { capture: "relay", attachment: "color" }],
            },
        ];
    }
    mode-toggle := Button {
        x: 8px; y: 99px; width: 84px; height: 30px;
        text: root.custom ? "自定义" : "默认"; clicked => { root.custom = !root.custom; }
    }
    output-toggle := CheckBox {
        x: 103px; y: 99px; width: 88px; height: 30px;
        text: "捕获"; checked <=> root.output;
    }
    effect-toggle := CheckBox {
        x: 195px; y: 99px; width: 82px; height: 30px;
        text: "效果"; checked <=> root.effect;
    }
}
