struct SweepActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    layers: int, visible: bool, pickable: bool, collidable: bool,
}

export component SphereCastDemo inherits Window {
    title: "XRack · 球体扫掠";
    width: 604px; height: 422px;
    resizable: false;
    background: #172638;

    in-out property <float> lane: 0.9;
    in-out property <float> radius: 0.5;
    in-out property <float> requested: 6.5;
    in-out property <bool> blocking: true;
    in-out property <int> mask: 1;

    property <SweepActor> unit: SweepActor {
        id: "", mesh: "primitive:box",
        x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #7185a1, layers: 1,
        visible: true, pickable: true, collidable: true,
    };
    property <SweepActor> wall: SweepActor {
        id: "wall", x: 0, y: 0.35, scale-x: 0.4, scale-y: 1.7, scale-z: 1.4,
        color: #789ab8, collidable: root.blocking, ..root.unit
    };
    property <SweepActor> gate: SweepActor {
        id: "gate", x: 1.55, y: 0.35, z: 0.78, scale-x: 0.55, scale-y: 1.3, scale-z: 0.8,
        color: #a184ab, layers: 2, ..root.unit
    };
    property <SweepActor> terrain: SweepActor {
        id: "terrain", mesh: @mesh-url("models/ridge.png"), y: -1.45,
        scale-x: 8.4, scale-y: 0.55, scale-z: 4.8,
        color: #415e59, layers: 4, ..root.unit
    };
    property <[SweepActor]> world: [root.wall, root.gate, root.terrain];
    property <point3d> origin: Point3D.new(-3, 0.35, root.lane);
    property <vector3d> forward: Vector3D.new(1, 0, 0);
    out property <hit3d> contact: Scene3D.sphere-cast(
        root.world, root.origin, root.forward, root.requested, root.radius, root.mask);
    out property <hit3d> point-ray: Scene3D.ray-hit(root.world, root.origin, root.forward, root.requested, root.mask);
    out property <[hit3d]> overlap: Scene3D.sphere-overlap(
        root.world, Point3D.new(0.63, 0.35, 0.25), 0.9, 3);
    out property <hit3d> terrain-hit: Scene3D.sphere-cast(
        root.world, Point3D.new(0, 4, 0), Vector3D.new(0, -1, 0), 10, 0.3, 4);
    property <float> travel: root.contact.valid ? root.contact.distance : root.requested;
    property <[SweepActor]> view: [
        root.wall, root.gate, root.terrain,
        SweepActor {
            mesh: "primitive:sphere", x: -3 + root.travel, y: 0.35, z: root.lane,
            scale-x: root.radius, scale-y: root.radius, scale-z: root.radius,
            color: root.contact.valid ? #ffbd5b : #74d6cb, pickable: false, collidable: false,
            ..root.unit
        },
        SweepActor {
            mesh: "primitive:sphere", x: root.contact.position.x, y: root.contact.position.y, z: root.contact.position.z,
            scale-x: 0.07, scale-y: 0.07, scale-z: 0.07,
            color: #ff874d, visible: root.contact.valid, pickable: false, collidable: false,
            ..root.unit
        },
        SweepActor {
            x: -3 + root.requested / 2, y: -0.65, z: root.lane,
            scale-x: Math.max(root.requested, 0.015), scale-y: 0.045, scale-z: 0.045,
            color: #9baab9, pickable: false, collidable: false, ..root.unit
        },
    ];
    SceneView3D {
        width: 604px; height: 354px;
        model: root.view; camera-yaw: -16; camera-pitch: 27; camera-distance: 9.5;
        scene-background: #223b51; layer-mask: 7;
        multisampling: true; ambient-intensity: 0.32;
    }
    HorizontalLayout {
        x: 14px; y: 365px; width: 580px; height: 42px; spacing: 12px;
        block-toggle := CheckBox { width: 98px; text: "墙体阻挡"; checked <=> root.blocking; }
        Text { width: 91px; color: #dbe6ef; text: root.contact.valid ? "接触 " + root.contact.object-id : "可通过"; }
        travel-slider := Slider { width: 165px; minimum: 0; maximum: 6.5; value <=> root.requested; }
        radius-slider := Slider { width: 169px; minimum: 0.09; maximum: 0.8; value <=> root.radius; }
    }
}
