struct TransparentActor {
    id: string, mesh: string,
    x: float, y: float, z: float, scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color, visible: bool,
    camera-kind: string, camera-height: float, camera-reverse-depth: bool, depth-bias: float,
}

struct TransparencyScissor {
    x: length, y: length, width: length, height: length, enabled: bool,
}

export component TransparencyDemo inherits Window {
    title <- "XRack · 相交透明面";
    width <- 480px;
    height <- 344px;
    background <- #141d29;

    in-out property <bool> weighted: false;
    in-out property <bool> linked: false;
    in-out property <bool> clipped: false;
    in-out property <length> clip-x: 96px;
    in-out property <length> clip-width: 208px;
    in-out property <bool> reverse-depth: false;
    in-out property <float> red-depth-bias: 0;
    in-out property <bool> cache: false;
    in-out property <bool> reversed: false;
    in-out property <bool> smooth: false;
    in-out property <bool> hdr: false;
    in-out property <bool> single: false;
    in-out property <bool> offscreen: false;
    property <float> shift <- root.offscreen ? 100 : 0;

    property <TransparentActor> defaults <- TransparentActor {
        id: "", mesh: "", x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff, visible: true, camera-kind: "", camera-height: 6, camera-reverse-depth: root.reverse-depth, depth-bias: 0,
    };
    property <string> sheet <- @mesh-url("models/oit-sheet.gltf");
    property <TransparentActor> red <- TransparentActor {
        id: "red", mesh: root.sheet, x: root.shift, yaw: 40, color: #ff3838, depth-bias: root.red-depth-bias, ..root.defaults
    };
    property <TransparentActor> blue <- TransparentActor {
        id: "blue", mesh: root.sheet, x: root.shift, yaw: -40, color: #3864ff,
        visible: !root.single, ..root.defaults
    };
    property <TransparentActor> culled <- TransparentActor {
        id: "outside", mesh: root.sheet, x: 100, ..root.defaults
    };
    property <TransparentActor> front <- TransparentActor {
        id: "block", mesh: "primitive:box", y: -0.63, z: 3.25,
        scale-x: 0.85, scale-y: 1.35, scale-z: 0.55, roll: 17,
        color: #46936f, ..root.defaults
    };
    property <TransparentActor> camera <- TransparentActor {
        id: "eye", z: 8, camera-kind: "orthographic", ..root.defaults
    };
    property <TransparentActor> coated <- TransparentActor {
        id: "coated", mesh: @mesh-url("models/oit-coated.gltf"), x: root.shift,
        y: -2.18, scale-x: 0.48, scale-y: 0.28, scale-z: 1,
        color: #e9bb6e, visible: !root.single, ..root.defaults
    };
    property <[TransparentActor]> models <- root.reversed
        ? [root.blue, root.culled, root.red, root.front, root.coated, root.camera]
        : [root.red, root.culled, root.blue, root.front, root.coated, root.camera];
    property <point2d> viewport <- Point2D.new(480px, 248px);
    out property <string> left-pick <- Scene3D.pick-camera(root.models, "eye",
        root.viewport, Point2D.new(185px, 98px));
    out property <string> right-pick <- Scene3D.pick-camera(root.models, "eye",
        root.viewport, Point2D.new(295px, 98px));

    view := SceneView3D {
        width <- 480px;
        height <- 248px;
        camera <- "eye";
        model <- root.models;
        oit-method <- root.linked ? "linked-list" : root.weighted ? "weighted" : "sorted";
        scissor-rect <- TransparencyScissor {
            x: root.clip-x, y: 48px, width: root.clip-width, height: 152px, enabled: root.clipped,
        };
        cache-rendering <- root.cache;
        multisampling <- root.smooth;
        environment <- root.hdr ? @environment-url("models/studio.hdr") : "";
        scene-background <- #172333;
    }

    HorizontalLayout {
        y <- 248px;
        height <- 52px;
        width <- 480px;
        padding <- 12px;
        spacing <- 14px;
        weighted-toggle := CheckBox { text <- "加权透明"; checked <-> root.weighted; }
        reversed-toggle := CheckBox { text <- "反转行序"; checked <-> root.reversed; }
        smooth-toggle := CheckBox { text <- "4× MSAA"; checked <-> root.smooth; }
        hdr-toggle := CheckBox { text <- "HDR"; checked <-> root.hdr; }
    }
    bias-toggle := Button {
        x <- 12px; y <- 302px; width <- 156px; height <- 32px;
        enabled <- !root.weighted && !root.linked;
        text <- root.red-depth-bias == 0 ? "默认排序"
            : root.red-depth-bias > 0 ? "红片先画" : "红片后画";
        clicked => {
            root.red-depth-bias = root.red-depth-bias == 0 ? 0.8
                : root.red-depth-bias > 0 ? -0.8 : 0;
        }
    }
    linked-toggle := CheckBox {
        x <- 184px; y <- 303px; width <- 154px; height <- 30px;
        text <- "逐像素透明"; checked <-> root.linked;
    }
    scissor-toggle := CheckBox {
        x <- 352px; y <- 303px; width <- 110px; height <- 30px;
        text <- "裁剪"; checked <-> root.clipped;
    }
}
