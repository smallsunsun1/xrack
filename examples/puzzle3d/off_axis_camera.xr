struct FrustumActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color,
    camera-kind: string, camera-near: float, camera-far: float,
    camera-left: float, camera-right: float, camera-bottom: float, camera-top: float,
}

export component OffAxisCameraDemo inherits Window {
    title <- "XRack · 偏轴相机";
    width <- 360px;
    height <- 296px;
    resizable <- false;
    background <- #141d29;

    in-out property <float> horizontal: 0.25;
    in-out property <float> vertical: 0.125;
    in-out property <float> half-width: 0.75;
    in-out property <float> half-height: 0.5;
    in-out property <bool> parallel: false;
    in-out property <bool> culling: true;
    in-out property <bool> effects: true;
    in-out property <point2d> cursor: Point2D.new(120px, 150px);
    property <point2d> viewport-size <- Point2D.new(360px, 240px);
    property <float> lens-scale <- root.parallel ? 8.0 : 1.0;
    property <FrustumActor> defaults: FrustumActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ffffff, camera-kind: "", camera-near: 1, camera-far: 40,
        camera-left: -0.75, camera-right: 0.75, camera-bottom: -0.5, camera-top: 0.5,
    };
    property <[FrustumActor]> scene <- [
        FrustumActor {
            id: "lens", mesh: "", z: 8,
            camera-kind: root.parallel ? "orthographic" : "frustum",
            camera-left: (root.horizontal - root.half-width) * root.lens-scale,
            camera-right: (root.horizontal + root.half-width) * root.lens-scale,
            camera-bottom: (root.vertical - root.half-height) * root.lens-scale,
            camera-top: (root.vertical + root.half-height) * root.lens-scale,
            ..root.defaults
        },
        FrustumActor {
            id: "floor", y: -1.05, scale-x: 20, scale-y: 0.3, scale-z: 6,
            color: #69778e, ..root.defaults
        },
        FrustumActor {
            id: "center", mesh: "primitive:sphere", scale-x: 1.8, scale-y: 1.8, scale-z: 1.8,
            color: #e9b24d, ..root.defaults
        },
        FrustumActor {
            id: "left", x: -7, scale-x: 0.95, scale-y: 1.8, scale-z: 0.65,
            color: #e66c8e, ..root.defaults
        },
        FrustumActor {
            id: "right", x: 7, scale-x: 0.95, scale-y: 1.8, scale-z: 0.65,
            color: #63d6bd, ..root.defaults
        },
    ];
    out property <projectedpoint3d> projected <- Scene3D.project-camera(root.scene, "lens",
        root.viewport-size, Point3D.new(0, 0, 0));
    out property <point3d> unprojected <- Scene3D.unproject-camera(root.scene, "lens",
        root.viewport-size, root.projected.point, root.projected.depth, Point3D.new(100, 100, 100));
    out property <string> picked <- Scene3D.pick-camera(root.scene, "lens", root.viewport-size, root.cursor);

    image := SceneView3D {
        width <- 360px;
        height <- 240px;
        model <- root.scene;
        camera <- "lens";
        frustum-culling <- root.culling;
        scene-background <- #172333;
        environment <- @environment-url("models/studio.hdr");
        environment-skybox <- true;
        shadows <- root.effects;
        shadow-cascades <- 3;
        shadow-map-size <- 512;
        shadow-bias <- 0.008;
        ambient-occlusion <- root.effects;
    }
    scene-input := TouchArea {
        width <- 360px; height <- 240px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.inside {
                root.cursor = Point2D.new(event.x, event.y);
            }
        }
    }
    Text {
        x <- 12px; y <- 12px; color <- #ffffff;
        text <- root.picked == "" ? "点击选择物体" : "已选中 · " + root.picked;
    }
    HorizontalLayout {
        x <- 10px; y <- 248px; width <- 340px; height <- 38px; spacing <- 8px;
        left := Button { width <- 54px; text <- "左"; clicked => { root.horizontal = -0.25; } }
        centered := Button {
            width <- 54px; text <- "居中";
            clicked => { root.horizontal = 0; root.vertical = 0; }
        }
        right := Button { width <- 54px; text <- "右"; clicked => { root.horizontal = 0.25; } }
        change-projection := Button {
            width <- 64px;
            text <- root.parallel ? "正交" : "透视";
            clicked => { root.parallel = !root.parallel; }
        }
        shift := Slider { width <- 80px; minimum <- -0.4; maximum <- 0.4; value <-> root.horizontal; }
    }
}

struct FieldOfViewActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    camera-kind: string, camera-fov: float, camera-fov-axis: string,
    lod-of: string, lod-max-size: length,
}

export component FieldOfViewDemo inherits Window {
    title <- "XRack · 透视视角";
    width <- 320px;
    height <- 216px;
    resizable <- false;
    background <- #141d29;

    in-out property <string> fov-axis: "vertical";
    in-out property <bool> wide: true;
    property <FieldOfViewActor> defaults: FieldOfViewActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1.4, scale-y: 1.4, scale-z: 1.4, yaw: 0, pitch: 0, roll: 0,
        color: #ff784d, camera-kind: "", camera-fov: 90, camera-fov-axis: "",
        lod-of: "", lod-max-size: 0px,
    };
    property <scenemodel3d> scene <- Scene3D.prepare([
        FieldOfViewActor { id: "lens", mesh: "", z: 8, camera-kind: "perspective",
            camera-fov-axis: root.fov-axis, ..root.defaults },
        FieldOfViewActor { id: "side", mesh: "primitive:sphere", x: 4, y: 3, ..root.defaults },
        FieldOfViewActor { lod-of: "side", lod-max-size: 96px, ..root.defaults },
        FieldOfViewActor { id: "top", y: 6, color: #5addae, ..root.defaults },
    ]);
    property <point3d> reference <- Point3D.new(4, 3, 0);
    property <point2d> dimensions <- Point2D.new(root.wide ? 320px : 160px, 160px);
    out property <projectedpoint3d> side-point <- view.project(root.reference);
    out property <projectedpoint3d> top-point <- view.project(Point3D.new(0, 6, 0));
    out property <projectedpoint3d> direct-point <-
        Scene3D.project-camera(root.scene, "lens", root.dimensions, root.reference);
    out property <point3d> unprojected <- view.unproject(root.side-point.point, root.side-point.depth,
        Point3D.new(-1, -1, -1));
    out property <hit3d> surface-hit <- view.hit(root.side-point.point);

    view := SceneView3D {
        width <- root.dimensions.x; height <- root.dimensions.y;
        model <- root.scene; camera <- "lens";
        scene-background <- #172333;
    }
    HorizontalLayout {
        x <- 10px; y <- 170px; width <- 300px; height <- 36px; spacing <- 8px;
        axis-button := Button {
            width <- 148px;
            text <- root.fov-axis == "horizontal" ? "水平视角" : "垂直视角";
            clicked => { root.fov-axis = root.fov-axis == "horizontal" ? "vertical" : "horizontal"; }
        }
        resize-button := Button {
            width <- 144px; text <- root.wide ? "宽画幅" : "方画幅";
            clicked => { root.wide = !root.wide; }
        }
    }
}
