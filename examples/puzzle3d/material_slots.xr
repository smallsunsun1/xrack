struct CoatStyle {
    enabled: bool, slot: string, base-color: color, alpha-mode: string, alpha-cutoff: float,
    opacity: float,
}
struct ScenePalette {
    body: CoatStyle,
    slot-0: CoatStyle,
    default-slot: CoatStyle,
}
struct PaletteActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, material-slots: ScenePalette, casts-shadow: bool, opacity: float,
    camera-kind: string, camera-height: float,
}

export component MaterialSlotsDemo inherits Window {
    title <- "XRack · 逐槽材质";
    width <- 634px; height <- 466px;
    resizable <- false; background <- #1a2638;

    in-out property <string> target: "Body finish";
    in-out property <bool> warm: true;
    in-out property <bool> cutout: false;
    in-out property <bool> accent: true;
    in-out property <bool> implicit-style: true;
    in-out property <float> body-opacity: 1;
    in-out property <float> model-opacity: 1;
    in-out property <float> mask-alpha: 40.0 / 255.0;
    property <CoatStyle> original: CoatStyle {
        enabled: false, slot: "", base-color: #ffffff, alpha-mode: "opaque", alpha-cutoff: 0.5, opacity: 1,
    };
    property <ScenePalette> no-overrides <- ScenePalette {
        body: root.original, slot-0: root.original, default-slot: root.original,
    };
    property <PaletteActor> base <- PaletteActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, material-slots: root.no-overrides, casts-shadow: true, opacity: 1,
        camera-kind: "", camera-height: 5.4,
    };
    property <[PaletteActor]> world <- [
        PaletteActor { id: "eye", mesh: "", z: 8, camera-kind: "orthographic", ..root.base },
        PaletteActor {
            id: "wall", z: -1.7, scale-x: 16, scale-y: 8, scale-z: 0.1,
            color: #48627d, casts-shadow: false, ..root.base
        },
        PaletteActor {
            id: "model", mesh: @mesh-url("models/material-slots.gltf"), opacity: root.model-opacity,
            material-slots: ScenePalette {
                body: CoatStyle {
                    enabled: true, slot: root.target,
                    base-color: root.cutout ? Colors.with-alpha(#e0834e, root.mask-alpha) : root.warm ? #e0834e : #60bce9,
                    opacity: root.body-opacity,
                    alpha-mode: root.cutout ? "mask" : "opaque", ..root.original
                },
                slot-0: CoatStyle { enabled: root.accent, base-color: #8dd8a1, ..root.original },
                default-slot: CoatStyle { enabled: root.implicit-style, base-color: #bba7ee, ..root.original },
            },
            ..root.base
        },
    ];
    out property <string> body-hit <- Scene3D.pick-camera(
        root.world, "eye", Point2D.new(634px, 324px), Point2D.new(183px, 162px));
    SceneView3D {
        width <- 634px; height <- 324px; model <- root.world; camera <- "eye";
        scene-background <- #263b54; ambient-intensity <- 0.44; light-yaw <- -22; light-elevation <- 39;
        shadows <- true; shadow-map-size <- 512; scene-hdr <- true; cache-rendering <- true;
    }
    Label { x <- 106px; y <- 328px; width <- 150px; height <- 31px; text <- "Body finish · #2"; horizontal-alignment <- center; }
    Label { x <- 250px; y <- 328px; width <- 134px; height <- 31px; text <- "Trim · #0"; horizontal-alignment <- center; }
    Label { x <- 385px; y <- 328px; width <- 128px; height <- 31px; text <- "#default"; horizontal-alignment <- center; }
    palette-toggle := CheckBox { x <- 13px; y <- 371px; width <- 87px; height <- 34px; text <- "暖色"; checked <-> root.warm; }
    mask-toggle := CheckBox { x <- 112px; y <- 371px; width <- 124px; height <- 34px; text <- "裁切外壳"; checked <-> root.cutout; }
    trim-toggle := CheckBox { x <- 249px; y <- 371px; width <- 122px; height <- 34px; text <- "覆盖饰条"; checked <-> root.accent; }
    default-toggle := CheckBox { x <- 382px; y <- 371px; width <- 130px; height <- 34px; text <- "覆盖默认槽"; checked <-> root.implicit-style; }
    selector-toggle := Button {
        x <- 516px; y <- 370px; width <- 103px; height <- 35px;
        text <- root.target == "#2" ? "按索引" : "按名称";
        clicked => { root.target = root.target == "#2" ? "Body finish" : "#2"; }
    }
    Label { x <- 13px; y <- 421px; width <- 107px; height <- 32px; text <- "外壳不透明度"; }
    body-fade := Slider {
        x <- 125px; y <- 421px; width <- 169px; height <- 32px;
        minimum <- 0; maximum <- 1; step <- 0.05; value <-> root.body-opacity;
    }
    Label { x <- 325px; y <- 421px; width <- 107px; height <- 32px; text <- "模型不透明度"; }
    model-fade := Slider {
        x <- 440px; y <- 421px; width <- 169px; height <- 32px;
        minimum <- 0; maximum <- 1; step <- 0.05; value <-> root.model-opacity;
    }
}
