struct FresnelFinish {
    unlit: bool, base-color: color, metalness: float, roughness: float, specular-amount: float,
    fresnel-power: float, fresnel-scale: float, fresnel-bias: float, fresnel-scale-bias-enabled: bool,
    clearcoat: float, clearcoat-roughness: float,
    clearcoat-fresnel-power: float, clearcoat-fresnel-scale: float, clearcoat-fresnel-bias: float,
    clearcoat-fresnel-scale-bias-enabled: bool,
}
struct FresnelActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float, visible: bool, material: FresnelFinish,
}
struct FresnelLight {
    kind: string, x: float, y: float, z: float, yaw: float, elevation: float,
    intensity: float, color: color, range: float, inner-angle: float, outer-angle: float,
}

export component FresnelDemo inherits Window {
    title: "XRack · Fresnel reflectance";
    width: 600px; height: 372px; background: #192330;

    in-out property <bool> base-controls = false;
    in-out property <bool> coat-controls = false;
    in-out property <float> base-power = 5.0;
    in-out property <float> coat-power = 5.0;
    in-out property <float> base-scale = 1.0;
    in-out property <float> coat-scale = 1.0;
    in-out property <float> base-bias = 0.30;
    in-out property <float> coat-bias = 0.30;
    in-out property <bool> curved = false;
    in-out property <bool> probe = false;
    in-out property <bool> floor = false;
    in-out property <bool> screen-reflections = false;

    property <FresnelFinish> flat: FresnelFinish {
        unlit: false, base-color: #111, metalness: 0.0, roughness: 0.62, specular-amount: 1.0,
        fresnel-power: 5, fresnel-scale: 1, fresnel-bias: 0, fresnel-scale-bias-enabled: false,
        clearcoat: 0, clearcoat-roughness: 0.62, clearcoat-fresnel-power: 5, clearcoat-fresnel-scale: 1,
        clearcoat-fresnel-bias: 0, clearcoat-fresnel-scale-bias-enabled: false,
    };
    property <FresnelActor> defaults: FresnelActor {
        id: "", mesh: "primitive:rectangle", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, camera-kind: "", camera-height: 4, visible: true, material: root.flat,
    };
    property <string> sample-mesh: root.curved ? "primitive:sphere" : "primitive:rectangle";
    property <FresnelFinish> base-finish: FresnelFinish {
        fresnel-power: root.base-power, fresnel-scale: root.base-scale, fresnel-bias: root.base-bias,
        fresnel-scale-bias-enabled: root.base-controls, ..root.flat
    };
    property <[FresnelActor]> world: [
        FresnelActor { id: "eye", mesh: "", camera-kind: "orthographic", z: 8, ..root.defaults },
        FresnelActor {
            id: "base", mesh: root.sample-mesh, x: -1.5, scale-x: 2.2, scale-y: 2.15, scale-z: 2.2,
            visible: !root.floor, material: root.base-finish, ..root.defaults
        },
        FresnelActor {
            id: "coat", mesh: root.sample-mesh, x: 1.5, scale-x: 2.2, scale-y: 2.15, scale-z: 2.2,
            visible: !root.floor,
            material: FresnelFinish {
                specular-amount: 0, clearcoat: 1, clearcoat-fresnel-power: root.coat-power,
                clearcoat-fresnel-scale: root.coat-scale, clearcoat-fresnel-bias: root.coat-bias,
                clearcoat-fresnel-scale-bias-enabled: root.coat-controls, ..root.flat
            }, ..root.defaults
        },
        FresnelActor {
            id: "floor", y: -0.5, pitch: -90, scale-x: 10, scale-y: 8,
            visible: root.floor, material: FresnelFinish {
                base-color: #c5cbd6, metalness: 1.0, roughness: 0.12, ..root.base-finish
            }, ..root.defaults
        },
        FresnelActor {
            id: "red", mesh: "primitive:box", x: -1.5, y: 0.45, z: -0.65,
            scale-x: 1.45, scale-y: 1.42, scale-z: 1.45, yaw: 15, visible: root.floor,
            material: FresnelFinish { unlit: true, base-color: #ff6545, ..root.flat }, ..root.defaults
        }
    ];
    property <[FresnelLight]> dark;
    property <[FresnelLight]> lights: root.probe || root.floor ? root.dark : [
        FresnelLight {
            kind: "directional", x: 0, y: 0, z: 0, yaw: 0, elevation: 0, intensity: 3,
            color: #fff, range: 1, inner-angle: 0, outer-angle: 20,
        }
    ];

    SceneView3D {
        width: 600px; height: 320px; model: root.world; camera: root.floor ? "" : "eye";
        camera-yaw: 0; camera-pitch: 26; camera-distance: 10;
        ambient-intensity: 0; lights: root.lights; shadows: false;
        environment: root.probe ? @environment-url("models/studio.hdr") : "";
        environment-intensity: 1.7; scene-background: #22334b;
        screen-space-reflections: root.screen-reflections;
        ssr-roughness-cutoff: 0.6; ssr-thickness: 0.26; ssr-steps: 128;
    }
    base-button := Button {
        x: 12px; y: 334px; width: 135px; height: 30px;
        text: root.base-controls ? "Base custom" : "Base Schlick";
        clicked => { root.base-controls = !root.base-controls; }
    }
    coat-button := Button {
        x: 160px; y: 334px; width: 135px; height: 30px;
        text: root.coat-controls ? "Coat custom" : "Coat Schlick";
        clicked => { root.coat-controls = !root.coat-controls; }
    }
    CheckBox { x: 312px; y: 334px; width: 118px; text: "Sphere"; checked <=> root.curved; }
    CheckBox { x: 447px; y: 334px; width: 140px; text: "Light probe"; checked <=> root.probe; }
}
