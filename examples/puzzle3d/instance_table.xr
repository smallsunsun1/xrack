struct SharedMaterial { base-color: color, roughness: float }
struct InstanceActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, parent: string, instance-of: string, instance-template: bool,
    visible: bool, pickable: bool, collidable: bool,
    instancing-lod-min: float, instancing-lod-max: float,
    camera-kind: string, camera-height: float, lod-of: string, lod-max-size: length,
    animation: string, animation-time: float, material: SharedMaterial,
}

export component InstanceTableDemo inherits Window {
    title <- "XRack · Authored instance table";
    width <- 640px; height <- 424px;
    background <- #1a2638;

    in-out property <float> shift: 0;
    in-out property <bool> distance-lod: false;
    in-out property <float> eye-distance: 8;
    in-out property <bool> culling: true;
    in-out property <bool> far: false;
    in-out property <bool> imported: false;
    in-out property <float> phase: 0;
    in-out property <color> left-color: #ed9768;
    in-out property <bool> left-pickable: true;
    property <InstanceActor> base: InstanceActor {
        id: "", mesh: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, parent: "", instance-of: "", instance-template: false,
        visible: true, pickable: true, collidable: true,
        instancing-lod-min: 0, instancing-lod-max: -1,
        camera-kind: "", camera-height: 4, lod-of: "", lod-max-size: 0px,
        animation: "", animation-time: 0, material: SharedMaterial { base-color: #fff, roughness: 0.8 },
    };
    property <[InstanceActor]> world <- [
        InstanceActor { id: "eye", z: root.eye-distance, camera-kind: "orthographic", camera-height: root.far ? 32 : 4, ..root.base },
        InstanceActor { id: "stage", y: root.shift, ..root.base },
        InstanceActor {
            id: "shape", mesh: root.imported ? @mesh-url("models/gpu-instances.gltf") : "primitive:box",
            instance-template: true, x: 0.0, animation: "Slide", animation-time: root.phase, ..root.base
        },
        InstanceActor { mesh: "primitive:sphere", lod-of: "shape", lod-max-size: 32px, visible: !root.imported, ..root.base },
        InstanceActor { id: "left", instance-of: "shape", parent: "stage", x: -1.3,
                        color: root.left-color, pickable: root.left-pickable,
                        instancing-lod-max: root.distance-lod ? 10 : -1, ..root.base },
        InstanceActor { id: "right", instance-of: "shape", parent: "stage", x: 1.3, color: #74bfe9, instancing-lod-min: root.distance-lod ? 10 : 0, ..root.base },
        InstanceActor { id: "remote", instance-of: "shape", x: 60, color: #74bfe9, ..root.base },
        InstanceActor { id: "dangling", instance-of: "missing", mesh: "primitive:box", ..root.base },
        InstanceActor { id: "cycle-a", instance-of: "cycle-b", ..root.base },
        InstanceActor { id: "cycle-b", instance-of: "cycle-a", ..root.base },
    ];
    out property <hit3d> left-hit <- Scene3D.hit-camera(
        root.world, "eye", Point2D.new(640px, 320px), Point2D.new(216px, 160px));
    out property <hit3d> right-hit <- Scene3D.hit-camera(
        root.world, "eye", Point2D.new(640px, 320px), Point2D.new(424px, 160px));
    out property <[int]> selected-rows <- Scene3D.pick-in-rect-camera(root.world, "eye",
        Point2D.new(640px, 320px), Point2D.new(0px, 0px), Point2D.new(640px, 320px));
    out property <string> center-hit <- Scene3D.pick-camera(
        root.world, "eye", Point2D.new(640px, 320px), Point2D.new(320px, 160px));
    SceneView3D {
        width <- 640px; height <- 320px; model <- root.world; camera <- "eye";
        scene-background <- #263b54; frustum-culling <- root.culling;
    }
    move-button := Button {
        x <- 12px; y <- 332px; width <- 142px; text <- "Move group";
        clicked => { root.shift = root.shift == 0.0 ? 1.0 : 0.0; }
    }
    far-toggle := CheckBox { x <- 172px; y <- 332px; width <- 155px; text <- "Far view"; checked <-> root.far; }
    imported-toggle := CheckBox { x <- 312px; y <- 332px; width <- 155px; text <- "Imported"; checked <-> root.imported; }
    phase-button := Button {
        x <- 489px; y <- 332px; width <- 135px; text <- "Play pose";
        clicked => { root.phase = root.phase == 0.0 ? 1.0 : 0.0; }
    }
    lod-toggle := CheckBox {
        x <- 12px; y <- 380px; width <- 184px; text <- "Distance LOD"; checked <-> root.distance-lod;
    }
    distance-slider := Slider {
        x <- 204px; y <- 380px; width <- 408px; minimum <- 6; maximum <- 14; value <-> root.eye-distance;
    }
}
