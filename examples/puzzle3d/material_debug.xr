struct ReflectionMap {
    data: texturedata2d, uv-offset-u: float, mag-filter: string, mip-filter: string,
}
struct ReflectionSky { enabled: bool, sky-top-color: color, sky-horizon-color: color, sun-energy: float }
struct ScalarMap {
    data: texturedata2d, uv-set: int, uv-offset-u: float, wrap-u: string,
    mag-filter: string, min-filter: string, mip-filter: string,
}
struct Style {
    base-color: color, roughness: float, metalness: float,
    metallic-roughness-map: texturedata2d, metalness-map: ScalarMap, roughness-map: texturedata2d,
    metalness-channel: string, roughness-channel: string,
    specular-reflection-map: ReflectionMap, specular-reflection-item: string,
    emissive-color: color, emissive-strength: float, occlusion-strength: float,
    clearcoat: float, clearcoat-roughness: float, alpha-mode: string,
    material-shader: string, shader-parameters: vector3d,
}
struct Actor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    camera-kind: string, camera-height: float,
    casts-shadow: bool, receives-shadow: bool, visible: bool,
    material: Style,
}
struct Lamp {
    kind: string, x: float, y: float, z: float, yaw: float, elevation: float,
    intensity: float, color: color, range: float, inner-angle: float, outer-angle: float,
    casts-shadow: bool,
}
struct Feed { name: string, camera: string }

export component MaterialDebugDemo inherits Window {
    title <- "XRack · 材质调试"; width <- 480px; height <- 416px;
    background <- #172437; resizable <- false;
    in-out property <int> mode: 0;
    in-out property <bool> effects: false;
    in-out property <bool> reference: false;
    in-out property <bool> glass: false;
    in-out property <bool> wireframe: false;
    in-out property <bool> material-reflection: false;
    in-out property <string> reflection-item: "";
    in-out property <bool> warm-reflection: true;
    in-out property <float> reflection-offset: 0.125;
    in-out property <bool> reflection-sky: false;
    in-out property <bool> use-packed-map: false;
    in-out property <bool> use-metalness-map: false;
    in-out property <bool> use-roughness-map: false;
    in-out property <bool> second-metalness-uv: false;
    in-out property <float> metalness-offset: 0;
    in-out property <string> metalness-channel: "b";
    in-out property <string> roughness-channel: "g";
    property <texturedata2d> empty-map;
    property <texturedata2d> reflection-colors <- TextureData2D.rgba8(4, 2, [
        230, 220, 35, 255, 224, 35, 21, 255, 30, 208, 82, 255, 34, 65, 235, 255,
        230, 220, 35, 255, 224, 35, 21, 255, 30, 208, 82, 255, 34, 65, 235, 255,
    ]);
    property <texturedata2d> packed-map <- TextureData2D.rgba8(1, 1, [0, 160, 80, 255]);
    property <texturedata2d> metal-map <- TextureData2D.rgba8(2, 1, [64, 0, 96, 255, 64, 0, 224, 255]);
    property <texturedata2d> matte-map <- TextureData2D.rgba8(1, 1, [32, 224, 0, 255]);
    property <[string]> modes: [
        "none", "base-color", "roughness", "metalness", "emission", "ambient-occlusion",
        "normals", "tangents", "binormals", "f0", "diffuse", "specular", "shadow-occlusion"
    ];

    property <Style> stock <- Style {
        base-color: #c08040,
        roughness: root.use-packed-map || root.use-roughness-map ? 0.5 : 0.25,
        metalness: root.use-packed-map || root.use-metalness-map ? 0.8 : 0,
        metallic-roughness-map: root.use-packed-map ? root.packed-map : root.empty-map,
        metalness-map: ScalarMap {
            data: root.use-metalness-map ? root.metal-map : root.empty-map,
            uv-set: root.second-metalness-uv ? 1 : 0, uv-offset-u: root.metalness-offset,
            wrap-u: "repeat", mag-filter: "nearest", min-filter: "nearest", mip-filter: "none",
        },
        roughness-map: root.use-roughness-map ? root.matte-map : root.empty-map,
        metalness-channel: root.metalness-channel, roughness-channel: root.roughness-channel,
        emissive-color: #000, emissive-strength: 1, occlusion-strength: 1,
        clearcoat: 0, clearcoat-roughness: 0.25, alpha-mode: "opaque",
        specular-reflection-map: ReflectionMap {
            data: root.empty-map, uv-offset-u: 0, mag-filter: "nearest", mip-filter: "none",
        },
        specular-reflection-item: "",
        material-shader: "", shader-parameters: Vector3D.new(0, 0, 0),
    };
    property <Actor> card <- Actor {
        id: "", mesh: "primitive:rectangle", x: 0, y: 0, z: 0,
        scale-x: 1.8, scale-y: 2.0, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, camera-kind: "", camera-height: 4, material: root.stock,
        casts-shadow: false, receives-shadow: true, visible: true,
    };

    view := SceneView3D {
        width <- 480px; height <- 250px; camera <- "eye"; cache-rendering <- true;
        scene-background <- #26354a; scene-tone-map <- none; ambient-intensity <- 0.28;
        material-debug <- Model.at(root.modes, root.mode, "none");
        environment-sky <- ReflectionSky {
            enabled: root.reflection-sky, sky-top-color: #375fb4, sky-horizon-color: #838caf, sun-energy: 0,
        };
        debug-wireframe <- root.wireframe;
        shadows <- true; shadow-map-size <- 256;
        bloom <- root.effects; bloom-strength <- 0.42; bloom-threshold <- 0.13;
        scene-exposure <- root.effects ? 1.8 : 1;
        temporal-aa <- root.effects; temporal-aa-mode <- "motion-vectors";
        ambient-occlusion <- true; ao-strength <- 1;
        scene-captures <- [Feed { name: "lit", camera: "eye" }];
        scene-color-capture <- root.reference ? "lit" : "";
        lights <- [Lamp {
            kind: "directional", x: 0, y: 0, z: 0, yaw: -35, elevation: 12,
            intensity: 1.7, color: #fff, range: 0, inner-angle: 18, outer-angle: 40,
            casts-shadow: true,
        }];
        model <- [
            Actor { id: "eye", mesh: "", z: 7, camera-kind: "orthographic", ..root.card },
            Actor {
                id: "stock", x: -1.4,
                material: Style {
                    specular-reflection-map: ReflectionMap {
                        data: root.material-reflection ? root.reflection-colors : root.empty-map,
                        uv-offset-u: root.reflection-offset,
                        ..root.stock.specular-reflection-map
                    },
                    specular-reflection-item: root.reflection-item,
                    ..root.stock
                }, ..root.card
            },
            Actor {
                id: "sphere", mesh: "primitive:sphere", y: 0.92,
                scale-x: 0.53, scale-y: 0.53, scale-z: 0.53,
                material: Style { base-color: #74c5c0, roughness: 0.35, ..root.stock },
                ..root.card
            },
            Actor {
                id: "custom", x: 1.4, yaw: -12,
                material: Style {
                    material-shader: @material-shader-url("effects/material_surface.wgsl"),
                    shader-parameters: Vector3D.new(1, 0, 0), clearcoat: 0.4,
                    ..root.stock
                },
                ..root.card
            },
            Actor {
                id: "occluder", mesh: "primitive:box", x: -1.88, y: 0.46, z: 0.42,
                scale-x: 0.38, scale-y: 0.52, scale-z: 0.22,
                casts-shadow: true, receives-shadow: false, ..root.card
            },
            Actor {
                id: "glass", visible: root.glass, mesh: "primitive:rectangle", x: -1.4, y: -0.53, z: 0.62,
                scale-x: 1.42, scale-y: 0.36, scale-z: 1,
                material: Style { base-color: #2a90e080, alpha-mode: "blend", ..root.stock },
                ..root.card
            },
        ];
    }

    mode-next := Button {
        x <- 12px; y <- 259px; width <- 108px; height <- 33px;
        text <- "下一视图"; clicked => { root.mode = (root.mode + 1) % 13; }
    }
    ComboBox {
        x <- 133px; y <- 259px; width <- 208px; height <- 33px;
        model <- root.modes; current-index <-> root.mode;
    }
    wireframe-toggle := CheckBox {
        x <- 356px; y <- 261px; width <- 104px; height <- 28px;
        text <- "线框"; checked <-> root.wireframe;
    }
    Label { x <- 12px; y <- 303px; width <- 155px; text <- "左 内建  ·  右 自定义"; }
    effects-toggle := CheckBox {
        x <- 190px; y <- 300px; width <- 91px; height <- 26px;
        text <- "后期效果"; checked <-> root.effects;
    }
    glass-toggle := CheckBox {
        x <- 291px; y <- 300px; width <- 91px; height <- 26px;
        text <- "透明面"; checked <-> root.glass;
    }
    metalness-toggle := CheckBox {
        x <- 12px; y <- 338px; width <- 132px; height <- 28px;
        text <- "金属度贴图"; checked <-> root.use-metalness-map;
    }
    roughness-toggle := CheckBox {
        x <- 153px; y <- 338px; width <- 132px; height <- 28px;
        text <- "粗糙度贴图"; checked <-> root.use-roughness-map;
    }
    Label { x <- 292px; y <- 338px; width <- 58px; height <- 28px; text <- "U 偏移"; }
    metalness-offset-control := Slider {
        x <- 354px; y <- 338px; width <- 112px; height <- 28px;
        minimum <- 0; maximum <- 1; step <- 0.05; value <-> root.metalness-offset;
    }
    Rectangle {
        x <- 0px; y <- 0px; width <- 64px; height <- 32px;
        texture-source <- "studio-swatch"; texture-only <- true;
        background <- root.warm-reflection ? #ea3d23 : #2958e8;
    }
    reflection-toggle := CheckBox {
        x <- 12px; y <- 380px; width <- 142px; height <- 28px;
        text <- "材质反射贴图"; checked <-> root.material-reflection;
    }
    reflection-source-toggle := Button {
        x <- 158px; y <- 380px; width <- 123px; height <- 28px; text <- "实时反射来源";
        clicked => { root.reflection-item = root.reflection-item == "" ? "studio-swatch" : ""; }
    }
    reflection-color-toggle := Button {
        x <- 287px; y <- 380px; width <- 84px; height <- 28px; text <- "切换色温";
        clicked => { root.warm-reflection = !root.warm-reflection; }
    }
    reflection-shift-toggle := Button {
        x <- 379px; y <- 380px; width <- 91px; height <- 28px; text <- "旋转贴图";
        clicked => { root.reflection-offset = root.reflection-offset == 0.125 ? 0.375 : 0.125; }
    }

}
