struct ContactActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color, visible: bool,
}

export component BodyContactsDemo inherits Window {
    title: "XRack · 刚体接触报告";
    width: 690px; height: 474px;
    resizable: false; background: #172638;

    property <physicsworld3d> world: Physics3D.new(Vector3D.new(0, 0, 0), 0.016);
    property <point3d> ball-start: Point3D.new(-2.7, 0.51, 0);
    property <point3d> wall-center: Point3D.new(0.32, 0.7, 0);
    property <vector3d> wall-size: Vector3D.new(0.24, 1.4, 1.7);
    property <physicscontact3d> no-contact;
    out property <int> ball: 0;
    out property <int> wall: 0;
    out property <int> ticks: 0;
    out property <int> reported: 0;
    out property <bool> reporting: true;
    out property <bool> events-enabled: true;
    out property <int> entered: 0;
    out property <int> exited: 0;
    out property <[int]> step-entered: Physics3D.contact-entered(root.world, root.ball);
    out property <[int]> step-exited: Physics3D.contact-exited(root.world, root.ball);
    out property <[int]> touching: Physics3D.contact-bodies(root.world, root.ball);
    in-out property <bool> running: false;
    out property <physicscontact3d> impact;
    out property <float> strength: root.impact.normal-impulse;
    out property <[physicscontact3d]> step-contacts: Physics3D.contacts(root.world, root.ball);
    out property <point3d> position: root.ball > 0 ? Physics3D.position(root.world, root.ball) : root.ball-start;

    callback enable-reports(enabled: bool);
    enable-reports(enabled) => {
        root.reporting = enabled;
        if root.wall > 0 {
            Physics3D.set-contact-reports(root.world, root.wall, enabled, false);
        }
    }
    callback enable-events(enabled: bool);
    enable-events(enabled) => {
        root.events-enabled = enabled;
        if root.ball > 0 {
            Physics3D.set-contact-events(root.world, root.ball, enabled);
        }
    }
    callback reset();
    reset() => {
        Physics3D.clear(root.world);
        root.wall = Physics3D.add-box(root.world, root.wall-center, root.wall-size, 0, 0.1, 0.6);
        root.ball = Physics3D.add-sphere(root.world, root.ball-start, 0.31, 1, 0.1, 0.6);
        root.enable-reports(root.reporting);
        Physics3D.set-contact-reports(root.world, root.ball, false, true);
        root.enable-events(root.events-enabled);
        root.entered = 0;
        root.exited = 0;
        root.ticks = 0;
        root.reported = 0;
        root.impact = root.no-contact;
        root.running = false;
    }
    callback launch();
    launch() => {
        root.reset();
        Physics3D.apply-impulse(root.world, root.ball, Vector3D.new(10, 0, 0));
    }
    callback collect(steps: int);
    collect(steps) => {
        if steps > 0 {
            root.ticks += steps;
            root.entered += Model.count(root.step-entered);
            root.exited += Model.count(root.step-exited);
            for contact in root.step-contacts {
                root.reported += 1;
                if contact.normal-impulse > root.strength { root.impact = contact; }
            }
            if root.position.x < -3.1 || root.ticks >= 56 { root.running = false; }
        }
    }
    callback advance();
    advance() => {
        if root.ball == 0 { root.reset(); }
        if Physics3D.step(root.world) { root.collect(1); }
    }
    callback advance-batch(elapsed: float, limit: int);
    advance-batch(elapsed, limit) => {
        if root.ball == 0 { root.reset(); }
        root.collect(Physics3D.advance(root.world, elapsed, limit));
    }
    clock := Timer {
        interval: 16; repeat: true; running: root.running;
        triggered => { root.advance(); }
    }

    pure function actor(id: string, mesh: string, position: point3d, scale: vector3d, tint: color, visible: bool) -> ContactActor {
        ContactActor {
            id: id, mesh: mesh, x: position.x, y: position.y, z: position.z,
            scale-x: scale.x, scale-y: scale.y, scale-z: scale.z,
            yaw: 0, pitch: 0, roll: 0, color: tint, visible: visible,
        }
    }
    property <[ContactActor]> actors: [
        root.actor("platform", "primitive:box", Point3D.new(-0.7, -0.12, 0), Vector3D.new(7.8, 0.24, 4), #395966, true),
        root.actor("lane", "primitive:box", Point3D.new(-1.4, 0.006, 0), Vector3D.new(3.3, 0.012, 0.035), #5c93a1, true),
        root.actor("wall", "primitive:box", root.wall-center, root.wall-size, #84acd1, true),
        root.actor("ball", "primitive:sphere", root.position, Vector3D.new(0.31, 0.31, 0.31), #ffb15d, true),
        root.actor("impact", "primitive:sphere", root.impact.position, Vector3D.new(0.12, 0.12, 0.12), #62efb4, root.impact.body > 0),
        root.actor("normal", "primitive:box",
            Point3D.new(root.impact.position.x + root.impact.normal.x * 0.32, root.impact.position.y, root.impact.position.z),
            Vector3D.new(0.64, 0.04, 0.04), #62efb4, root.impact.body > 0),
    ];
    SceneView3D {
        width: 690px; height: 400px; model: root.actors;
        camera-yaw: -22; camera-pitch: 30; camera-distance: 9.7;
        scene-background: #233d50; ambient-intensity: 0.42; multisampling: true;
    }
    contact-status := Text {
        x: 18px; y: 16px; color: root.reported > 0 ? #7befc4 : #e1edf4;
        text: "报告 " + root.reported + "   ·   最大法向冲量 " + Math.round(root.strength * 100) / 100.0 + "   ·   步数 " + root.ticks;
    }
    report-toggle := CheckBox {
        x: 530px; y: 7px; width: 140px; height: 32px;
        text: "接触报告"; checked: root.reporting;
        toggled => { root.enable-reports(!root.reporting); }
    }
    events-status := Text {
        x: 18px; y: 44px; color: #afc9db;
        text: "接触 " + root.entered + "   ·   分离 " + root.exited
            + "   ·   接触中 " + Model.count(root.touching);
    }
    events-toggle := CheckBox {
        x: 530px; y: 35px; width: 140px; height: 32px;
        text: "接触事件"; checked: root.events-enabled;
        toggled => { root.enable-events(!root.events-enabled); }
    }
    HorizontalLayout {
        x: 14px; y: 412px; width: 662px; height: 44px; spacing: 10px;
        fire-button := Button {
            width: 122px; text: "发射";
            clicked => { root.launch(); root.running = true; }
        }
        run-button := Button {
            width: 122px; text: root.running ? "暂停" : "运行";
            clicked => { root.running = !root.running; }
        }
        step-button := Button { width: 112px; text: "单步"; clicked => { root.advance(); } }
        batch-button := Button {
            width: 112px; text: "批量步进";
            clicked => { root.launch(); root.advance-batch(0.64, 40); }
        }
        reset-button := Button { width: 112px; text: "重置"; clicked => { root.reset(); } }
    }
}
