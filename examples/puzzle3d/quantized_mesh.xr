struct QuantizedWeights { bend: float }
struct QuantizedActor {
    id: string, mesh: string, morph-weights: QuantizedWeights,
    x: float, y: float, z: float, yaw: float, pitch: float, roll: float,
    scale-x: float, scale-y: float, scale-z: float, color: color,
    camera-kind: string, camera-height: float,
}
struct QuantizedLight {
    kind: string, x: float, y: float, z: float, yaw: float, elevation: float,
    color: color, intensity: float, range: float, inner-angle: float, outer-angle: float,
}

export component QuantizedMeshDemo inherits Window {
    title <- "XRack · Quantized glTF attributes";
    width <- 200px;
    height <- 144px;
    in-out property <bool> quantized: true;
    in-out property <float> weight: 0;
    property <QuantizedActor> defaults <- QuantizedActor {
        id: "", mesh: "", x: 0, y: 0, z: 0, yaw: 0, pitch: 0, roll: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, color: #fff, camera-kind: "", camera-height: 3,
        morph-weights: QuantizedWeights { bend: root.weight },
    };
    property <[QuantizedActor]> actors <- [
        QuantizedActor { id: "eye", z: 4, camera-kind: "orthographic", ..root.defaults },
        QuantizedActor {
            id: "cards", mesh: root.quantized
                ? @mesh-url("models/quantized-cards.gltf")
                : @mesh-url("models/float-cards.gltf"),
            ..root.defaults
        },
    ];
    out property <hit3d> picked <- Scene3D.ray-hit(
        root.actors, Point3D.new(1, 0, 4), Vector3D.new(0, 0, -1), 6);

    SceneView3D {
        width <- 200px; height <- 144px; camera <- "eye";
        scene-background <- #162034; scene-tone-map <- none; ambient-intensity <- 0.45;
        model <- root.actors;
        lights <- [QuantizedLight {
            kind: "directional", x: 0, y: 0, z: 0, yaw: 22, elevation: 30,
            color: #fff, intensity: 1.6, range: 0, inner-angle: 18, outer-angle: 40,
        }];
    }
}
