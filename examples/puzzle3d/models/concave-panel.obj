# A recessed backdrop and an eight-corner foreground, before triangulation.
mtllib wavefront/panel.mtl
o Panel
v -2 -1 0
v 2 -1 0
v 2 1 0
v -2 1 0
v -2 -1 1
v 2 -1 1
v 2 1 1
v 0.5 1 1
v 0.5 0 1
v -0.5 0 1
v -0.5 1 1
v -2 1 1
vt 0 0
vt 1 0
vt 1 1
vt 0.625 1
vt 0.625 0.5
vt 0.375 0.5
vt 0.375 1
vt 0 1
vn 0 0 1
usemtl Backdrop
f 1//1 2//1 3//1 4//1
usemtl Trim
s 1
f -8/1 -7/2 -6/3 -5/4 -4/5 -3/6 -2/7 -1/8
