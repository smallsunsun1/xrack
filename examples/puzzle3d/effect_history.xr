struct TrailActor {
    id: string, mesh: string, x: float, y: float, z: float,
    yaw: float, pitch: float, roll: float, color: color,
    scale-x: float, scale-y: float, scale-z: float,
}

struct HistoryInput { name: string, previous-frame: bool }

struct TrailPass {
    shader: string, output: string, history: bool, scale: float, strength: float,
    parameters: vector3d, buffers: [HistoryInput], output-format: string,
}

export component EffectHistoryDemo inherits Window {
    title: "XRack · 后处理反馈";
    width: 480px; height: 310px; resizable: false;
    background: #172332;

    in-out property <float> object-x: -1.4;
    in-out property <float> decay: 0.82;
    in-out property <int> history-revision: 0;
    in-out property <bool> animate-history: false;
    in-out property <bool> show-trail: true;
    in-out property <string> history-format: "rgba16f";
    in-out property <length> view-width: 480px;

    Rectangle { width: 480px; height: 242px; background: #24394e; }
    trail-view := SceneView3D {
        width: root.view-width; height: 242px;
        scene-background: #00000000;
        camera-yaw: 0; camera-pitch: 0; camera-distance: 6;
        cache-rendering: true;
        scene-hdr: true;
        scene-effect-history-revision: root.history-revision;
        scene-effect-animate: root.animate-history;
        model: [
            TrailActor {
                id: "core", mesh: "primitive:box", x: root.object-x, y: 0, z: 0,
                yaw: 14, pitch: 12, roll: 7, color: #ff8246,
                scale-x: 0.74, scale-y: 0.74, scale-z: 0.74,
            },
        ];
        scene-effects: [
            TrailPass {
                shader: @shader-url("effects/feedback.wgsl"),
                output: "trail", history: true, strength: root.show-trail ? 1 : 0, scale: 0.5,
                output-format: root.history-format,
                parameters: Vector3D.new(root.decay, 0, 0),
                buffers: [HistoryInput { previous-frame: true, name: "trail" }],
            },
        ];
    }
    move-core := Button {
        x: 14px; y: 258px; width: 98px; height: 35px; text: "移动方块";
        clicked => { root.object-x = root.object-x < 0 ? 1.4 : -1.4; }
    }
    reset := Button {
        x: 122px; y: 258px; width: 98px; height: 35px; text: "清除拖影";
        clicked => { root.history-revision += 1; }
    }
    playback := CheckBox {
        x: 231px; y: 258px; width: 103px; height: 35px;
        text: "连续衰减"; checked <=> root.animate-history;
    }
    decay-slider := Slider {
        x: 340px; y: 258px; width: 124px; height: 35px;
        minimum: 0.1; maximum: 0.98; step: 0.01; value <=> root.decay;
    }
}
