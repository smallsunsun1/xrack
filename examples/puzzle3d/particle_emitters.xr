struct SpatialEmitter {
    position: point3d, color: color, size: float, lifetime: float,
    burst-count: int, fade-out: float, seed: int,
    emitter-shape: string, emitter-extents: vector3d, emitter-fill: bool, emitter-roll: float,
    velocity: vector3d, velocity-spread: vector3d, velocity-mode: string, velocity-cone-angle: float,
    velocity-target: point3d,
}

struct EmitterCamera {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float,
}

export component ParticleEmittersDemo inherits Window {
    title: "XRack · 空间粒子发射";
    width: 670px; height: 466px;
    background: #182333;

    in-out property <string> shape: "box";
    in-out property <string> direction: "cone";
    in-out property <bool> filled: true;
    in-out property <float> angle: 28;
    in-out property <float> turn: 0;
    in-out property <float> time: 0.62;
    in-out property <int> population: 520;

    property <SpatialEmitter> defaults: SpatialEmitter {
        position: Point3D.new(-2.45, 0, 0), color: #50dbffff, size: 0.069, lifetime: 4,
        burst-count: root.population, fade-out: 0, seed: 37,
        emitter-shape: "point", emitter-extents: Vector3D.new(0, 0, 0),
        emitter-fill: true, emitter-roll: 0, velocity-mode: "vector", velocity-cone-angle: 0,
        velocity: Vector3D.new(0, 0, 0), velocity-spread: Vector3D.new(0, 0, 0),
        velocity-target: Point3D.new(2.20, 1.15, 0),
    };
    property <[SpatialEmitter]> emitters: [
        SpatialEmitter {
            position: Point3D.new(-0.35, -0.7, 0), color: #bbcade, size: 0.10, burst-count: 1,
            ..root.defaults
        },
        SpatialEmitter {
            emitter-shape: root.shape, emitter-extents: Vector3D.new(1.25, 0.84, 0.82),
            emitter-fill: root.filled, emitter-roll: root.turn, ..root.defaults
        },
        SpatialEmitter {
            color: #ff9e4fff, position: Point3D.new(2.2, -1.55, 0),
            emitter-shape: "cylinder", emitter-extents: Vector3D.new(0.52, 0.10, 0.52),
            velocity: Vector3D.new(0, 3.2, 0), velocity-spread: Vector3D.new(1.05, 0.20, 0.5),
            velocity-mode: root.direction, velocity-cone-angle: root.angle, seed: 48, ..root.defaults
        },
        SpatialEmitter {
            position: Point3D.new(2.2, 1.15, 0), color: #bbcade, size: 0.10, burst-count: 1,
            ..root.defaults
        },
    ];
    property <[EmitterCamera]> model: [
        EmitterCamera {
            id: "inspection", mesh: "", x: 0, y: 0, z: 9,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, camera-kind: "orthographic", camera-height: 6,
        },
    ];

    SceneView3D {
        width: 670px; height: 360px;
        camera: "inspection"; model: root.model;
        scene-background: #101925;
        particle-emitters: root.emitters; particle-time: root.time;
        order-independent-transparency: true; cache-rendering: true;
    }
    shape-toggle := Button {
        x: 14px; y: 372px; width: 96px; height: 35px;
        text: root.shape == "box" ? "盒体" : root.shape == "sphere" ? "球体" : "圆柱";
        clicked => { root.shape = root.shape == "box" ? "sphere" : root.shape == "sphere" ? "cylinder" : "box"; }
    }
    fill-toggle := CheckBox {
        x: 114px; y: 372px; width: 89px; height: 35px; text: "体积采样"; checked <=> root.filled;
    }
    Label { x: 216px; y: 372px; width: 46px; height: 35px; text: "旋转"; }
    turn-slider := Slider { x: 268px; y: 372px; width: 157px; height: 35px; minimum: 0; maximum: 180; value <=> root.turn; }
    mode-toggle := Button {
        x: 438px; y: 372px; width: 108px; height: 35px;
        text: root.direction == "cone" ? "锥形喷射" : root.direction == "target" ? "目标聚拢" : "向量扰动";
        clicked => {
            root.direction = root.direction == "cone" ? "target" : root.direction == "target" ? "normalized-vector" : "cone";
        }
    }
    Label { x: 14px; y: 421px; width: 49px; height: 32px; text: "时间"; }
    time-slider := Slider { x: 66px; y: 421px; width: 352px; height: 32px; minimum: 0; maximum: 1.3; value <=> root.time; }
    Label { x: 438px; y: 421px; width: 54px; height: 32px; text: "锥半角"; }
    angle-slider := Slider { x: 496px; y: 421px; width: 158px; height: 32px; minimum: 0; maximum: 75; value <=> root.angle; }
}
