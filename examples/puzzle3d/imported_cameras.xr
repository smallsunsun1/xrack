struct CameraActor {
    id: string, mesh: string, parent: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color, visible: bool,
    animation: string, animation-time: float,
}

export component ImportedCamerasDemo inherits Window {
    title: "XRack · glTF 相机";
    width: 480px;
    height: 296px;
    background: #141d29;

    in-out property <string> selected-camera: "rig/Hero";
    in-out property <float> time: 0;
    in-out property <bool> effects: false;
    in-out property <point2d> cursor: Point2D.new(240px, 120px);
    property <point2d> viewport-size: Point2D.new(480px, 240px);
    property <CameraActor> defaults: CameraActor {
        id: "", mesh: "", parent: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ffffff, visible: true, animation: "", animation-time: 0,
    };
    property <[CameraActor]> scene: [
        CameraActor { id: "mount", scale-y: 1.3, scale-z: 2, ..root.defaults },
        CameraActor {
            id: "rig", parent: "mount", mesh: @mesh-url("models/camera-rig.gltf"),
            animation: "Dolly", animation-time: root.time, ..root.defaults
        },
        CameraActor {
            id: "subject", mesh: "primitive:sphere", scale-x: 1.1, scale-y: 1.1, scale-z: 1.1,
            color: #eab244, ..root.defaults
        },
        CameraActor {
            id: "bar-item", mesh: "primitive:box", x: -5.0, scale-x: 2, scale-y: 1.2,
            color: #ef6d90, ..root.defaults
        },
        CameraActor {
            id: "right-item", mesh: "primitive:box", x: 1.4, y: 0.7, scale-x: 0.66, scale-y: 0.72,
            color: #a5d8b1, ..root.defaults
        },
        CameraActor {
            id: "far-item", mesh: "primitive:box", x: 32, z: -155,
            scale-x: 18, scale-y: 22, color: #4d8cff, ..root.defaults
        },
    ];
    out property <projectedpoint3d> projected: Scene3D.project-camera(root.scene, root.selected-camera,
        root.viewport-size, Point3D.new(2, 0, 0));
    out property <point3d> round-trip: Scene3D.unproject-camera(root.scene, root.selected-camera,
        root.viewport-size, root.projected.point, root.projected.depth, Point3D.new(0, 0, 0));
    out property <string> picked: Scene3D.pick-camera(root.scene, root.selected-camera, root.viewport-size, root.cursor);

    SceneView3D {
        width: 480px;
        height: 240px;
        model: root.scene;
        camera: root.selected-camera;
        scene-background: #172333;
        shadows: root.effects;
        shadow-cascades: 3;
        shadow-map-size: 128;
        depth-of-field: root.effects;
        dof-focus-distance: 6;
        dof-blur-radius: 10px;
        ambient-occlusion: root.effects;
    }
    HorizontalLayout {
        x: 10px; y: 246px; width: 460px; height: 42px; spacing: 8px;
        perspective := Button { width: 92px; text: "透视"; clicked => { root.selected-camera = "rig/Hero"; } }
        orthographic := Button { width: 92px; text: "正交"; clicked => { root.selected-camera = "rig/Map"; } }
        infinite := Button { width: 108px; text: "无限远"; clicked => { root.selected-camera = "rig/Far"; } }
        timeline := Slider { width: 130px; minimum: 0; maximum: 2; value <=> root.time; }
    }
}
