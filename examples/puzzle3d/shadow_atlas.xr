struct Actor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    casts-shadow: bool, receives-shadow: bool,
}
struct Lamp {
    kind: string, x: float, y: float, z: float,
    yaw: float, elevation: float, intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float, shadow-map-size: int,
    shadow-filter: string, shadow-radius: float, shadow-map-precision: string,
}

export component ShadowAtlasDemo inherits Window {
    title: "XRack · 阴影图分配";
    width: 408px; height: 352px; resizable: false; background: #182438;

    in-out property <bool> mixed: false;
    in-out property <bool> depth16: false;
    in-out property <bool> larger-green: false;
    in-out property <bool> point: false;
    in-out property <bool> shadows: true;
    in-out property <string> green-precision: "inherit";
    in-out property <string> blue-precision: "inherit";

    property <Actor> wall: Actor {
        id: "wall", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 8, scale-y: 4.4, scale-z: 0.1, yaw: 0, pitch: 0, roll: 0,
        color: #d4e1f0, casts-shadow: false, receives-shadow: true,
    };
    property <Lamp> red: Lamp {
        kind: "directional", x: -1, y: 1, z: 3, yaw: -44, elevation: 0,
        range: 0, inner-angle: 18, outer-angle: 44, color: #ff0000, intensity: 1.8,
        shadow-map-size: 0, shadow-filter: "pcf8", shadow-radius: 7, shadow-map-precision: "inherit",
    };
    view := SceneView3D {
        width: 408px; height: 216px;
        scene-background: #25354d; ambient-intensity: 0.08;
        camera-distance: 7.7; camera-pitch: 0; camera-yaw: 0;
        cache-rendering: true; shadows: root.shadows; shadow-map-size: 512;
        shadow-map-precision: root.depth16 ? "depth16" : "depth32";
        model: [
            root.wall,
            Actor {
                id: "left", x: -1.2, y: 0.15, z: 1.8,
                yaw: 12, scale-x: 0.74, scale-y: 1.65, scale-z: 0.32,
                color: #a6b9d4, casts-shadow: true, receives-shadow: false, ..root.wall
            },
            Actor {
                id: "right", x: 1.4, y: -0.18, z: 1.55,
                yaw: -13, scale-x: 0.94, scale-y: 1.24, scale-z: 0.38,
                color: #a6b9d4, casts-shadow: true, receives-shadow: false, ..root.wall
            },
        ];
        lights: [
            root.red,
            Lamp {
                yaw: 37, color: #00ff00,
                shadow-map-size: root.mixed ? (root.larger-green ? 256 : 128) : 0,
                shadow-map-precision: root.green-precision, ..root.red
            },
            Lamp {
                kind: root.point ? "point" : "directional",
                x: 0, y: 0.9, z: 3.9, yaw: 0, elevation: 36,
                color: #0000ff, intensity: root.point ? 24 : 1.6,
                shadow-map-size: root.mixed ? 128 : 0,
                shadow-map-precision: root.blue-precision,
                ..root.red
            },
        ];
    }

    mixed-toggle := CheckBox {
        x: 10px; y: 226px; width: 174px; height: 32px;
        text: "混合分辨率"; checked: root.mixed; toggled => { root.mixed = !root.mixed; }
    }
    precision-toggle := CheckBox {
        x: 206px; y: 226px; width: 188px; height: 32px;
        text: "16 位深度"; checked: root.depth16; toggled => { root.depth16 = !root.depth16; }
    }
    green-toggle := CheckBox {
        x: 10px; y: 266px; width: 174px; height: 32px;
        text: "绿灯 256 像素"; enabled: root.mixed; checked: root.larger-green;
        toggled => { root.larger-green = !root.larger-green; }
    }
    point-toggle := CheckBox {
        x: 206px; y: 266px; width: 188px; height: 32px;
        text: "蓝灯用点光"; checked: root.point; toggled => { root.point = !root.point; }
    }
    green-depth-toggle := CheckBox {
        x: 10px; y: 306px; width: 174px; height: 32px;
        text: "绿灯单独用 16 位"; checked: root.green-precision == "depth16";
        toggled => { root.green-precision = root.green-precision == "depth16" ? "inherit" : "depth16"; }
    }
    blue-depth-toggle := CheckBox {
        x: 206px; y: 306px; width: 188px; height: 32px;
        text: "蓝灯单独用 16 位"; checked: root.blue-precision == "depth16";
        toggled => { root.blue-precision = root.blue-precision == "depth16" ? "inherit" : "depth16"; }
    }
}
