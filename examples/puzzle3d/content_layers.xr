struct LayerActor {
    id: string, mesh: string, parent: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    layers: int, camera-kind: string, casts-shadow: bool,
}

struct LayerLight {
    kind: string, x: float, y: float, z: float,
    yaw: float, elevation: float, intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float, layers: int,
}

struct LayerProbe { source: string, position: point3d, box-size: vector3d, layers: int }

export component ContentLayersDemo inherits Window {
    title <- "XRack · 多视口内容层";
    width <- 552px;
    height <- 310px;
    resizable <- false;
    background <- #141d29;
    in-out property <int> mask: 1;
    in-out property <float> hidden-x: -2.0;
    in-out property <bool> culling: true;
    in-out property <point2d> pointer: Point2D.new(128px, 110px);
    property <point2d> viewport <- Point2D.new(256px, 220px);
    property <point3d> ray-origin <- Point3D.new(0, 0, 8);
    property <vector3d> ray-direction <- Vector3D.new(0, 0, -1);

    property <LayerActor> plain: LayerActor {
        id: "", mesh: "primitive:box", parent: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ffffff, layers: 1, camera-kind: "", casts-shadow: true,
    };
    property <[LayerActor]> world <- [
        LayerActor { id: "origin", mesh: "", layers: 1, ..root.plain },
        LayerActor { id: "map-eye", mesh: "", z: 8, layers: 2, camera-kind: "perspective", ..root.plain },
        LayerActor {
            id: "platform", y: -1.05, scale-x: 7.8, scale-y: 0.15, scale-z: 4.6,
            color: #778da7, layers: 3, ..root.plain
        },
        LayerActor {
            id: "marker", mesh: "primitive:sphere", color: #efad52,
            scale-x: 0.88, scale-y: 0.88, scale-z: 0.88, layers: 1, ..root.plain
        },
        LayerActor {
            id: "objective", z: 1.5, parent: "origin", color: #85caff, roll: 16,
            scale-x: 0.78, scale-y: 0.78, scale-z: 0.78, layers: 2, ..root.plain
        },
        LayerActor {
            id: "mirror", mesh: @mesh-url("models/probe-sphere.gltf"), x: 2.36,
            scale-x: 0.69, scale-y: 0.69, scale-z: 0.69, layers: 3, ..root.plain
        },
        LayerActor {
            id: "hidden-caster", x: root.hidden-x, y: 0.8, z: 0.2,
            color: #df79a9, scale-y: 1.4, layers: 4, ..root.plain
        },
        LayerActor {
            id: "offscreen", x: 20, casts-shadow: false, layers: 1, ..root.plain
        },
    ];
    property <LayerLight> daylight: LayerLight {
        kind: "directional", x: 0, y: 0, z: 0,
        yaw: -35, elevation: 60, intensity: 2.3, color: #ffe0be,
        range: 12, inner-angle: 0, outer-angle: 44, layers: 1,
    };
    property <[LayerLight]> lights <- [
        root.daylight,
        LayerLight { color: #c5e3ff, yaw: 32, layers: 2, ..root.daylight },
    ];
    property <[LayerProbe]> probes <- [
        LayerProbe { source: @environment-url("models/probe-amber.hdr"),
            position: Point3D.new(2.36, 0, 0), box-size: Vector3D.new(4, 4, 4), layers: 1 },
        LayerProbe { source: @environment-url("models/probe-blue.hdr"),
            position: Point3D.new(2.36, 0, 0), box-size: Vector3D.new(4, 4, 4), layers: 2 },
    ];

    out property <string> picked <- Scene3D.pick(root.world, 0, 0, 8, root.viewport, root.pointer, root.mask);
    out property <hit3d> hit <- Scene3D.hit(root.world, 0, 0, 8, root.viewport, root.pointer, root.mask);
    out property <[hit3d]> hits <- Scene3D.hit-all(root.world, 0, 0, 8, root.viewport, root.pointer, root.mask);
    out property <string> map-picked <- Scene3D.pick-camera(root.world, "map-eye", root.viewport, root.pointer);
    out property <hit3d> map-hit <- Scene3D.hit-camera(root.world, "map-eye", root.viewport, root.pointer);
    out property <[hit3d]> map-hits <- Scene3D.hit-all-camera(root.world, "map-eye", root.viewport, root.pointer, root.mask);
    out property <hit3d> ray-hit <- Scene3D.ray-hit(root.world, root.ray-origin, root.ray-direction, 30, root.mask);
    out property <[hit3d]> ray-hits <- Scene3D.ray-hit-all(root.world, root.ray-origin, root.ray-direction, 30, root.mask);

    Text { x <- 12px; y <- 5px; text <- "主视口 · " + root.picked; color <- #e2eaf4; }
    Text { x <- 284px; y <- 5px; text <- "第二视口 · " + root.map-picked; color <- #e2eaf4; }
    main := SceneView3D {
        x <- 12px; y <- 32px; width <- 256px; height <- 220px;
        model <- root.world; lights <- root.lights; reflection-probes <- root.probes;
        layer-mask <- root.mask; frustum-culling <- root.culling;
        camera-yaw <- 0; camera-pitch <- 0; camera-distance <- 8;
        shadows <- true; shadow-map-size <- 512; shadow-bias <- 0.009;
        scene-hdr <- true; scene-background <- #26364d;
    }
    main-pointer := TouchArea {
        x <- 12px; y <- 32px; width <- 256px; height <- 220px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.inside { root.pointer = Point2D.new(event.x, event.y); }
        }
    }
    overview := SceneView3D {
        x <- 284px; y <- 32px; width <- 256px; height <- 220px;
        model <- root.world; lights <- root.lights; reflection-probes <- root.probes;
        camera <- "map-eye";
        shadows <- true; shadow-map-size <- 512; shadow-bias <- 0.009;
        scene-hdr <- true; scene-background <- #26364d;
    }
    HorizontalLayout {
        x <- 12px; y <- 260px; width <- 528px; height <- 42px; spacing <- 8px;
        first := Button { text <- "主层"; width <- 104px; clicked => { root.mask = 1; } }
        second := Button { text <- "目标层"; width <- 116px; clicked => { root.mask = 2; } }
        combined := Button { text <- "全部层"; width <- 116px; clicked => { root.mask = -1; } }
        empty := Button { text <- "清空视口"; width <- 120px; clicked => { root.mask = 0; } }
    }
}

struct CombinedCollider { shape: string, position: point3d, size: vector3d, mesh: string }
struct CombinedActor {
    id: string, mesh: string, parent: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float,
    visible: bool, physics-body: string, lod-of: string, lod-max-size: length, collision-shapes: [CombinedCollider],
}

export component CombinedSceneDemo inherits Window {
    title <- "XRack · 共享场景与局部模型";
    width <- 520px; height <- 308px; background <- #141d29;
    in-out property <bool> show-extra: true;

    property <CombinedActor> unit: CombinedActor {
        id: "", mesh: "primitive:box", parent: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ffffff, camera-kind: "", camera-height: 4,
        visible: true, physics-body: "", lod-of: "", lod-max-size: 0px, collision-shapes: [],
    };
    property <CombinedActor> eye <- CombinedActor {
        mesh: "", z: 8, camera-kind: "orthographic", ..root.unit
    };
    property <scenemodel3d> shared <- Scene3D.prepare([
        CombinedActor { id: "shared-eye", ..root.eye },
        CombinedActor { id: "hidden", visible: false, ..root.unit },
        CombinedActor { id: "pivot", mesh: "", x: -1.25, ..root.unit },
        CombinedActor {
            id: "landmark", parent: "pivot", mesh: "primitive:sphere", color: #f3bd5c, ..root.unit
        },
        CombinedActor { lod-of: "landmark", lod-max-size: 200px, ..root.unit },
    ]);
    property <scenemodel3d> left-local <- Scene3D.prepare([
        CombinedActor { id: "left-eye", ..root.eye },
        CombinedActor { id: "pivot", mesh: "", x: 1.25, yaw: -90, ..root.unit },
        CombinedActor { id: "left-token", parent: "pivot", color: #e87c98, ..root.unit },
    ]);
    property <scenemodel3d> right-local <- Scene3D.prepare([
        CombinedActor { id: "right-eye", ..root.eye },
        CombinedActor { id: "pivot", mesh: "", x: 1.25, yaw: 90, ..root.unit },
        CombinedActor {
            id: "right-token", parent: "pivot", color: #77cadd, visible: root.show-extra,
            physics-body: "right-body",
            collision-shapes: [CombinedCollider {
                shape: "box", position: Point3D.new(0, 0, 0),
                size: Vector3D.new(0.3, 0.3, 0.3), mesh: "",
            }],
            ..root.unit
        },
    ]);
    out property <scenemodel3d> left-scene <- Scene3D.combine(root.shared, root.left-local);
    out property <scenemodel3d> right-scene <- Scene3D.combine(root.shared, root.right-local);
    property <vector3d> forward <- Vector3D.new(0, 0, -1);
    property <point3d> local-ray <- Point3D.new(1.25, 0, 5);
    out property <hit3d> left-hit <- left.ray-hit(root.local-ray, root.forward, 10);
    out property <hit3d> right-hit <- right.ray-hit(root.local-ray, root.forward, 10);
    out property <hit3d> shared-hit <- right.ray-hit(Point3D.new(-1.25, 0, 5), root.forward, 10);
    out property <hit3d> right-contact <- Scene3D.sphere-cast(
        root.right-scene, root.local-ray, root.forward, 10, 0.04);
    out property <vector3d> right-axis <- Scene3D.map-direction(
        root.right-scene, "right-token", "", Vector3D.new(1, 0, 0), Vector3D.new(0, 0, 0));

    Text { x <- 12px; y <- 8px; text <- "共享地标 + 左侧模型"; color <- #e2eaf4; }
    Text { x <- 268px; y <- 8px; text <- "共享地标 + 右侧模型"; color <- #e2eaf4; }
    left := SceneView3D {
        x <- 12px; y <- 36px; width <- 240px; height <- 220px;
        scene-background <- #26364d; camera <- "left-eye";
        model <- root.left-scene; cache-rendering <- true;
    }
    right := SceneView3D {
        x <- 268px; y <- 36px; width <- 240px; height <- 220px;
        scene-background <- #26364d; camera <- "right-eye";
        model <- root.right-scene; cache-rendering <- true;
    }
    CheckBox {
        x <- 268px; y <- 264px; width <- 208px; height <- 34px;
        text <- "显示右侧局部模型"; checked <-> root.show-extra;
    }
}
