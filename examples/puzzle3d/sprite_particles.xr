struct ParticleBurst { time: float, count: int }

struct SpriteEmitter {
    position: point3d, color: color, size: float, lifetime: float,
    bursts: [ParticleBurst], sprite: image, sprite-frames: int,
    sprite-duration: float, sprite-duration-variation: float,
    sprite-playback: string, sprite-interpolate: bool, sprite-random-start: bool,
    velocity: vector3d, velocity-spread: vector3d, gravity: vector3d,
    start-time: float, seed: int,
}

export component SpriteParticlesDemo inherits Window {
    title: "XRack · 粒子序列帧";
    width: 620px;
    height: 416px;
    background: #182333;

    in-out property <float> time = 0.10;
    in-out property <float> epoch = 0.0;
    in-out property <string> playback = "loop";
    in-out property <bool> interpolate-frames = false;
    in-out property <bool> random-start = true;
    in-out property <bool> weighted = true;
    in-out property <bool> animating = false;
    in-out property <int> cells = 4;

    clock := Timer {
        interval: 16;
        running: root.animating;
        triggered => {
            root.time += 0.016;
            if root.time - root.epoch > 4.2 { root.epoch = root.time; }
        }
    }

    property <SpriteEmitter> defaults: SpriteEmitter {
        position: Point3D.new(0, 0, 0), color: #ffffff, size: 1.45, lifetime: 4,
        bursts: [ParticleBurst { time: 0, count: 1 }], sprite: @image-url("models/particle-marks.png"), sprite-frames: root.cells,
        sprite-duration: 1.2, sprite-duration-variation: 0,
        sprite-playback: root.playback, sprite-interpolate: root.interpolate-frames,
        sprite-random-start: false, velocity: Vector3D.new(0,0,0), velocity-spread: Vector3D.new(0,0,0),
        gravity: Vector3D.new(0,0,0), start-time: root.epoch, seed: 57,
    };
    property <[SpriteEmitter]> emitters: [
        SpriteEmitter { position: Point3D.new(-1.9, 0, 0), ..root.defaults },
        SpriteEmitter {
            sprite: @image-url("models/particle-ring.png"), sprite-frames: 1,
            size: 1.55, ..root.defaults
        },
        SpriteEmitter {
            position: Point3D.new(1.9, -0.65, 0.3), size: 0.30, bursts: [ParticleBurst { time: 0, count: 44 }],
            sprite-random-start: root.random-start, sprite-duration-variation: 0.20,
            velocity: Vector3D.new(0, 1.75, 0), velocity-spread: Vector3D.new(1.35, 0.85, 0.6),
            gravity: Vector3D.new(0, -2.25, 0), ..root.defaults
        },
    ];

    SceneView3D {
        width: 620px; height: 320px;
        camera-yaw: 0; camera-pitch: 0; camera-distance: 7;
        scene-background: #111a29;
        particle-time: root.time; particle-emitters: root.emitters;
        cache-rendering: true;
        order-independent-transparency: root.weighted;
    }
    Label { x: 18px; y: 327px; width: 60px; height: 34px; text: "时间"; }
    timeline := Slider { x: 72px; y: 328px; width: 531px; height: 34px; minimum: 0; maximum: 3.6; value <=> root.time; }
    play := CheckBox { x: 18px; y: 369px; width: 79px; height: 35px; text: "播放"; checked <=> root.animating; }
    restart := Button {
        x: 105px; y: 369px; width: 75px; height: 35px; text: "爆发";
        clicked => { root.epoch = root.time - 0.35; }
    }
    playback-mode := Button {
        x: 189px; y: 369px; width: 98px; height: 35px;
        text: root.playback == "loop" ? "循环" : root.playback == "reverse" ? "倒放" : "往返";
        clicked => {
            root.playback = root.playback == "loop" ? "reverse" : root.playback == "reverse" ? "ping-pong" : "loop";
        }
    }
    interpolation := CheckBox { x: 306px; y: 369px; width: 86px; height: 35px; text: "插值"; checked <=> root.interpolate-frames; }
    randomness := CheckBox { x: 410px; y: 369px; width: 105px; height: 35px; text: "随机起帧"; checked <=> root.random-start; }
    transparency := CheckBox { x: 529px; y: 369px; width: 82px; height: 35px; text: "加权"; checked <=> root.weighted; }
}

struct BirthEmitter {
    position: point3d, color: color, size: float, lifetime: float, fade-out: float,
    lifetime-variation: float, size-variation: float, end-size-variation: float,
    bursts: [ParticleBurst], seed: int,
    emitter-shape: string, emitter-extents: vector3d,
    sprite: image, sprite-frames: int, sprite-playback: string,
    velocity: vector3d, velocity-spread: vector3d,
    trail-segments: int, trail-duration: float, trail-eol-fade: float,
    particle-model: string, particle-casts-shadow: bool,
    particle-angular-velocity-variation: vector3d,
}

struct BirthCamera {
    id: string, mesh: string, color: color,
    x: float, y: float, z: float, yaw: float, pitch: float, roll: float,
    scale-x: float, scale-y: float, scale-z: float, camera-kind: string, camera-height: float,
}

export component ParticleBirthVariationsDemo inherits Window {
    title: "XRack · 粒子出生变体";
    width: 624px; height: 414px; background: #182333;

    in-out property <float> time = 0.65;
    in-out property <int> seed = 5;
    in-out property <int> population = 24;
    in-out property <float> lifetime-spread = 0.75;
    in-out property <float> size-spread = 0.36;
    in-out property <float> end-spread = 0.33;
    in-out property <float> spin-spread = 115;
    in-out property <bool> variant = true;
    in-out property <bool> trail = false;
    in-out property <bool> textured = true;
    in-out property <bool> model-particles = false;
    property <image> empty-image;
    property <BirthEmitter> baseline: BirthEmitter {
        position: Point3D.new(-1.5, 0, 0.4), color: root.textured ? #ffffff : #ff46d9,
        size: 0.45, lifetime: 1, fade-out: 0,
        lifetime-variation: 0, size-variation: 0, end-size-variation: 0,
        bursts: [ParticleBurst { time: 0, count: root.population }], seed: root.seed,
        emitter-shape: root.population > 1 ? "box" : "point", emitter-extents: Vector3D.new(0.85, 0.65, 0),
        sprite: root.textured ? @image-url("models/particle-marks.png") : root.empty-image,
        sprite-frames: 4, sprite-playback: "once",
        velocity: root.trail ? Vector3D.new(0.0, 0.9, 0) : Vector3D.new(0, 0, 0),
        velocity-spread: root.population > 1 ? Vector3D.new(0.36, 0.36, 0) : Vector3D.new(0, 0, 0),
        trail-segments: root.trail ? 8 : 0, trail-duration: 0.25, trail-eol-fade: 0.25,
        particle-model: root.model-particles ? "primitive:box" : "", particle-casts-shadow: root.model-particles,
        particle-angular-velocity-variation: Vector3D.new(0, 0, 0),
    };
    property <BirthCamera> eye: BirthCamera {
        id: "eye", mesh: "", color: #fff, x: 0, y: 0, z: 9, yaw: 0, pitch: 0, roll: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, camera-kind: "orthographic", camera-height: 6,
    };
    SceneView3D {
        width: 624px; height: 300px; camera: "eye"; scene-background: #101925;
        model: [
            root.eye,
            BirthCamera {
                id: "floor", mesh: root.model-particles ? "primitive:box" : "",
                color: #445774, z: 0, y: -1.65, scale-x: 10, scale-z: 4, scale-y: 0.2,
                camera-kind: "", ..root.eye
            },
        ];
        shadows: root.model-particles; shadow-map-size: 128;
        particle-time: root.time;
        particle-emitters: [
            root.baseline,
            BirthEmitter {
                position: Point3D.new(1.5, 0, 0.4),
                lifetime-variation: root.variant ? root.lifetime-spread : 0,
                size-variation: root.variant ? root.size-spread : 0,
                end-size-variation: root.variant ? root.end-spread : 0,
                particle-angular-velocity-variation: Vector3D.new(
                    0, 0, root.variant ? root.spin-spread : 0),
                ..root.baseline
            },
        ];
    }
    Label { x: 18px; y: 18px; width: 176px; height: 28px; text: "固定参数"; color: #cce2f2; }
    Label { x: 329px; y: 18px; width: 176px; height: 28px; text: "每颗粒子的出生变体"; color: #cce2f2; }
    Label { x: 18px; y: 310px; width: 58px; height: 32px; text: "时间"; }
    timeline := Slider {
        x: 78px; y: 310px; width: 528px; height: 32px;
        minimum: 0; maximum: 2.1; value <=> root.time;
    }
    variations := CheckBox { x: 18px; y: 363px; width: 103px; text: "变体"; checked <=> root.variant; }
    trails := CheckBox { x: 132px; y: 363px; width: 103px; text: "拖尾"; checked <=> root.trail; }
    texture := CheckBox { x: 246px; y: 363px; width: 105px; text: "序列帧"; checked <=> root.textured; }
    meshes := CheckBox { x: 362px; y: 363px; width: 105px; text: "模型"; checked <=> root.model-particles; }
    reseed := Button {
        x: 476px; y: 361px; width: 128px; height: 34px; text: "更换种子";
        clicked => { root.seed += 1; }
    }
}
