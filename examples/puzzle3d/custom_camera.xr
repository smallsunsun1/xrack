struct CameraMatrix {
    m11: float, m12: float, m13: float, m14: float,
    m21: float, m22: float, m23: float, m24: float,
    m31: float, m32: float, m33: float, m34: float,
    m41: float, m42: float, m43: float, m44: float,
}
struct CameraMaterial { unlit: bool, metalness: float, roughness: float, cull-mode: string }
struct CameraActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    camera-kind: string, camera-clip-space: string, camera-projection: CameraMatrix,
    camera-reverse-depth: bool,
    material: CameraMaterial,
}

export component CustomCameraDemo inherits Window {
    title: "XRack · 自定义投影";
    width: 432px; height: 330px; resizable: false;
    background: #152131;
    in-out property <float> skew: 0.35;
    in-out property <bool> parallel: false;
    in-out property <bool> opengl: false;
    in-out property <bool> reversed: false;
    in-out property <bool> device-reversed: false;
    in-out property <bool> mirrored: false;
    in-out property <bool> effects: true;
    in-out property <bool> geometry-culling: true;
    in-out property <bool> msaa: false;
    property <point2d> viewport: Point2D.new(432px, 272px);

    property <CameraMatrix> perspective: CameraMatrix {
        m11: 1.44, m12: root.skew, m13: 0.06, m14: 0.12,
        m21: 0.12, m22: 1.6, m23: -0.02, m24: 0.08,
        m31: 0.01, m32: -0.02, m33: -1.25, m34: -1.25,
        m41: 0.045, m42: -0.035, m43: -1, m44: 0,
    };
    property <CameraMatrix> affine: CameraMatrix {
        m11: 0.48, m12: root.skew * 0.45, m13: 0.18, m14: 0.15,
        m21: 0.0, m22: 0.6, m23: -0.13, m24: -0.25,
        m31: 0, m32: 0, m33: -0.25, m34: -0.25,
        m41: 0, m42: 0, m43: 0, m44: 1,
    };
    property <CameraMatrix> direct-matrix: root.parallel ? root.affine : root.perspective;
    property <CameraMatrix> native-matrix: !root.mirrored ? root.direct-matrix : CameraMatrix {
        m11: -root.direct-matrix.m11, m12: -root.direct-matrix.m12,
        m13: -root.direct-matrix.m13, m14: -root.direct-matrix.m14,
        ..root.direct-matrix
    };
    property <CameraMatrix> ordered: !root.reversed ? root.native-matrix : CameraMatrix {
        m31: root.native-matrix.m41 - root.native-matrix.m31,
        m32: root.native-matrix.m42 - root.native-matrix.m32,
        m33: root.native-matrix.m43 - root.native-matrix.m33,
        m34: root.native-matrix.m44 - root.native-matrix.m34,
        ..root.native-matrix
    };
    property <CameraMatrix> matrix: !root.opengl ? root.ordered : CameraMatrix {
        m31: root.ordered.m31 * 2 - root.ordered.m41,
        m32: root.ordered.m32 * 2 - root.ordered.m42,
        m33: root.ordered.m33 * 2 - root.ordered.m43,
        m34: root.ordered.m34 * 2 - root.ordered.m44,
        ..root.ordered
    };

    property <CameraActor> base: CameraActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, camera-kind: "", camera-clip-space: "", camera-projection: root.matrix,
        camera-reverse-depth: root.device-reversed,
        material: CameraMaterial { unlit: false, metalness: 0.1, roughness: 0.32, cull-mode: "back" },
    };
    property <scenemodel3d> scene: Scene3D.prepare([
        CameraActor { id: "eye", mesh: "", z: 8, camera-kind: "custom",
            camera-clip-space: root.opengl ? "opengl" : "webgpu", ..root.base },
        CameraActor { id: "peach", mesh: "primitive:rectangle", x: -0.92, y: 0.52, z: 5.15,
            scale-x: -0.72, scale-y: 0.92, color: #f9a55c, ..root.base },
        CameraActor { id: "cyan", mesh: "primitive:sphere", x: 0.9, y: 0.5, z: 5,
            scale-x: 0.76, scale-y: 0.86, scale-z: 0.72, color: #6ae0dc, ..root.base },
        CameraActor { id: "floor", y: -0.52, z: 4.95,
            scale-x: 5.6, scale-y: 0.16, scale-z: 4.4, color: #4b5d70,
            material: CameraMaterial { unlit: false, metalness: 0.72, roughness: 0.23, cull-mode: "back" },
            ..root.base },
        CameraActor { id: "beyond", x: 0.9, y: 0.5, z: 1, color: #a87bff, ..root.base },
    ]);
    out property <projectedpoint3d> projected: Scene3D.project-camera(
        root.scene, "eye", root.viewport, Point3D.new(0.9, 0.5, 5));
    out property <point3d> restored: Scene3D.unproject-camera(
        root.scene, "eye", root.viewport, root.projected.point, root.projected.depth, Point3D.new(99, 99, 99));
    out property <string> picked: Scene3D.pick-camera(root.scene, "eye", root.viewport, root.projected.point);
    out property <projectedpoint3d> panel-projection: Scene3D.project-camera(
        root.scene, "eye", root.viewport, Point3D.new(-0.92, 0.52, 5.15));
    out property <string> panel-picked: Scene3D.pick-camera(
        root.scene, "eye", root.viewport, root.panel-projection.point);

    SceneView3D {
        width: root.viewport.x; height: root.viewport.y; model: root.scene; camera: "eye";
        frustum-culling: root.geometry-culling; multisampling: root.msaa;
        scene-background: #23384e; ambient-intensity: 0.32;
        ambient-occlusion: root.effects; ao-strength: 0.45;
        screen-space-reflections: root.effects; ssr-scale: 0.5;
        screen-space-global-illumination: root.effects; ssgi-occlusion: 0;
        depth-of-field: root.effects; dof-focus-distance: 3; dof-blur-radius: 4px;
    }
    HorizontalLayout {
        x: 12px; y: 282px; width: 408px; height: 34px; spacing: 8px;
        projection-switch := Button {
            text: root.parallel ? "平行剪切" : "非对称透视";
            clicked => { root.parallel = !root.parallel; }
        }
        skew-switch := Button {
            text: "切换斜切";
            clicked => { root.skew = root.skew > 0 ? -0.35 : 0.35; }
        }
        mirror-switch := CheckBox { text: "镜像"; checked <=> root.mirrored; }
        effects-switch := CheckBox { text: "特效"; checked <=> root.effects; }
    }
}
