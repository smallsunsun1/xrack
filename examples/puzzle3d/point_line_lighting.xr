struct PointLineActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float,
}

struct PointLineLight {
    kind: string, x: float, y: float, z: float, yaw: float, elevation: float,
    color: color, intensity: float, range: float, inner-angle: float, outer-angle: float,
}

export component PointLineLightingDemo inherits Window {
    title <- "XRack · glTF point and line lighting";
    width <- 160px;
    height <- 120px;
    in-out property <bool> light-on: false;
    in-out property <bool> side-light: false;
    property <PointLineActor> defaults: PointLineActor {
        id: "", mesh: "", x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #fff, camera-kind: "", camera-height: 3,
    };

    SceneView3D {
        width <- 160px;
        height <- 120px;
        camera <- "eye";
        scene-background <- #0c1420;
        scene-tone-map <- none;
        ambient-intensity <- 0;
        model <- [
            PointLineActor { id: "eye", z: 4, camera-kind: "orthographic", ..root.defaults },
            PointLineActor { id: "asset", mesh: @mesh-url("models/point-line-lighting.gltf"), ..root.defaults },
        ];
        lights <- [PointLineLight {
            kind: "directional", x: 0, y: 0, z: 0, yaw: root.side-light ? 90 : 0, elevation: 0,
            color: #fff, intensity: root.light-on ? 4 : 0, range: 0, inner-angle: 18, outer-angle: 40,
        }];
    }
}
