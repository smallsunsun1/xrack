struct DispersionObject {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color, visible: bool,
    camera-kind: string, camera-height: float,
}

struct DispersionLamp {
    kind: string, x: float, y: float, z: float,
    yaw: float, elevation: float,
    intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float,
}

export component DispersionDemo inherits Window {
    title: "XRack · 体积色散";
    width: 460px;
    height: 278px;
    background: #141d29;

    in-out property <bool> dispersed: true;
    in-out property <bool> show-glass: true;
    in-out property <bool> msaa: false;
    in-out property <float> yaw: 32;
    property <DispersionObject> defaults: DispersionObject {
        id: "", mesh: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff, visible: true,
        camera-kind: "", camera-height: 5.6,
    };
    property <[DispersionObject]> scene: [
        DispersionObject {
            id: "stripes", mesh: @mesh-url("models/dispersion-stripes.gltf"),
            z: -4, scale-x: 5.1, scale-y: 2.3, ..root.defaults
        },
        DispersionObject {
            id: "glass",
            mesh: root.dispersed ? @mesh-url("models/dispersion-block.gltf") : @mesh-url("models/dispersion-off.gltf"),
            yaw: root.yaw, visible: root.show-glass, ..root.defaults
        },
        DispersionObject {
            id: "eye", z: 9, camera-kind: "orthographic", ..root.defaults
        },
    ];
    property <[DispersionLamp]> lamps;

    SceneView3D {
        width: 460px;
        height: 224px;
        model: root.scene;
        camera: "eye";
        lights: root.lamps;
        ambient-intensity: 0;
        multisampling: root.msaa;
        scene-background: #253346;
    }
    dispersion-toggle := CheckBox { x: 20px; y: 230px; width: 110px; height: 40px; text: "体积色散"; checked <=> root.dispersed; }
    Label { x: 155px; y: 230px; width: 80px; height: 40px; text: "倾斜角度"; }
    angle := Slider { x: 249px; y: 230px; width: 179px; height: 40px; minimum: 0; maximum: 45; value <=> root.yaw; }
}
