struct SurfaceMap {
    source: string, wrap-u: string, wrap-v: string,
    min-filter: string, mag-filter: string, mip-filter: string,
    uv-scale-u: float, uv-scale-v: float, uv-offset-u: float, uv-offset-v: float,
    uv-rotation: float,
}
struct TexturedStyle {
    enabled: bool, base-color: color, metalness: float, roughness: float,
    base-color-map: SurfaceMap, metallic-roughness-map: string, normal-map: string,
    normal-strength: float, alpha-mode: string, alpha-cutoff: float, unlit: bool,
    cull-mode: string,
}
struct TexturedActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, material: TexturedStyle, casts-shadow: bool,
    camera-kind: string, camera-height: float,
}

export component AuthoredTextureDemo inherits Window {
    title: "XRack · 材质贴图";
    width: 644px; height: 434px;
    resizable: false; background: #182535;

    in-out property <float> repeat: 1.5;
    in-out property <float> rotation: 0;
    in-out property <float> roughness: 0.5;
    in-out property <bool> cutout: false;
    in-out property <bool> bump: true;
    in-out property <bool> imported: false;
    in-out property <string> wrap: "repeat";
    property <SurfaceMap> tiles: SurfaceMap {
        source: @texture-url("models/focus-grid.png"),
        wrap-u: root.wrap, wrap-v: root.wrap,
        min-filter: "linear", mag-filter: "nearest", mip-filter: "linear",
        uv-scale-u: root.repeat, uv-scale-v: root.repeat,
        uv-offset-u: 0, uv-offset-v: 0, uv-rotation: root.rotation,
    };
    property <TexturedStyle> left: TexturedStyle {
        enabled: true, base-color: root.cutout ? #b39bf0 : #7fbdde,
        metalness: 0.05, roughness: root.roughness,
        base-color-map: root.cutout ? SurfaceMap {
            source: @texture-url("models/particle-ring.png"),
            uv-scale-u: 1, uv-scale-v: 1, uv-rotation: 0,
            ..root.tiles
        } : root.tiles,
        metallic-roughness-map: "", normal-map: "", normal-strength: 1,
        alpha-mode: root.cutout ? "mask" : "opaque", alpha-cutoff: 0.5,
        unlit: false, cull-mode: "back",
    };
    property <TexturedStyle> right: TexturedStyle {
        base-color: #efa868, alpha-mode: "opaque", cull-mode: "none",
        base-color-map: SurfaceMap { ..root.tiles },
        normal-map: root.bump ? @texture-url("models/coat-normal.png") : "",
        metallic-roughness-map: @texture-url("models/coat-channels.png"),
        normal-strength: 0.8, metalness: 0.55, ..root.left
    };
    property <TexturedActor> base: TexturedActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, material: TexturedStyle { enabled: false, ..root.left },
        casts-shadow: true, camera-kind: "", camera-height: 6.2,
    };
    property <[TexturedActor]> world: [
        TexturedActor { id: "eye", mesh: "", z: 8, camera-kind: "orthographic", ..root.base },
        TexturedActor {
            id: "backdrop", z: -2.15, scale-x: 16, scale-y: 9, scale-z: 0.08,
            color: #4a6078, casts-shadow: false, ..root.base
        },
        TexturedActor {
            id: "panel", x: -2.02, y: 0.15, z: 0.38,
            scale-x: 2.56, scale-y: 2.56, scale-z: 0.08, material: root.left, ..root.base
        },
        TexturedActor {
            id: "detail", mesh: root.imported ? @mesh-url("models/uv-atlas.gltf") : "primitive:sphere",
            x: 2.12, y: 0.15, z: 0.32,
            scale-x: root.imported ? 0.54 : 1.24,
            scale-y: root.imported ? 0.54 : 1.24,
            scale-z: root.imported ? 0.54 : 1.24,
            material: root.right, ..root.base
        },
    ];
    out property <string> picked: Scene3D.pick-camera(
        root.world, "eye", Point2D.new(644px, 321px), Point2D.new(217px, 153px));
    SceneView3D {
        width: 644px; height: 321px; model: root.world; camera: "eye";
        scene-background: #253b52; scene-hdr: true;
        shadows: true; shadow-map-size: 512; shadow-bias: 0.0028;
        light-yaw: -35; light-elevation: 37; ambient-intensity: 0.34;
        cache-rendering: true;
    }
    Label { x: 14px; y: 327px; width: 53px; height: 34px; text: "平铺"; }
    tile-slider := Slider { x: 64px; y: 328px; width: 160px; height: 32px; minimum: 0.55; maximum: 5; value <=> root.repeat; }
    Label { x: 234px; y: 327px; width: 53px; height: 34px; text: "旋转"; }
    turn-slider := Slider { x: 284px; y: 328px; width: 135px; height: 32px; minimum: 0; maximum: 180; value <=> root.rotation; }
    Label { x: 429px; y: 327px; width: 55px; height: 34px; text: "粗糙度"; }
    rough-slider := Slider { x: 486px; y: 328px; width: 142px; height: 32px; minimum: 0.04; maximum: 1; value <=> root.roughness; }
    mask-toggle := CheckBox { x: 14px; y: 375px; width: 139px; height: 36px; text: "底色裁切"; checked <=> root.cutout; }
    normal-toggle := CheckBox { x: 153px; y: 375px; width: 124px; height: 36px; text: "法线贴图"; checked <=> root.bump; }
    mesh-toggle := CheckBox { x: 285px; y: 375px; width: 139px; height: 36px; text: "用 glTF UV"; checked <=> root.imported; }
    wrap-toggle := Button {
        x: 447px; y: 374px; width: 181px; height: 36px;
        text: root.wrap == "repeat" ? "重复寻址" : root.wrap == "mirror" ? "镜像寻址" : "边缘延伸";
        clicked => { root.wrap = root.wrap == "repeat" ? "mirror" : root.wrap == "mirror" ? "clamp" : "repeat"; }
    }
}
