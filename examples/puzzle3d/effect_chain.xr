struct ChainActor {
    id: string, mesh: string, x: float, y: float, z: float,
    yaw: float, pitch: float, roll: float, color: color,
    scale-x: float, scale-y: float, scale-z: float,
}

struct EffectStep {
    shader: string, strength: float, depth: bool, scale: float, parameters: vector3d,
}

export component EffectChainDemo inherits Window {
    title <- "XRack · 多阶段后处理";
    width <- 481px; height <- 310px; resizable <- false;
    background <- #172332;
    in-out property <bool> apply-effects: true;
    in-out property <bool> composite: true;
    in-out property <bool> composite-first: false;
    in-out property <float> radius: 8;
    property <EffectStep> horizontal <- EffectStep {
        shader: @shader-url("effects/blur.wgsl"),
        strength: root.apply-effects ? 1 : 0, depth: false, scale: 0.5,
        parameters: Vector3D.new(root.radius, 0, 0)
    };
    property <EffectStep> vertical <- EffectStep {
        shader: @shader-url("effects/blur.wgsl"),
        strength: root.apply-effects ? 1 : 0, depth: false, scale: 0.5,
        parameters: Vector3D.new(0, root.radius * 0.5, 0)
    };
    property <EffectStep> mix-source <- EffectStep {
        shader: @shader-url("effects/halo.wgsl"),
        strength: root.apply-effects && root.composite ? 1 : 0, depth: false, scale: 1,
        parameters: Vector3D.new(0, 0, 0)
    };
    Rectangle {
        width <- 481px; height <- 245px; background <- #24394e;
    }
    effect-view := SceneView3D {
        width <- 481px; height <- 245px; scene-background <- #00000000;
        scene-hdr <- true; cache-rendering <- true;
        camera-yaw <- 22; camera-pitch <- 16; camera-distance <- 6;
        model <- [
            ChainActor {
                id: "core", mesh: "primitive:box", x: 0, y: 0, z: 0,
                yaw: 16, pitch: 0, roll: 0, color: #df875a,
                scale-x: 1.25, scale-y: 1.25, scale-z: 1.25
            }
        ];
        scene-effects <- root.composite-first
            ? [root.mix-source, root.horizontal, root.vertical]
            : [root.horizontal, root.vertical, root.mix-source];
    }
    effects := CheckBox {
        x <- 12px; y <- 258px; width <- 92px; height <- 34px;
        text <- "效果"; checked <-> root.apply-effects;
    }
    composite-toggle := CheckBox {
        x <- 108px; y <- 258px; width <- 104px; height <- 34px;
        text <- "合成原图"; checked <-> root.composite;
    }
    order := CheckBox {
        x <- 216px; y <- 258px; width <- 102px; height <- 34px;
        text <- "先合成"; checked <-> root.composite-first;
    }
    radius-slider := Slider {
        x <- 327px; y <- 258px; width <- 132px; height <- 34px;
        minimum <- 2; maximum <- 18; step <- 0.5;
        value <-> root.radius;
    }
}
