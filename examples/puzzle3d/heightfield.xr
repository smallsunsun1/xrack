struct TerrainActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color, casts-shadow: bool,
}

export component HeightfieldDemo inherits Window {
    title: "XRack · 高度图地形";
    width: 600px; height: 422px;
    resizable: false;
    background: #17283b;
    in-out property <bool> flat = false;
    in-out property <float> marker-x = -0.6;
    in-out property <float> marker-z = 0.2;
    in-out property <float> azimuth = 30;
    property <float> inclination: 37;
    property <float> distance: 11;
    property <TerrainActor> defaults: TerrainActor {
        id: "", mesh: "primitive:box",
        x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff, casts-shadow: true,
    };
    property <[TerrainActor]> surface: [
        TerrainActor {
            id: "ridge", mesh: @mesh-url("models/ridge.png", lightmap-uv, auto-lod),
            scale-x: 7.2, scale-y: root.flat ? 0.1 : 2.4, scale-z: 5.6,
            color: #6b9a75,
            ..root.defaults
        },
    ];
    out property <hit3d> contact: Scene3D.ray-hit(
        root.surface, Point3D.new(root.marker-x, 6, root.marker-z), Vector3D.new(0, -1, 0), 10);
    property <[TerrainActor]> actors: [
        Model.at(root.surface, 0, root.defaults),
        TerrainActor {
            id: "marker", mesh: "primitive:box",
            x: root.marker-x, y: root.contact.position.y + 0.14, z: root.marker-z,
            scale-x: 0.28, scale-y: 0.28, scale-z: 0.28,
            yaw: 18, color: #ffcc57,
            ..root.defaults
        },
    ];
    terrain-input := TouchArea {
        width: 600px; height: 355px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.inside {
                let candidate = Scene3D.hit(
                    root.surface, root.azimuth, root.inclination, root.distance,
                    Point2D.new(self.layout-width, self.layout-height), Point2D.new(event.x, event.y));
                if candidate.valid {
                    root.marker-x = candidate.position.x;
                    root.marker-z = candidate.position.z;
                }
            }
        }
        SceneView3D {
            width: 600px; height: 355px;
            model: root.actors;
            camera-yaw: root.azimuth; camera-pitch: root.inclination; camera-distance: root.distance;
            scene-background: #21364c;
            ambient-intensity: 0.3;
            light-yaw: -35; light-elevation: 43;
            shadows: true; shadow-map-size: 1024; shadow-bias: 0.002;
            multisampling: true;
        }
    }
    HorizontalLayout {
        x: 18px; y: 369px; width: 564px; height: 36px; spacing: 12px;
        flatten := CheckBox { width: 112px; text: "压平地形"; checked <=> root.flat; }
        Text { width: 120px; text: "高度 " + Math.round(root.contact.position.y * 100) + " cm"; color: #edf4fc; }
        azimuth := Slider { width: 230px; minimum: -70; maximum: 70; value <=> root.azimuth; }
    }
}
