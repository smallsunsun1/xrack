BAKE_ROOM_ASSETS = [
    "models/lightmap-receiver.gltf",
    "models/ssgi-emitter.gltf",
    "models/lod-surface.gltf",
    "models/lod-surface.bin",
]

exports_files(
    ["lightmap_bake_scene.xr", "lightmap_baked_view.xr"],
    visibility = ["//tests:__pkg__"],
)

genrule(
    name = "baked_room_atlas",
    srcs = ["lightmap_bake_scene.xr", "lightmap_baked_view.xr"] + BAKE_ROOM_ASSETS,
    outs = ["baked/atlas.png", "baked/lighting.xr", "baked/lightmaps.json", "baked_room_ui.rs"],
    tools = ["//crates/xrack-compiler:xrackc"],
    cmd = """
        set -eu
        work="$$(mktemp -d)"
        trap 'rm -rf "$$work"' EXIT
        "$(location //crates/xrack-compiler:xrackc)" --emit lightmaps \
            --restrict-assets --restrict-sources \
            --asset "$(location models/lightmap-receiver.gltf)" \
            --asset "$(location models/ssgi-emitter.gltf)" \
            --asset "$(location models/lod-surface.gltf)" \
            --asset "$(location models/lod-surface.bin)" \
            --bake-receiver plate --bake-receiver figure --bake-size 64 --bake-samples 48 \
            -o "$$work/baked" "$(location lightmap_bake_scene.xr)"
        mkdir -p "$$work/models"
        cp "$(location models/lightmap-receiver.gltf)" "$(location models/ssgi-emitter.gltf)" "$(location models/lod-surface.gltf)" \
            "$(location models/lod-surface.bin)" "$$work/models/"
        cp "$(location lightmap_bake_scene.xr)" "$(location lightmap_baked_view.xr)" "$$work/"
        "$(location //crates/xrack-compiler:xrackc)" --emit rust --restrict-assets --restrict-sources \
            --source "$$work/lightmap_bake_scene.xr" --source "$$work/baked/lighting.xr" \
            --asset "$$work/models/lightmap-receiver.gltf" --asset "$$work/models/ssgi-emitter.gltf" \
            --asset "$$work/models/lod-surface.gltf" --asset "$$work/models/lod-surface.bin" \
            --asset "$$work/baked/atlas.png" -o "$(location baked_room_ui.rs)" "$$work/lightmap_baked_view.xr"
        cp "$$work/baked/atlas.png" "$(location baked/atlas.png)"
        cp "$$work/baked/lighting.xr" "$(location baked/lighting.xr)"
        cp "$$work/baked/lightmaps.json" "$(location baked/lightmaps.json)"
    """,
    visibility = ["//tests:__pkg__"],
)

rust_library(
    name = "baked_room_ui",
    srcs = [":baked_room_ui.rs"],
    crate_root = "baked_room_ui.rs",
    edition = "2024",
    tags = ["no-clippy"],
    deps = ["//crates/xrack-runtime:xrack_runtime"],
    visibility = ["//tests:__pkg__"],
)

rust_binary(
    name = "play_baked_room",
