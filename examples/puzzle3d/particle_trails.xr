struct ParticleBurst { time: float, count: int }

struct TrailEmitter {
    position: point3d, color: color, size: float, lifetime: float,
    bursts: [ParticleBurst], fade-out: float, seed: int, layers: int,
    velocity: vector3d, velocity-spread: vector3d, gravity: vector3d,
    trail-segments: int, trail-duration: float, trail-end-scale: float,
    trail-fade: float, trail-eol-fade: float,
}

struct TrailRotator {
    affector-kind: string, position: point3d, direction: vector3d,
    angular-speed: float, enabled: bool, layers: int,
}

struct TrailCamera {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, camera-kind: string, camera-height: float,
}

export component ParticleTrailsDemo inherits Window {
    title: "XRack · 粒子拖尾";
    width: 670px; height: 457px;
    background: #182333;

    in-out property <float> time: 0.9;
    in-out property <int> segments: 12;
    in-out property <float> history: 0.8;
    in-out property <bool> rotate-trails: false;
    in-out property <bool> retain-trails: true;
    in-out property <int> population: 1;

    property <TrailEmitter> comet: TrailEmitter {
        position: Point3D.new(-2.2, -0.4, 0), color: #48d9ffff, size: 0.22, lifetime: 1.25,
        bursts: [ParticleBurst { time: 0, count: root.population }], fade-out: 0, seed: 41, layers: 1,
        velocity: Vector3D.new(3.8, 3.8, 0), velocity-spread: Vector3D.new(0, 0, 0),
        gravity: Vector3D.new(0, -5.4, 0),
        trail-segments: root.segments, trail-duration: root.history,
        trail-end-scale: 0.16, trail-fade: 0.78, trail-eol-fade: root.retain-trails ? 0.62 : 0,
    };
    property <[TrailEmitter]> emitters: [
        TrailEmitter { ..root.comet },
        TrailEmitter {
            position: Point3D.new(-2.2, -1.84, 0), color: #ff9e46ff, size: 0.19, lifetime: 2.2, layers: 2,
            trail-segments: 0, ..root.comet
        },
    ];
    property <[TrailRotator]> fields: [
        TrailRotator {
            affector-kind: "point-rotator", position: Point3D.new(0.5, 0.72, 0),
            direction: Vector3D.new(0,0,1), angular-speed: 85,
            enabled: root.rotate-trails, layers: 1,
        },
    ];
    property <[TrailCamera]> model: [
        TrailCamera {
            id: "eye", mesh: "", x: 0, y: 0, z: 10,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, camera-kind: "orthographic", camera-height: 6,
        },
    ];
    SceneView3D {
        width: 670px; height: 352px;
        camera: "eye"; model: root.model; layer-mask: 3;
        particle-emitters: root.emitters; particle-time: root.time; particle-affectors: root.fields;
        scene-background: #101925; cache-rendering: true; order-independent-transparency: true;
    }
    Text { x: 20px; y: 34px; text: "拖尾轨迹"; color: #9eb7c9; }
    Text { x: 20px; y: 203px; text: "点粒子"; color: #d0b291; }

    segments-toggle := Button {
        x: 18px; y: 365px; width: 107px; height: 36px;
        text: root.segments == 12 ? "12 段" : root.segments == 1 ? "1 段" : "无拖尾";
        clicked => { root.segments = root.segments == 12 ? 1 : root.segments == 1 ? 0 : 12; }
    }
    rotate-toggle := CheckBox { x: 141px; y: 365px; width: 116px; height: 36px; text: "旋转影响器"; checked <=> root.rotate-trails; }
    retain-toggle := CheckBox { x: 270px; y: 365px; width: 110px; height: 36px; text: "保留残影"; checked <=> root.retain-trails; }
    Label { x: 400px; y: 365px; width: 76px; height: 36px; text: "拖尾时长"; }
    span-slider := Slider { x: 479px; y: 365px; width: 169px; height: 36px; minimum: 0.12; maximum: 1.3; value <=> root.history; }
    Label { x: 18px; y: 412px; width: 50px; height: 35px; text: "时间"; }
    time-slider := Slider { x: 72px; y: 412px; width: 578px; height: 35px; minimum: 0; maximum: 2.1; value <=> root.time; }
}

export struct EmissionKey {
    time: float, position: point3d, orientation: quaternion3d,
}

struct BirthEmitter {
    position: point3d, color: color, size: float, lifetime: float,
    velocity: vector3d, rate: float, bursts: [ParticleBurst], start-time: float, fade-out: float,
    emission-track: [EmissionKey], emission-loop: bool, trail-segments: int, trail-duration: float,
    particle-model: string, particle-casts-shadow: bool,
}

export component ParticleBirthTrackDemo inherits Window {
    title: "XRack · 粒子出生轨道";
    width: 624px; height: 396px; background: #182333;

    in-out property <float> time: 1.75;
    in-out property <float> start: 0;
    in-out property <bool> running: false;
    in-out property <bool> loop-births: false;
    in-out property <int> ribbons: 0;
    in-out property <string> particle-mesh: "";
    property <quaternion3d> upward: Quaternion3D.from-axis-angle(Vector3D.new(0, 0, 1), 90);
    in-out property <[EmissionKey]> keys: [
        EmissionKey { time: 0, position: Point3D.new(-3, 0, 0.7), orientation: root.upward },
        EmissionKey { time: 1, position: Point3D.new(0, 0, 0.7), orientation: root.upward },
        EmissionKey { time: 2, position: Point3D.new(3, 0, 0.7), orientation: Quaternion3D.identity() },
    ];
    property <EmissionKey> fallback: EmissionKey {
        time: 0, position: Point3D.new(0, 0, 0), orientation: Quaternion3D.identity(),
    };
    property <EmissionKey> first: Model.at(root.keys, 0, root.fallback);
    property <EmissionKey> middle: Model.at(root.keys, 1, root.first);
    property <EmissionKey> last: Model.at(root.keys, 2, root.middle);
    property <float> elapsed: root.time - root.start;
    property <float> path-time: root.loop-births && root.last.time > 0 && root.elapsed >= 0
        ? root.elapsed - Math.floor(root.elapsed / root.last.time) * root.last.time
        : root.elapsed;
    property <EmissionKey> from: root.path-time < root.middle.time ? root.first : root.middle;
    property <EmissionKey> to: root.path-time < root.middle.time ? root.middle : root.last;
    property <float> fraction: Math.clamp(
        (root.path-time - root.from.time) / Math.max(root.to.time - root.from.time, 0.000001), 0, 1);
    property <point3d> head: Point3D.new(
        root.from.position.x + root.fraction * (root.to.position.x - root.from.position.x),
        root.from.position.y + root.fraction * (root.to.position.y - root.from.position.y),
        root.from.position.z + root.fraction * (root.to.position.z - root.from.position.z));

    clock := FrameAnimation {
        running <=> root.running;
        triggered(delta, elapsed, frame) => {
            root.time = root.time + delta;
            if root.time > 4.5 { root.time = 0; }
        }
    }

    property <TrailCamera> base: TrailCamera {
        id: "", mesh: "", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ffffff, camera-kind: "", camera-height: 6,
    };
    SceneView3D {
        width: 624px; height: 284px; camera: "eye"; particle-time: root.time;
        scene-background: #101a2c; ambient-intensity: 0.6;
        shadows: true;
        model: [
            TrailCamera { id: "eye", camera-kind: "orthographic", z: 10, ..root.base },
            TrailCamera {
                id: "guide", mesh: "primitive:box", z: -0.9,
                scale-x: 7.8, scale-y: 0.045, scale-z: 0.10, color: #406080, ..root.base
            },
            TrailCamera {
                id: "nozzle", mesh: "primitive:sphere",
                x: root.head.x, y: root.head.y, z: root.head.z - 0.4,
                scale-x: 0.35, scale-y: 0.35, scale-z: 0.35, color: #b7e9ff, ..root.base
            },
        ];
        particle-emitters: [
            BirthEmitter {
                position: Point3D.new(0, 0, 0), color: #ff42ea, size: 0.24, lifetime: 4,
                velocity: Vector3D.new(0.5, 0, 0), rate: 2, bursts: [ParticleBurst { time: 0, count: 1 }],
                start-time: root.start, fade-out: 0, emission-track: root.keys, emission-loop: root.loop-births,
                trail-segments: root.ribbons, trail-duration: 0.4,
                particle-model: root.particle-mesh, particle-casts-shadow: true,
            },
        ];
    }
    Label { x: 18px; y: 296px; width: 68px; height: 34px; text: "时间"; }
    time-position := Slider { x: 88px; y: 296px; width: 516px; height: 34px; minimum: 0; maximum: 4.5; value <=> root.time; }
    play := Button {
        x: 18px; y: 344px; width: 100px; height: 34px;
        text: root.running ? "暂停" : "播放";
        clicked => { root.running = !root.running; }
    }
    rewind := Button {
        x: 132px; y: 344px; width: 100px; height: 34px; text: "回到起点";
        clicked => { root.running = false; root.time = 0; }
    }
    ribbon-toggle := Button {
        x: 246px; y: 344px; width: 120px; height: 34px;
        text: root.ribbons == 0 ? "开启拖尾" : "关闭拖尾";
        clicked => { root.ribbons = root.ribbons == 0 ? 8 : 0; }
    }
    loop-choice := CheckBox {
        x: 380px; y: 344px; width: 145px; height: 34px;
        text: "循环出生"; checked <=> root.loop-births;
    }
}

export struct ImpactBurst {
    time: float, count: int, duration: float, position: point3d, orientation: quaternion3d,
}

struct ImpactEmitter {
    position: point3d, color: color, size: float, lifetime: float, fade-out: float,
    parent: string, rate: float, emission-track: [EmissionKey], bursts: [ImpactBurst],
    velocity: vector3d, velocity-spread: vector3d, seed: int,
    trail-segments: int, trail-duration: float, trail-end-scale: float,
    particle-model: string, particle-casts-shadow: bool,
}

export component ParticleImpactDemo inherits Window {
    title: "XRack · 点击发射粒子";
    width: 624px; height: 402px; background: #182333;

    in-out property <float> time: 0.2;
    in-out property <float> burst-duration: 0.4;
    in-out property <int> count: 36;
    in-out property <bool> spread: true;
    in-out property <bool> upward: true;
    in-out property <bool> running: false;
    in-out property <bool> ribbons: false;
    in-out property <bool> model-particles: false;
    in-out property <float> rate: 0;
    in-out property <bool> track: false;
    in-out property <string> parent-name: "";
    in-out property <[ImpactBurst]> impacts: [];
    out property <int> impact-count: Model.count(root.impacts);
    property <[EmissionKey]> no-track: [];

    property <TrailCamera> eye: TrailCamera {
        id: "eye", mesh: "", x: 0, y: 0, z: 10,
        scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, camera-kind: "orthographic", camera-height: 6,
        color: #ffffff,
    };

    clock := FrameAnimation {
        running: root.running;
        triggered(delta, elapsed, frame) => {
            root.time = Math.min(root.time + delta, 4);
            if root.time >= 4 { root.running = false; }
        }
    }
    view := SceneView3D {
        width: 624px; height: 284px;
        camera: "eye"; scene-background: #101a2c;
        shadows: root.model-particles; shadow-map-size: 128;
        model: [
            root.eye,
            TrailCamera {
                id: "wall", mesh: "primitive:rectangle", z: 0,
                scale-x: 8, scale-y: 4, camera-kind: "", color: #405979, ..root.eye
            },
        ];
        particle-time: root.time;
        particle-emitters: [
            ImpactEmitter {
                position: Point3D.new(0, -0.8, 0.5), color: #ff42ea,
                size: 0.16, lifetime: 3, fade-out: 0, parent: root.parent-name,
                velocity: Vector3D.new(1.5, 0, 0),
                velocity-spread: root.spread ? Vector3D.new(0.9, 0.7, 0.12) : Vector3D.new(0, 0, 0),
                seed: 83, rate: root.rate, bursts: root.impacts,
                emission-track: root.track ? [
                    EmissionKey { time: 0, position: Point3D.new(-1, -1.5, 0.55), orientation: Quaternion3D.identity() },
                    EmissionKey { time: 1, position: Point3D.new(1, -1.5, 0.55), orientation: Quaternion3D.identity() },
                ] : root.no-track,
                trail-segments: root.ribbons ? 8 : 0, trail-duration: 0.2, trail-end-scale: 0.16,
                particle-model: root.model-particles ? "primitive:box" : "",
                particle-casts-shadow: root.model-particles,
            },
        ];
    }
    callback burst-at(point: point2d);
    burst-at(point) => {
        let hit = view.hit(point);
        if hit.valid {
            if Model.count(root.impacts) >= 128 { Model.remove(root.impacts, 0); }
            Model.append(root.impacts, ImpactBurst {
                time: root.time, count: root.count, duration: root.burst-duration,
                position: Point3D.new(hit.position.x, hit.position.y, hit.position.z + 0.2),
                orientation: root.upward
                    ? Quaternion3D.from-axis-angle(Vector3D.new(0, 0, 1), 90)
                    : Quaternion3D.identity(),
            });
        }
    }
    surface := TouchArea {
        width: 624px; height: 284px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.inside {
                root.burst-at(Point2D.new(event.x, event.y));
            }
        }
    }
    Label { x: 18px; y: 290px; width: 112px; height: 35px; text: "点击墙面发射"; }
    Slider { x: 138px; y: 290px; width: 466px; height: 35px; minimum: 0; maximum: 4; value <=> root.time; }
    playback := Button {
        x: 18px; y: 342px; width: 90px; height: 34px;
        text: root.running ? "暂停" : "播放"; clicked => { root.running = !root.running; }
    }
    CheckBox { x: 120px; y: 342px; width: 100px; height: 34px; text: "向上"; checked <=> root.upward; }
    CheckBox { x: 232px; y: 342px; width: 100px; height: 34px; text: "拖尾"; checked <=> root.ribbons; }
    CheckBox { x: 344px; y: 342px; width: 100px; height: 34px; text: "模型"; checked <=> root.model-particles; }
    clear-events := Button {
        x: 482px; y: 342px; width: 122px; height: 34px; text: "清空记录";
        clicked => { Model.clear(root.impacts); }
    }
}
