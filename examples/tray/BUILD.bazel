load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel:xrack.bzl", "xr_ui_library")

xr_ui_library(
    name = "tray_ui",
    src = "tray.xr",
    assets = [
        "assets/status.svg",
        "i18n/catalog.toml",
        "i18n/en-US.ftl",
        "i18n/zh-CN.ftl",
    ],
    visibility = ["//tests:__pkg__"],
)

rust_binary(
    name = "tray",
    srcs = ["main.rs"],
    edition = "2024",
    deps = [
        ":tray_ui",
        "//crates/xrack-platform-winit:xrack_platform_winit",
    ],
)
