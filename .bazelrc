build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --compilation_mode=opt
build --jobs=8
# Share action outputs across output bases/worktrees and Bazel restarts.
# `~` is expanded by Bazel, so this remains portable across developer machines.
build --disk_cache=~/.cache/bazel/xrack
build --experimental_disk_cache_gc_max_size=30G
build --experimental_disk_cache_gc_max_age=30d
# Java is only the ANTLR generator's build-time runtime. Reuse the JDK that
# runs Bazel instead of fetching an additional JDK for the generated C++ code.
build --java_runtime_version=local_jdk
build --tool_java_runtime_version=local_jdk
# LLVM's overlay enables strict Clang module layering checks, which do not
# model the current Apple SDK's libc++ headers as Bazel modules.
build --enable_platform_specific_config
build:macos --features=-layering_check
build:macos --host_features=-layering_check
build:macos --macos_minimum_os=13.0
build:macos --host_macos_minimum_os=13.0
test --test_output=errors
