startup:windows --windows_enable_symlinks

build --compilation_mode=opt
build --jobs=auto
# Share action outputs across output bases/worktrees and Bazel restarts.
# `~` is expanded by Bazel, so this remains portable across developer machines.
# GitHub Actions overrides this local default from setup-bazel's home RC.
build --disk_cache=~/.cache/bazel/xrack
# LLVM/MLIR and the native/cross-target Rust builds share this budget.
build --experimental_disk_cache_gc_max_size=20G
build --experimental_disk_cache_gc_max_age=30d
# Reuse the JDK that runs Bazel to generate the ANTLR Rust sources.
build --java_runtime_version=local_jdk
build --tool_java_runtime_version=local_jdk
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --repo_env=ASPECT_TOOLS_TELEMETRY=-all
# LLVM's overlay enables strict Clang module layering checks, which do not
# model the current Apple SDK's libc++ headers as Bazel modules.
build --enable_platform_specific_config
build:linux --host_platform=//bazel:linux_gnu --platforms=//bazel:linux_gnu
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:linux --@ffmpeg//:enable_alsa_indev=true
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:macos --@ffmpeg//:enable_avfoundation_indev=true
build:windows --cxxopt=/std:c++20 --host_cxxopt=/std:c++20
build:windows --@ffmpeg//:enable_dshow_indev=true
build:windows --cxxopt=/bigobj --host_cxxopt=/bigobj
build:windows --enable_runfiles
# The Windows LLVM toolchain uses clang-cl and cannot assemble the MASM payload.
build:windows --@openssl//:use-no-asm-fallback=true
build:windows --host_platform=//bazel:windows_msvc --platforms=//bazel:windows_msvc
build:windows --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA
build:windows --repo_env=BAZEL_WINDOWS_SDK_EULA
build:macos --features=-layering_check
build:macos --host_features=-layering_check
build:macos --@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_macos=false
build:macos --macos_minimum_os=13.0
build:macos --host_macos_minimum_os=13.0

build:fmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:fmt --output_groups=rustfmt_checks
build:lint --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:lint --output_groups=clippy_checks
build:lint --@rules_rust//rust/settings:clippy_flag=-Dclippy::correctness
build:lint --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build:lint --@rules_rust//rust/settings:clippy_flag=-Dclippy::unwrap_used
build:lint --@rules_rust//rust/settings:clippy_flag=-Dclippy::expect_used

build:lint-strict --config=lint

test --test_output=errors

# Versions covered by the Android SDK/NDK license acceptance for this project.
common --repo_env=ACCEPTED_ANDROID_SDK_LICENSE_VERSION=34
common --repo_env=ACCEPTED_ANDROID_NDK_LICENSE_VERSION=r28c
common --downloader_config=bazel/android_downloads.cfg

# Native playback profile. Media targets are opt-in.
build:media --@ffmpeg//:enable_openssl=true
build:media --@ffmpeg//:enable_http_protocol=true
build:media --@ffmpeg//:enable_https_protocol=true
build:media --@ffmpeg//:enable_hls_demuxer=true
build:media --@ffmpeg//:enable_mpegts_demuxer=true
build:media --@ffmpeg//:enable_matroska_demuxer=true
build:media --@ffmpeg//:enable_vp8_decoder=true
build:media --@ffmpeg//:enable_vp9_decoder=true
build:media --@ffmpeg//:enable_wav_demuxer=true
build:media --@ffmpeg//:enable_pcm_u8_decoder=true
build:media --@ffmpeg//:enable_pcm_s16le_decoder=true
build:media --@ffmpeg//:enable_pcm_s24le_decoder=true
build:media --@ffmpeg//:enable_pcm_s32le_decoder=true
build:media --@ffmpeg//:enable_pcm_f32le_decoder=true
build:media --@ffmpeg//:enable_pcm_f64le_decoder=true
build:media --@ffmpeg//:enable_mp3_demuxer=true
build:media --@ffmpeg//:enable_mp3_decoder=true
build:media --@ffmpeg//:enable_ogg_demuxer=true
build:media --@ffmpeg//:enable_opus_decoder=true
build:media --@ffmpeg//:enable_vorbis_decoder=true
build:media --@ffmpeg//:enable_flac_demuxer=true
build:media --@ffmpeg//:enable_flac_decoder=true
build:media --@ffmpeg//:enable_subrip_decoder=true
build:media --@ffmpeg//:enable_movtext_decoder=true
build:media --@ffmpeg//:enable_webvtt_decoder=true
build:media --@ffmpeg//:enable_ass_decoder=true
build:media --@ffmpeg//:enable_file_protocol=true
build:media --@ffmpeg//:enable_yuv4mpegpipe_demuxer=true
build:media --@ffmpeg//:enable_rawvideo_decoder=true
build:media --@ffmpeg//:enable_mov_demuxer=true
build:media --@ffmpeg//:enable_h264_decoder=true
build:media --@ffmpeg//:enable_h264_parser=true
build:media --@ffmpeg//:enable_aac_decoder=true
build:media --@ffmpeg//:enable_mpeg4_decoder=true
build:media --//crates/xrack-media:enabled

# Apple Silicon iOS Simulator. Apple rules select the simulator SDK from Xcode.
build:ios-sim --ios_multi_cpus=sim_arm64

# Native iPhone and iPad packages use Xcode's device SDK and the arm64 Rust target.
build:ios-device --ios_multi_cpus=arm64
# Link the device executables directly for checks without a provisioning profile.
build:ios-device-check --config=ios-device
build:ios-device-check --platforms=@apple_support//platforms:ios_arm64
build:ios-device-check --apple_platform_type=ios
build:ios-device-check --cpu=ios_arm64
build:ios-device-check --ios_minimum_os=18.2

# Android arm64 APK. The NDK supplies the target linker and sysroot.
build:android --platforms=//bazel:arm64-v8a
build:android --android_platforms=@@//bazel:arm64-v8a
build:android --extra_toolchains=@androidndk//:all,@androidsdk//:all
build:android --java_language_version=17
build:android --tool_java_language_version=17
