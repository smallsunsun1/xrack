{
  "clangd.path": "clangd",
  "mlir.server_path": "bazel-bin/mlir/xrack-mlir-lsp-server",
  "rust-analyzer.linkedProjects": ["rust-project.json"],
  "rust-analyzer.checkOnSave": false,
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.lens.run.enable": false,
  "rust-analyzer.lens.debug.enable": false,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[xrack]": {
    "editor.defaultFormatter": "SunJiahe.xrack",
    "editor.formatOnSave": true
  },
  "files.exclude": {
    "**/bazel-*": true,
    "**/.tools": true
  }
}
