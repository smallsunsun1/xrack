+    pub(crate) fn write_ink_metrics(
+        &self,
+        variations: &FontVariations,
+        glyphs: &mut [super::textlayout::ShapedGlyph],
+    ) {
+        let mut cache = self.layout_ink.borrow_mut();
+        let defaults = FontVariations::default();
+        let variations = if cache.variable { variations } else { &defaults };
+        let variant = cache.variants.iter().position(|cached| {
+            cached.variations.iter().eq(variations.iter())
+        });
+        if variant != Some(0) {
+            let variant = variant.and_then(|index| cache.variants.remove(index)).unwrap_or_else(|| {
+                // Keep recent weights and italics together without retaining
+                // every coordinate set from animation or repeated resizing.
+                const LIMIT: usize = 4;
+                let mut entry = if cache.variants.len() == LIMIT {
+                    cache.variants.pop_back().unwrap_or_default()
+                } else {
+                    LayoutInkVariant::default()
+                };
+                entry.variations = variations.clone();
+                entry.glyphs.clear();
+                entry
+            });
+            cache.variants.push_front(variant);
+        }
+        let variant = &mut cache.variants[0];
+        let mut face = None;
+        for glyph in glyphs {
+            let metrics = variant.glyphs.entry(glyph.glyph_id).or_insert_with(|| {
+                let face = face.get_or_insert_with(|| self.face_ref_with_variations(variations));
+                let id = GlyphId(glyph.glyph_id);
+                self.bitmap_metrics(face, id)
+                    .or_else(|| face.0.glyph_bounding_box(id).map(Self::outline_metrics))
+            });
+            if let Some(metrics) = metrics {
+                glyph.width = metrics.width;
+                glyph.height = metrics.height;
+                glyph.bearing_y = metrics.bearing_y;
+            }
+        }
+    }
