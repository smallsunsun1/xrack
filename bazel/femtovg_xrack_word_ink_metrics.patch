+    fn bitmap_metrics(&self, face: &FontFaceRef<'_>, id: GlyphId) -> Option<GlyphMetrics> {
+        let image = face.0.glyph_raster_image(id, u16::MAX)
+            .filter(|image| image.format == ttf_parser::RasterImageFormat::PNG)?;
+        let scale = if image.pixels_per_em != 0 {
+            self.units_per_em as f32 / image.pixels_per_em as f32
+        } else {
+            1.0
+        };
+        Some(GlyphMetrics {
+            width: image.width as f32 * scale,
+            height: image.height as f32 * scale,
+            bearing_x: image.x as f32 * scale,
+            bearing_y: (image.y as f32 + image.height as f32) * scale,
+        })
+    }
+
+    #[cfg(feature = "textlayout")]
+    fn outline_metrics(bounds: ttf_parser::Rect) -> GlyphMetrics {
+        GlyphMetrics {
+            width: bounds.width() as f32,
+            height: bounds.height() as f32,
+            bearing_x: bounds.x_min as f32,
+            bearing_y: bounds.y_max as f32,
+        }
+    }
