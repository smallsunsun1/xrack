+#[derive(Default)]
+struct GlyphMaskBatches {
+    current: std::ops::Range<usize>,
+    completed: Vec<std::ops::Range<usize>>,
+}
+
+impl GlyphMaskBatches {
+    fn record<T: Renderer>(
+        &mut self,
+        canvas: &Canvas<T>,
+        start: usize,
+        first_vertex: usize,
+        cell: (u32, u32, u32, u32),
+    ) {
+        use crate::renderer::CommandType;
+
+        let end = canvas.commands.len();
+        let commands = &canvas.commands[start..end];
+        let (x, y, width, height) = cell;
+        // The atlas packer gives each mask a disjoint cell. Also verify the
+        // actual tessellated vertices, including the sample offsets and cover
+        // quads. An outline that exceeds its font's metrics keeps its draw order.
+        let isolated = commands.len() == COMMANDS_PER_MASK
+            && matches!(commands[0].cmd_type, CommandType::ClearRect { keep_clip: false, .. })
+            && commands[1..].iter().all(|command| {
+                matches!(command.cmd_type, CommandType::ConcaveFill { .. })
+                    && !command.clip_active
+                    && command.triangles_verts.is_some_and(|(_, count)| count == 4)
+                    && command.drawables.iter().all(|drawable| drawable.stroke_verts.is_none())
+            })
+            && canvas.verts[first_vertex..].iter().all(|vertex| {
+                (x as f32) < vertex.x
+                    && vertex.x < (x + width) as f32
+                    && (y as f32) < vertex.y
+                    && vertex.y < (y + height) as f32
+            });
+        // A render-target change inserts a command between the masks.
+        if !isolated || self.current.end != start {
+            self.close_current();
+            self.current = start..start;
+        }
+        if isolated {
+            self.current.end = end;
+        }
+    }
+
+    fn close_current(&mut self) {
+        if self.current.len() > COMMANDS_PER_MASK {
+            self.completed.push(std::mem::take(&mut self.current));
+        }
+    }
+
+    fn finish<T: Renderer>(mut self, canvas: &mut Canvas<T>) {
+        self.close_current();
+        let Some(mut cursor) = self.completed.first().map(|range| range.start) else {
+            return;
+        };
+        // Move each command at most once even when target switches or
+        // unbatchable outlines split a glyph run into several batches.
+        let mut original = canvas.commands.split_off(cursor).into_iter();
+        for range in self.completed {
+            canvas.commands.extend(original.by_ref().take(range.start - cursor));
+            Self::merge(
+                canvas,
+                original.by_ref().take(range.len()),
+                range.len() / COMMANDS_PER_MASK,
+            );
+            cursor = range.end;
+        }
+        canvas.commands.extend(original);
+    }
+
+    fn merge<T: Renderer>(
+        canvas: &mut Canvas<T>,
+        masks: impl Iterator<Item = crate::renderer::Command>,
+        glyphs: usize,
+    ) {
+        use crate::renderer::Command;
+
+        let mut samples: [Option<(Command, Vec<usize>)>; MASK_SAMPLES.len()] = Default::default();
+
+        // Clear every cell, then process the same sample across all cells.
+        // Each sample uses the same solid paint and additive blend state.
+        for (index, mut command) in masks.enumerate() {
+            let sample = index % COMMANDS_PER_MASK;
+            if sample == 0 {
+                canvas.commands.push(command);
+            } else if let Some((cover, _)) = command.triangles_verts {
+                match &mut samples[sample - 1] {
+                    Some((first, covers)) => {
+                        first.drawables.append(&mut command.drawables);
+                        covers.push(cover);
+                    }
+                    slot => {
+                        let mut covers = Vec::with_capacity(glyphs);
+                        covers.push(cover);
+                        *slot = Some((command, covers));
+                    }
+                }
+            }
+        }
+        for (mut command, covers) in samples.into_iter().flatten() {
+            let start = canvas.verts.len();
+            for cover in covers {
+                if canvas.verts.len() != start {
+                    // Degenerate connector triangles preserve the cover quads'
+                    // winding and leave the pixels between cells untouched.
+                    let last = canvas.verts[canvas.verts.len() - 1];
+                    let next = canvas.verts[cover];
+                    canvas.verts.extend([last, next]);
+                }
+                canvas.verts.extend_from_within(cover..cover + 4);
+            }
+            command.triangles_verts = Some((start, canvas.verts.len() - start));
+            canvas.commands.push(command);
         }
     }
