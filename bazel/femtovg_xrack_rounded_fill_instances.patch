+
+@vertex fn mesh_vertex(@location(0) point: vec2f, @location(1) uv: vec2f,
+    @location(2) instance: vec4f, @location(3) color: vec4f) -> MeshFragment {
+    let xy = point + instance.xy;
+    let p = vec4f(2.0 * xy.x / view_size.x - 1.0, 1.0 - 2.0 * xy.y / view_size.y, 0.0, 1.0);
+    return MeshFragment(p, uv, color);
+}
+
+@fragment fn mesh_fragment(input: MeshFragment) -> @location(0) vec4f {
+    let side = min(1.0, 1.0 - abs(input.uv.x * 2.0 - 1.0));
+    return input.color * (side * min(1.0, input.uv.y));
+}
