@@ -0,0 +1,184 @@
+use super::WGPURenderer;
+use crate::{
+    Canvas, Color, CompositeOperationState, FillRule, LineJoin, Path, RenderTarget, Transform2D,
+    geometry::Bounds,
+    renderer::{Command, CommandType, Params, Vertex},
+};
+
+pub(super) const INSTANCE_SLOTS: usize = 2;
+pub(super) const ISOLATED_INSTANCE_SLOTS: usize = 5;
+
+/// An instance of a convex fill sharing a path defined at the origin.
+#[doc(hidden)]
+#[derive(Clone, Copy, Debug)]
+pub struct MeshFillInstance {
+    /// Translation in canvas coordinates.
+    pub origin: [f32; 2],
+    /// Straight fill color.
+    pub color: Color,
+    /// Isolated opacity, if the fill is captured before composition.
+    pub opacity: Option<MeshFillOpacity>,
+}
+
+/// The capture bounds and opacity of a shared fill.
+#[doc(hidden)]
+#[derive(Clone, Copy, Debug)]
+pub struct MeshFillOpacity {
+    /// Visible element clip in canvas coordinates.
+    pub clip: [f32; 4],
+    /// Pixel-aligned capture rectangle in canvas coordinates.
+    pub raster: [f32; 4],
+    /// Opacity applied after rounding the captured color.
+    pub amount: f32,
+}
+
+impl Canvas<WGPURenderer> {
+    /// Draws a shared, antialiased convex mesh in instance order. The ordinary
+    /// painter is required for intersecting clips or thin coverage masks.
+    #[doc(hidden)]
+    pub fn draw_mesh_fill_instances(
+        &mut self,
+        path: &Path,
+        isolated: bool,
+        instances: impl ExactSizeIterator<Item = MeshFillInstance>,
+    ) -> Option<usize> {
+        let state = *self.state();
+        let Transform2D([sx, b, c, sy, tx, ty]) = state.transform;
+        let Transform2D([a, clip_b, clip_c, d, clip_x, clip_y]) = state.scissor.transform;
+        if b != 0.0
+            || c != 0.0
+            || sx != sy
+            || !sx.is_finite()
+            || sx < 1.0
+            || tx != 0.0
+            || ty != 0.0
+            || clip_b != 0.0
+            || clip_c != 0.0
+            || state.scissor.radius != 0.0
+            || state.clip_depth != 0
+            || self.shadow_enabled()
+            || state.composite_operation != CompositeOperationState::default()
+            || self.current_render_target != RenderTarget::Screen
+        {
+            return None;
+        }
+        self.reconcile_current_clip_plane();
+        if self.clip_active() {
+            return None;
+        }
+
+        let mut limits = [0.0, 0.0, self.width() as f32, self.height() as f32];
+        if let Some([half_w, half_h]) = state.scissor.extent {
+            let (half_w, half_h) = (half_w * a.abs(), half_h * d.abs());
+            if half_w < 0.0
+                || half_h < 0.0
+                || ![half_w, half_h, clip_x, clip_y]
+                    .into_iter()
+                    .all(f32::is_finite)
+            {
+                return None;
+            }
+            limits[0] = limits[0].max(clip_x - half_w);
+            limits[1] = limits[1].max(clip_y - half_h);
+            limits[2] = limits[2].min(clip_x + half_w);
+            limits[3] = limits[3].min(clip_y + half_h);
+        }
+        let mut mesh = path.cache(&state.transform, self.tess_tol, self.dist_tol);
+        let bounds = mesh.bounds;
+        if self.fill_masks.enabled()
+            && (bounds.maxx - bounds.minx) * (bounds.maxy - bounds.miny) <= crate::THIN_FILL_SPAN
+            && crate::clip::is_thin(mesh.mean_width(FillRule::NonZero))
+        {
+            return None;
+        }
+        mesh.expand_fill(self.fringe_width, LineJoin::Miter, 2.4, FillRule::NonZero);
+        if !mesh.is_convex() {
+            return None;
+        }
+        let contour = &mesh.contours[0];
+        let (hub, rim) = contour.fill.split_first()?;
+        let start = self.verts.len();
+        for side in rim.windows(2) {
+            self.verts.extend_from_slice(&[*hub, side[0], side[1]]);
+        }
+        for (index, strip) in contour.stroke.windows(3).enumerate() {
+            let flip = index % 2;
+            self.verts
+                .extend_from_slice(&[strip[flip], strip[1 - flip], strip[2]]);
+        }
+        let mesh_vertices = self.verts.len() - start;
+        if mesh_vertices == 0 {
+            return None;
+        }
+        let stride = if isolated {
+            ISOLATED_INSTANCE_SLOTS
+        } else {
+            INSTANCE_SLOTS
+        };
+        self.verts.reserve(instances.len() * stride);
+        for instance in instances {
+            let [dx, dy] = instance.origin.map(|v| v * sx);
+            // The shape's own scissor is elided by the path painter when it
+            // holds the outline. Require a fringe of clearance from its
+            // parent scissor before using that unclipped outline here.
+            let fringe = self.fringe_width;
+            if !dx.is_finite()
+                || !dy.is_finite()
+                || bounds.minx + dx - fringe < limits[0]
+                || bounds.miny + dy - fringe < limits[1]
+                || bounds.maxx + dx + fringe > limits[2]
+                || bounds.maxy + dy + fringe > limits[3]
+            {
+                self.verts.truncate(start);
+                return None;
+            }
+            if let Some(opacity) = instance.opacity {
+                if !isolated {
+                    self.verts.truncate(start);
+                    return None;
+                }
+                let [x, y, w, h] = opacity.raster;
+                let (minx, miny) = state.transform.transform_point(x, y);
+                let (maxx, maxy) = state.transform.transform_point(x + w, y + h);
+                let raster = Bounds {
+                    minx,
+                    miny,
+                    maxx,
+                    maxy,
+                };
+                let clip = (opacity.clip != opacity.raster).then_some(opacity.clip);
+                let Some(style) = self.isolated_fill_vertices(instance.color, clip, raster) else {
+                    continue;
+                };
+                self.verts
+                    .push(Vertex::new(dx, dy, opacity.amount * state.alpha, 0.0));
+                self.verts.extend_from_slice(&style);
+            } else {
+                let mut color = instance.color;
+                color.a *= state.alpha;
+                let [r, g, b, a] = color.premultiplied().to_array();
+                self.verts
+                    .extend_from_slice(&[Vertex::new(dx, dy, -1.0, 0.0), Vertex::new(r, g, b, a)]);
+                if isolated {
+                    self.verts
+                        .extend_from_slice(&[Vertex::new(0.0, 0.0, 0.0, 0.0); 3]);
+                }
+            }
+        }
+        let count = self.verts.len() - start;
+        if count == mesh_vertices {
+            self.verts.truncate(start);
+            return Some(0);
+        }
+        let mut command = Command::new(CommandType::Triangles {
+            params: Params {
+                instanced_fill_vertices: mesh_vertices as u32,
+                direct_opacity: isolated,
+                ..Params::default()
+            },
+        });
+        command.triangles_verts = Some((start, count));
+        self.append_cmd(command);
+        Some(count * size_of::<Vertex>())
+    }
+}
