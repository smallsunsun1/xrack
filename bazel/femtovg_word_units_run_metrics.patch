+fn sliced_word_width(context: &super::TextContextImpl, word: &str, settings: &TextSettings) -> Option<f32> {
+    if context.word_slice_hints.is_empty()
+        || !(4..=8).contains(&word.len())
+        || !word.bytes().all(|byte| byte.is_ascii_alphanumeric())
+    {
+        return None;
+    }
+
+    let latin = word.bytes().any(|byte| byte.is_ascii_alphabetic());
+    let variation_hash = settings.font_variations.hash();
+    for suffix in [false, true] {
+        let slot = word_slice_hint(word.as_bytes(), suffix)?;
+        let word_hash = context.word_slice_hints[slot];
+        if word_hash == 0 {
+            continue;
+        }
+        let id = WordId {
+            word_hash,
+            font_ids: settings.font_ids,
+            variation_hash,
+            rtl: false,
+        };
+        let Some(Ok(parent)) = context.shaped_words_cache.peek(&id) else {
+            continue;
+        };
+        let Some(slice) = parent.ascii_slice.as_deref() else {
+            continue;
+        };
+        let source = &slice.source[..usize::from(slice.len)];
+        if slice.latin != latin || source.len() <= word.len() {
+            continue;
+        }
+
+        // Shaping the source and slice must pick the same script and font.
+        // A matching hint is useful only at a cluster break Rustybuzz marked safe.
+        let cut = if suffix { source.len() - word.len() } else { word.len() };
+        if slice.safe_cuts & (1 << cut) == 0 {
+            continue;
+        }
+        let glyphs = if suffix && source.ends_with(word.as_bytes()) {
+            &parent.glyphs[cut..]
+        } else if !suffix && source.starts_with(word.as_bytes()) {
+            &parent.glyphs[..cut]
+        } else {
+            continue;
+        };
+        let scale = parent.scale(settings.font_size);
+        return Some(glyphs.iter().fold(0.0, |width, glyph| {
+            width + (glyph.advance_x * scale + settings.letter_spacing)
+        }));
+    }
+    None
+}
