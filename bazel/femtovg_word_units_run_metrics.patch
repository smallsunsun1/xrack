+
+fn unified_ideograph(character: char) -> bool {
+    matches!(character, '\u{4e00}'..='\u{9fff}')
+}
+
+const WORD_SLICE_HINT_SLOTS: usize = 16_384;
+const MIN_WORD_CACHE_FOR_SLICES: usize = 8_192;
+
+fn word_slice_hint(word: &[u8], suffix: bool) -> Option<usize> {
+    let key = if suffix {
+        word.get(word.len().checked_sub(4)?..)?
+    } else {
+        word.get(..4)?
+    };
+    let key = u32::from_le_bytes(key.try_into().ok()?);
+    let slot = (key.wrapping_mul(0x9e3779b1) >> 18) as usize;
+    Some(usize::from(suffix) * WORD_SLICE_HINT_SLOTS + slot)
 }

