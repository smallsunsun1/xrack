load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "adb",
    srcs = ["android_adb.py"],
    args = ["$(rlocationpath @androidsdk//:platform-tools/adb)"],
    data = ["@androidsdk//:platform-tools/adb"],
    env = {"PYTHONDONTWRITEBYTECODE": "1"},
    main = "android_adb.py",
    python_version = "3.11",
    tags = ["manual"],
    deps = ["@rules_python//python/runfiles"],
)

exports_files([
    "accesskit_macos_mixed_state.patch",
    "android_downloads.cfg",
    "bindgen_libclang_runtime.patch",
    "bindgen_toolchain_headers.patch",
    "bindgen_windows_imports.patch",
    "ffmpeg_hls_window.patch",
    "ffmpeg_capture_interrupt.patch",
    "femtovg_batch_contour_fans.patch",
    "femtovg_cache_shaping_face.patch",
    "femtovg_cache_shaping_plans.patch",
    "femtovg_glyph_sampling.patch",
    "femtovg_vector_glyph_batches.patch",
    "femtovg_wgpu_shared_resources.patch",
    "femtovg_wgpu_stencil_only.patch",
    "femtovg_word_units.patch",
    "femtovg_word_units_run_metrics.patch",
    "femtovg_word_units_skip_rejected_metrics.patch",
    "femtovg_word_units_store_ink_lazily.patch",
    "femtovg_word_units_use_han_boundaries.patch",
    "femtovg_word_units_vertical_ink.patch",
    "femtovg_word_units_warm_ideographs.patch",
    "femtovg_write_glyph_atlas_first.patch",
    "femtovg_xrack_opacity_instances.patch",
    "femtovg_xrack_outline_runs.patch",
    "femtovg_xrack_word_ink_metrics.patch",
    "femtovg_xrack_word_ink_reuse_face.patch",
