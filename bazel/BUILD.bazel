load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "adb",
    srcs = ["android_adb.py"],
    args = ["$(rlocationpath @androidsdk//:platform-tools/adb)"],
    data = ["@androidsdk//:platform-tools/adb"],
    env = {"PYTHONDONTWRITEBYTECODE": "1"},
    main = "android_adb.py",
    python_version = "3.11",
    tags = ["manual"],
    deps = ["@rules_python//python/runfiles"],
)

exports_files([
    "accesskit_macos_mixed_state.patch",
    "android_downloads.cfg",
    "bindgen_libclang_runtime.patch",
    "bindgen_toolchain_headers.patch",
    "bindgen_windows_imports.patch",
    "ffmpeg_hls_window.patch",
    "ffmpeg_capture_interrupt.patch",
    "ffmpeg_windows_probes.patch",
    "openssl_windows_ssize_max.patch",
    "openssl_windows_winstore.patch",
    "rust_llvm_msvc_linker.patch",
    "xrack.bzl",
])

platform(
    name = "linux_gnu",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

platform(
    name = "windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@llvm//constraints/windows/crt:ucrt",
    ],
    parents = ["@platforms//host"],
)
