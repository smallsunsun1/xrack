platform(
    name = "linux_gnu",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

platform(
    name = "windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
        "@llvm//constraints/windows/crt:ucrt",
    ],
    parents = ["@platforms//host"],
)
