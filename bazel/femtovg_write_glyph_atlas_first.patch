+/// The atlas packer never reuses a cell in a live page. Reads of earlier
+/// glyphs can pass writes to other cells, if all new paths actually stay
+/// inside their reserved cells. Draw order within each page is preserved.
+#[derive(Debug, Default)]
+pub(crate) struct GlyphAtlasWrites {
+    spans: Vec<std::ops::Range<usize>>,
+    keep_inline: bool,
+}
+
+impl GlyphAtlasWrites {
+    fn record(&mut self, start: usize, commands: &[crate::renderer::Command], previous: RenderTarget) {
+        use crate::renderer::CommandType;
+
+        let span = &commands[start..];
+        if self.keep_inline || span.is_empty() {
+            return;
+        }
+        // These scopes begin by binding an atlas page and end by restoring
+        // the caller's target. A clip or any other command keeps the frame
+        // in its original order.
+        if matches!(
+            span.first().map(|command| &command.cmd_type),
+            Some(CommandType::SetRenderTarget(RenderTarget::Image(_)))
+        ) && matches!(
+            span.last().map(|command| &command.cmd_type),
+            Some(CommandType::SetRenderTarget(target)) if *target == previous
+        ) && span[..span.len() - 1].iter().all(|command| {
+            !command.clip_active
+                && matches!(
+                    command.cmd_type,
+                    CommandType::SetRenderTarget(RenderTarget::Image(_))
+                        | CommandType::ClearRect { keep_clip: false, .. }
+                        | CommandType::ConvexFill { .. }
+                        | CommandType::ConcaveFill { .. }
+                )
+        }) {
+            self.spans.push(start..commands.len());
+        } else {
+            self.keep_inline = true;
+        }
+    }
+
+    pub(crate) fn prepend(&mut self, mut commands: Vec<crate::renderer::Command>) -> Vec<crate::renderer::Command> {
+        use crate::renderer::{Command, CommandType};
+
+        let spans = std::mem::take(&mut self.spans);
+        if std::mem::take(&mut self.keep_inline) || spans.is_empty() {
+            return commands;
+        }
+        if let [span] = spans.as_slice() {
+            // Even one atlas scope can split a scene render pass. Move it
+            // ahead of the scene without rebuilding the command buffer.
+            // wgpu starts each flush on the screen, including when the
+            // original scope was recorded inside an offscreen layer.
+            commands[span.end - 1] = Command::new(CommandType::SetRenderTarget(RenderTarget::Screen));
+            commands[..span.end].rotate_right(span.len());
+            return commands;
+        }
+        let mut scene = Vec::new();
+        let mut pages: Vec<(RenderTarget, Vec<Command>)> = Vec::new();
+        let mut original = commands.into_iter();
+        let mut cursor = 0;
+        for span in spans {
+            scene.extend(original.by_ref().take(span.start - cursor));
+            // The first command selects a page, and the last restores the
+            // prior target. That restore belongs to the original scene.
+            let mut page = 0;
+            for command in original.by_ref().take(span.len() - 1) {
+                if let CommandType::SetRenderTarget(target) = command.cmd_type {
+                    page = pages.iter().position(|(key, _)| *key == target).unwrap_or_else(|| {
+                        pages.push((target, Vec::new()));
+                        pages.len() - 1
+                    });
+                } else {
+                    pages[page].1.push(command);
+                }
+            }
+            original.next();
+            cursor = span.end;
+        }
+        scene.extend(original);
+        let mut reordered =
+            Vec::with_capacity(scene.len() + pages.iter().map(|(_, page)| page.len() + 1).sum::<usize>() + 1);
+        for (target, commands) in pages {
+            reordered.push(Command::new(CommandType::SetRenderTarget(target)));
+            reordered.extend(commands);
+        }
+        reordered.push(Command::new(CommandType::SetRenderTarget(RenderTarget::Screen)));
+        reordered.extend(scene);
+        reordered
+    }
+}
