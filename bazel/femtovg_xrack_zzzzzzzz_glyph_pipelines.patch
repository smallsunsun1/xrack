+@fragment
+fn fs_clear_color() -> @location(0) vec4f {
+    return params.inner_col;
+}
+
+@fragment
+fn fs_alpha_glyph(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_alpha_glyph(vertex, 1.0);
+}
+
+@fragment
+fn fs_alpha_glyph_clip(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_alpha_glyph(vertex, clipMask(vertex.fpos));
+}
+
+@fragment
+fn fs_alpha_glyph_mask(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_alpha_glyph(vertex, clipMaskCoverage(vertex.fpos));
+}
+
+@fragment
+fn fs_alpha_glyph_clip_mask(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_alpha_glyph(vertex, clipMask(vertex.fpos) * clipMaskCoverage(vertex.fpos));
+}
+
+fn shade_alpha_glyph(vertex: VertexOutput, clip: f32) -> vec4f {
+    if strokeMask(vertex, params) < params.stroke_thr {
+        discard;
+    }
+    let coverage = scissorMask(vertex.fpos, params) * clip;
+    let mask = textureSample(glyph_texture, glyph_sampler, vertex.ftcoord).x;
+    return params.inner_col * (mask * coverage);
+}
