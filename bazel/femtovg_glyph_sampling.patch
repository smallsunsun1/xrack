+    /// The eight samples of an outline share the flattened and expanded
+    /// contours. Rasterize each with its device-space offset in the atlas.
+    fn fill_glyph_samples(
+        &mut self,
+        path: &Path,
+        origin: Transform2D,
+        scale: f32,
+        samples: &[(f32, f32)],
+        paint: &PaintFlavor,
+    ) {
+        const SUBPIXELS: f32 = 4096.0;
+        let transform = Transform2D::new(scale, 0.0, 0.0, scale, 0.0, 0.0);
+        let mut cache = path.cache(&transform, self.tess_tol, self.dist_tol);
+        cache.expand_fill(0.0, LineJoin::Miter, 2.4, FillRule::NonZero);
+
+        let params = Params::new(
+            &self.images,
+            &origin,
+            paint,
+            &GlyphTexture::default(),
+            &Scissor::default(),
+            self.fringe_width,
+            self.fringe_width,
+            -1.0,
+        );
+        let composite = self.state().composite_operation;
+        for &(dx, dy) in samples {
+            let kind = if cache.is_convex() {
+                CommandType::ConvexFill { params: params.clone() }
+            } else {
+                CommandType::ConcaveFill {
+                    stencil_params: Params::stencil(),
+                    fill_params: params.clone(),
+                }
+            };
+            let mut cmd = Command::new(kind);
+            cmd.fill_rule = FillRule::NonZero;
+            cmd.composite_operation = composite;
+
+            let start = self.verts.len();
+            self.push_fill(&mut cmd, &cache, 0.0);
+            let tx = origin[4] + dx;
+            let ty = origin[5] + dy;
+            for vertex in &mut self.verts[start..] {
+                // Use a shared subpixel grid so translating to another atlas
+                // cell can't round the coordinates to different samples.
+                vertex.x = (vertex.x * SUBPIXELS).round() / SUBPIXELS + tx;
+                vertex.y = (vertex.y * SUBPIXELS).round() / SUBPIXELS + ty;
+            }
+            self.append_cmd(cmd);
         }
     }
 
