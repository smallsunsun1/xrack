+    /// Prepares independent short LTR words in the first paint face.
+    /// The ordinary cache only takes a prepared word when that exact text is requested.
+    #[doc(hidden)]
+    pub fn prepare_short_ltr_words<'a>(&self, words: impl Iterator<Item = &'a str>, paint: &Paint) {
+        const MAX_WORDS: usize = 4096;
+        const MIN_WORDS_PER_THREAD: usize = 128;
+        let mut context = self.0.borrow_mut();
+        let limit = MAX_WORDS - context.prepared_words.len();
+        let settings = &paint.text;
+        let Some(font_id) = settings.font_ids[0] else { return };
+        if limit < 2 * MIN_WORDS_PER_THREAD {
+            return;
+        }
+        let style = WordStyle::new(settings.font_ids, &settings.font_variations);
+        let mut seen = std::collections::HashSet::with_hasher(fnv::FnvBuildHasher::default());
+        let words: Vec<_> = words.filter_map(|word| {
+            // Keep the same non-sliced shaping path as the short-word cache.
+            // A new FontId or variation setting produces a different WordId.
+            if !(2..=8).contains(&word.len()) || !word.bytes().all(|byte| byte.is_ascii_alphanumeric()) {
+                return None;
+            }
+            let id = WordId::new(word, &style, false);
+            (!context.shaped_words_cache.contains(&id) && !context.prepared_words.contains_key(&id) && seen.insert(id))
+                .then_some((id, word))
+        }).take(limit).collect();
+        let workers = std::thread::available_parallelism().map_or(1, |count| count.get())
+            .min(4).min(words.len() / MIN_WORDS_PER_THREAD);
+        if workers < 2 {
+            return;
+        }
+        let Some(font) = context.font(font_id) else { return };
+        let face = if font.metrics(1.0).variable() {
+            font.face_ref_with_variations(style.variations)
+        } else {
+            font.face_ref()
+        };
+        let face = rustybuzz::Face::from_face(face.0);
+        let units_per_em = font.units_per_em();
+        let direction = rustybuzz::Direction::LeftToRight;
+        let latin = rustybuzz::ShapePlan::new(&face, direction, Some(rustybuzz::script::LATIN), None, &[]);
+        let common = rustybuzz::ShapePlan::new(&face, direction, None, None, &[]);
+        let shape = |words: &[(WordId, &str)]| {
+            let mut buffer = rustybuzz::UnicodeBuffer::new();
+            let mut results = Vec::with_capacity(words.len());
+            for &(id, text) in words {
+                buffer.push_str(text);
+                buffer.set_direction(direction);
+                buffer.guess_segment_properties();
+                let plan = if buffer.script() == rustybuzz::script::LATIN { &latin } else { &common };
+                let output = rustybuzz::shape_with_plan(&face, plan, buffer);
+                let infos = output.glyph_infos();
+                // Missing glyphs must follow the original ordered font fallback.
+                if infos.iter().all(|info| info.glyph_id != 0) {
+                    let glyphs = output.glyph_positions().iter().zip(infos.iter().zip(text.chars()))
+                        .map(|(position, (info, character))| ShapedGlyph::from_shaping(font_id, character, info, position))
+                        .collect();
+                    let mut bytes = [0; 8];
+                    bytes[..text.len()].copy_from_slice(text.as_bytes());
+                    results.push((id, PreparedWord {
+                        text: bytes,
+                        len: text.len() as u8,
+                        shaped: ShapedWord { glyphs, units_per_em, ascii_slice: None, has_ink: false },
+                    }));
+                }
+                buffer = output.clear();
+            }
+            results
+        };
+        let prepared = std::thread::scope(|scope| {
+            let mut chunks = words.chunks(words.len().div_ceil(workers));
+            let first = chunks.next().unwrap_or_default();
+            let jobs: Vec<_> = chunks.filter_map(|chunk| {
+                let shape = &shape;
+                std::thread::Builder::new().spawn_scoped(scope, move || shape(chunk)).ok()
+            }).collect();
+            let mut prepared = shape(first);
+            for job in jobs {
+                if let Ok(mut words) = job.join() {
+                    prepared.append(&mut words);
+                }
+            }
+            prepared
+        });
+        context.prepared_words.extend(prepared);
