+    /// Prepare the initial text pipelines during window layout on Metal.
+    #[cfg(target_os = "macos")]
+    #[doc(hidden)]
+    pub fn prepare_window_text_pipelines(&self, format: wgpu::TextureFormat) {
+        use wgpu::{
+            BlendComponent, BlendOperation, BlendState, Face,
+            PrimitiveTopology::{TriangleList, TriangleStrip},
+            TextureFormat,
+        };
+
+        let mut prepared = self.shared.prepared_pipelines.borrow_mut();
+        if prepared.is_some() || !self.shared.pipelines.borrow().is_empty() {
+            return;
+        }
+        if !matches!(
+            format,
+            TextureFormat::Bgra8Unorm
+                | TextureFormat::Bgra8UnormSrgb
+                | TextureFormat::Rgba8Unorm
+                | TextureFormat::Rgba8UnormSrgb
+        ) {
+            return;
+        }
+
+        let mut winding = PipelineState::new(
+            None,
+            fill_winding_stencil(false),
+            TextureFormat::Rgba8Unorm,
+            true,
+            TriangleList,
+            None,
+            true,
+        );
+        winding.stencil_only = true;
+        // Glyph masks accumulate alpha into the red channel of the atlas.
+        let additive = BlendComponent {
+            src_factor: wgpu::BlendFactor::SrcAlpha,
+            dst_factor: wgpu::BlendFactor::One,
+            operation: BlendOperation::Add,
+        };
+        let atlas_blend = Some(BlendState {
+            color: additive,
+            alpha: additive,
+        });
+        let mut cover = PipelineState::new(
+            atlas_blend,
+            fill_cover_stencil(false, FillRule::NonZero),
+            TextureFormat::Rgba8Unorm,
+            true,
+            TriangleStrip,
+            Some(Face::Back),
+            true,
+        );
+        cover.fragment_paint = FragmentPaint::SolidColor;
+        let mut convex = PipelineState::new(
+            atlas_blend,
+            StencilTest::Disabled,
+            TextureFormat::Rgba8Unorm,
+            true,
+            TriangleList,
+            Some(Face::Back),
+            true,
+        );
+        convex.fragment_paint = FragmentPaint::SolidColor;
+        let mut text = PipelineState::new(
+            Some(BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+            StencilTest::Disabled,
+            format,
+            false,
+            TriangleList,
+            Some(Face::Back),
+            false,
+        );
+        text.fragment_paint = FragmentPaint::AlphaGlyph;
+        let mut solid = text.clone();
+        solid.fragment_paint = FragmentPaint::SolidColor;
+        let mut solid_strip = solid.clone();
+        solid_strip.primitive_topology = TriangleStrip;
+
+        let jobs = [winding, cover, convex, text, solid, solid_strip];
+        let keys = jobs.to_vec();
+        let device = self.device.clone();
+        let main_layout = self.shared.draw_layouts[0].pipeline.clone();
+        let stencil_layout = self.shared.stencil_pipeline_layout.clone();
+        let main_shader = self.shared.shader_module.clone();
+        let stencil_shader = self
+            .shared
+            .shader_for(&device, false, false, false, true)
+            .clone();
+        let (send, completed) = std::sync::mpsc::channel();
+        if std::thread::Builder::new()
+            .name("femtovg-pipelines".into())
+            .spawn(move || {
+                for key in jobs {
+                    let (layout, shader) = if key.stencil_only {
+                        (&stencil_layout, &stencil_shader)
+                    } else {
+                        (&main_layout, &main_shader)
+                    };
+                    let pipeline = key.materialize(&device, layout, shader);
+                    if send.send((key, pipeline)).is_err() {
+                        break;
+                    }
+                }
+            })
+            .is_ok()
+        {
+            *prepared = Some(PreparedTextPipelines { keys, completed });
+        }
     }
 
