+#[cfg(target_os = "macos")]
+#[derive(Debug)]
+struct PreparedTextPipelines {
+    keys: Vec<PipelineState>,
+    completed: std::sync::mpsc::Receiver<(PipelineState, wgpu::RenderPipeline)>,
+}
+
+#[cfg(target_os = "macos")]
+impl PreparedTextPipelines {
+    fn collect(
+        &mut self,
+        required: &PipelineState,
+        cache: &mut HashMap<PipelineState, CachedPipeline>,
+        epoch: u64,
+    ) {
+        use std::sync::mpsc::TryRecvError;
+
+        while !self.keys.is_empty() {
+            let next = if self.keys.contains(required) && !cache.contains_key(required) {
+                // An exact cache miss can wait for that pipeline. Draws with
+                // other states still follow the normal on-demand path.
+                self.completed
+                    .recv()
+                    .map_err(|_| TryRecvError::Disconnected)
+            } else {
+                self.completed.try_recv()
+            };
+            match next {
+                Ok((key, pipeline)) => {
+                    self.keys.retain(|pending| *pending != key);
+                    cache.entry(key).or_insert(CachedPipeline {
+                        pipeline,
+                        last_used: epoch,
+                    });
+                }
+                Err(TryRecvError::Empty) => return,
+                Err(TryRecvError::Disconnected) => self.keys.clear(),
+            }
+        }
+    }
+}
