+    /// Detect a series of identical short contours before flattening.
+    fn repeated_contour(&self) -> Option<(usize, usize)> {
+        if self.verbs.len() < 12 || self.verbs.first() != Some(&PackedVerb::MoveTo) {
+            return None;
+        }
+        let span = 1 + self.verbs[1..]
+            .iter()
+            .take(32)
+            .position(|verb| *verb == PackedVerb::MoveTo)?;
+        let copies = self.verbs.len() / span;
+        if copies < 3 || self.verbs.len() % span != 0 {
+            return None;
+        }
+        let template = &self.verbs[..span];
+        if !self.verbs.chunks_exact(span).skip(1).all(|part| part == template) {
+            return None;
+        }
+        let points = template.iter().map(|verb| match verb {
+            PackedVerb::MoveTo | PackedVerb::LineTo => 1,
+            PackedVerb::BezierTo => 3,
+            PackedVerb::Solid | PackedVerb::Hole | PackedVerb::Close => 0,
+        }).sum::<usize>();
+        if self.coords.len() != points * copies {
+            return None;
+        }
+        let template_coords = &self.coords[..points];
+        self.coords.chunks_exact(points).skip(1).all(|part| {
+            part.iter().zip(template_coords).all(|(left,right)| {
+                left.x.to_bits() == right.x.to_bits() && left.y.to_bits() == right.y.to_bits()
+            })
+        }).then_some((span, copies))
+    }
