+    /// Duplicate the already flattened contour, keeping every winding and
+    /// stroke contribution of the original path.
+    pub(super) fn repeat_contour(mut self, copies: usize) -> Self {
+        let [template] = self.contours.as_slice() else {
+            return self;
+        };
+        let template = template.clone();
+        let points = template.point_range.clone();
+        self.contours.reserve(copies - 1);
+        self.points.reserve(points.len() * (copies - 1));
+        for _ in 1..copies {
+            let start = self.points.len();
+            self.points.extend_from_within(points.clone());
+            let mut contour = template.clone();
+            contour.point_range = start..self.points.len();
+            self.contours.push(contour);
+        }
+        self.identical_contours = true;
+        self
+    }
+
+    fn share_expanded_contours(&mut self) {
+        if !self.identical_contours {
+            return;
+        }
+        let Some((first, rest)) = self.contours.split_first_mut() else {
+            return;
+        };
+        for contour in rest {
+            contour.fill.clone_from(&first.fill);
+            contour.stroke.clone_from(&first.stroke);
+            contour.bevel = first.bevel;
+            contour.reversed = first.reversed;
+            contour.convexity = first.convexity;
+        }
     }
 
