+/// Index multiple fringe or stroke contours as one draw. A restart
+/// between contours preserves the winding and order of separate strips.
+#[derive(Debug, Default)]
+struct StripIndices {
+    indices: Vec<u32>,
+    draws: Vec<Option<std::ops::Range<u32>>>,
+}
+
+impl StripIndices {
+    fn build(&mut self, first_index: u32, commands: &[super::Command]) {
+        self.indices.clear();
+        self.draws.clear();
+        for command in commands {
+            let draw = self.append(first_index, command);
+            self.draws.push(draw);
+        }
+    }
+
+    fn append(&mut self, first_index: u32, command: &super::Command) -> Option<std::ops::Range<u32>> {
+        if command.drawables.len() < 2
+            || !matches!(
+                command.cmd_type,
+                super::CommandType::ConcaveFill { .. }
+                    | super::CommandType::Stroke { .. }
+                    | super::CommandType::StencilStroke { .. }
+                    | super::CommandType::FinishBlur { stencil_params: Some(_), .. }
+            )
+        {
+            return None;
+        }
+        let mut strips = command.drawables.iter().filter_map(|drawable| drawable.stroke_verts);
+        let (start, count) = strips.next()?;
+        let (second, second_count) = strips.next()?;
+        let first = first_index + self.indices.len() as u32;
+        self.indices.extend(start as u32..(start + count) as u32);
+        for (start, count) in std::iter::once((second, second_count)).chain(strips) {
+            self.indices.push(u32::MAX);
+            self.indices.extend(start as u32..(start + count) as u32);
+        }
+        Some(first..first_index + self.indices.len() as u32)
+    }
+}
