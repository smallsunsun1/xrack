+    /// Classifies the analytic shapes and bitmap generated for a pair of rounded clips.
+    #[doc(hidden)]
+    pub fn rounded_clip_composition(
+        outer: &Path,
+        inner: &Path,
+        transform: Transform2D,
+        dpi: f32,
+    ) -> RoundedClipComposition {
+        use RoundedClipComposition::{Combined, Inner, Outer, Separate};
+        let Some((outer, _, None)) = RoundedBox::fit_with_cut(outer) else {
+            return Combined;
+        };
+        let Some((inner, _, None)) = RoundedBox::fit_with_cut(inner) else {
+            return Combined;
+        };
+        let outer = outer.transformed(&transform);
+        let inner = inner.transformed(&transform);
+        let fringe = 1.0 / dpi;
+        let (Some(outer_cover), Some(inner_cover)) = (outer.coverage(fringe), inner.coverage(fringe))
+        else {
+            return Combined;
+        };
+        if let Some(both) = outer.intersection(&inner, fringe) {
+            if both == outer {
+                Outer
+            } else if both == inner {
+                Inner
+            } else {
+                Combined
+            }
+        } else if inner_cover.contains(&outer) {
+            Outer
+        } else if outer_cover.contains(&inner) {
+            Inner
+        } else if outer.radii != [0.0; 2] && inner.radii != [0.0; 2] {
+            Separate
+        } else {
+            Combined
+        }
+    }
+
