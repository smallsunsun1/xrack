+static struct playlist *xr_hls_playlist(AVFormatContext *s, int stream_index)
+{
+    HLSContext *c = s->priv_data;
+
+    for (int i = 0; i < c->n_playlists; i++) {
+        struct playlist *pls = c->playlists[i];
+        for (int j = 0; j < pls->n_main_streams; j++)
+            if (pls->main_streams[j] == s->streams[stream_index])
+                return pls;
+    }
+    return NULL;
+}
+
+/* XRack's native wrapper calls this on its decoder thread. Return timestamps
+ * on the selected stream's DTS clock, in AV_TIME_BASE units. */
+int xrack_ffmpeg_hls_window(AVFormatContext *s, int stream_index, int refresh,
+                          int64_t *start, int64_t *end, int64_t *edge);
+
+int xrack_ffmpeg_hls_window(AVFormatContext *s, int stream_index, int refresh,
+                          int64_t *start, int64_t *end, int64_t *edge)
+{
+    HLSContext *c = s->priv_data;
+    struct playlist *pls = xr_hls_playlist(s, stream_index);
+    int64_t position;
+
+    if (!pls || pls->finished)
+        return AVERROR(ENOSYS);
+    if (refresh && av_gettime_relative() - pls->last_load_time >= default_reload_interval(pls)) {
+        int ret = parse_playlist(c, pls->url, pls, NULL);
+        if (ret < 0)
+            return ret;
+    }
+    if (pls->xr_window_start == AV_NOPTS_VALUE || !pls->n_segments)
+        return AVERROR(EAGAIN);
+
+    *start = position = pls->xr_window_start;
+    *edge = position;
+    for (int i = 0; i < pls->n_segments; i++) {
+        /* Match the default HLS start three complete segments from the end. */
+        if (i == FFMAX(pls->n_segments - 3, 0))
+            *edge = position;
+        position = av_sat_add64(position, pls->segments[i]->duration);
+    }
+    *end = position;
+
+    return 0;
 }
 
