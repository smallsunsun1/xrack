+// These classes leave BidiInfo's implicit LTR paragraph at level zero.
+// Paragraph separators and directional controls still need the full layout.
+fn simple_ltr_character(character: char) -> bool {
+    use unicode_bidi::BidiClass::{L, EN, ES, ET, CS, NSM, ON, WS, S};
+    matches!(character, ' '..='~')
+        || matches!(unicode_bidi::bidi_class(character), L | EN | ES | ET | CS | NSM | ON | WS | S)
+}
