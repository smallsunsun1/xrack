+// Resume accumulation at an exact word boundary. The ink cursor and
+// horizontal advance retain the same floating-point addition order.
+pub(super) struct InkPrefix {
+    bytes: [u8; 32],
+    len: usize,
+    fonts: FontList,
+    variations: FontVariations,
+    size: u32,
+    spacing: u32,
+    advance: f32,
+    ink: AlphabeticInk,
+}
+
+impl InkPrefix {
+    fn matches(&self, prefix: &str, settings: &TextSettings, style: &WordStyle<'_>) -> bool {
+        self.fonts == style.fonts
+            && self.size == settings.font_size.to_bits()
+            && self.spacing == settings.letter_spacing.to_bits()
+            && &self.bytes[..self.len] == prefix.as_bytes()
+            && self.variations.iter().eq(style.variations.iter())
+    }
+
+    fn new(prefix: &str, settings: &TextSettings, style: &WordStyle<'_>, advance: f32, ink: AlphabeticInk) -> Self {
+        let mut bytes = [0; 32];
+        bytes[..prefix.len()].copy_from_slice(prefix.as_bytes());
+        Self {
+            bytes,
+            len: prefix.len(),
+            fonts: style.fonts,
+            variations: style.variations.clone(),
+            size: settings.font_size.to_bits(),
+            spacing: settings.letter_spacing.to_bits(),
+            advance,
+            ink,
+        }
+    }
+}
+
+fn split_ink_prefix(text: &str) -> Option<usize> {
+    let bytes = text.as_bytes();
+    if !(4..=40).contains(&bytes.len()) {
+        return None;
+    }
+    // The trailing word is independent of the prefix after an ASCII space.
+    let tail = bytes
+        .iter()
+        .rev()
+        .take(9)
+        .take_while(|byte| byte.is_ascii_alphanumeric())
+        .count();
+    let end = bytes.len() - tail;
+    ((2..=8).contains(&tail) && (2..=32).contains(&end) && bytes[end - 1] == b' ').then_some(end)
 }
 
