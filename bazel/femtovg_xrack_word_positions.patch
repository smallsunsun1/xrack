+fn baseline_offset(baseline: Baseline, ascender: f32, descender: f32) -> f32 {
+    match baseline {
+        Baseline::Top => ascender,
+        Baseline::Middle => ascender.midpoint(descender),
+        Baseline::Alphabetic => 0.0,
+        Baseline::Bottom => descender,
+    }
+}
