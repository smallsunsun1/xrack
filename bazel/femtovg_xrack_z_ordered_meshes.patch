+        (vertices != 0).then_some(FillMesh {
+            bounds,
+            start: u32::try_from(start).ok()?,
+            vertices,
+        })
+    }
+}
diff --git a/src/renderer/wgpu/mesh_palette.wgsl b/src/renderer/wgpu/mesh_palette.wgsl
new file mode 100644
--- /dev/null
+++ b/src/renderer/wgpu/mesh_palette.wgsl
@@ -0,0 +1,44 @@
+@group(1) @binding(0) var<storage, read> mesh_palette: array<vec4f>;
+
+fn palette_vertex(vertex: u32, mesh: vec4u) -> vec4f {
+    if vertex >= mesh.y {
+        // Mesh lengths are multiples of three. Unused triangles collapse
+        // to one point and have no coverage.
+        return vec4f(0.0);
+    }
+    return mesh_palette[mesh.x + vertex];
+}
+
+struct MeshPaletteVertex {
+    @builtin(position) position: vec4f,
+    @location(0) uv: vec2f,
+    @location(1) @interpolate(flat) color: vec4f,
+}
+
+@vertex fn mesh_palette_vertex(
+    @builtin(vertex_index) vertex: u32,
+    @location(2) instance: vec4f, @location(3) color: vec4f,
+    @location(7) mesh: vec4u,
+) -> MeshPaletteVertex {
+    let sample = palette_vertex(vertex, mesh);
+    let point = sample.xy + instance.xy;
+    let position = vec4f(2.0 * point.x / view_size.x - 1.0, 1.0 - 2.0 * point.y / view_size.y, 0.0, 1.0);
+    return MeshPaletteVertex(position, sample.zw, color);
+}
+
+@fragment fn mesh_palette_fragment(input: MeshPaletteVertex) -> @location(0) vec4f {
+    let side = min(1.0, 1.0 - abs(input.uv.x * 2.0 - 1.0));
+    return input.color * (side * min(1.0, input.uv.y));
+}
+
+@vertex fn mesh_palette_opacity_vertex(
+    @builtin(vertex_index) vertex: u32,
+    @location(2) instance: vec4f, @location(3) color: vec4f,
+    @location(4) scissor_mat: vec4f, @location(5) scissor: vec4f,
+    @location(6) bounds: vec4f, @location(7) mesh: vec4u,
+) -> DirectVertex {
+    let sample = palette_vertex(vertex, mesh);
+    let point = sample.xy + instance.xy;
+    let p = vec4f(2.0 * point.x / view_size.x - 1.0, 1.0 - 2.0 * point.y / view_size.y, 0.0, 1.0);
+    return DirectVertex(p, point, sample.z, color, scissor_mat, scissor, bounds, instance.z);
+}
