+    /// Replay already-rasterized outline glyph runs in their supplied order.
+    ///
+    /// Adjacent runs using the same atlas image share a draw. A cache miss
+    /// or unsupported run returns false before recording any drawing.
+    pub fn fill_cached_glyph_runs<'a>(
+        &mut self,
+        runs: impl IntoIterator<Item = (FontId, &'a [PositionedGlyph])>,
+        paint: &Paint,
+    ) -> bool {
+        let transform = self.state().transform;
+        let scale = transform.0[0];
+        let size = paint.text.font_size * scale;
+        if cfg!(feature = "swash")
+            || !matches!(scale, 1.0 | 2.0 | 4.0)
+            || transform.0 != [scale, 0.0, 0.0, scale, 0.0, 0.0]
+            || !(size > 0.0 && size <= 92.0)
+            || self.shadow_enabled()
+            || !matches!(paint.flavor, PaintFlavor::Color(_))
+        {
+            return false;
+        }
+
+        let commands = {
+            let context = self.text_context.borrow();
+            self.glyph_atlas.cached_outline_runs(runs, size, paint.stroke.line_width * scale, scale, &context)
+        };
+        let Some(commands) = commands else { return false };
+        self.state_mut().transform = Transform2D::identity();
+        self.draw_glyph_commands(commands, paint);
+        self.state_mut().transform = transform;
+        true
     }
 
