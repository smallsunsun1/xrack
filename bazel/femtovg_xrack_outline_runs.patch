+    outline_replay: RefCell<OutlineReplay>,
     #[cfg(feature = "swash")]
     swash_scale_context: Rc<RefCell<swash::scale::ScaleContext>>,
+}
+
+#[derive(Default)]
+struct OutlineReplay {
+    settings: Option<(u32, u32)>,
+    slots: Vec<Option<OutlineEntry>>,
+}
+
+#[derive(Clone, Copy)]
+struct OutlineEntry {
+    font: FontId,
+    glyph: u16,
+    tile: Option<OutlineTile>,
+}
+
+#[derive(Clone, Copy)]
+struct OutlineTile {
+    page: usize,
+    image: ImageId,
+    bearing: [f32; 2],
+    padding: [f32; 2],
+    size: [f32; 2],
+    uv: [f32; 4],
+}
+
+impl OutlineTile {
+    fn resolve(rendered: &RenderedGlyph, texture: &FontTexture) -> Self {
+        let q = rendered.atlas_quad(0.0, 0.0, texture.atlas.size(), 0.0);
+        let [texel_width, texel_height] = rendered.texel_size;
+        Self {
+            page: rendered.texture_index,
+            image: texture.image_id,
+            bearing: [rendered.bearing_x, rendered.bearing_y],
+            padding: [GLYPH_PADDING as f32 * texel_width, GLYPH_PADDING as f32 * texel_height],
+            size: [rendered.width as f32 * texel_width, rendered.height as f32 * texel_height],
+            uv: [q.s0, q.t0, q.s1, q.t1],
+        }
+    }
+
+    fn quad(&self, x: f32, y: f32) -> Quad {
+        // Keep the same rounding and arithmetic order as atlas_quad.
+        let x0 = x.trunc() + self.bearing[0] - self.padding[0];
+        let y0 = y.round() - self.bearing[1] - self.padding[1];
+        let [s0, t0, s1, t1] = self.uv;
+        Quad { x0, y0, x1: x0 + self.size[0], y1: y0 + self.size[1], s0, t0, s1, t1 }
+    }
 }
 
