+impl RenderedGlyph {
+    fn atlas_quad(&self, x: f32, y: f32, size: (usize, usize), line_width_offset: f32) -> Quad {
+        let itw = 1.0 / size.0 as f32;
+        let ith = 1.0 / size.1 as f32;
+        let [texel_width, texel_height] = self.texel_size;
+        let x0 = x.trunc() + self.bearing_x - (line_width_offset + GLYPH_PADDING as f32) * texel_width;
+        let y0 = y.round() - self.bearing_y - (line_width_offset + GLYPH_PADDING as f32) * texel_height;
+        Quad {
+            x0,
+            y0,
+            x1: x0 + self.width as f32 * texel_width,
+            y1: y0 + self.height as f32 * texel_height,
+            s0: self.atlas_x as f32 * itw,
+            t0: self.atlas_y as f32 * ith,
+            s1: (self.atlas_x + self.width) as f32 * itw,
+            t1: (self.atlas_y + self.height) as f32 * ith,
+        }
+    }
 }
 
