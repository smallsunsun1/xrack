diff --git a/src/renderer/wgpu/atlas_fills.rs b/src/renderer/wgpu/atlas_fills.rs
new file mode 100644
--- /dev/null
+++ b/src/renderer/wgpu/atlas_fills.rs
@@ -0,0 +1,95 @@
+use super::WGPURenderer;
+use crate::{
+    Canvas, Color, CompositeOperationState, Paint, Path,
+    renderer::{Command, CommandType, Drawable, Params, ShaderType, Vertex},
+};
+
+// XYUV, premultiplied tint, inverse scissor, and scissor extent/scale.
+pub(super) const FILL_VERTEX_SLOTS: usize = 4;
+
+fn batch_params(command: &Command) -> Option<Params> {
+    let CommandType::ConvexFill { params } = command.cmd_type else {
+        return None;
+    };
+    (command.batchable_atlas_fill
+        && command.composite_operation == CompositeOperationState::default()
+        && !command.clip_active
+        && params.shader_type == ShaderType::FillColor
+        && params.clip.is_none()
+        && params.clip_mask.is_none()
+        && params.scissor_radius == 0.0
+        && params.scissor_mat[1] == 0.0
+        && params.scissor_mat[4] == 0.0
+        && params.stroke_mult == 1.0
+        && params.stroke_thr == -1.0)
+        .then_some(params)
+}
+
+impl Canvas<WGPURenderer> {
+    /// Records a solid atlas fill, which may be combined with adjacent
+    /// compatible fills when submitting the atlas.
+    #[doc(hidden)]
+    pub fn fill_opacity_atlas_path(&mut self, path: &Path, color: Color) {
+        let start = self.commands.len();
+        self.fill_path(path, &Paint::color(color));
+        if self.commands.len() == start + 1 {
+            self.commands[start].batchable_atlas_fill = true;
+        }
+    }
+
+    /// Batches consecutive atlas fills, using the expanded geometry and
+    /// scissor parameters recorded by the ordinary painter.
+    #[doc(hidden)]
+    pub fn batch_opacity_atlas_fills(&mut self) {
+        if !self.commands.iter().any(|command| command.batchable_atlas_fill) {
+            return;
+        }
+        let mut commands = std::mem::take(&mut self.commands).into_iter().peekable();
+        while let Some(command) = commands.next() {
+            let Some(params) = batch_params(&command) else {
+                self.commands.push(command);
+                continue;
+            };
+            if commands.peek().and_then(batch_params).is_none() {
+                self.commands.push(command);
+                continue;
+            }
+            let first = self.verts.len();
+            let mut drawables = Vec::new();
+            let mut current = Some((command, params));
+            while let Some((command, params)) = current.take() {
+                let tint = params.inner_col;
+                let scissor = params.scissor_mat;
+                let extra = [
+                    Vertex::new(tint[0], tint[1], tint[2], tint[3]),
+                    Vertex::new(scissor[0], scissor[5], scissor[8], scissor[9]),
+                    Vertex::new(params.scissor_ext[0], params.scissor_ext[1], params.scissor_scale[0], params.scissor_scale[1]),
+                ];
+                let mut copy = |(start, count): (usize, usize)| {
+                    let from = (self.verts.len() - first) / FILL_VERTEX_SLOTS;
+                    self.verts.reserve(count * FILL_VERTEX_SLOTS);
+                    for index in start..start + count {
+                        let vertex = self.verts[index];
+                        self.verts.push(vertex);
+                        self.verts.extend_from_slice(&extra);
+                    }
+                    (from, count)
+                };
+                for drawable in command.drawables {
+                    drawables.push(Drawable {
+                        fill_verts: drawable.fill_verts.map(&mut copy),
+                        stroke_verts: drawable.stroke_verts.map(&mut copy),
+                    });
+                }
+                let next = commands.peek().and_then(batch_params);
+                current = next.and_then(|params| commands.next().map(|command| (command, params)));
+            }
+            let mut batch = Command::new(CommandType::Triangles {
+                params: Params { atlas_fills: true, ..Params::default() },
+            });
+            batch.triangles_verts = Some((first, self.verts.len() - first));
+            batch.drawables = drawables;
+            self.commands.push(batch);
+        }
+    }
+}
