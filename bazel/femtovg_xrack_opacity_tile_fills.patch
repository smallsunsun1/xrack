new file mode 100644
--- /dev/null
+++ b/src/renderer/wgpu/atlas_fills.wgsl
@@ -0,0 +1,37 @@
+struct ViewSize {
+    x: f32,
+    y: f32,
+    pad: vec2f,
+}
+
+@group(0) @binding(0) var<uniform> view_size: ViewSize;
+
+struct AtlasVertex {
+    @builtin(position) position: vec4f,
+    @location(0) device_point: vec2f,
+    @location(1) uv: vec2f,
+    @location(2) @interpolate(flat) color: vec4f,
+    @location(3) @interpolate(flat) scissor_mat: vec4f,
+    @location(4) @interpolate(flat) scissor: vec4f,
+}
+
+@vertex fn atlas_vertex(@location(0) point: vec2f, @location(1) uv: vec2f,
+    @location(2) color: vec4f, @location(3) scissor_mat: vec4f, @location(4) scissor: vec4f) -> AtlasVertex {
+    let p = vec4f(2.0 * point.x / view_size.x - 1.0, 1.0 - 2.0 * point.y / view_size.y, 0.0, 1.0);
+    return AtlasVertex(p, point, uv, color, scissor_mat, scissor);
+}
+
+@vertex fn atlas_vertex_texture(@location(0) point: vec2f, @location(1) uv: vec2f,
+    @location(2) color: vec4f, @location(3) scissor_mat: vec4f, @location(4) scissor: vec4f) -> AtlasVertex {
+    let p = vec4f(2.0 * point.x / view_size.x - 1.0, 2.0 * point.y / view_size.y - 1.0, 0.0, 1.0);
+    return AtlasVertex(p, point, uv, color, scissor_mat, scissor);
+}
+
+@fragment fn atlas_fragment(input: AtlasVertex) -> @location(0) vec4f {
+    let side = min(1.0, 1.0 - abs(input.uv.x * 2.0 - 1.0));
+    let stroke = side * min(1.0, input.uv.y);
+    let point = input.device_point * input.scissor_mat.xy + input.scissor_mat.zw;
+    let distance = abs(point) - input.scissor.xy;
+    let fringe = clamp(vec2f(0.5) - distance * input.scissor.zw, vec2f(0.0), vec2f(1.0));
+    return input.color * (stroke * (fringe.x * fringe.y));
+}
