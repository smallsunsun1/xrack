--- /dev/null
+++ b/src/renderer/wgpu/opacity_tiles.rs
@@ -0,0 +1,101 @@
+use super::WGPURenderer;
+use crate::{
+    geometry::Bounds, paint::GlyphTexture, renderer::{Command, CommandType, Params, Vertex},
+    Canvas, ImageFlags, ImageId, Paint, PixelFormat, Rect, Scissor, Transform2D,
+};
+
+// Each instance occupies five ordinary vertex slots. The WGPU backend
+// binds that range of the frame buffer with an instance-rate layout.
+pub(super) const TILE_VERTICES: usize = 5;
+
+/// A premultiplied atlas tile painted with a rectangular scissor.
+#[doc(hidden)]
+#[derive(Clone, Copy, Debug)]
+pub struct OpacityTile {
+    /// Drawn bounds before clipping, in user coordinates as `[x, y, width, height]`.
+    pub bounds: [f32; 4],
+    /// Scissor rectangle, in user coordinates as `[x, y, width, height]`.
+    pub clip: [f32; 4],
+    /// Atlas paint origin and extent, in user coordinates as `[x, y, width, height]`.
+    pub mapping: [f32; 4],
+    /// Opacity applied after sampling the premultiplied atlas.
+    pub opacity: f32,
+}
+
+impl Canvas<WGPURenderer> {
+    /// Draws atlas tiles in order and returns the vertex bytes written.
+    /// Returns None if the canvas requires the
+    /// ordinary painter (for example, a rounded scissor or a clip path).
+    #[doc(hidden)]
+    pub fn draw_opacity_tiles(&mut self, image: ImageId, tiles: &[OpacityTile]) -> Option<usize> {
+        let state = *self.state();
+        let Transform2D([sx, b, c, sy, _, _]) = state.transform;
+        let Transform2D([_, clip_b, clip_c, _, _, _]) = state.scissor.transform;
+        if b != 0.0 || c != 0.0 || !(sx > 0.0 && sy > 0.0)
+            || clip_b != 0.0 || clip_c != 0.0 || state.scissor.radius != 0.0
+            || state.clip_depth != 0 || self.shadow_enabled()
+            || !state.composite_operation.takes_coverage()
+            || !self.images.info(image).is_some_and(|info| {
+                info.format() == PixelFormat::Rgba8
+                    && info.flags().contains(ImageFlags::PREMULTIPLIED)
+                    && !info.flags().contains(ImageFlags::FLIP_Y)
+            })
+        {
+            return None;
+        }
+        self.reconcile_current_clip_plane();
+        if self.clip_active() {
+            return None;
+        }
+        let first = self.verts.len();
+        self.verts.reserve(tiles.len() * TILE_VERTICES);
+        for tile in tiles {
+            let [x, y, w, h] = tile.bounds;
+            let (x0, y0) = state.transform.transform_point(x, y);
+            let (x1, y1) = state.transform.transform_point(x + w, y + h);
+            let mut bounds = Rect::new(x0, y0, x1 - x0, y1 - y0);
+            self.state_mut().scissor = state.scissor;
+            if tile.clip != tile.bounds {
+                let [x, y, w, h] = tile.clip;
+                self.intersect_scissor(x, y, w, h);
+            }
+            let clip = self.draw_clip(
+                || Bounds { minx: x0, miny: y0, maxx: x1, maxy: y1 },
+                None,
+            );
+            let mut scissor = clip.scissor;
+            if let Some(rect) = scissor.as_rect(self.width() as f32, self.height() as f32) {
+                let Some(intersection) = bounds.intersection(&rect) else {
+                    continue;
+                };
+                bounds = intersection;
+                scissor = Scissor::default();
+            }
+            let [x, y, w, h] = tile.mapping;
+            let paint = Paint::image(image, x, y, w, h, 0.0, tile.opacity * state.alpha);
+            let params = Params::new(&self.images, &state.transform, &paint.flavor,
+                &GlyphTexture::None, &scissor, self.fringe_width, self.fringe_width, -1.0);
+            let m = params.paint_mat;
+            let s = params.scissor_mat;
+            self.verts.extend_from_slice(&[
+                Vertex::new(bounds.x, bounds.y, bounds.x + bounds.w, bounds.y + bounds.h),
+                Vertex::new(m[0], m[5], m[8], m[9]),
+                Vertex::new(s[0], s[5], s[8], s[9]),
+                Vertex::new(params.scissor_ext[0], params.scissor_ext[1], params.scissor_scale[0], params.scissor_scale[1]),
+                Vertex::new(params.extent[0], params.extent[1], params.inner_col[3], 0.0),
+            ]);
+        }
+        self.state_mut().scissor = state.scissor;
+        let count = self.verts.len() - first;
+        if count != 0 {
+            let mut command = Command::new(CommandType::Triangles {
+                params: Params { opacity_tiles: true, ..Params::default() }
+            });
+            command.image = Some(image);
+            command.composite_operation = state.composite_operation;
+            command.triangles_verts = Some((first, count));
+            self.append_cmd(command);
+        }
+        Some(count * size_of::<Vertex>())
+    }
+}
diff --git a/src/renderer/wgpu/opacity_tiles.wgsl b/src/renderer/wgpu/opacity_tiles.wgsl
new file mode 100644
--- /dev/null
+++ b/src/renderer/wgpu/opacity_tiles.wgsl
@@ -0,0 +1,47 @@
+struct ViewSize {
+    x: f32,
+    y: f32,
+    pad: vec2f,
+}
+
+@group(0) @binding(0) var<uniform> view_size: ViewSize;
+@group(1) @binding(1) var atlas: texture_2d<f32>;
+@group(1) @binding(2) var atlas_sampler: sampler;
+
+struct TileVertex {
+    @builtin(position) position: vec4f,
+    @location(0) device_point: vec2f,
+    @location(1) @interpolate(flat) paint_mat: vec4f,
+    @location(2) @interpolate(flat) scissor_mat: vec4f,
+    @location(3) @interpolate(flat) scissor: vec4f,
+    @location(4) @interpolate(flat) image: vec4f,
+}
+
+fn tile_vertex(index: u32, bounds: vec4f, paint_mat: vec4f, scissor_mat: vec4f,
+    scissor: vec4f, image: vec4f, flipped: bool) -> TileVertex {
+    let p = vec2f(select(bounds.x, bounds.z, (index & 1u) != 0u),
+                  select(bounds.y, bounds.w, index >= 2u));
+    let y = select(1.0 - 2.0 * p.y / view_size.y, 2.0 * p.y / view_size.y - 1.0, flipped);
+    return TileVertex(vec4f(2.0 * p.x / view_size.x - 1.0, y, 0.0, 1.0),
+        p, paint_mat, scissor_mat, scissor, image);
+}
+
+@vertex fn opacity_vertex(@builtin(vertex_index) index: u32, @location(0) bounds: vec4f,
+    @location(1) paint_mat: vec4f, @location(2) scissor_mat: vec4f,
+    @location(3) scissor: vec4f, @location(4) image: vec4f) -> TileVertex {
+    return tile_vertex(index, bounds, paint_mat, scissor_mat, scissor, image, false);
+}
+
+@vertex fn opacity_vertex_texture(@builtin(vertex_index) index: u32, @location(0) bounds: vec4f,
+    @location(1) paint_mat: vec4f, @location(2) scissor_mat: vec4f,
+    @location(3) scissor: vec4f, @location(4) image: vec4f) -> TileVertex {
+    return tile_vertex(index, bounds, paint_mat, scissor_mat, scissor, image, true);
+}
+
+@fragment fn opacity_fragment(input: TileVertex) -> @location(0) vec4f {
+    let uv = (input.device_point * input.paint_mat.xy + input.paint_mat.zw) / input.image.xy;
+    let sample = textureSampleBias(atlas, atlas_sampler, uv, -0.5);
+    let distance = abs(input.device_point * input.scissor_mat.xy + input.scissor_mat.zw) - input.scissor.xy;
+    let fringe = clamp(vec2f(0.5) - distance * input.scissor.zw, vec2f(0.0), vec2f(1.0));
+    return (sample * input.image.z) * (fringe.x * fringe.y);
+}
