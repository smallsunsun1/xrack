+
+struct AlphabeticInk {
+    cursor: f32,
+    top: f32,
+    bottom: f32,
+}
+
+impl AlphabeticInk {
+    fn new(baseline: f32) -> Self {
+        Self {
+            cursor: baseline,
+            top: baseline,
+            bottom: baseline,
+        }
+    }
+
+    fn add(&mut self, glyph: &ShapedGlyph, scale: f32) {
+        let y = self.cursor + glyph.offset_y * scale - glyph.bearing_y * scale;
+        self.top = self.top.min(y);
+        self.bottom = self.bottom.max(y + glyph.height * scale);
+        self.cursor += glyph.advance_y * scale;
+    }
+
+    fn bounds(&self) -> [f32; 2] {
+        [self.top, self.top + (self.bottom - self.top)]
+    }
 }
 
