+@fragment
+fn fs_premult_image_mask(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_premult_image(vertex, clipMaskCoverage(vertex.fpos));
+}
+
+@fragment
+fn fs_premult_image_clip_mask(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_premult_image(vertex, clipMask(vertex.fpos) * clipMaskCoverage(vertex.fpos));
+}
+
+fn shade_premult_image(vertex: VertexOutput, clip: f32) -> vec4f {
+    let stroke = strokeMask(vertex, params);
+    if stroke < params.stroke_thr {
+        discard;
+    }
+    let uv = (params.paint_mat * vec3f(vertex.fpos, 1.0)).xy / params.extent;
+    let color = textureSampleBias(image_texture, image_sampler, uv, -0.5) * params.inner_col;
+    return color * (stroke * (scissorMask(vertex.fpos, params) * clip));
+}
+
