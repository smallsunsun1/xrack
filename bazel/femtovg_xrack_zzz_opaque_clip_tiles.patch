+
+fn opaque_tiles(pixels: &[u8], size: [usize; 2]) -> Vec<bool> {
+    let columns = size[0].div_ceil(OPAQUE_TILE_SIZE);
+    let mut tiles = vec![true; opaque_tile_count(size)];
+    for (y, row) in pixels.chunks_exact(size[0]).enumerate() {
+        for (x, pixels) in row.chunks(OPAQUE_TILE_SIZE).enumerate() {
+            let tile = &mut tiles[(y / OPAQUE_TILE_SIZE) * columns + x];
+            *tile = *tile && pixels.iter().all(|pixel| *pixel == 255);
+        }
+    }
+    tiles
+}
