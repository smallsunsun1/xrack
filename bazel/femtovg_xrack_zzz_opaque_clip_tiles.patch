+const OPAQUE_TILE_SIZE: usize = 16;
+
+fn opaque_tile_count([width, height]: [usize; 2]) -> usize {
+    width.div_ceil(OPAQUE_TILE_SIZE) * height.div_ceil(OPAQUE_TILE_SIZE)
