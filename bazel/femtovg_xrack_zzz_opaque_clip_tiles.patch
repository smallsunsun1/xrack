+    pub(crate) fn covers(&self, origin: [i32; 2], bounds: crate::geometry::Bounds, pad: f32) -> bool {
+        if self.opaque_tiles.is_empty() {
+            return false;
+        }
+        let [width, height] = self.size();
+        let left = (bounds.minx - pad - origin[0] as f32).floor();
+        let top = (bounds.miny - pad - origin[1] as f32).floor();
+        let right = (bounds.maxx + pad - origin[0] as f32).ceil();
+        let bottom = (bounds.maxy + pad - origin[1] as f32).ceil();
+        if !(left >= 0.0 && top >= 0.0 && right <= width as f32 && bottom <= height as f32
+            && left < right && top < bottom)
+        {
+            return false;
+        }
+        let columns = width.div_ceil(OPAQUE_TILE_SIZE);
+        let left = left as usize / OPAQUE_TILE_SIZE;
+        let right = (right as usize).div_ceil(OPAQUE_TILE_SIZE);
+        let top = top as usize / OPAQUE_TILE_SIZE;
+        let bottom = (bottom as usize).div_ceil(OPAQUE_TILE_SIZE);
+        (top..bottom).all(|row| {
+            self.opaque_tiles[row * columns + left..row * columns + right]
+                .iter().all(|opaque| *opaque)
+        })
     }
 
