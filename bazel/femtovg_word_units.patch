+
+impl ShapedWord {
+    fn scale(&self, size: f32) -> f32 {
+        size / f32::from(self.units_per_em)
+    }
+
+    fn width(&self, scale: f32, letter_spacing: f32) -> f32 {
+        self.glyphs
+            .iter()
+            .fold(0.0, |width, glyph| width + (glyph.advance_x * scale + letter_spacing))
+    }
+
+    fn append(&self, glyphs: &mut Vec<ShapedGlyph>, scale: f32, byte_index: usize, rtl: bool) {
+        let start = glyphs.len();
+        glyphs.extend(self.glyphs.iter().map(|glyph| {
+            let mut glyph = *glyph;
+            glyph.byte_index += byte_index;
+            glyph.width *= scale;
+            glyph.height *= scale;
+            glyph.advance_x *= scale;
+            glyph.advance_y *= scale;
+            glyph.offset_x *= scale;
+            glyph.offset_y *= scale;
+            glyph.bearing_y *= scale;
+            glyph
+        }));
+        if rtl {
+            glyphs[start..].reverse();
+        }
+    }
+}
