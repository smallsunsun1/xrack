+fn cached_word<'a>(
+    context: &'a mut super::TextContextImpl,
+    word: &str,
+    direction: rustybuzz::Direction,
+    font_ids: [Option<FontId>; 8],
+    variations: &FontVariations,
+) -> Option<&'a ShapedWord> {
+    let mut hasher = FnvHasher::default();
+    word.hash(&mut hasher);
+    let id = WordId {
+        word_hash: hasher.finish(),
+        font_ids,
+        variation_hash: variations.hash(),
+        rtl: direction == rustybuzz::Direction::RightToLeft,
+    };
+    if !context.shaped_words_cache.contains(&id) {
+        let shaped = shape_word(word, direction, context, &font_ids, variations);
+        context.shaped_words_cache.put(id, shaped);
+    }
+    context.shaped_words_cache.get(&id)?.as_ref().ok()
 }
 
