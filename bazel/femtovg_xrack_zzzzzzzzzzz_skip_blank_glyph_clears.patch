 pub struct FontTexture {
     pub atlas: Atlas,
     pub(crate) image_id: ImageId,
+    zeroed_unused_cells: bool,
+}
+
+impl FontTexture {
+    fn skip_redundant_clear(
+        &mut self,
+        confined: bool,
+        first: Option<&mut crate::renderer::Command>,
+    ) {
+        // An unconfined path or stroke may leave color and stencil in cells
+        // that are not reserved yet. Keep their clears for the rest of this page.
+        self.zeroed_unused_cells &= confined;
+        if !self.zeroed_unused_cells {
+            return;
+        }
+        if let Some(command) = first.filter(|command| {
+            matches!(command.cmd_type, crate::renderer::CommandType::ClearRect { keep_clip: false, .. })
+        }) {
+            // The fresh cell is already blank and its mask samples use red only.
+            // Keep the command slot until the batch has grouped the glyph samples.
+            command.triangles_verts = None;
+        }
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn glyph_atlas_clear_is_retained_after_an_unconfined_mask() {
+    use crate::renderer::{Command, CommandType};
+
+    let mut canvas = Canvas::new(crate::RecordingRenderer::default()).unwrap();
+    let image_id = canvas
+        .create_image_empty(16, 16, PixelFormat::Rgba8, ImageFlags::empty())
+        .unwrap();
+    let mut texture = FontTexture {
+        atlas: Atlas::new(16, 16),
+        image_id,
+        zeroed_unused_cells: true,
+    };
+    for (confined, keep_clear) in [(true, false), (false, true), (true, true)] {
+        let mut clear = Command::new(CommandType::ClearRect {
+            color: Color::black(),
+            keep_clip: false,
+        });
+        clear.triangles_verts = Some((0, 6));
+        texture.skip_redundant_clear(confined, Some(&mut clear));
+        assert_eq!(clear.triangles_verts.is_some(), keep_clear);
+    }
 }
 
