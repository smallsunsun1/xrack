     /// Creates a new renderer for the device.
     pub fn new(device: wgpu::Device, queue: wgpu::Queue) -> Self {
         let shared = Rc::new(SharedGpuResources::new(&device, &queue));
+        Self::with_shared_resources(device, queue, shared)
+    }
+
+    /// Creates a renderer reusing live pipeline resources for this device
+    /// and queue on the current thread.
+    #[doc(hidden)]
+    pub fn new_with_device_cache(
+        instance: &wgpu::Instance,
+        device: wgpu::Device,
+        queue: wgpu::Queue,
+    ) -> Self {
+        let cached = DEVICE_RESOURCES.with_borrow_mut(|resources| {
+            let mut cached = None;
+            resources.retain(|entry| {
+                let Some(shared) = entry.upgrade() else {
+                    return false;
+                };
+                // Native wgpu device and queue IDs are local to an instance.
+                if shared.instance.as_ref() == Some(instance)
+                    && shared.device == device
+                    && shared.queue == queue
+                {
+                    cached = Some(shared);
+                }
+                true
+            });
+            cached
+        });
+        let shared = cached.unwrap_or_else(|| {
+            let mut shared = SharedGpuResources::new(&device, &queue);
+            shared.instance = Some(instance.clone());
+            let shared = Rc::new(shared);
+            DEVICE_RESOURCES.with_borrow_mut(|resources| resources.push(Rc::downgrade(&shared)));
+            shared
+        });
         Self::with_shared_resources(device, queue, shared)
     }
 
