+#[derive(Clone, Copy, Eq, PartialEq)]
+struct FontList {
+    hash: u64,
+    ids: [Option<FontId>; 8],
+}
+
+impl FontList {
+    fn new(ids: [Option<FontId>; 8]) -> Self {
+        let mut hash = FnvHasher::default();
+        ids.hash(&mut hash);
+        Self { hash: hash.finish(), ids }
+    }
+}
+
+impl Hash for FontList {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        // Equality still compares the complete ordered font list.
+        state.write_u64(self.hash);
+    }
+}
+
+struct WordStyle<'a> {
+    fonts: FontList,
+    variations: &'a FontVariations,
+    variation_hash: u64,
+}
+
+impl<'a> WordStyle<'a> {
+    fn new(ids: [Option<FontId>; 8], variations: &'a FontVariations) -> Self {
+        Self { fonts: FontList::new(ids), variations, variation_hash: variations.hash() }
+    }
+}
