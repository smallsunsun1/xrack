new file mode 100644
--- /dev/null
+++ b/src/renderer/wgpu/stencil.wgsl
@@ -0,0 +1,22 @@
+struct ViewSize {
+    x: f32,
+    y: f32,
+    pad: vec2<f32>,
+}
+
+@group(0) @binding(0) var<uniform> view_size: ViewSize;
+
+@vertex
+fn vs_main(@location(0) point: vec2<f32>) -> @builtin(position) vec4<f32> {
+    return vec4<f32>(2.0 * point.x / view_size.x - 1.0, 1.0 - 2.0 * point.y / view_size.y, 0.0, 1.0);
+}
+
+@vertex
+fn vs_main_texture(@location(0) point: vec2<f32>) -> @builtin(position) vec4<f32> {
+    return vec4<f32>(2.0 * point.x / view_size.x - 1.0, 2.0 * point.y / view_size.y - 1.0, 0.0, 1.0);
+}
+
+@fragment
+fn fs_stencil() -> @location(0) vec4<f32> {
+    return vec4<f32>(0.0);
+}
