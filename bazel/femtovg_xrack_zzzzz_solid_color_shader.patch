+@fragment
+fn fs_solid_color(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_solid_color(vertex, 1.0);
+}
+
+@fragment
+fn fs_solid_color_clip(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_solid_color(vertex, clipMask(vertex.fpos));
+}
+
+@fragment
+fn fs_solid_color_mask(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_solid_color(vertex, clipMaskCoverage(vertex.fpos));
+}
+
+@fragment
+fn fs_solid_color_clip_mask(vertex: VertexOutput) -> @location(0) vec4f {
+    return shade_solid_color(vertex, clipMask(vertex.fpos) * clipMaskCoverage(vertex.fpos));
+}
+
+fn shade_solid_color(vertex: VertexOutput, clip: f32) -> vec4f {
+    let stroke = strokeMask(vertex, params);
+    if stroke < params.stroke_thr {
+        discard;
+    }
+    return params.inner_col * (stroke * (scissorMask(vertex.fpos, params) * clip));
+}
