--- a/ffmpeg_config_checks.bzl
+++ b/ffmpeg_config_checks.bzl
@@ -173,20 +173,13 @@
     #
     # Getting this one wrong is not a missing feature but a silent miscompile:
-    # av_malloc() falls through to plain malloc() (libavutil/mem.c:110), which
-    # aligns to 16 on Windows, and every `mova` in FFmpeg's AVX2 kernels then
-    # faults on a buffer that only happens to be 32-byte aligned. Meanwhile
-    # _aligned_malloc is unconditionally present in the UCRT and in mingw-w64,
-    # so on Windows a "no" answer here can only ever be a broken probe.
-    #
-    # It was exactly that on the BCR Windows machine, which failed this probe on
-    # one run and a different arbitrary handful of AC_TRY_LINK probes on the
-    # next: rules_cc_autoconf ran cl.exe without /Fo, so concurrent
-    # configurations raced on one intermediate object in the shared execroot.
-    # Fixed in rules_cc_autoconf 0.20.0, which is why this is no longer OR'd
-    # with windows.h.
-    checks.AC_TRY_LINK(name = "ac_cv_aligned_malloc", code = "void *p = _aligned_malloc(1, 16); _aligned_free(p);", includes = ["#include <malloc.h>"]),
+    # The UCRT provides the declarations and the functions. A failed link
+    # probe otherwise makes av_malloc use plain malloc, which on Windows
+    # does not guarantee the alignment of FFmpeg's AVX buffers.
+    checks.AC_TRY_COMPILE(name = "ac_cv_aligned_malloc", code = "(void)sizeof(&_aligned_malloc); (void)sizeof(&_aligned_free);", includes = ["#include <malloc.h>"]),
     checks.AC_TRY_LINK(define = "HAVE_ARC4RANDOM_BUF", code = "long x = (long)arc4random_buf; (void)x;", includes = ["#include <stdlib.h>"]),
     checks.AC_TRY_LINK(define = "HAVE_CLOCK_GETTIME", code = "long x = (long)clock_gettime; (void)x;", includes = ["#include <time.h>"]),
-    checks.AC_TRY_LINK(define = "HAVE_CLOSESOCKET", code = "long x = (long)closesocket; (void)x;", includes = _WINSOCK_INCLUDES),
+    # The Windows targets already link ws2_32. Probe the declaration rather
+    # than linking through the autoconf runner, whose SDK can differ from the target.
+    checks.AC_TRY_COMPILE(define = "HAVE_CLOSESOCKET", code = "(void)sizeof(&closesocket);", includes = _WINSOCK_INCLUDES),
     # AC_CHECK_LIB rather than AC_TRY_LINK because the symbol needs a library
     # named: CommandLineToArgvW lives in shell32.dll and shellapi.h carries no
@@ -200,5 +193,5 @@
     checks.AC_TRY_LINK(define = "HAVE_ELF_AUX_INFO", code = "long x = (long)elf_aux_info; (void)x;", includes = ["#include <sys/auxv.h>"]),
     checks.AC_CHECK_FUNC("fcntl", define = "HAVE_FCNTL"),
-    checks.AC_TRY_LINK(define = "HAVE_GETADDRINFO", code = "long x = (long)getaddrinfo; (void)x;", includes = _net_includes(["#include <sys/types.h>", "#include <sys/socket.h>", "#include <netdb.h>"])),
+    checks.AC_TRY_COMPILE(define = "HAVE_GETADDRINFO", code = "(void)sizeof(&getaddrinfo);", includes = _net_includes(["#include <sys/types.h>", "#include <sys/socket.h>", "#include <netdb.h>"])),
     checks.AC_TRY_LINK(define = "HAVE_GETAUXVAL", code = "long x = (long)getauxval; (void)x;", includes = ["#include <sys/auxv.h>"]),
     checks.AC_TRY_LINK(define = "HAVE_GETENV", code = "long x = (long)getenv; (void)x;", includes = ["#include <stdlib.h>"]),
