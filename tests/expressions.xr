component LazyChild inherits Rectangle {
    in property <int> input: 0;
    out property <int> doubled: input * 2;
}

export component LazyProperties inherits Window {
    in-out property <bool> use-left: true;
    in-out property <int> left: 3;
    in-out property <int> right: 8;
    in-out property <int> unused: 0;
    pure callback observe(int) -> int;
    pure callback format-value(int) -> string;
    pure callback format-right(int) -> string;
    in-out property <int> result: root.observe(root.use-left ? root.left : root.right);
    out property <int> shown: child.doubled;
    child := LazyChild { input: root.result; }
    label := Text { text: root.format-value(root.shown); }
    right-label := Text { text: root.format-right(root.right); }
}

export component LazyList inherits Window {
    in-out property <[string]> items: [];
    in-out property <bool> show-list: true;
    in-out property <bool> use-suffix: true;
    in-out property <string> suffix: "!";
    in-out property <int> details: 1;
    in-out property <int> unrelated: 0;
    pure callback row-label(string, int, string) -> string;
    pure callback row-index(int) -> string;
    pure callback detail-label(string, int, int) -> string;

    Text { text: "unrelated=" + root.unrelated; }
    if root.show-list : VerticalLayout {
        for item[index] in root.items : HorizontalLayout {
            Text { text: root.row-label(item, index, index == 2 && root.use-suffix ? root.suffix : ""); }
            Text { text: root.row-index(index); }
            if index == 2 : VerticalLayout {
                for detail in root.details : Text { text: root.detail-label(item, index, detail); }
            }
        }
    }
}

export component SharedVisuals inherits Window {
    in-out property <int> count: 0;
    in-out property <[string]> items: ["A", "B"];
