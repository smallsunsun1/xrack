export component CallbackModelSnapshots inherits Window {
    in-out property <[string]> strings: ["before"];
    in-out property <[CallbackSnapshotRow]> rows: [CallbackSnapshotRow { text: "before" }];
    out property <bool> saw-original: false;
    out property <[string]> saved-strings;
    out property <[CallbackSnapshotRow]> saved-rows;
    out property <[TouchPoint]> empty-points: root.copy-points([]);
    out property <styled-text> styled-copy: root.copy-style(@markdown("**bold**"));

    pure callback change-models() -> bool;
    pure callback compare([string], [CallbackSnapshotRow], bool) -> bool;
    compare(strings, rows, changed) => {
        changed && strings == ["before"] && rows == [CallbackSnapshotRow { text: "before" }]
    }
    pure callback current-strings() -> [string];
    current-strings => { root.strings }
    pure callback current-rows() -> [CallbackSnapshotRow];
    current-rows => { root.rows }
    pure callback copy-points([TouchPoint]) -> [TouchPoint];
    copy-points(points) => { points }
    pure callback copy-style(styled-text) -> styled-text;
    copy-style(text) => { text }
    callback run;
    run => {
        root.saw-original = root.compare(root.strings, root.rows, root.change-models());
        root.saved-strings = root.current-strings();
        root.saved-rows = root.current-rows();
    }
}

export struct ToggleDelegateRow {
    enabled: bool,
    state: CheckState,
}

export component ToggleDelegateEvents inherits Window {
    width: 240px;
    height: 180px;
    in-out property <[ToggleDelegateRow]> rows: root.initial-rows();
    out property <int> trace: 0;
    in-out property <bool> three-states: true;
    pure callback initial-rows() -> [ToggleDelegateRow];
    initial-rows => {
        root.copy-rows([ToggleDelegateRow { enabled: false, state: CheckState.unchecked }])
    }
    pure callback copy-rows([ToggleDelegateRow]) -> [ToggleDelegateRow];
    copy-rows(rows) => { rows }

    checks := ListView {
        x: 0px; y: 0px; width: 200px; height: 72px; row-height: 32px;
        for row in root.rows : CheckDelegate {
            text: "Checked";
            checked <=> row.enabled;
            toggled => { root.trace = root.trace * 10 + (row.enabled ? 1 : 2); }
            check-state-changed(state) => {
                root.trace = root.trace * 10 + (state == CheckState.checked ? 3 : 4);
            }
        }
    }
    states-list := ListView {
        x: 0px; y: 80px; width: 200px; height: 72px; row-height: 32px;
        for row in root.rows : CheckDelegate {
            text: "Tristate";
            tristate: root.three-states;
            check-state <=> row.state;
            toggled => {
                root.trace = root.trace * 10 + (row.state == CheckState.partially-checked ? 5 : 7);
            }
            check-state-changed(state) => {
                root.trace = root.trace * 10 + (state == CheckState.partially-checked ? 6 : 8);
            }
        }
    }
}

