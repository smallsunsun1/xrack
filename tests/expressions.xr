export component ImageRecordEqualityParity inherits Window {
    in-out property <ComparedCard> original;
    in-out property <ComparedCard> candidate;
    in-out property <[ComparedCard]> originals;
    in-out property <[ComparedCard]> candidates;
    out property <bool> same-source: root.original.picture.source == root.candidate.picture.source;
    out property <bool> same-record: root.original == root.candidate;
    out property <bool> different-record: root.original != root.candidate;
    out property <bool> same-list: root.originals == root.candidates;
    out property <int> received: 0;
    callback receive(card: ComparedCard);
    callback supply() -> ComparedCard;
    callback observe-list(rows: [ComparedCard]);
    callback publish();
    receive(card) => { root.received += 1; }
    publish => { root.observe-list(root.originals); }
}

