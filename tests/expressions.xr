    color-popup := ColorPickerPopup {
        open <=> root.color-open;
        show-alpha: root.color-alpha();
        canceled => { root.cancels += 1; }
    }
    date-popup := DatePickerPopup {
        open <=> root.date-open;
        maximum-date: root.date-maximum();
        canceled => { root.cancels += 1; }
    }
    time-popup := TimePickerPopup {
        open <=> root.time-open;
        use-24-hour-format: root.time-format();
        canceled => { root.cancels += 1; }
    }
}

export component ViewportOffsetRetryParity inherits Window {
    in-out property <length> offset: -48px;
    pure callback read-offset(length) -> length;
    read-offset(value) => { value }
    ScrollView {
        content-y: root.read-offset(root.offset);
        content-height: 300px;
    }
}

component CallbackPrecedenceLeaf inherits Rectangle {
    pure callback score(int) -> int;
    score(value) => { value + 1 }
}

component CallbackPrecedenceInner inherits Rectangle {
    pure callback first <=> leaf.score;
    pure callback second <=> leaf.score;
    leaf := CallbackPrecedenceLeaf {}
}

component CallbackPrecedenceOuter inherits Rectangle {
    pure callback supplied <=> inner.first;
    pure callback fallback <=> inner.second;
    fallback(value) => { value + 10 }
    inner := CallbackPrecedenceInner {
        first(value) => { value + 20 }
    }
}

export component CallbackPrecedenceParity inherits Window {
    out property <int> overridden: with-override.fallback(1);
    out property <int> fallback: with-default.supplied(1);
    with-override := CallbackPrecedenceOuter { supplied(value) => { value + 30 } }
    with-default := CallbackPrecedenceOuter {}
}

component PropertyForwardLeaf inherits Rectangle {
    in-out property <int> value: 1;
}

component PropertyForwardInner inherits Rectangle {
    in-out property <int> first <=> leaf.value;
    in-out property <int> second <=> leaf.value;
    leaf := PropertyForwardLeaf {}
}

component PropertyForwardOuter inherits Rectangle {
    in-out property <int> supplied <=> inner.first;
    in-out property <int> fallback <=> inner.second;
    inner := PropertyForwardInner { second: 20; }
}

export component PropertyForwardParity inherits Window {
    in-out property <int> external: 30;
    in-out property <int> edited <=> with-override.fallback;
    out property <int> overridden: with-override.supplied;
    out property <int> fallback: with-default.supplied;
    with-override := PropertyForwardOuter { supplied <=> root.external; }
    with-default := PropertyForwardOuter {}
}

export struct RowGroupInputRecord { name: string, expanded: bool }

component RowGroupInputContent inherits Rectangle {
    callback hit();
    button := Button { text: "Hit"; clicked => { root.hit(); } }
}

export component RowGroupInputParity inherits Window {
    width: 320px; height: 200px;
    in-out property <[RowGroupInputRecord]> rows: [
        RowGroupInputRecord { name: "A", expanded: true },
        RowGroupInputRecord { name: "B", expanded: false },
    ];
    out property <string> hits: "";
    TableView {
        row-height: 64px;
        TableColumn { title: "Group"; width: 280px; }
        for row[index] in root.rows : TableRow {
            GroupBox {
                checkable: true;
                checked: row.expanded;
                RowGroupInputContent { hit => { root.hits += row.name; } }
                for child in index + 2 : GroupBox {
                    checkable: true;
                    checked: child == 0;
                    Text { text: row.name; }
                }
            }
        }
    }
}

export struct TreeEditScopeRow { key: int, parent: int, label: string }

export component TreeEditScopeParity inherits Window {
    width: 320px; height: 200px;
    in-out property <bool> shown: true;
    in-out property <[TreeEditScopeRow]> rows: [TreeEditScopeRow { key: 1, parent: -1, label: "original" }];
    pure callback row-visible() -> bool;
    pure callback cell-enabled() -> bool;
    row-visible => { true }
    cell-enabled => { true }
    TreeView {
        for row in root.rows : TreeRow {
            key: row.key; parent-key: row.parent;
            visible: root.shown && root.row-visible();
            TreeCell { enabled: root.cell-enabled(); text <=> row.label; }
        }
    }
}

export component RepeatedGroupParity inherits Window {
    in-out property <[string]> labels: ["A", "B"];
    in-out property <bool> allow-rows: true;
    for label in root.labels : GroupBox {
        title: label;
        enabled: root.allow-rows;
        checkable: true;
        checked: label == "A";
        for child in 2 : GroupBox {
            checkable: true;
            checked: child == 0;
            Text { text: label; }
        }
    }
}
