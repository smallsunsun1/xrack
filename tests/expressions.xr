export component EmptyOrdinaryRepeats inherits Window {
    in-out property <int> count: 0;
    out property <int> clicks: 0;
    pure callback describe(int) -> string;
    describe(index) => { "" + index }
    for row in 0 : Text { text: root.describe(row); }
    for row in -1 : Rectangle {}
    for item in [] : Text { text: item; }
    for row in root.count : Text { text: root.describe(row); }
    ListView { for row in 0 : Text {} }
    natural := Rectangle {
        Rectangle { z: 1; }
        Rectangle { z: 2; }
    }
    tail := Button { clicked => { root.clicks += 1; } }
}

