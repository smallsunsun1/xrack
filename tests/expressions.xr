    in-out property <int> current: root.read-key();
    out property <int> changes: 0;
    out property <int> expansions: 0;
    out property <int> collapses: 0;
    out property <int> current-at-collapse: -1;
    out property <int> selected-count: 0;
    pure callback read-key() -> int;
    pure callback query-root() -> int;
    query-root => { -1 }
    callback select-source(int);
    callback expand-root();
    callback collapse-root();
    expand-root => { branches.expand(1); }
    collapse-root => { branches.collapse(1); }
    select-source(source) => { branches.select-source-index(source); }
    read-key => { -1 }

    branches := TreeView {
        root-key: root.query-root();
        enabled: root.allowed;
        multi-select: root.multiple;
        current-key <=> root.current;
        changed(key) => { root.changes += 1; }
        expanded(key) => { root.expansions += 1; }
        collapsed(key) => { root.collapses += 1; root.current-at-collapse = root.current; }
        selection-changed(count) => { root.selected-count = count; }
        for entry in root.records : TreeRow {
            key: entry.id; parent-key: entry.parent;
            TreeCell { text: entry.label; }
        }
    }
}

export component CallbackReplacementParity inherits Window {
    out property <int> steps: 0;
    out property <int> observed: root.probe();
    callback replace();
    callback advance() -> int;
    pure callback probe() -> int;

    advance => { root.steps += 1; root.replace(); -1 }
    probe => { 0 }
}

