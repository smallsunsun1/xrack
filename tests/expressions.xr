    Label { text: root.message; width: 180px; height: 28px; y: 32px; }
    Label { text: root.summary; y: 64px; }
}

export component LocalAliasUpdates inherits Window {
    property <int> value: 7;
    property <int> middle <=> root.value;
    property <int> tail <=> root.middle;
    in-out property <int> exposed <=> root.tail;
    out property <int> observed: root.tail;
    callback step();
    step => { root.tail += 2; }
}

export component AnimationTimingParity inherits Window {
    in-out property <bool> active: true;
    pure callback motion(int) -> bool;
    motion(tag) => { true }

    Rectangle {
        x: root.active ? 20px : 10px;
        y: root.active ? 30px : 10px;
        width: 100px;
        height: 20px;
        animate x { duration: 0ms; enabled: root.motion(1); }
        animate y { delay: 20ms; enabled: root.motion(2); }
        animate height { duration: 0ms; }
        states [
            active when root.active: {
                width: 200px;
                in { animate width { duration: 40ms; enabled: root.motion(3); } }
                out { animate width { duration: 60ms; enabled: root.motion(4); } }
            }
        ]
    }
}

export component StaticStatePlans inherits Window {
    in-out property <string> message: "Ready";
    pure callback fallback-width() -> length;
    fallback-width => { 20px }

    grid := GridLayout {
        tile := Rectangle { col: 0; width: root.fallback-width(); height: 20px; }
    }
    status := Text { text: root.message; width: 120px; }
    states [
        settled when true: { tile.col: 1; tile.width: 40px; status.height: 24px; }
    ]
}

export component MergedStateCases inherits Window {
    in-out property <int> mode: 0;
    pure callback probe(int, int) -> bool;
    out property <bool> flag: root.mode == 1 ? true : root.probe(4, root.mode);
    panel := Text { text: "Base"; }
    states [
        first when root.probe(1, root.mode): { panel.text: "Shared"; }
        second when root.probe(2, root.mode): { panel.text: "Shared"; }
        third when root.probe(3, root.mode): { panel.text: "Third"; }
    ]
}

export component ActionStateParity inherits Window {
    in-out property <bool> command-enabled: false;
    in-out property <bool> alternate: true;
    out property <int> activations: 0;
    pure callback allow-button(int) -> bool;

    command := Action {
        enabled: root.command-enabled;
        activated => { root.activations += 1; }
    }
    button := Button {
        action: command;
        enabled: root.allow-button(2);
        states [ alternate when root.alternate: { enabled: root.allow-button(1); } ]
    }
}

export component ActionPresentationParity inherits Window {
    pure callback read-flag(int) -> bool;
    pure callback read-label() -> string;

    command := Action {
        enabled: root.read-flag(2);
        checkable: root.read-flag(1);
        checked: root.read-flag(3);
        text: root.read-label();
    }
    button := Button { action: command; }
}

export component LiveActionActivationParity inherits Window {
    in-out property <bool> command-enabled: true;
    in-out property <bool> menu-enabled: true;
    in-out property <bool> menu-parent-enabled: true;
    in-out property <bool> menu-checkable: true;
    in-out property <bool> action-checked: false;
    in-out property <bool> menu-checked: false;
    out property <int> action-activations: 0;
    out property <int> menu-activations: 0;
    pure callback check-action() -> bool;
    pure callback check-menu-item() -> bool;
    check-action => { true }
    check-menu-item => { root.menu-checkable }

    command := Action {
        enabled: root.command-enabled;
        checkable: root.check-action();
        checked <=> root.action-checked;
        activated => { root.action-activations += 1; }
    }
    button := Button { action: command; }
    MenuBar {
        Menu {
            title: "Menu";
            enabled: root.menu-parent-enabled;
            item := MenuItem {
                text: "Item";
                enabled: root.menu-enabled;
                checkable: root.check-menu-item();
                checked <=> root.menu-checked;
                activated => { root.menu-activations += 1; }
            }
            linked-item := MenuItem { enabled: root.menu-enabled; action: command; }
        }
    }
}

