export component Expressions inherits Rectangle {
    in-out property <int> base-value: 3;
    out property <int> precedence: 1 + 2 * 3;
    out property <int> left-associative: 10 - 3 - 2;
    out property <float> promoted: base-value + 0.5;
    out property <float> ratio: 12px / 4px;
    out property <length> scaled: 8px * 2;
    out property <length> scalar-left: 2 * 1.5px;
    out property <length> negative: -3px;
    out property <length> combined: (8px - 2px) / 2;
    out property <bool> comparison: base-value >= 2 && !false;
    out property <color> foreground: #0f08;
    out property <bool> same-color: foreground == #00ff0088;
    out property <string> greeting: "hello " + "\u4f60\u597d\n\"UI\"";
    out property <string> selected: comparison ? greeting : "other";
    out property <string> numbers: "n=" + base-value + ", f=" + promoted + ", ok=" + comparison;
    out property <int> safe-ratio: base-value == 0 ? 42 : 12 / base-value;
    out property <bool> guarded: base-value != 0 && 12 / base-value > 0;
    callback update(type: int);
    update(type) => { root.base-value = type; }
    callback step();
    step() => { root.base-value += 1; root.base-value += root.base-value; }
    out property <int> calls: 0;
    out property <bool> branch-result: false;
    callback touch() -> bool;
    touch => { root.calls += 1; true }
    callback run-branch(bool);
    run-branch(run) => { root.branch-result = !!(run && (root.touch() && true)); }
    out property <int> branch-value: 0;
    callback run-equal-branches();
    run-equal-branches() => { root.branch-value = root.touch() ? 7 : 7; }
    width: scaled;
}

export component LiteralDecodingParity inherits Window {
    out property <int> integer: 9223372036854775807;
    out property <float> signed-zero: -0.0;
    out property <float> fraction: 12.5%;
    out property <length> extent: 1.25e2px;
    out property <color> tint: #aB09;
    out property <string> caption: "版\n\"\u0041\"";
    out property <StandardButtonKind> button: StandardButtonKind.yes-to-all;
    out property <MessageButtons> buttons: MessageButtons.yes-no-cancel;
    out property <PointerEvent> pointer;
    out property <TouchPoint> touch;
}

export component BrushPromotionParity inherits Window {
    in-out property <brush> paint: #f00;
    in-out property <color> tint: #f00;
    in-out property <bool> use-color: true;
    out property <bool> left: root.paint == root.tint;
    out property <bool> right: root.tint != root.paint;
    out property <brush> first: root.use-color ? root.tint : root.paint;
    out property <brush> second: root.use-color ? root.paint : root.tint;
    Rectangle { background: root.first; }
    Rectangle { background: root.second; }
}

