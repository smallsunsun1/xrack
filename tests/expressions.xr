struct ClipboardProbeRow { text: string }

export component ClipboardProbe inherits Window {
    in property <[ClipboardProbeRow]> records: [ClipboardProbeRow { text: "item" }];
    pure callback format-copy(string) -> string;
    TableView {
        copyable: true;
        current-row: 0;
        TableColumn { title: "Cell"; }
        TableColumn { title: "Next"; }
        for row in root.records : TableRow {
            TableCell { text: row.text; clipboard-text: root.format-copy(row.text); }
            TableCell { text: row.text; clipboard-text: root.format-copy(row.text + " next"); }
        }
    }
}
component DirectDispatchLeaf inherits Rectangle {
    out property <int> calls: 0;
    out property <bool> checked: false;
    hidden-button := Button {
        visible: false;
        clicked => { root.calls = root.calls + 1; }
    }
    hidden-switch := CheckBox {
        enabled: false;
        checked <=> root.checked;
        toggled => { root.calls = root.calls + 10; }
    }
}

component DirectDispatchMiddle inherits Rectangle {
    out property <int> calls: leaf.calls;
    out property <bool> checked: leaf.checked;
    leaf := DirectDispatchLeaf {}
}

export component DirectDispatchScene inherits Window {
    out property <int> calls: middle.calls;
    out property <bool> checked: middle.checked;
    out property <int> endings: 0;
    hidden-root-button := Button {
        visible: false;
        clicked => { root.endings = root.endings + 10; }
    }
    middle := DirectDispatchMiddle {}
    gesture := ScaleRotateGestureHandler {
        enabled: false;
        ended => { root.endings = root.endings + 1; }
        cancelled => { root.endings = root.endings + 2; }
    }
    range := Slider {
        changed(value) => { root.endings = root.endings + 100; }
    }
}

export component ListSelectionParity inherits Window {
    in-out property <[string]> labels: ["A", "B", "C"];
    in-out property <int> selected: -1;
    out property <int> changes: 0;

    entries := ListView {
        current-index <=> root.selected;
        changed(index) => { root.changes += 1; }
        for label in root.labels : Text { text: label; }
    }
}

export component CallbackReplacementParity inherits Window {
    out property <int> steps: 0;
    out property <int> observed: root.probe();
    callback replace();
    callback advance() -> int;
    pure callback probe() -> int;

    advance => { root.steps += 1; root.replace(); -1 }
    probe => { 0 }
}

export component ControlStorageParity inherits Window {
    in-out property <float> minimum-value: 4.5;
    in-out property <float> level <=> slider.value;
    in-out property <int> amount <=> spin.value;
    out property <CheckState> last-state;

    slider := Slider { minimum: root.minimum-value; }
    spin := SpinBox { minimum: 6; }
    check := CheckBox {
        tristate: true;
        check-state-changed(state) => { root.last-state = state; }
    }
    choice := ComboBox { editable: true; model: ["A", "B"]; }
}

export component IntegerArithmeticParity inherits Window {
    in-out property <int> left: 9223372036854775807;
    in-out property <int> right: 1;
    in-out property <bool> evaluate-right: false;
    out property <int> sum: root.left + root.right;
    out property <int> difference: root.left - root.right;
    out property <int> product: root.left * root.right;
    out property <int> negated: -root.left;
    out property <int> quotient: root.left / root.right;
    out property <int> remainder: root.left % root.right;
    out property <int> fixed-sum: 9223372036854775807 + 1;
    out property <int> fixed-difference: (0 - 9223372036854775807 - 1) - 1;
    out property <int> fixed-product: 4611686018427387904 * 2;
    out property <int> fixed-negated: -(0 - 9223372036854775807 - 1);
    out property <int> guarded: root.evaluate-right ? (12 / 0) : 42;
    out property <bool> short-and: root.evaluate-right && ((12 / 0) > 0);
    out property <bool> short-or: !root.evaluate-right || ((12 % 0) > 0);
}

export struct InputSnapshotParity {
    key: KeyEvent,
    wheel: WheelEvent,
    modifiers: KeyModifiers,
    pointer: PointerEvent,
    point: TouchPoint,
    buttons: PointerButtons,
    kind: PointerEventKind,
    response: EventResult,
    image: image,
    label: styledtext,
}

export component InputDefaultsParity inherits Window {
    out property <KeyEvent> key;
    out property <WheelEvent> wheel;
    out property <KeyModifiers> modifiers;
    out property <InputSnapshotParity> snapshot;
}

export struct ComparedPicture {
    source: image,
    score: float,
}

export struct ComparedCard {
    picture: ComparedPicture,
}

export component ImageRecordEqualityParity inherits Window {
    in-out property <ComparedCard> original;
    in-out property <ComparedCard> candidate;
    in-out property <[ComparedCard]> originals;
    in-out property <[ComparedCard]> candidates;
    out property <bool> same-source: root.original.picture.source == root.candidate.picture.source;
    out property <bool> same-record: root.original == root.candidate;
    out property <bool> different-record: root.original != root.candidate;
    out property <bool> same-list: root.originals == root.candidates;
    out property <int> received: 0;
    callback receive(card: ComparedCard);
    callback supply() -> ComparedCard;
    callback observe-list(rows: [ComparedCard]);
    callback publish();
    receive(card) => { root.received += 1; }
    publish => { root.observe-list(root.originals); }
}

export struct LiveCheckedRow {
    title: string,
    picture: ComparedPicture,
}

export component LiveRecordValidationParity inherits Window {
    in-out property <[LiveCheckedRow]> rows: [
        LiveCheckedRow { title: "first", picture: ComparedPicture { source: @image-url(""), score: 1.0 } },
        LiveCheckedRow { title: "second", picture: ComparedPicture { source: @image-url(""), score: 2.0 } },
    ];
    in-out property <int> mode: 0;
    if root.mode == 0 : ListView {
        for row in root.rows : Text { text: row.title + row.picture.score; }
    }
    if root.mode == 1 : StandardTableView {
        model: root.rows;
        auto-sort: true;
        TableColumn { title: "Score"; field: "picture.score"; }
    }
    if root.mode == 2 : ComboBox {
        model: root.rows; text-role: "title"; value-role: "picture.score"; current-value: 1.0;
    }
}

export struct PasteBoundsRow { count: int, load: float }

export component PasteBoundsParity inherits Window {
    in-out property <[PasteBoundsRow]> rows: [PasteBoundsRow { count: 2, load: 0.5 }];
    pure callback integer-minimum(int) -> int;
    pure callback decimal-minimum(float) -> float;

    TableView {
        pasteable: true;
        undoable: true;
        TableColumn { title: "Count"; }
        TableColumn { title: "Load"; }
        for row in root.rows : TableRow {
            SpinBox { minimum: root.integer-minimum(row.count); value <=> row.count; }
            DoubleSpinBox {
                minimum: root.decimal-minimum(row.load);
                maximum: 1.0;
                value <=> row.load;
            }
        }
    }
}

export struct ProjectedPasteRow { first: string, second: string }

export component ProjectedPasteParity inherits Window {
    in-out property <[ProjectedPasteRow]> rows: [
        ProjectedPasteRow { first: "one", second: "two" },
    ];
    pure callback allow-second() -> bool;
    allow-second => { true }

    StandardTableView {
        model: root.rows;
        pasteable: true;
        TableColumn { title: "First"; field: "first"; editable: true; }
        TableColumn { title: "Second"; field: "second"; editable: root.allow-second(); }
    }
}

export struct StatefulPasteRow { name: string, note: string }
struct StatefulTextPaste { accepted: bool, value: string }

component StatefulPasteEditor inherits HorizontalLayout {
    in-out property <string> value <=> input.text;
    input := LineEdit {}
}

export component StatefulPasteParity inherits Window {
    in-out property <bool> lock-cell: false;
    in-out property <[StatefulPasteRow]> rows: [
        StatefulPasteRow { name: "first", note: "one" },
        StatefulPasteRow { name: "second", note: "two" },
    ];
    pure callback may-edit(string) -> bool;
    may-edit(name) => { true }
    pure callback hide-table() -> bool;
    pure callback hide-row(string) -> bool;
    pure callback hide-proxy(string) -> bool;

    TableView {
        pasteable: true;
        copyable: true;
        current-row: 0;
        edit-on-tab: true;
        states [ hidden when root.hide-table(): { visible: false; } ]
        TableColumn { title: "Name"; }
        TableColumn { title: "Note"; }
        TableColumn { title: "Proxy"; }
        for row[index] in root.rows : TableRow {
            states [ hidden when root.hide-row(row.name): { visible: false; } ]
            TableCell { text <=> row.name; enabled: root.may-edit(row.name); }
            TableCell { text <=> row.note; enabled: root.may-edit(row.name); }
            Pane {
                states [
                    hidden when root.hide-proxy(row.name): { visible: false; }
                    locked when index == 0 && root.lock-cell: { enabled: false; }
                ]
                StatefulPasteEditor {
                    value <=> row.note;
                    clipboard-target: "value";
                    clipboard-paste(text) => { StatefulTextPaste { accepted: true, value: text } }
                }
            }
        }
    }
}
