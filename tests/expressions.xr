        for row[index] in root.rows : TableRow {
            states [ hidden when root.hide-row(row.name): { visible: false; } ]
            TableCell { text <=> row.name; enabled: root.may-edit(row.name); }
            TableCell { text <=> row.note; enabled: root.may-edit(row.name); }
            Pane {
