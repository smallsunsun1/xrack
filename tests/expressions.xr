    out property <string> caption: root.describe();
    first := Text { text: "Count " + root.count; }
    second := Text { text: "Count " + root.count; }
    for item in root.items : VerticalLayout {
        Text { text: "Row " + item; }
        Text { text: "Row " + item; }
        Text { text: "Caption " + root.caption; }
    }
    if false : Text { text: "not-rendered-marker"; }
    tail := Text { text: "tail"; }
}

