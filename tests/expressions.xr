export component Expressions inherits Rectangle {
    in-out property <int> base-value: 3;
    out property <int> precedence: 1 + 2 * 3;
    out property <int> left-associative: 10 - 3 - 2;
    out property <float> promoted: base-value + 0.5;
    out property <float> ratio: 12px / 4px;
    out property <length> scaled: 8px * 2;
    out property <length> scalar-left: 2 * 1.5px;
    out property <length> negative: -3px;
    out property <length> combined: (8px - 2px) / 2;
    out property <bool> comparison: base-value >= 2 && !false;
    out property <color> foreground: #0f08;
    out property <bool> same-color: foreground == #00ff0088;
    out property <string> greeting: "hello " + "\u4f60\u597d\n\"UI\"";
    out property <string> selected: comparison ? greeting : "other";
    out property <string> numbers: "n=" + base-value + ", f=" + promoted + ", ok=" + comparison;
    out property <int> safe-ratio: base-value == 0 ? 42 : 12 / base-value;
    out property <bool> guarded: base-value != 0 && 12 / base-value > 0;
    callback update(type: int);
    update(type) => { root.base-value = type; }
    callback step();
    step() => { root.base-value += 1; root.base-value += root.base-value; }
    out property <int> calls: 0;
    out property <bool> branch-result: false;
    callback touch() -> bool;
    touch => { root.calls += 1; true }
    callback run-branch(bool);
    run-branch(run) => { root.branch-result = !!(run && (root.touch() && true)); }
    out property <int> branch-value: 0;
    callback run-equal-branches();
    run-equal-branches() => { root.branch-value = root.touch() ? 7 : 7; }
    width: scaled;
}

export component FixedTextUpdates inherits Window {
    in-out property <string> message: "Ready";
    in-out property <string> summary: "Short";
    Text { text: root.message; width: 180px; height: 28px; }
    Label { text: root.message; width: 180px; height: 28px; y: 32px; }
    Label { text: root.summary; y: 64px; }
}

export component LocalAliasUpdates inherits Window {
    property <int> value: 7;
    property <int> middle <=> root.value;
    property <int> tail <=> root.middle;
    in-out property <int> exposed <=> root.tail;
    out property <int> observed: root.tail;
    callback step();
    step => { root.tail += 2; }
}

export component StaticStatePlans inherits Window {
    in-out property <string> message: "Ready";
    pure callback fallback-width() -> length;
    fallback-width => { 20px }

    grid := GridLayout {
        tile := Rectangle { col: 0; width: root.fallback-width(); height: 20px; }
    }
    status := Text { text: root.message; width: 120px; }
    states [
        settled when true: { tile.col: 1; tile.width: 40px; status.height: 24px; }
    ]
}

export component MergedStateCases inherits Window {
    in-out property <int> mode: 0;
    pure callback probe(int, int) -> bool;
    out property <bool> flag: root.mode == 1 ? true : root.probe(4, root.mode);
    panel := Text { text: "Base"; }
    states [
        first when root.probe(1, root.mode): { panel.text: "Shared"; }
        second when root.probe(2, root.mode): { panel.text: "Shared"; }
        third when root.probe(3, root.mode): { panel.text: "Third"; }
    ]
}

export component StaticRepeatScenes inherits Window {
    in-out property <string> caption: "Before";
    Text { text: root.caption; }
    for row in 48 : Rectangle { width: 120px; height: 24px; Text { text: "Static"; } }
    for row in 48 : Rectangle { width: 120px; height: 24px; Text { text: "Static"; } }
    for row in 3 : Rectangle { x: 2px; width: 32px; height: 18px; }
    for row in 3 : Text { text: "Row " + row; }
}

export component ReactiveBrushScenes inherits Window {
    in-out property <color> accent: #48a;
