        changed(index) => { root.changes += 1; }
    }
}

export struct ItemActivationRow { label: string, allowed: bool }

export component ItemActivationParity inherits Window {
    width: 300px; height: 120px;
    in-out property <bool> locked: false;
    in-out property <[ItemActivationRow]> rows: [
        ItemActivationRow { label: "First", allowed: true },
        ItemActivationRow { label: "Second", allowed: true },
    ];
    out property <int> activations: 0;
    pure callback allow-row(bool) -> bool;
    allow-row(value) => { value }
    ListView {
        width: 280px; height: 100px; row-height: 32px;
        for entry[index] in root.rows : ItemDelegate {
            text: entry.label;
            enabled: root.allow-row(entry.allowed);
            states [ locked when root.locked && index == 0: { enabled: false; } ]
            clicked => { root.activations += 1; }
        }
    }
}

export component StateOrderParity inherits Window {
    in-out property <int> mode: 1;
    in-out property <string> caption: "Before";
    pure callback condition(int) -> bool;
    pure callback label(string) -> string;

    first := Text { text: root.label(root.caption); }
    target := Text { text: "Base"; }
    states [ active when root.condition(root.mode): { target.text: "Selected"; } ]
}

export component StatefulSwipeParity inherits Window {
    in-out property <bool> hide-first: false;
    in-out property <bool> disable-second: false;
    in-out property <int> selection: 0;
    out property <int> changes: 0;
    pure callback page-body(int) -> string;
    pure callback page-flag(bool) -> bool;

    pages := SwipeView {
        current-index <=> root.selection;
        changed(index) => { root.changes += 1; }
        first := SwipePage {
            Text { text: root.page-body(0); }
            states [ hidden when root.hide-first: { visible: false; } ]
        }
        second := SwipePage {
            detail := Text { text: root.page-body(1); }
            states [
                disabled when root.disable-second: { enabled: false; }
                fallback when root.page-flag(root.hide-first): { detail.text: root.page-body(2); }
            ]
        }
    }
}

export component MountedPageInputParity inherits Window {
    in-out property <int> tab: 0;
    in-out property <int> swipe: 0;
    in-out property <bool> hide-first: false;
    out property <int> clicks: 0;
    pure callback page-content() -> string;
    page-content => { "inactive content" }
    callback advance();
    advance => { stack.push("second"); }
    TabWidget {
        current-index <=> root.tab;
        Tab {
            title: "First";
            tab-click := Button { clicked => { root.clicks += 1; } }
        }
        Tab { title: "Second"; Text { text: root.page-content(); } }
    }
    SwipeView {
        current-index <=> root.swipe;
        SwipePage {
            visible: !root.hide-first;
            swipe-click := Button { clicked => { root.clicks += 10; } }
        }
        SwipePage { Text { text: root.page-content(); } }
    }
    stack := StackView {
        initial-page: "first";
        first := StackPage {
            stack-click := Button { clicked => { root.clicks += 100; } }
        }
        second := StackPage { Text { text: root.page-content(); } }
    }
}

export component NavigationSelectionParity inherits Window {
    in-out property <bool> allowed: true;
    in-out property <bool> shown: true;
    in-out property <string> choice: "a";
    in-out property <int> tab: 0;
    in-out property <int> repeated: 0;
    in-out property <[string]> labels: ["A", "B"];
    out property <string> events: "";
    pure callback label() -> string;
    label => { "b" }
    radio := RadioGroup {
        current-value <=> root.choice;
        selected(value) => { root.events += value + ";"; }
        RadioButton { text: "a"; }
        RadioButton { text: root.label(); enabled: root.allowed; }
    }
    tabs := TabWidget {
        current-index <=> root.tab;
        changed(index) => { root.events += "tab;"; }
        Tab { title: "First"; }
        Tab { title: "Second"; visible: root.shown; }
    }
    bar := TabBar {
        current-index <=> root.repeated;
        changed(index) => { root.events += "bar;"; }
        for name[index] in root.labels : TabButton {
            text: name;
            enabled: index == 0 || root.allowed;
        }
    }
}

export component DistributedSelectionParity inherits Window {
    in-out property <string> label: "b";
    in-out property <string> choice: "a";
    in-out property <bool> allowed: true;
    in-out property <bool> checked: false;
    out property <string> selected: "";
    out property <int> toggles: 0;
    radios := ButtonGroup {
        current-value <=> root.choice;
        selected(value) => { root.selected = value; }
    }
    checks := ButtonGroup { exclusive: false; enabled: root.allowed; }
    RadioButton { group: radios; value: "a"; }
    RadioButton { group: radios; value: root.label; }
    check := CheckBox {
        group: checks;
        checked <=> root.checked;
        toggled() => { root.toggles += 1; }
    }
}

component NestedMonthGridContent inherits Rectangle {
    in-out property <Date> date: Date { year: 2026, month: 1, day: 5 };
    in-out property <Date> month: Date { year: 2026, month: 1, day: 1 };
    in property <int> revision;
    in property <int> week-start;
    pure callback sibling(int) -> string;
    callback selected(Date);
    callback browsed(Date);
    callback picked(Date);
    calendar := MonthGrid {
        date <=> root.date;
        display-month <=> root.month;
        week-start: root.week-start;
        changed(day) => { root.selected(day); }
        month-changed(month) => { root.browsed(month); }
        activated(day) => { root.picked(day); }
    }
    Text { text: root.sibling(root.revision); }
}

export component NestedMonthGridParity inherits Window {
    in-out property <int> revision: 0;
    in-out property <int> week-start: 1;
    in-out property <Date> date <=> child.date;
    in-out property <Date> month <=> child.month;
    out property <string> events: "";
    pure callback sibling(int) -> string;
    child := NestedMonthGridContent {
        revision: root.revision;
        week-start: root.week-start;
        sibling(revision) => { root.sibling(revision) }
        selected(day) => { root.events += "D" + day.day + "@" + root.month.month + ";"; }
        browsed(month) => { root.events += "M" + month.month + "@" + root.date.day + ";"; }
        picked(day) => { root.events += "A" + day.day + ";"; }
    }
}

export component ScrollReadOrderParity inherits Window {
    out property <float> bar-position: bar.position;
    out property <float> indicator-position: indicator.position;
    out property <float> indicator-size: indicator.size;
    pure callback read-metric(int) -> float;
