}

component FocusRowContent inherits Rectangle {
    in property <string> label: "";
    callback seen(string);
    scope := FocusScope {
        focus-lost(reason) => { root.seen("lost " + root.label); }
        key-pressed(event) => { root.seen("key " + root.label); accept }
    }
    touch := TouchArea {
        pointer-event(event) => { root.seen("pointer " + root.label); }
    }
    drag := DragArea {
        data: root.label;
        drag-started() => { root.seen("start " + root.label); }
        drag-finished(action) => { root.seen("drag " + root.label); }
    }
}

export component TypedInputAvailabilityParity inherits Window {
    in-out property <bool> allowed: true;
    out property <string> events: "";
    blocker := WheelHandler {
        wheel(event) => { root.allowed = false; reject }
    }
    wheel := WheelHandler {
        enabled: root.allowed;
        wheel(event) => { root.events += "wheel;"; accept }
    }
    focus := FocusScope {
        enabled: root.allowed;
        key-pressed(event) => { root.events += "key;"; accept }
        focus-gained(reason) => { root.events += "gain;"; }
        focus-lost(reason) => { root.events += "loss;"; }
        focus-changed-event(reason) => { root.events += "focus;"; }
    }
    touch := TouchArea {
        enabled: root.allowed;
        pointer-event(event) => { root.events += "pointer;"; }
    }
    drag := DragArea {
        enabled: root.allowed;
        data: "row";
        drag-started() => { root.events += "start;"; }
        drag-finished(action) => { root.events += "finish;"; }
    }
}

component TypedInputChild inherits Rectangle {
    visible: false;
    callback seen(string);
    pure callback can-wheel() -> bool;
    wheel := WheelHandler {
        enabled: root.can-wheel();
        wheel(event) => { root.seen("wheel;"); accept }
    }
    focus := FocusScope {
        key-pressed(event) => { root.seen("key;"); accept }
        focus-lost(reason) => { root.seen("loss;"); }
    }
}

export component TypedInputAncestorParity inherits Window {
    in-out property <bool> allowed: true;
    in-out property <bool> shown: true;
    out property <string> events: "";
    pure callback check-wheel() -> bool;
    check-wheel => { true }
    parent := FocusScope {
        enabled: root.allowed;
        child := TypedInputChild {
            visible: root.shown;
            can-wheel => { root.check-wheel() }
            seen(value) => { root.events += value; }
        }
    }
    passive := WheelHandler {
        enabled: false;
        inner := WheelHandler {
            wheel(event) => { root.events += "pass-through;"; accept }
        }
    }
}

component ScopedInputProbe inherits FocusScope {
    in property <string> label;
    callback seen(string);
    pure callback read-checked() -> bool;
    read-checked => { false }
    key-pressed(event) => { root.seen(root.label + ";"); accept }
    focus-lost(reason) => { root.seen("lost-" + root.label + ";"); }
    probe := Button {
        clicked() => { root.seen(root.label + ";"); }
    }
    hover := HoverHandler {
        entered() => { root.seen("entered-" + root.label + ";"); }
        exited() => { root.seen("exited-" + root.label + ";"); }
    }
    toggle := CheckBox {
        checked: root.read-checked();
        toggled() => { root.seen("toggled-" + root.label + ";"); }
    }
}

export component TypedInputScopeParity inherits Window {
    in-out property <bool> checkable: true;
    in-out property <bool> checked: true;
    in-out property <bool> dialog-open: true;
    in-out property <bool> drawer-open: true;
    in-out property <bool> popup-open: true;
    in-out property <SwipeSide> side: left;
    out property <string> events: "";
    pure callback read-popup-check() -> bool;
    read-popup-check => { false }
    GroupBox {
        checkable: root.checkable;
        checked <=> root.checked;
        ScopedInputProbe { label: "group"; seen(value) => { root.events += value; } }
    }
    Dialog {
        open <=> root.dialog-open;
        ScopedInputProbe { label: "dialog"; seen(value) => { root.events += value; } }
    }
    Drawer {
        open <=> root.drawer-open;
        ScopedInputProbe { label: "drawer"; seen(value) => { root.events += value; } }
    }
    Rectangle {
        PopupWindow {
            open <=> root.popup-open;
            ScopedInputProbe {
                label: "popup";
                seen(value) => { root.events += value; }
                read-checked => { root.read-popup-check() }
            }
        }
    }
    SwipeDelegate {
        open-side <=> root.side;
        SwipeLeft {
            ScopedInputProbe { label: "left"; seen(value) => { root.events += value; } }
        }
        SwipeContent {
            ScopedInputProbe { label: "content"; seen(value) => { root.events += value; } }
        }
        SwipeRight {
            ScopedInputProbe { label: "right"; seen(value) => { root.events += value; } }
        }
    }
}

