export component TableMoveOrderParity inherits Window {
    in-out property <[TableMoveOrderRow]> rows: [TableMoveOrderRow { name: "one" }, TableMoveOrderRow { name: "two" }];
    in-out property <int> current: 0;
    in-out property <string> query: "";
    out property <int> moves: 0;
    out property <string> events: "";
    out property <int> sort-column: table.current-sort-column;
    pure callback automatic() -> bool;
    pure callback source() -> [TableMoveOrderRow];
    pure callback selected() -> int;
    pure callback filter(string) -> string;
    callback select-cell(int, int);
    callback select-source(int);
    callback sort();
    callback sort-reverse();
    callback clear-sort();
    callback move-row(int, int);
    automatic => { true }
    source => { root.rows }
    selected => { root.current }
    filter(query) => { query }
    select-cell(row, column) => { table.select-cell(row, column); }
    select-source(row) => { table.select-source-index(row); }
    sort => { table.sort-by(0, false); }
    sort-reverse => { table.sort-by(0, true); }
    clear-sort => { table.clear-sort(); }
    move-row(from, to) => { table.move-row(from, to); }
    table := StandardTableView {
        model: root.source();
        auto-sort: root.automatic();
        current-row: root.selected();
        selection-target: cells;
        multi-select: true;
        filter-field: "name";
        filter-text: root.filter(root.query);
        current-cell-changed(row, column) => { root.events += "cell:" + row + "/" + column + ";"; }
        current-row-changed(row) => { root.events += "cursor:" + row + ";"; }
        row-moved(row, from, to) => {
            root.moves += 1;
            root.events += "move:" + row + "/" + from + "/" + to + ";";
        }
        sort-descending(column) => { root.events += "descending:" + column + ";"; }
        TableColumn { title: "Name"; field: "name"; }
    }
}

