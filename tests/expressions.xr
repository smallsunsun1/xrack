export component SpinOptionsParity inherits Window {
    in-out property <int> integer-limit: 100;
    in-out property <float> decimal-limit: 100.0;
    in-out property <int> precision: 2;
    in-out property <bool> unlocked: true;
    in-out property <int> amount: 10;
    in-out property <float> level: 10.0;
    out property <int> edits: 0;

    integer-spin := SpinBox {
        maximum: root.integer-limit;
        value <=> root.amount;
        read-only: !root.unlocked;
        edited(value) => { root.edits += 1; }
    }
    decimal-spin := DoubleSpinBox {
        maximum: root.decimal-limit;
        decimals: root.precision;
        value <=> root.level;
        read-only: !root.unlocked;
        edited(value) => { root.edits += 1; }
    }
}

export component RangeOptionsParity inherits Window {
    in-out property <float> limit: 100.0;
    in-out property <float> amount: 10.0;
    in-out property <float> dial-value: 10.0;
    in-out property <float> lower: 10.0;
    in-out property <float> upper: 40.0;
    out property <int> changes: 0;
    out property <int> releases: 0;
    out property <float> last-release: 0.0;
    callback after-change;

    slider := Slider {
        maximum: root.limit; value <=> root.amount;
        changed(value) => { root.changes += 1; root.after-change(); }
        released(value) => { root.releases += 1; root.last-release = value; }
    }
    dial := Dial {
        maximum: root.limit; value <=> root.dial-value;
        changed(value) => { root.changes += 1; }
        released(value) => { root.releases += 1; root.last-release = value; }
    }
    band := RangeSlider {
        maximum: root.limit; lower-value <=> root.lower; upper-value <=> root.upper;
        changed(lower, upper) => { root.changes += 1; }
        released(lower, upper) => { root.releases += 1; root.last-release = upper; }
    }
}

