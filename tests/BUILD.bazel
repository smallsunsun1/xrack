    name = "gpu_test",
    size = "small",
    srcs = [
        "gpu_test.rs",
        "ui_driver.rs",
    ],
    edition = "2024",
    tags = [
        "local",
        "manual",
        "no-sandbox",
        "requires-gpu",
    ],
    deps = [
        "//crates/xrack-layout:xrack_layout",
        "//crates/xrack-renderer-femtovg:xrack_renderer_femtovg",
