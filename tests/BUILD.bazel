        "//examples/layout:bundled_ui",
        "//examples/layout:layout_ui",
        "//examples/list:list_ui",
        "//examples/media:media_ui",
        "//examples/menu:menu_ui",
        "//examples/navigation:navigation_ui",
        "//examples/notes:notes_ui",
        "//examples/painting:painting_ui",
        "//examples/selection:selection_ui",
        "//examples/split:split_ui",
        "//examples/table:records_ui",
        "//examples/table:table_ui",
        "//examples/tooltip:tooltip_ui",
        "//examples/tree:tree_ui",
