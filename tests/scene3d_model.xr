    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: root.orbit;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: 45;
        light-elevation: 0;
        shadows: true;
        shadow-map-size: 256;
    }
}

