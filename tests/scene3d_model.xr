export struct Actor3D {
    id: string,
    mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color,
    group: string,
}

export component SceneModelTest inherits Window {
    width: 200px;
    height: 200px;

    in-out property <[Actor3D]> actors: [
        Actor3D {
            id: "orb", mesh: "primitive:sphere",
            x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1,
            yaw: 0, pitch: 0, roll: 0, color: #ffd86c,
            group: "puzzle",
        },
    ];
    out property <string> hit: Scene3D.pick(root.actors, 0, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 100px));

    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: 0;
        camera-pitch: 0;
        camera-distance: 8;
    }
}

export component ProjectionReuseScene inherits Window {
    width: 400px;
    height: 200px;
    in-out property <[Actor3D]> actors: [];
    in-out property <float> heading: 0;
    out property <hit3d> hit: Scene3D.hit(root.actors, root.heading, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 100px));
    out property <[hit3d]> ray-hits: Scene3D.ray-hit-all(
        root.actors, Point3D.new(0, 0, 8), Vector3D.new(0, 0, -1), 20 + root.heading);
    out property <projectedpoint3d> missing-camera: Scene3D.project-camera(
        root.actors, "missing", Point2D.new(200px, 200px), Point3D.new(root.heading, 0, 0));

    left := SceneView3D {
        width: 200px;
        height: 200px;
        camera-yaw: root.heading;
        camera-pitch: 0;
        camera-distance: 8;
        model: root.actors;
    }
    right := SceneView3D {
        x: 200px;
        width: 200px;
        height: 200px;
        camera-yaw: root.heading + 10;
        camera-pitch: 0;
        camera-distance: 8;
        model: root.actors;
    }
}

export component MaterialScene inherits Window {
    width: 200px;
    height: 200px;
    property <[Actor3D]> actors: [
        Actor3D {
            id: "mask", mesh: @mesh-url("../examples/puzzle3d/models/exit.gltf"),
            x: 0, y: 0, z: 0,
            scale-x: 4, scale-y: 1, scale-z: 4, yaw: 0, pitch: 90, roll: 0,
            color: #ffffff, group: "screen",
        },
        Actor3D {
            id: "back", mesh: "primitive:box",
            x: 0, y: 0, z: -0.5,
            scale-x: 4, scale-y: 4, scale-z: 0.1, yaw: 0, pitch: 0, roll: 0,
            color: #ff3000, group: "screen",
        },
    ];
    out property <string> left-hit: Scene3D.pick(root.actors, 0, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(78px, 100px));
    out property <string> right-hit: Scene3D.pick(root.actors, 0, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(122px, 100px));

    out property <hit3d> solid-texel: Scene3D.hit(root.actors, 0, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(78px, 100px));
    out property <hit3d> transparent-texel: Scene3D.hit(root.actors, 0, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(122px, 100px));
    out property <float> world-x: root.solid-texel.position.x;
    out property <float> normal-z: root.solid-texel.normal.z;
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: 0;
        camera-pitch: 0;
        camera-distance: 8;
    }
}

export component BlendedScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> rear: false;
    property <float> yaw: root.rear ? 180 : 0;
    property <[Actor3D]> actors: [
        Actor3D {
            id: "glass", mesh: @mesh-url("../examples/puzzle3d/models/glass.gltf"),
            x: 0, y: 0, z: 0,
            scale-x: 2, scale-y: 2, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, group: "screen",
        },
        Actor3D {
            id: "back", mesh: "primitive:box", x: 0, y: 0, z: root.rear ? 2 : -1,
            scale-x: 5, scale-y: 5, scale-z: 0.1, yaw: 0, pitch: 0, roll: 0,
            color: #0000ff, group: "screen",
        },
        Actor3D {
            id: "occluder", mesh: "primitive:box",
            x: root.rear ? 0.8 : -0.8, y: 0, z: root.rear ? -0.5 : 1.5,
            scale-x: 0.6, scale-y: 2, scale-z: 0.1, yaw: 0, pitch: 0, roll: 0,
            color: #0000ff, group: "screen",
        },
        Actor3D {
            id: "invisible", mesh: @mesh-url("../examples/puzzle3d/models/glass.gltf"),
            x: 0, y: 0, z: 2,
            scale-x: 2, scale-y: 2, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff00, group: "screen",
        },
    ];
    out property <string> center-hit: Scene3D.pick(root.actors, root.yaw, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 100px));
    out property <string> left-hit: Scene3D.pick(root.actors, root.yaw, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(70px, 100px));

    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: root.yaw;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: root.yaw;
        light-elevation: 0;
    }
}

export component SidedScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> rear: false;
    property <float> yaw: root.rear ? 180 : 0;
    property <[Actor3D]> actors: [
        Actor3D {
            id: "panels", mesh: @mesh-url("scene3d_sided.gltf"),
            x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, group: "screen",
        },
    ];
    out property <string> left-hit: Scene3D.pick(root.actors, root.yaw, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(69px, 100px));
    out property <string> right-hit: Scene3D.pick(root.actors, root.yaw, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(131px, 100px));

    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: root.yaw;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: root.yaw;
        light-elevation: 0;
    }
}

export component PbrScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <int> lamp: 0;
    property <[Actor3D]> actors: [
        Actor3D {
            id: "materials", mesh: @mesh-url("scene3d_pbr.gltf"),
            x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, group: "surface",
        },
    ];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: 0;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: root.lamp == 0 ? 0 : root.lamp == 1 ? 62 : 180;
        light-elevation: 0;
    }
}

export component NormalMapScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> rear: false;
    property <float> yaw: root.rear ? 180 : 0;
    property <[Actor3D]> actors: [
        Actor3D {
            id: "tiles", mesh: @mesh-url("scene3d_normal.gltf"),
            x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, group: "surface",
        },
    ];
    out property <string> top-hit: Scene3D.pick(root.actors, root.yaw, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 68px));
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: root.yaw;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: root.yaw;
        light-elevation: root.rear ? -45 : 45;
    }
}

export struct LightRow {
    kind: string,
    x: float, y: float, z: float,
    yaw: float, elevation: float,
    intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float,
}

export component LightsScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <int> mode: 0;
    in-out property <float> point-distance: 2;
    in-out property <float> point-range: 2.6;
    in-out property <float> ambient: 0;
    property <LightRow> common-light: LightRow {
        kind: "directional", x: 0, y: 0, z: 0, yaw: 0, elevation: 0,
        intensity: 0, color: #ffffff, range: 0, inner-angle: 8, outer-angle: 24,
    };
    property <[LightRow]> lamps: [
        LightRow { color: #ff0000, intensity: root.mode == 1 || root.mode == 4 ? 0.9 : 0, ..root.common-light },
        LightRow {
            kind: "point", x: -1.3, z: root.point-distance, range: root.point-range,
            color: #00ff00, intensity: root.mode == 2 || root.mode == 4 ? 9 : 0,
            ..root.common-light
        },
        LightRow {
            kind: "spot", x: 1.3, z: 2, range: 4,
            color: #0000ff, intensity: root.mode == 3 || root.mode == 4 ? 7 : 0,
            ..root.common-light
        },
    ];
    property <[Actor3D]> actors: [
        Actor3D {
            id: "wall", mesh: @mesh-url("scene3d_lighting.gltf"),
            x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
            yaw: 0, pitch: 0, roll: 0, color: #ffffff, group: "surface",
        },
    ];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: 0;
        camera-pitch: 0;
        camera-distance: 8;
        lights: root.lamps;
        ambient-intensity: root.ambient;
        ambient-color: #80ffff;
    }
}

struct ShadowActor {
    id: string,
    mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color,
    casts-shadow: bool,
    receives-shadow: bool,
}

struct ShadowLamp {
    kind: string,
    x: float, y: float, z: float,
    yaw: float, elevation: float,
    intensity: float, color: color,
    range: float, inner-angle: float, outer-angle: float,
    casts-shadow: bool,
}

export component ShadowScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> enabled: false;
    in-out property <float> orbit: 0;
    in-out property <int> mode: 0;
    property <ShadowActor> wall: ShadowActor {
        id: "wall", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 5, scale-y: 5, scale-z: 0.1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        casts-shadow: false, receives-shadow: root.mode != 2,
    };
    property <[ShadowActor]> objects: [
        root.wall,
        ShadowActor {
            id: "caster",
            mesh: root.mode == 6 ? @mesh-url("../examples/puzzle3d/models/exit.gltf")
                : root.mode == 7 ? @mesh-url("../examples/puzzle3d/models/glass.gltf") : "primitive:box",
            x: root.mode == 10 ? -0.4 : root.mode == 6 || root.mode == 7 ? -2 : -1,
            z: root.mode == 6 || root.mode == 7 ? 2 : 1,
            scale-x: root.mode == 6 || root.mode == 7 ? 1.8 : 0.7,
            scale-y: 1.2, scale-z: root.mode == 6 ? 1.8 : 0.2,
            pitch: root.mode == 6 ? 90 : 0,
            color: #995522, casts-shadow: root.mode != 3, receives-shadow: false,
            ..root.wall
        },
    ];
    property <ShadowLamp> main-light: ShadowLamp {
        kind: root.mode >= 12 ? "point" : root.mode == 5 ? "spot" : "directional",
        x: -3, y: 0, z: root.mode == 13 ? 6 : 3, yaw: -45, elevation: 0,
        intensity: root.mode == 15 ? 48 : root.mode >= 12 || root.mode == 5 ? 60 : root.mode == 9 ? 1.5 : 2.6,
        color: #ffffff, range: root.mode == 14 ? 1 : 10, inner-angle: 18, outer-angle: 35,
        casts-shadow: root.mode != 4 && root.mode != 16,
    };
    property <[ShadowLamp]> lamps: [
        root.main-light,
        ShadowLamp {
            kind: "spot", color: #00ff00,
            intensity: root.mode == 8 || root.mode == 11 ? 60 : 0,
            casts-shadow: root.mode != 11,
            ..root.main-light
        },
    ];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.objects;
        camera-yaw: root.orbit;
        camera-pitch: 0;
        camera-distance: 8;
        lights: root.lamps;
        ambient-intensity: 0.15;
        shadows: root.enabled;
        shadow-map-size: 256;
    }
}

export component PointShadows inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> enabled: false;
    in-out property <int> face: 0;
    property <int> axis: root.face / 2;
    property <float> axial-distance: root.face % 2 == 0 ? -4 : 4;
    property <ShadowLamp> lamp: ShadowLamp {
        kind: "point", color: #ffffff, intensity: 65, range: root.face == 5 ? 0 : 10, casts-shadow: true,
        x: root.axis == 0 ? root.axial-distance : 1.8,
        y: root.axis == 1 ? root.axial-distance : 0,
        z: root.axis == 2 ? root.axial-distance : root.axis == 0 ? 1.8 : 0,
        yaw: 0, elevation: 0, inner-angle: 0, outer-angle: 45,
    };
    property <[ShadowLamp]> lamps: [root.lamp];
    property <ShadowActor> receiver: ShadowActor {
        id: "wall", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: root.axis == 0 ? 0.1 : 5,
        scale-y: root.axis == 1 ? 0.1 : 5,
        scale-z: root.axis == 2 ? 0.1 : 5,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        casts-shadow: false, receives-shadow: true,
    };
    property <[ShadowActor]> objects: [
        root.receiver,
        ShadowActor {
            id: "caster", x: root.lamp.x * 0.5, y: root.lamp.y * 0.5, z: root.lamp.z * 0.5,
            scale-x: 0.55, scale-y: 0.55, scale-z: 0.55, color: #995522,
            casts-shadow: true, receives-shadow: false, ..root.receiver
        },
    ];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.objects;
        camera-yaw: root.face == 0 ? -90 : root.face == 1 ? 90 : root.face == 4 ? 180 : 0;
        camera-pitch: root.face == 2 ? -70 : root.face == 3 ? 70 : 0;
        camera-distance: 8;
        lights: root.lamps;
        ambient-intensity: 0.15;
        shadows: root.enabled;
        shadow-map-size: 256;
    }
}

export component CascadeScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> enabled: false;
    in-out property <float> orbit: 0;
    in-out property <float> coverage: 30;
    in-out property <bool> punctual-on: false;
    property <ShadowActor> panel: ShadowActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1.46, scale-y: 2, scale-z: 0.1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        casts-shadow: false, receives-shadow: true,
    };
    property <[ShadowActor]> objects: [
        ShadowActor { id: "near", x: -1, z: 10, ..root.panel },
        ShadowActor { id: "far", x: 4, z: -8, scale-x: 4, scale-y: 3, ..root.panel },
        // The near caster is outside the camera's frustum, but still blocks the light.
        ShadowActor {
            id: "offscreen-caster", x: -2.6, z: 11.6,
            scale-x: 0.45, scale-y: 1, scale-z: 0.2,
            color: #995522, casts-shadow: true, receives-shadow: false, ..root.panel
        },
        ShadowActor {
            id: "far-caster", x: 2.6, z: -6.6,
            scale-x: 0.9, scale-y: 2, scale-z: 0.2,
            color: #995522, casts-shadow: true, receives-shadow: false, ..root.panel
        },
    ];
    property <ShadowLamp> sun: ShadowLamp {
        kind: "directional", x: 0, y: 0, z: 0, yaw: -45, elevation: 0,
        intensity: 2.6, color: #ffffff, range: 0, inner-angle: 0, outer-angle: 45, casts-shadow: true,
    };
    property <[ShadowLamp]> lamps: [
        root.sun,
        ShadowLamp {
            kind: "point", x: -4, z: 13.2, intensity: root.punctual-on ? 2 : 0,
            color: #00ff00, range: 10, ..root.sun
        },
        ShadowLamp {
            kind: "spot", x: -4, z: 13.2, intensity: root.punctual-on ? 2 : 0,
            color: #0000ff, range: 10, ..root.sun
        },
    ];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.objects;
        camera-yaw: root.orbit;
        camera-pitch: 0;
        camera-distance: 16;
        lights: root.lamps;
        ambient-intensity: 0.15;
        shadows: root.enabled;
        shadow-map-size: 256;
        shadow-cascades: 3;
        shadow-distance: root.coverage;
        shadow-cascade-blend: 0.2;
        shadow-split-balance: 0;
    }
}

export component EnvironmentScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> enabled: true;
    in-out property <bool> sky: true;
    in-out property <bool> geometry: true;
    in-out property <float> yaw: 0;
    in-out property <float> camera: 0;
    in-out property <float> exposure: 1;
    in-out property <float> intensity: 1;
    property <[ShadowLamp]> lamps: [];
    property <[Actor3D]> models: [
        Actor3D {
            id: "panels", mesh: @mesh-url("scene3d_environment.gltf"),
            x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
            color: #ffffff, group: "environment",
        },
    ];
    property <[Actor3D]> empty-model: [];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.geometry ? root.models : root.empty-model;
        lights: root.lamps;
        ambient-intensity: 0;
        camera-yaw: root.camera;
        camera-pitch: 0;
        camera-distance: 8;
        scene-background: #05070b;
        environment: root.enabled ? @environment-url("../examples/puzzle3d/models/studio.hdr") : "";
        environment-yaw: root.yaw;
        environment-skybox: root.sky;
        environment-intensity: root.intensity;
        scene-exposure: root.exposure;
    }
}

struct HierarchyActor {
    id: string, mesh: string, parent: string, visible: bool,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    pivot-x: float, color: color, casts-shadow: bool,
}

export component HierarchyScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <int> mode: 0;
    in-out property <float> shift: 0;
    in-out property <float> orbit: 0;
    property <HierarchyActor> defaults: HierarchyActor {
        id: "", mesh: "", parent: "", visible: true,
        x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, pivot-x: 0, color: #ffffff, casts-shadow: false,
    };
    property <[HierarchyActor]> objects: [
        HierarchyActor {
            id: "target", parent: "hinge", mesh: "primitive:box", x: 0.25,
            scale-x: 1.4, scale-y: 1.3, scale-z: 0.5, color: #ff3000,
            casts-shadow: true, ..root.defaults
        },
        HierarchyActor {
            id: "rear", mesh: "primitive:box", z: -2, scale-x: 2.5, scale-y: 1.5,
            scale-z: 0.15, color: #204acc, ..root.defaults
        },
        HierarchyActor {
            id: "hinge", parent: "rig", yaw: 45, pivot-x: 0.25, ..root.defaults
        },
        HierarchyActor {
            id: "rig", visible: root.mode != 1, x: root.shift, scale-x: 2,
            parent: root.mode == 2 ? "missing" : root.mode == 3 ? "hinge" : "",
            ..root.defaults
        },
        HierarchyActor { id: root.mode == 4 ? "rig" : "", ..root.defaults },
    ];
    out property <string> hit: Scene3D.pick(root.objects, root.orbit, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 100px));
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.objects;
        camera-yaw: root.orbit;
        camera-pitch: 0;
        camera-distance: 8;
        ambient-intensity: 0;
        light-yaw: 0;
        light-elevation: 0;
        shadows: true;
        shadow-map-size: 256;
    }
}

export struct CameraRow {
    id: string, mesh: string, parent: string, visible: bool,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float,
    color: color,
    camera-kind: string, camera-fov: float, camera-height: float,
    camera-near: float, camera-far: float, camera-look-at: string,
}

export component CameraScene inherits Window {
    width: root.view-width;
    height: 200px;
    in-out property <length> view-width: 200px;
    in-out property <string> active: "perspective";
    in-out property <float> rig-x: 0;
    in-out property <float> rig-yaw: 0;
    in-out property <float> target-x: 0;
    in-out property <bool> target-visible: true;
    in-out property <bool> rig-visible: true;
    in-out property <float> near: 0.1;
    in-out property <float> far: 40;
    in-out property <float> fov: 45;
    in-out property <bool> shadows: false;
    property <CameraRow> defaults: CameraRow {
        id: "", mesh: "", parent: "", visible: true,
        x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        camera-kind: "", camera-fov: root.fov, camera-height: 8,
        camera-near: root.near, camera-far: root.far, camera-look-at: "",
    };
    property <[CameraRow]> objects: [
        CameraRow { id: "perspective", camera-kind: "perspective", parent: "rig", z: 8, ..root.defaults },
        CameraRow { id: "map", camera-kind: "orthographic", parent: "rig", z: 8, ..root.defaults },
        CameraRow { id: "angled", camera-kind: "perspective", parent: "rig", x: 4, z: 8, yaw: 45, ..root.defaults },
        CameraRow { id: "rig", x: root.rig-x, yaw: root.rig-yaw, visible: root.rig-visible, scale-x: 2, scale-y: 0.5, ..root.defaults },
        CameraRow { id: "follow", z: 8, camera-kind: "perspective", camera-look-at: "focus", ..root.defaults },
        CameraRow { id: "pole", y: 8, camera-kind: "orthographic", camera-look-at: "focus", ..root.defaults },
        CameraRow { id: "focus", x: root.target-x, visible: root.target-visible, ..root.defaults },
        CameraRow { id: "front", mesh: "primitive:box", scale-x: 1.8, scale-y: 2, scale-z: 0.2, color: #ff0000, ..root.defaults },
        CameraRow { id: "rear", mesh: "primitive:box", z: -4, scale-x: 1.8, scale-y: 2, scale-z: 0.2, color: #0000ff, ..root.defaults },
        CameraRow { id: "side", mesh: "primitive:box", x: 2.5, scale-x: 0.9, scale-y: 2, scale-z: 0.9, color: #00ff00, ..root.defaults },
    ];
    property <point2d> viewport: Point2D.new(root.view-width, 200px);
    out property <string> center-hit: Scene3D.pick-camera(root.objects, root.active,
        root.viewport, Point2D.new(root.view-width * 0.5, 100px));
    out property <string> edge-hit: Scene3D.pick-camera(root.objects, root.active,
        root.viewport, Point2D.new(root.view-width * 0.62, 100px));
    property <point3d> world: Point3D.new(0.65, 0.35, 0);
    property <point3d> fallback: Point3D.new(-7, -11, -13);
    out property <projectedpoint3d> projected: Scene3D.project-camera(
        root.objects, root.active, root.viewport, root.world);
    out property <point3d> restored: Scene3D.unproject-camera(
        root.objects, root.active, root.viewport, root.projected.point, root.projected.depth, root.fallback);
    out property <length> screen-x: root.projected.point.x;
    out property <projectedpoint3d> orbit-project: Scene3D.project(0, 0, 8, root.viewport, root.world);
    out property <point3d> orbit-unproject: Scene3D.unproject(
        0, 0, 8, root.viewport, root.orbit-project.point, root.orbit-project.depth, root.fallback);
    out property <hit3d> camera-contact: Scene3D.hit-camera(root.objects, root.active,
        root.viewport, Point2D.new(root.view-width * 0.5, 100px));
    out property <hit3d> ray-contact: Scene3D.ray-hit(root.objects,
        Point3D.new(0, 0, 8), Vector3D.new(0, 0, -2), 10);
    SceneView3D {
        width: root.view-width;
        height: 200px;
        camera: root.active;
        model: root.objects;
        light-yaw: 0;
        light-elevation: 0;
        shadows: root.shadows;
        shadow-cascades: 2;
        shadow-distance: 28;
        shadow-map-size: 256;
        scene-background: #08090a;
    }
}

struct MountedLamp {
    kind: string, parent: string, visible: bool,
    x: float, y: float, z: float,
    yaw: float, elevation: float,
    intensity: float, color: color, range: float,
    inner-angle: float, outer-angle: float, casts-shadow: bool,
}

export component MountedLightScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <float> mount-x: 0;
    in-out property <float> mount-yaw: 0;
    in-out property <int> mode: 0;
    in-out property <bool> root-visible: true;
    in-out property <bool> light-visible: true;
    in-out property <string> parent-id: "joint";
    in-out property <bool> shadows: false;
    property <CameraRow> defaults: CameraRow {
        id: "", mesh: "", parent: "", visible: true,
        x: 0, y: 0, z: 0, scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        camera-kind: "", camera-fov: 45, camera-height: 8, camera-near: 0.1,
        camera-far: 40, camera-look-at: "",
    };
    property <[CameraRow]> objects: [
        CameraRow { id: "joint", parent: "base", yaw: root.mount-yaw, ..root.defaults },
        CameraRow {
            id: "base", x: root.mount-x, z: 2, scale-x: 2, scale-z: 0.5,
            visible: root.root-visible, ..root.defaults
        },
        CameraRow { id: "wall", mesh: "primitive:box", scale-x: 6, scale-y: 5, scale-z: 0.1, ..root.defaults },
        CameraRow {
            id: "block", mesh: "primitive:box", x: -0.5, z: 1,
            scale-x: 0.45, scale-y: 0.8, scale-z: 0.3, color: #202040, ..root.defaults
        },
    ];
    property <MountedLamp> moving: MountedLamp {
        kind: root.mode == 0 ? "directional" : root.mode == 1 ? "point" : "spot",
        parent: root.parent-id, visible: root.light-visible,
        x: root.mode == 1 ? -0.5 : 0.5, y: 0, z: 0,
        yaw: 0, elevation: 0, intensity: root.mode == 0 ? 2.3 : 18,
        color: root.mode == 0 ? #ff0000 : root.mode == 1 ? #00ff00 : #0000ff,
        range: root.mode == 1 ? 3 : 8, inner-angle: 12, outer-angle: 25,
        casts-shadow: true,
    };
    property <[MountedLamp]> lights: [
        MountedLamp {
            kind: "directional", parent: "", visible: root.mode == 3,
            yaw: 0, elevation: 0, color: #ff0000, intensity: 1,
            ..root.moving
        },
        root.moving,
    ];
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.objects;
        lights: root.lights;
        camera-yaw: 0;
        camera-pitch: 0;
        camera-distance: 8;
        ambient-intensity: 0;
        shadows: root.shadows;
        shadow-map-size: 256;
    }
}

struct AnimatedActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    casts-shadow: bool,
    animation: string, animation-time: float, animation-loop: bool,
}

export component AnimatedScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <string> clip: "Slide";
    in-out property <float> time: 0;
    in-out property <bool> loop: false;
    in-out property <float> orbit: 0;
    property <AnimatedActor> base: AnimatedActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        casts-shadow: false, animation: "", animation-time: 0, animation-loop: false,
    };
    property <[AnimatedActor]> actors: [
        AnimatedActor {
            id: "mover", mesh: @mesh-url("../examples/puzzle3d/models/animated-panel.glb"),
            color: #ff3000, casts-shadow: true,
            animation: root.clip, animation-time: root.time, animation-loop: root.loop,
            ..root.base
        },
        AnimatedActor {
            id: "wall", z: -1, scale-x: 6, scale-y: 5, scale-z: 0.1,
            color: #2040ff, ..root.base
        },
    ];
    out property <string> hit: Scene3D.pick(root.actors, root.orbit, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 100px));
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: root.orbit;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: -45;
        light-elevation: 0;
        shadows: true;
        shadow-map-size: 256;
    }
}

export component SkinnedScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <float> time: 0;
    in-out property <float> orbit: 0;
    property <AnimatedActor> base: AnimatedActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1,
