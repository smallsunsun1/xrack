}

struct FacePose { extend: float, target-0: float }

struct DrivenActor {
    id: string, mesh: string,
    x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
    casts-shadow: bool,
    animation: string, animation-time: float, animation-loop: bool,
    morph-weights: FacePose,
}

export component MorphControlScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <float> time: 0.5;
    in-out property <float> extension: 0;
    property <float> orbit: 0;
    property <DrivenActor> base: DrivenActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1,
        yaw: 0, pitch: 0, roll: 0, color: #ffffff,
        casts-shadow: false, animation: "", animation-time: 0, animation-loop: false,
        morph-weights: FacePose { extend: 0, target-0: 0.125 },
    };
    property <[DrivenActor]> actors: [
        DrivenActor {
            id: "panel", mesh: @mesh-url("../examples/puzzle3d/models/morph-panel.glb"),
            color: #ff5030, casts-shadow: true,
            animation: "Morph", animation-time: root.time,
            morph-weights: FacePose { extend: root.extension, target-0: 0.125 },
            ..root.base
        },
        DrivenActor {
            id: "twin", mesh: @mesh-url("../examples/puzzle3d/models/morph-panel.glb"),
            x: -2.3, y: -1.4, color: #30e060,
            morph-weights: FacePose { extend: 0.2, target-0: 0.125 },
            ..root.base
        },
        DrivenActor {
            id: "wall", z: -1, scale-x: 8, scale-y: 6, scale-z: 0.1,
            color: #2040ff, ..root.base
        },
    ];
    out property <string> center-hit: Scene3D.pick(root.actors, root.orbit, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(100px, 100px));
    out property <string> side-hit: Scene3D.pick(root.actors, root.orbit, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(175px, 100px));
    out property <string> upper-hit: Scene3D.pick(root.actors, root.orbit, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(84px, 58px));
    out property <string> twin-hit: Scene3D.pick(root.actors, root.orbit, 0, 8,
        Point2D.new(200px, 200px), Point2D.new(55px, 142px));
    out property <hit3d> driven-contact: Scene3D.ray-hit(root.actors,
        Point3D.new(2.45, 0, 8), Vector3D.new(0, 0, -1), 10);
    SceneView3D {
        width: 200px;
        height: 200px;
        model: root.actors;
        camera-yaw: root.orbit;
        camera-pitch: 0;
        camera-distance: 8;
        light-yaw: 45;
        light-elevation: 0;
        shadows: true;
        shadow-map-size: 256;
    }
}

struct QueryActor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, pickable: bool, camera-kind: string, camera-near: float, camera-far: float,
}

export component HitListScene inherits Window {
    width: 300px;
    height: 180px;
    property <QueryActor> cube: QueryActor {
        id: "", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ffffff, pickable: true, camera-kind: "", camera-near: 0.1, camera-far: 40,
    };
    property <[QueryActor]> actors: [
        QueryActor { id: "skip-invalid", mesh: "missing", ..root.cube },
        QueryActor { id: "front", z: 2, ..root.cube },
        QueryActor { id: "rig", mesh: @mesh-url("scene3d_hit_group.glb"), ..root.cube },
        QueryActor { id: "rear", z: -2, ..root.cube },
        QueryActor { id: "decoration", z: 3, pickable: false, ..root.cube },
        QueryActor { z: 1, ..root.cube },
        QueryActor { id: "front", z: -4, ..root.cube },
        QueryActor {
            id: "camera", mesh: "", z: 8, camera-kind: "perspective", camera-near: 7, camera-far: 12,
            ..root.cube
        },
    ];
    property <hit3d> miss;
    property <point2d> viewport: Point2D.new(200px, 200px);
    property <point2d> pointer: Point2D.new(100px, 100px);
    out property <[hit3d]> hits: Scene3D.hit-all(root.actors, 0, 0, 8, root.viewport, root.pointer);
    out property <[hit3d]> clipped: Scene3D.hit-all-camera(root.actors, "camera", root.viewport, root.pointer);
    out property <[hit3d]> from-world: Scene3D.ray-hit-all(
        root.actors, Point3D.new(0, 0, 8), Vector3D.new(0, 0, -2), 12);
    out property <[hit3d]> too-short: Scene3D.ray-hit-all(
        root.actors, Point3D.new(0, 0, 8), Vector3D.new(0, 0, -2), 2);
    out property <[hit3d]> invalid-camera: Scene3D.hit-all-camera(
        root.actors, "missing", root.viewport, root.pointer);
    out property <hit3d> selected: Model.at(root.hits, 0, root.miss);
    out property <hit3d> out-of-range: Model.at(root.hits, -1, root.miss);
    out property <int> selected-row: root.selected.row-index;
    out property <int> count: Model.count(root.hits);
    out property <bool> no-short-hits: Model.is-empty(root.too-short);
    out property <string> visited: "";
    out property <[hit3d]> edited: [];
    callback collect();
    collect => {
        root.visited = "";
        root.edited = [];
        for hit[index] in root.hits {
            root.visited = root.visited + hit.row-index + " ";
            if index < 2 { Model.append(root.edited, hit); }
        }
        Model.remove(root.edited, 0);
    }
    VerticalLayout {
        for hit in root.hits: Text {
            text: "row " + hit.row-index + " " + hit.object-id;
        }
    }
}

export component CullScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> cull: true;
    in-out property <[CameraRow]> actors: [];
    SceneView3D {
        width: 200px;
        height: 200px;
        frustum-culling: root.cull;
        camera: "view";
        model: root.actors;
        shadows: false;
        scene-background: #08090a;
    }
}

export component CullPoseScene inherits Window {
    width: 200px;
    height: 200px;
    in-out property <bool> cull: true;
    in-out property <bool> morph: false;
    in-out property <float> time: 0;
    property <[AnimatedActor]> actors: [AnimatedActor {
        id: "panel",
        mesh: root.morph ? @mesh-url("../examples/puzzle3d/models/morph-panel.glb")
            : @mesh-url("../examples/puzzle3d/models/skinned-panel.glb"),
        x: root.morph ? -3.5 : -2.5, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #ff5030, casts-shadow: false,
        animation: root.morph ? "Morph" : "Bend",
        animation-time: root.time, animation-loop: false,
    }];
    SceneView3D {
        width: 200px;
        height: 200px;
        frustum-culling: root.cull;
        model: root.actors;
        camera-yaw: 0;
        camera-pitch: 0;
        camera-distance: 2;
        shadows: false;
        scene-background: #08090a;
    }
}
