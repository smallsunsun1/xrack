// CHECK: "xr.make_record"{{.*}}!xr.recordlist<"Vertex">{{.*}}!xr.intlist{{.*}}!xr.record<"Geometry">
// CHECK: "xr.bind"{{.*}}name = "model"{{.*}}xr.update_effect = "paint"{{.*}}!xr.recordlist<"Actor">

struct Vertex { position: point3d }
struct Geometry { vertices: [Vertex], indices: [int] }
struct Actor {
    id: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, geometry: Geometry,
}
export component AuthoredMeshPlan inherits Window {
    in property <[Vertex]> points: [];
    in property <[int]> faces: [];
    SceneView3D {
        width: 80px; height: 80px;
        model: [Actor {
            id: "panel", x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0, color: #fff,
            geometry: Geometry { vertices: root.points, indices: root.faces },
        }];
    }
}
