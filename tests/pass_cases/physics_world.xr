// RAW: "xr.physics_function"{{.*}}value = "new"
// RAW: "xr.physics_function"{{.*}}value = "step"
// CHECK: [[FIRST:%[0-9]+]] = "xr.physics_function"{{.*}}value = "new"
// CHECK: "xr.property"([[FIRST]]) <{name = "world"
// CHECK: [[SECOND:%[0-9]+]] = "xr.physics_function"{{.*}}value = "new"
// CHECK: "xr.property"([[SECOND]]) <{name = "other"
// CHECK: "xr.callback"() <{name = "advance"
// CHECK: "xr.physics_function"{{.*}}value = "position"
// CHECK: [[TARGET:%[0-9]+]] = "xr.physics_function"{{.*}}value = "set-kinematic-target"
