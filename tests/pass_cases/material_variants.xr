// CHECK: "xr.mesh_url"() <{value = "car.gltf"}> : () -> !xr.string
// CHECK: "xr.make_record"{{.*}}!xr.record<"Actor">
// CHECK: "xr.bind"{{.*}}name = "model"{{.*}}xr.update_effect = "paint"{{.*}}!xr.recordlist<"Actor">

struct Actor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, material-variant: string,
}
export component VariantPlan inherits Window {
    in property <string> finish = "Copper";
    SceneView3D {
        width: 80px; height: 80px;
        model: [Actor {
            id: "car", mesh: @mesh-url("car.gltf"), x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0, color: #fff,
            material-variant: root.finish,
        }];
    }
}
