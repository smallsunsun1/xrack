// CHECK: "xr.make_record"{{.*}}!xr.record<"Actor">
// CHECK: "xr.bind"{{.*}}name = "model"{{.*}}xr.update_effect = "paint"{{.*}}!xr.recordlist<"Actor">

struct Actor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float, yaw: float, pitch: float, roll: float,
    color: color, instance-of: string, instance-template: bool,
}

export component InstancePlan inherits Window {
    in property <float> shift = 1.0;
    property <Actor> prototype: Actor {
        id: "shape", mesh: "primitive:box", x: 0, y: 0, z: 0,
        scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0,
        color: #fff, instance-of: "", instance-template: true,
    };
    SceneView3D {
        width: 80px; height: 80px;
        model: [root.prototype, Actor {
            id: "copy", x: root.shift, instance-of: "shape", instance-template: false, ..root.prototype
        }];
    }
}
