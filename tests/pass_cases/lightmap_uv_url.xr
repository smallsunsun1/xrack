// RAW: "xr.mesh_lightmap_url"() <{value = "models/static.glb"}> : () -> !xr.string
// RAW: "xr.mesh_lod_lightmap_url"() <{value = "models/static.glb"}> : () -> !xr.string
// CHECK: %[[CHART:[0-9]+]] = "xr.mesh_lightmap_url"() <{value = "models/static.glb"}> : () -> !xr.string
// CHECK: "xr.property"(%[[CHART]]) <{mode = "formula", name = "chart", visibility = "out"}>
// CHECK: %[[LOD:[0-9]+]] = "xr.mesh_lod_lightmap_url"() <{value = "models/static.glb"}> : () -> !xr.string
// CHECK: "xr.property"(%[[LOD]]) <{mode = "formula", name = "simplified", visibility = "out"}>

export component ChartAssets inherits Window {
    out property <string> chart <- @mesh-url("models/static.glb", lightmap-uv);
    out property <string> simplified <- @mesh-url("models/static.glb", auto-lod, lightmap-uv);
}
