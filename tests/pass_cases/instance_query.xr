// RAW: "xr.geometry_function"{{.*}}value = "scene-instance-3d"{{.*}} -> !xr.instance3d
// CHECK: "xr.literal"() <{value = ""}> : () -> !xr.instance3d
// CHECK-NOT: "xr.geometry_function"

struct Actor {
    id: string, mesh: string, x: float, y: float, z: float,
    scale-x: float, scale-y: float, scale-z: float,
    yaw: float, pitch: float, roll: float, color: color,
}
export component App inherits Window {
    out property <instance3d> missing <- Scene3D.instance([
        Actor { id: "cube", mesh: "primitive:box", x: 0, y: 0, z: 0,
            scale-x: 1, scale-y: 1, scale-z: 1, yaw: 0, pitch: 0, roll: 0, color: #ffffff },
    ], 4294967296, -1, -1);
}
