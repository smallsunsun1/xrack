// RAW: "xr.mesh_lod_url"() <{value = "models/surface.glb"}> : () -> !xr.string
// CHECK: %[[MESH:[0-9]+]] = "xr.mesh_lod_url"() <{value = "models/surface.glb"}> : () -> !xr.string
