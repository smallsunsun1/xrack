export struct Details { title: string, priority: int }

export enum Job {
    Pending(string),
    Ready(Details, int),
    Failed { message: string, retriable: bool },
    Done,
}

export enum WorkToggle { Off, On }

export component EnumPayloadDemo inherits Window {
    in-out property <Job> job;
    in-out property <WorkToggle> mode: WorkToggle::On;
    out property <string> summary: root.describe(root.job);
    out property <int> samples: 0;
    out property <int> failures: 0;

    pure function describe(value: Job) -> string {
        match value {
            Pending(text) => "pending " + text,
            Ready(details, count) => details.title + " " + count + " " + match root.mode {
                Off => details.priority + count,
                On => details.priority,
            },
            Failed { retriable: _, message: reason } => reason,
            Done => "done",
        }
    }

    callback sample() -> Job;
    sample => {
        root.samples += 1;
        Job::Ready(Details { title: "item", priority: 5 }, 3)
    }

    callback failure() -> int;
    failure => {
        root.failures += 1;
        -1
    }

    callback once() -> int;
    once => {
        match root.sample() {
            Pending(_) => root.failure(),
            Ready(details, count) => details.priority + count + count,
            Failed { message: text, retriable: _ } => Strings.character-count(text),
            Done => root.failure(),
        }
    }

    callback fail() -> Job;
    fail => { Job::Failed { retriable: true, message: "disk" } }
    callback echo(value: Job) -> Job;
    echo(value) => { value }

    match root.job: {
        Pending(text) => waiting := Text { text: text; },
        Ready(details, count) => ready := Button {
            text: details.title + " " + count;
            clicked => { root.samples += count; }
        },
        Failed { retriable, message } => error-label := Text {
            text: message + " " + retriable;
        },
        Done => done := Text { text: "done"; },
    }
}
