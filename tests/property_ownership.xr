enum TitleMode {
    Follow,
    Custom(string),
}

component DocumentEditor inherits Rectangle {
    in property <string> document-title;
    out property <string> live-title <- root.document-title;
    private property <string> draft: root.document-title;
    in-out property <string> editable-title <-> root.draft;
    private property <TitleMode> title-mode: TitleMode::Follow;
    out property <string> display-title <- match root.title-mode {
        Follow => root.document-title,
        Custom(text) => text,
    };

    callback rename(string);
    rename(text) => { root.title-mode = TitleMode::Custom(text); }
    callback restore-default();
    restore-default => { root.title-mode = TitleMode::Follow; }
}

component InputProbe inherits Rectangle {
    in property <string> supplied;
    callback rename-requested(string);
    callback request-rename(string);
    request-rename(value) => { if value != "" { root.rename-requested(value); } }
}

component SnapshotInput inherits Rectangle {
    in-out property <string> value;
}

export component PropertyOwnership inherits Window {
    in-out property <string> document-title: "A";
    in-out property <length> offset: -10px;
    in-out property <int> count: 1 + 2;
    out property <string> live-title <- document.live-title;
    out property <string> display-title <- document.display-title;
    out property <string> draft-title <- document.editable-title;
    out property <string> probe-title <- probe.supplied;
    out property <string> snapshot-title <- snapshot.value;
    callback edit-snapshot(string);
    edit-snapshot(text) => { snapshot.value = text; }
    out property <string> requested-title;
    out property <string> reported;
    in-out property <string> draft <-> document.editable-title;

    callback rename(string);
    rename(text) => { document.rename(text); }
    callback restore-default();
    restore-default => { document.restore-default(); }
    callback request-child-rename(string);
    request-child-rename(text) => { probe.request-rename(text); }

    document := DocumentEditor { document-title <- root.document-title; }
    probe := InputProbe {
        supplied <- root.document-title;
        rename-requested(text) => { root.requested-title = text; }
    }

    fixed := TextEdit {
        y <- 20px;
        width <- 180px;
        height <- 30px;
        text <- root.document-title;
        edited(text) => { root.reported = text; }
    }
    writable := TextInput {
        y <- 60px;
        width <- 180px;
        height <- 30px;
        text <-> root.draft;
    }
    viewport := ScrollView {
        y <- 100px;
        width <- 180px;
        height <- 80px;
        content-height <- 300px;
        content-y <- root.offset;
    }
    linked-viewport := ScrollView {
        y <- 190px;
        width <- 180px;
        height <- 80px;
        content-height <- 300px;
        content-y <-> root.offset;
    }
    snapshot := SnapshotInput { value: root.document-title; }
    snapshot-text := TextInput {
        y: 280px; width: 180px; height: 30px;
        text: root.document-title;
    }
    snapshot-rows := VerticalLayout {
        for index in 2: Text { text: root.document-title + index; }
    }

}

export component LanguageBlocks inherits Window {
    in-out property <bool> show-details: false;
    in-out property <bool> show-summary: false;
    private property <[string]> rows: ["A", "B"];
    out property <string> message <- if root.show-details { "Details" }
        else if root.show-summary { "Summary" }
        else { root.fallback() };
    out property <string> selected;
    pure callback fallback() -> string => { "Hidden" }
    pure callback row-count() -> int => { 2 }

    callback flip() => {
        let previous: bool = root.show-details;
        root.show-details = !previous;
    }
    callback swap() => { Model.move(root.rows, 0, 1); }
    callback measure(value: length) -> length => {
        let extra: length = 4px;
        let total = value + extra;
        total
    }

    controls := HorizontalLayout {
        spacing: 5px;
        if root.show-details {
            details := Text { width: 20px; text <- "Details"; }
            more := Text { width: 20px; text <- "More"; }
        } else if root.show-summary {
            summary := Text { width: 20px; text <- "Summary"; }
        } else {
            hidden := Text { width: 20px; text <- "Hidden"; }
        }
        tail := Text { width: 20px; text <- "Tail"; }
    }

    repeated := VerticalLayout {
        for row[index] in root.rows {
            Button {
                text <- index + " " + row;
                checkable <- true;
                clicked => { root.selected = row; }
            }
            Text { text <- row + "!"; }
        }
    }

    conditional-repeat := Rectangle {
        if root.show-details {
            for n in root.row-count() {
                Text { text <- "number " + n; }
            }
        }
    }
}
