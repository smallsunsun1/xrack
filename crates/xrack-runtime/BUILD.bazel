load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps")

rust_library(
    name = "xrack_runtime",
    srcs = glob(["src/*.rs"]),
    crate_name = "xrack_runtime",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.5.1",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "property_test",
    size = "small",
    crate = ":xrack_runtime",
)
