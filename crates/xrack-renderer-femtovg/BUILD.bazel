load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "xrack_renderer_femtovg",
    srcs = glob([
        "src/*.rs",
        "src/scene3d/**/*.rs",
        "src/text/**/*.rs",
    ]),
    aliases = aliases(),
    compile_data = [
        "src/scene3d/bloom.wgsl",
        "src/scene3d/composite_input.wgsl",
        "src/scene3d/depth_of_field.wgsl",
        "src/scene3d/morph.wgsl",
        "src/scene3d/motion.wgsl",
        "src/scene3d/occlusion.wgsl",
        "src/scene3d/particles.wgsl",
        "src/scene3d/particle_instances.wgsl",
        "src/pixel_blit.wgsl",
        "src/scene3d/reflection_filter.wgsl",
        "src/scene3d/screen_data_float.wgsl",
        "src/scene3d/screen_data_packed.wgsl",
        "src/scene3d/screen_indirect.wgsl",
        "src/scene3d/screen_packing.wgsl",
        "src/scene3d/screen_reflection.wgsl",
        "src/scene3d/screen_reflection_msaa.wgsl",
        "src/scene3d/screen_reflection_single.wgsl",
        "src/scene3d/scene.wgsl",
        "src/scene3d/material_sampling.wgsl",
        "src/scene3d/depth.wgsl",
        "src/scene3d/skin.wgsl",
        "src/scene3d/supersampling.wgsl",
        "src/scene3d/temporal.wgsl",
        "src/scene3d/tone_map.wgsl",
        "src/scene3d/transparency.wgsl",
        "src/scene3d/transmission_depth.wgsl",
        "src/scene3d/uv.wgsl",
        "src/scene3d/volumetric_fog.wgsl",
        "src/scene3d/volumetric_fog_profile.wgsl",
        "src/scene3d/volumetric_fog_noise.wgsl",
    ],
    crate_name = "xrack_renderer_femtovg",
    rustc_flags = [
        "--cfg=xrack_femtovg_glyph_samples",
        "--check-cfg=cfg(xrack_femtovg_glyph_samples)",
    ],
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.9.0",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/xrack-runtime:xrack_runtime",
        "//crates/xrack-layout:xrack_layout",
        "//crates/xrack-assets:xrack_assets",
    ] + all_crate_deps(normal = True),
)


rust_binary(
    name = "xrack-gpu-trace",
    crate_name = "xrack_gpu_trace",
    srcs = ["src/bin/gpu_trace.rs"],
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    visibility = ["//visibility:public"],
)
