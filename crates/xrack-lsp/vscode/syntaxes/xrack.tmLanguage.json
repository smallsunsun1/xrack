{
  "name": "XRack",
  "scopeName": "source.xrack",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#members"
    },
    {
      "include": "#values"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#references"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xrack",
          "match": "//.*$"
        },
        {
          "name": "comment.block.xrack",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xrack",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.xrack",
              "match": "\\\\(?:u[0-9a-fA-F]{4}|[\"\\\\/bfnrt])"
            },
            {
              "name": "invalid.illegal.escape.xrack",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.xrack",
          "begin": "(?<![A-Za-z_0-9-])(import)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.xrack"
            },
            "2": {
              "name": "punctuation.section.block.begin.xrack"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.xrack"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "keyword.control.import.xrack",
              "match": "(?<![A-Za-z_0-9-])as(?![A-Za-z_0-9-])"
            },
            {
              "name": "entity.name.type.imported.xrack",
              "match": "[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*"
            },
            {
              "name": "punctuation.separator.xrack",
              "match": ","
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.record.xrack",
          "begin": "(?<![A-Za-z_0-9-])(struct)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "entity.name.type.xrack"
            },
            "3": {
              "name": "punctuation.section.block.begin.xrack"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.xrack"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(:)\\s*(\\[\\s*)?([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(\\s*\\])?",
              "captures": {
                "1": {
                  "name": "variable.other.property.declaration.xrack"
                },
                "2": {
                  "name": "punctuation.separator.key-value.xrack"
                },
                "3": {
                  "name": "punctuation.section.brackets.begin.xrack"
                },
                "4": {
                  "name": "entity.name.type.xrack"
                },
                "5": {
                  "name": "punctuation.section.brackets.end.xrack"
                }
              }
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "name": "meta.callback.xrack",
          "begin": "(?<![A-Za-z_0-9-])(callback)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?=\\s*\\()",
          "end": "(?=;|[{}])",
          "beginCaptures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "entity.name.function.callback.xrack"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*(?=\\s*:)",
              "name": "variable.parameter.xrack"
            },
            {
              "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*",
              "name": "entity.name.type.xrack"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "match": "(?<![A-Za-z_0-9-])(component|global|struct)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "entity.name.type.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(inherits)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "keyword.control.xrack"
            },
            "2": {
              "name": "entity.other.inherited-class.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(property)\\s*(<)\\s*(\\[\\s*)?([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(\\s*\\])?\\s*(>)\\s*([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)?",
          "captures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "punctuation.definition.type.begin.xrack"
            },
            "3": {
              "name": "punctuation.section.brackets.begin.xrack"
            },
            "4": {
              "name": "entity.name.type.xrack"
            },
            "5": {
              "name": "punctuation.section.brackets.end.xrack"
            },
            "6": {
              "name": "punctuation.definition.type.end.xrack"
            },
            "7": {
              "name": "variable.other.property.declaration.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(callback)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "entity.name.function.callback.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(let)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?:\\s*(:)\\s*(\\[\\s*)?([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(\\s*\\])?)?",
          "captures": {
            "1": { "name": "keyword.control.xrack" },
            "2": { "name": "variable.other.local.xrack" },
            "3": { "name": "punctuation.separator.type.xrack" },
            "4": { "name": "punctuation.section.brackets.begin.xrack" },
            "5": { "name": "entity.name.type.xrack" },
            "6": { "name": "punctuation.section.brackets.end.xrack" }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(for)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?:\\s*(\\[)\\s*([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(\\]))?(?=\\s+in\\b)",
          "captures": {
            "1": {
              "name": "keyword.control.xrack"
            },
            "2": {
              "name": "variable.parameter.xrack"
            },
            "3": {
              "name": "punctuation.section.brackets.begin.xrack"
            },
            "4": {
              "name": "variable.parameter.xrack"
            },
            "5": {
              "name": "punctuation.section.brackets.end.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(animate)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "keyword.control.xrack"
            },
            "2": {
              "name": "variable.other.property.xrack"
            }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(:=)",
          "captures": {
            "1": {
              "name": "entity.name.label.xrack"
            },
            "2": {
              "name": "keyword.operator.assignment.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(\\()([A-Za-z0-9_,\\s-]*)(\\))\\s*(=>)",
          "captures": {
            "1": {
              "name": "entity.name.function.handler.xrack"
            },
            "2": {
              "name": "punctuation.section.parens.begin.xrack"
            },
            "3": {
              "name": "variable.parameter.xrack"
            },
            "4": {
              "name": "punctuation.section.parens.end.xrack"
            },
            "5": {
              "name": "keyword.operator.arrow.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(=>)",
          "captures": {
            "1": {
              "name": "entity.name.function.handler.xrack"
            },
            "2": {
              "name": "keyword.operator.arrow.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(accessible-live)\\s*(:)\\s*(off|polite|assertive)(?=\\s*(?:;|\\}|$))",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(return-key)\\s*(:)\\s*(auto|next|done)(?=\\s*(?:;|\\}|$))",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(keyboard-capitalization)\\s*(:)\\s*(auto|none|words|sentences|characters)(?=\\s*(?:;|\\}|$))",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(input-purpose)\\s*(:)\\s*(auto|username|current-password|new-password|one-time-code)(?=\\s*(?:;|\\}|$))",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(input-type)\\s*(:)\\s*(text|password|number|decimal|search|email|url|tel)(?=\\s*(?:;|\\}|$))",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(:)(?![=])",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(<->)",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "keyword.operator.assignment.xrack"
            }
          }
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.language.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:true|false)(?![A-Za-z_0-9-])"
        },
        {
          "name": "constant.other.color.xrack",
          "match": "#[0-9a-fA-F]+(?![A-Za-z_0-9-])"
        },
        {
          "match": "(?<![A-Za-z_0-9])([0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)(px|ms|deg|%)?(?![A-Za-z_0-9])",
          "captures": {
            "1": {
              "name": "constant.numeric.xrack"
            },
            "2": {
              "name": "keyword.other.unit.xrack"
            }
          }
        },
        {
          "match": "(@mesh-url)(\\s*\\(\\s*)(\"(?:[^\"\\\\]|\\\\.)*\")(\\s*,\\s*)(auto-lod|lightmap-uv)(?:(\\s*,\\s*)(auto-lod|lightmap-uv))?(?=\\s*\\))",
          "captures": {
            "1": {
              "name": "support.function.builtin.xrack"
            },
            "3": {
              "name": "string.quoted.double.xrack"
            },
            "5": {
              "name": "keyword.other.xrack"
            },
            "7": {
              "name": "keyword.other.xrack"
            }
          }
        },
        {
          "name": "support.function.xrack",
          "match": "@(?:image-url|mesh-url|texture-url|environment-url|shader-url|material-shader-url|instance-table-url|particle-shape-url|markdown|tr|linear-gradient|radial-gradient|children|slot)(?![A-Za-z_0-9-])"
        },
        {
          "match": "(?<![A-Za-z_0-9.-])(Math|Strings|Model|Colors|Dates|Times|I18n|Log|Point2D|Point3D|Vector2D|Vector3D|Quaternion3D|Transform2D|TextureData2D|TextureData3D|Scene3D|Physics3D)(\\.)([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "support.class.xrack"
            },
            "2": {
              "name": "punctuation.accessor.xrack"
            },
            "3": {
              "name": "support.function.xrack"
            }
          }
        },
        {
          "name": "variable.other.property.xrack",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*(?![A-Za-z_0-9-]|\\s*\\()"
        },
        {
          "match": "(?<![A-Za-z_0-9-])(ImageFit|ImageTileMode|ImageHorizontalAlignment|ImageVerticalAlignment|ImageRendering|ButtonDisplay|LayoutAlignment|CrossAxisAlignment|Orientation|FlickDirection|FlickBoundsBehavior|FlickBoundsMovement|LayoutDirection|FlexboxLayoutDirection|FlexboxLayoutWrap|DialInputMode|ScrollBarPolicy|ScrollSnapMode|ScrollAlignment|TextWrap|MouseSelectionMode|InputValidity|TextHorizontalAlignment|TextVerticalAlignment|TextOverflow|InputType|InputPurpose|KeyboardCapitalization|ReturnKey|AccessibleLive|CheckState|ColorScheme|SceneToneMap|DialogRole|DragAction|DrawerEdge|EventResult|FocusReason|FileDialogMode|MessageButtons|LogLevel|MessageLevel|PopupPlacement|SelectionTarget|StandardButtonKind|SwipeSide)(\\.)(?:([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*))?",
          "captures": {
            "1": {
              "name": "support.type.xrack"
            },
            "2": {
              "name": "punctuation.accessor.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "name": "constant.other.enum.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:space-between|space-around|space-evenly|always-off|stop-at-bounds|drag-over-bounds|overshoot-bounds|drag-and-overshoot-bounds|follow-bounds-behavior|both|always|on-release|none|horizontal|always-on|as-needed|char-wrap|word-wrap|circular|pixelated|smooth|repeat|round|preserve|vertical|columns|contain|no-wrap|stretch|accept|bottom|center|reject|cells|cover|right|start|auto|fill|left|rows|end|top|circle)(?![A-Za-z_0-9-])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:export|import|translations|from|as|inherits|if|else|for|let|match|slot|in-out|in|out|private|pure|animate|states|when)(?![A-Za-z_0-9-])"
        },
        {
          "name": "storage.type.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:component|global|struct|enum|property|callback|function)(?![A-Za-z_0-9-])"
        },
        {
          "name": "variable.language.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:root|self)(?![A-Za-z_0-9-])"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(::)\\s*([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)",
          "captures": {
            "1": {
              "name": "entity.name.type.enum.xrack"
            },
            "2": {
              "name": "punctuation.separator.namespace.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "name": "support.type.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:int|float|bool|string|styled-text|length|point2d|point3d|vector3d|quaternion3d|rotationtrack3d|hit3d|instance3d|instancetable3d|texturedata2d|texturedata3d|meshasset3d|meshnode3d|bounds3d|projectedpoint3d|renderstats3d|walkresult3d|physicsworld3d|scenemodel3d|physicscontact3d|physicshit3d|vector2d|transform2d|Point2D|Point3D|Vector3D|RotationTrack3D|Hit3D|Instance3D|InstanceTable3D|TextureData2D|TextureData3D|MeshAsset3D|MeshNode3D|Bounds3D|ProjectedPoint3D|RenderStats3D|WalkResult3D|PhysicsWorld3D|SceneModel3D|PhysicsContact3D|PhysicsHit3D|Vector2D|Transform2D|percent|color|brush|image|ImageFit|ImageTileMode|ImageHorizontalAlignment|ImageVerticalAlignment|ImageRendering|ButtonDisplay|LayoutAlignment|CrossAxisAlignment|Orientation|FlickDirection|FlickBoundsBehavior|FlickBoundsMovement|LayoutDirection|FlexboxLayoutDirection|FlexboxLayoutWrap|DialInputMode|ScrollBarPolicy|ScrollSnapMode|ScrollAlignment|TextWrap|MouseSelectionMode|InputValidity|TextHorizontalAlignment|TextVerticalAlignment|TextOverflow|InputType|InputPurpose|KeyboardCapitalization|ReturnKey|AccessibleLive|CheckState|ColorScheme|SceneToneMap|Date|DialogRole|DragAction|DrawerEdge|EventResult|FocusReason|KeyEvent|KeyModifiers|FileDialogMode|MessageButtons|LogLevel|MessageLevel|PopupPlacement|SelectionTarget|StandardButtonKind|SwipeSide|Time)(?![A-Za-z_0-9-])"
        },
        {
          "name": "support.type.xrack",
          "match": "(?<![A-Za-z_0-9.-])(?:TumblerOption|PathView|PathViewOption|SelectionStartHandle|SelectionEndHandle|StackLayout|StackItem|CustomRender|SceneView3D|MeshLoader3D|FrameAnimation)(?=\\s*\\{)"
        },
        {
          "name": "entity.name.type.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*(?=\\s*\\{)"
        },
        {
          "name": "entity.name.function.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*(?=\\s*\\()"
        },
        {
          "name": "support.type.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Z][A-Za-z_0-9-]*(?![A-Za-z_0-9-])"
        },
        {
          "name": "variable.other.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xrack",
          "match": "<->|<-|:=|=>|->|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\.\\.|[=+*/%!?<>-]"
        },
        {
          "name": "punctuation.accessor.xrack",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.xrack",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.section.block.xrack",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.xrack",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.xrack",
          "match": "[()]"
        }
      ]
    }
  }
}
