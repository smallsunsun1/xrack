{
  "name": "XRack",
  "scopeName": "source.xrack",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#members"
    },
    {
      "include": "#values"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#references"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xrack",
          "match": "//.*$"
        },
        {
          "name": "comment.block.xrack",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xrack",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.xrack",
              "match": "\\\\(?:u[0-9a-fA-F]{4}|[\"\\\\/bfnrt])"
            },
            {
              "name": "invalid.illegal.escape.xrack",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.xrack",
          "begin": "(?<![A-Za-z_0-9-])(import)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.xrack"
            },
            "2": {
              "name": "punctuation.section.block.begin.xrack"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.xrack"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "keyword.control.import.xrack",
              "match": "(?<![A-Za-z_0-9-])as(?![A-Za-z_0-9-])"
            },
            {
              "name": "entity.name.type.imported.xrack",
              "match": "[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*"
            },
            {
              "name": "punctuation.separator.xrack",
              "match": ","
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9-])(component|struct)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "entity.name.type.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(inherits)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "keyword.control.xrack"
            },
            "2": {
              "name": "entity.other.inherited-class.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(property)\\s*(<)\\s*(\\[\\s*)?([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(\\s*\\])?\\s*(>)\\s*([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)?",
          "captures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "punctuation.definition.type.begin.xrack"
            },
            "3": {
              "name": "punctuation.section.brackets.begin.xrack"
            },
            "4": {
              "name": "entity.name.type.xrack"
            },
            "5": {
              "name": "punctuation.section.brackets.end.xrack"
            },
            "6": {
              "name": "punctuation.definition.type.end.xrack"
            },
            "7": {
              "name": "variable.other.property.declaration.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(callback)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "storage.type.xrack"
            },
            "2": {
              "name": "entity.name.function.callback.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(for)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?:\\s*(\\[)\\s*([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(\\]))?(?=\\s+in\\b)",
          "captures": {
            "1": {
              "name": "keyword.control.xrack"
            },
            "2": {
              "name": "variable.parameter.xrack"
            },
            "3": {
              "name": "punctuation.section.brackets.begin.xrack"
            },
            "4": {
              "name": "variable.parameter.xrack"
            },
            "5": {
              "name": "punctuation.section.brackets.end.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])(animate)\\s+([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "keyword.control.xrack"
            },
            "2": {
              "name": "variable.other.property.xrack"
            }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(:=)",
          "captures": {
            "1": {
              "name": "entity.name.label.xrack"
            },
            "2": {
              "name": "keyword.operator.assignment.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(\\()([A-Za-z0-9_,\\s-]*)(\\))\\s*(=>)",
          "captures": {
            "1": {
              "name": "entity.name.function.handler.xrack"
            },
            "2": {
              "name": "punctuation.section.parens.begin.xrack"
            },
            "3": {
              "name": "variable.parameter.xrack"
            },
            "4": {
              "name": "punctuation.section.parens.end.xrack"
            },
            "5": {
              "name": "keyword.operator.arrow.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(=>)",
          "captures": {
            "1": {
              "name": "entity.name.function.handler.xrack"
            },
            "2": {
              "name": "keyword.operator.arrow.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(:)(?![=])",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "punctuation.separator.key-value.xrack"
            }
          }
        },
        {
          "match": "(?<![A-Za-z_0-9-])([A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*)\\s*(<=>)",
          "captures": {
            "1": {
              "name": "variable.other.property.xrack"
            },
            "2": {
              "name": "keyword.operator.assignment.xrack"
            }
          }
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "name": "constant.language.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:true|false)(?![A-Za-z_0-9-])"
        },
        {
          "name": "constant.other.color.xrack",
          "match": "#[0-9a-fA-F]+(?![A-Za-z_0-9-])"
        },
        {
          "match": "(?<![A-Za-z_0-9])([0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)(px|ms|deg|%)?(?![A-Za-z_0-9])",
          "captures": {
            "1": {
              "name": "constant.numeric.xrack"
            },
            "2": {
              "name": "keyword.other.unit.xrack"
            }
          }
        },
        {
          "name": "support.function.xrack",
          "match": "@(?:image-url|linear-gradient|radial-gradient)(?![A-Za-z_0-9-])"
        },
        {
          "name": "variable.other.property.xrack",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*"
        },
        {
          "match": "(?<![A-Za-z_0-9-])(int|float|bool|string|length|percent|color|brush|image|ImageFit|ImageTileMode|ImageHorizontalAlignment|ImageVerticalAlignment|ImageRendering|LayoutAlignment|CrossAxisAlignment|Orientation|DialInputMode|ScrollBarPolicy|TextWrap|DialogRole|DrawerEdge|SelectionTarget)(\\.)(?:(space-between|space-around|space-evenly|always-off|horizontal|always-on|as-needed|char-wrap|word-wrap|circular|pixelated|smooth|repeat|round|preserve|vertical|columns|contain|no-wrap|stretch|accept|bottom|center|reject|cells|cover|right|start|auto|fill|left|rows|end|top))?(?![A-Za-z_0-9-])",
          "captures": {
            "1": {
              "name": "support.type.xrack"
            },
            "2": {
              "name": "punctuation.accessor.xrack"
            },
            "3": {
              "name": "constant.other.enum.xrack"
            }
          }
        },
        {
          "name": "constant.other.enum.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:space-between|space-around|space-evenly|always-off|horizontal|always-on|as-needed|char-wrap|word-wrap|circular|pixelated|smooth|repeat|round|preserve|vertical|columns|contain|no-wrap|stretch|accept|bottom|center|reject|cells|cover|right|start|auto|fill|left|rows|end|top|circle)(?![A-Za-z_0-9-])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:export|import|from|as|inherits|if|for|in-out|in|out|private|pure|animate)(?![A-Za-z_0-9-])"
        },
        {
          "name": "storage.type.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:component|struct|property|callback)(?![A-Za-z_0-9-])"
        },
        {
          "name": "variable.language.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:root|self)(?![A-Za-z_0-9-])"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "support.type.xrack",
          "match": "(?<![A-Za-z_0-9-])(?:int|float|bool|string|length|percent|color|brush|image|ImageFit|ImageTileMode|ImageHorizontalAlignment|ImageVerticalAlignment|ImageRendering|LayoutAlignment|CrossAxisAlignment|Orientation|DialInputMode|ScrollBarPolicy|TextWrap|DialogRole|DrawerEdge|SelectionTarget)(?![A-Za-z_0-9-])"
        },
        {
          "name": "entity.name.type.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*(?=\\s*\\{)"
        },
        {
          "name": "entity.name.function.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*(?=\\s*\\()"
        },
        {
          "name": "support.type.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Z][A-Za-z_0-9-]*(?![A-Za-z_0-9-])"
        },
        {
          "name": "variable.other.xrack",
          "match": "(?<![A-Za-z_0-9-])[A-Za-z_][A-Za-z_0-9]*(?:-[A-Za-z_0-9]+)*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xrack",
          "match": "<=>|:=|=>|->|==|!=|<=|>=|&&|\\|\\||\\+=|-=|[=+*/%!?<>-]"
        },
        {
          "name": "punctuation.accessor.xrack",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.xrack",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.section.block.xrack",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.xrack",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.xrack",
          "match": "[()]"
        }
      ]
    }
  }
}
