load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "xrack-lsp",
    srcs = [
        "src/analysis.rs",
        "src/catalog.rs",
        "src/completion.rs",
        "src/completion/imports.rs",
        "src/completion/index_cache.rs",
        "src/completion/symbols.rs",
        "src/completion/workspace_index.rs",
        "src/editor_tokens.rs",
        "src/formatting.rs",
        "src/main.rs",
        "src/protocol.rs",
        "src/server_events.rs",
        "src/tests.rs",
    ],
    edition = "2024",
    deps = [
        "//crates/xrack-ir:xrack_ir",
        "//crates/xrack-parser:xrack_parser",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "xrack_lsp_test",
    size = "small",
    crate = ":xrack-lsp",
)
