load("@rules_android//android:rules.bzl", "android_library")
load(":editor_classpath.bzl", "android_editor_classpath")

android_library(
    name = "activity",
    srcs = [
        "dev/xrack/platform/XRackAccessibility.java",
        "dev/xrack/platform/XRackActivity.java",
        "dev/xrack/platform/XRackTextInput.java",
    ],
    custom_package = "dev.xrack.platform",
    exports_manifest = 1,
    manifest = "AndroidManifest.xml",
    resource_files = glob(["res/values*/strings.xml"]),
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
)

android_editor_classpath(
    name = "editor_classpath",
    activity = ":activity",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:android"],
)
