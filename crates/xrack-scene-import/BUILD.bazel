load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "xrack_scene_import",
    srcs = glob(["src/*.rs"]),
    aliases = aliases(),
    crate_name = "xrack_scene_import",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.9.0",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/xrack-assets:xrack_assets",
        "//crates/xrack-runtime:xrack_runtime",
        "//crates/xrack-syntax:xrack_syntax",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "scene_import_test",
    crate = ":xrack_scene_import",
)
