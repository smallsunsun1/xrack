load("@rules_rust//rust:defs.bzl", "rust_library")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")

rust_library(
    name = "xrack_mlir",
    srcs = glob(["src/*.rs"]),
    aliases = aliases(),
    crate_name = "xrack_mlir",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["--cfg=xrack_bazel"],
    version = "0.5.0",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/xrack-syntax:xrack_syntax",
        "//crates/xrack-ir:xrack_ir",
        "//mlir:xrack_mlir_bindings",
    ] + all_crate_deps(normal = True),
)
