load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "xrack_assets",
    srcs = glob(["src/*.rs"]),
    aliases = aliases(),
    crate_name = "xrack_assets",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.5.1",
    visibility = ["//visibility:public"],
    deps = ["//crates/xrack-runtime:xrack_runtime"] + all_crate_deps(normal = True),
)

rust_test(
    name = "assets_test",
    size = "small",
    crate = ":xrack_assets",
)
